        "chars": 1035,
        "chars_per_1k_ink": 7.87
      }
    },
    {
      "bbox": [
        305,
        2712,
        2122,
        3021
      ],
      "category": "Text",
      "text": "If such a chart is already available for your department, will you please have it brought up to date and send the requisite number of copies to me.",
