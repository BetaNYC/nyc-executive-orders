    {
      "bbox": [
        164,
        1117,
        1768,
        1406
      ],
      "category": "Text",
      "text": "At this season of the year most of the members of your staff will desire an opportunity to do their Christmas shopping. It is my desire that you arrange that this opportunity be afforded to all who desire it by granting the necessary time off from duty.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1488,
          "min": -1.125
        },
        "category": {
          "n_tokens": 1,
