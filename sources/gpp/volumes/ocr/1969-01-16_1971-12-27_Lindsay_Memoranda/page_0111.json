    {
      "bbox": [
        0,
        1159,
        2047,
        1757
      ],
      "category": "Text",
      "text": "Please instruct every employee in your administration, of all departments, agencies, and offices that the acceptance of gifts of any kind, from the City, is prohibited. Persons or firms having a direct or indirect interest in business affairs, their employees, and their agents are hereby restricted. Violations of this section will be subject to the City's City Court, and the City Police and City fire departments. Employees are hereby forbidden from receiving gifts of any kind from their superiors, their own agency, or for personal use, unless specifically requested by their superiors. This restriction applies to all City employees, including the heads of departments, agencies, and offices, except those employees designated as exempt by Section 1106 of the New York City Charter. Your employees should also be advised that it is improper for them to offer gifts to their superiors in their own agency or for City employees to accept gifts from their staff.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3464,
          "min": -1.6633
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0015,
          "min": -0.0015
        },
        "text": {
          "n_tokens": 184,
