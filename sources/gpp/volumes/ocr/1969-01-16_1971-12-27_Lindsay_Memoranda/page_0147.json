    {
      "bbox": [
        238,
        1411,
        1847,
        1598
      ],
      "category": "Text",
      "text": "As you well know, the serious financial condition of the City has resulted in the elimination of a number of programs and severe budget cuts in many others. The Urban Corps will be operating this coming fiscal year with a budget cut of 50 per cent.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2265,
          "min": -1.357
        },
        "category": {
          "n_tokens": 1,
