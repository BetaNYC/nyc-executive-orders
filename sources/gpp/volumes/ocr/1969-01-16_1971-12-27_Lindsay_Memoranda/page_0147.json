          "min": -0.0001
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0003,
          "min": -0.0099
        }
      },
      "ink": {
        "ink_px": 2706,
        "area_px": 288915,
        "density": 0.00937,
        "chars": 248,
        "chars_per_1k_ink": 91.65
      }
    },
    {
      "bbox": [
        238,
        1642,
        1847,
        1827
      ],
      "category": "Text",
      "text": "In order to place as many students as possible we are starting our summer program two weeks later than in previous years. Therefore, no intern will be allowed to begin work until June 21, which is the official start of the summer program.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1617,
          "min": -1.2885
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 49,
          "mean": -0.0001,
          "min": -0.0019
        }
      },
      "ink": {
        "ink_px": 2445,
        "area_px": 285825,
        "density": 0.00855,
        "chars": 238,
        "chars_per_1k_ink": 97.34
      }
    },
    {
      "bbox": [
        238,
        1872,
        1914,
        2191
      ],
      "category": "Text",
      "text": "We are also forced to limit the number of students that we can accept from each college and thus, the number of interns we can assign to each agency. We will attempt to meet the City's overall needs as well as those of the interns as best we can in our straitened condition. Martin Rose, Executive Director of the Urban Corps, will be in touch with the Urban Corps coordinator in your agency to discuss this summer's program and its constraints.",
