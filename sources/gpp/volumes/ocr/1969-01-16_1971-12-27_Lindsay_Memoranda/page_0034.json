    {
      "bbox": [
        411,
        1247,
        2054,
        1464
      ],
      "category": "Text",
      "text": "As one of the CIST (Geographic Information System) activities being developed under Dr. E.S. Savas, this office is developing a capability for producing computer-generated maps. I believe this will be of value to a wide range of City operations.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2648,
          "min": -1.4159
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.007,
          "min": -0.3169
        }
      },
      "ink": {
        "ink_px": 39296,
