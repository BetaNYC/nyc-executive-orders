    {
      "bbox": [
        225,
        1870,
        1815,
        2193
      ],
      "category": "Text",
      "text": "In response to this appropriation, City University has established a Center for Urban Analysis to coordinate studies to be done by its staff. Studies proposed to the Center by City agencies, the City Council, the Board of Estimate or other branches of the University will be reviewed by a policy committee to be jointly designated by City University and the City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2239,
          "min": -1.2344
        },
        "category": {
          "n_tokens": 1,
