    {
      "bbox": [
        559,
        739,
        2017,
        801
      ],
      "category": "Text",
      "text": "The rules as to when this advice must be given are as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.4516,
          "min": -1.6517
        },
        "category": {
