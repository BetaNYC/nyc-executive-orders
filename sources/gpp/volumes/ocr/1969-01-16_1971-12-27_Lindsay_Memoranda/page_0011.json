          "min": -0.4313
        }
      },
      "ink": {
        "ink_px": 667,
        "area_px": 91476,
        "density": 0.00729,
        "chars": 62,
        "chars_per_1k_ink": 92.95
      }
    },
    {
      "bbox": [
        159,
        857,
        2003,
        1003
      ],
      "category": "Text",
      "text": "1. where the inquiry relates to possible corruption or wrongdoing by the employee, the warning should be given before the employee is questioned.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3806,
          "min": -1.7572
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0337,
          "min": -0.0337
        },
        "text": {
          "n_tokens": 26,
          "mean": -0.0248,
          "min": -0.6327
        }
      },
      "ink": {
        "ink_px": 3158,
        "area_px": 249018,
        "density": 0.01268,
        "chars": 145,
        "chars_per_1k_ink": 45.92
      }
    },
    {
      "bbox": [
        159,
        1045,
        1981,
        1375
      ],
      "category": "Text",
      "text": "2. where the inquiry clearly relates only to incompetency or misconduct not amounting to corruption, the advice need be given only if an employee refuses to answer a question relating to his official duties and it is contemplated that a disciplinary charge will be based on this refusal. In such case, the employee should be given an opportunity to answer the question after the advice has been given.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2466,
          "min": -1.5974
        },
        "category": {
          "n_tokens": 1,
