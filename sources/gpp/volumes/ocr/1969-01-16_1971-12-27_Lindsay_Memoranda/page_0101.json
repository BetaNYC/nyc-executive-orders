    },
    {
      "bbox": [
        194,
        2313,
        2037,
        2514
      ],
      "category": "Text",
      "text": "As Co-Chairman of the Municipal Campaign, Mr. Victor Gotbaum and I are calling a meeting for all representatives in the Board of Estimate Room of City Hall on October 2nd at 9:00 a.m. Please be sure that your staff representatives are present.",
