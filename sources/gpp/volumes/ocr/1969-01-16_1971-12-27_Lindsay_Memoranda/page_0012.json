        "ink_px": 1092,
        "area_px": 438060,
        "density": 0.00249,
        "chars": 309,
        "chars_per_1k_ink": 282.97
      }
    },
    {
      "bbox": [
        257,
        1894,
        2077,
        2088
      ],
      "category": "List-item",
      "text": "6) Any agency which does not already have a regulation under which refusal to cooperate in a proper inquiry constitutes a ground for dismissal, should adopt at once a regulation along the following lines.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2648,
          "min": -1.6978
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 37,
          "mean": -0.0003,
          "min": -0.0049
        }
      },
      "ink": {
        "ink_px": 935,
        "area_px": 344760,
        "density": 0.00271,
        "chars": 204,
        "chars_per_1k_ink": 218.18
      }
    },
    {
      "bbox": [
        448,
        2125,
        2052,
        2597
      ],
      "category": "Text",
      "text": "> \"An employee who refuses or fails to appear to answer questions as to the performance of his official duties before this agency, the Department of Investigation, or any lawfully constituted court, officer or body, having authority to make inquiry relating thereto, or who, having appeared, refuses to answer questions specifically, narrowly and directly relating to the performance of his official duties, shall be subject to charges of misconduct therefor and if found guilty shall be subject to dismissal or other disciplinary action.\"",
