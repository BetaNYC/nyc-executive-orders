    {
      "bbox": [
        123,
        2144,
        2215,
        2305
      ],
      "category": "Text",
      "text": "Deputy Mayor Richard R. Aurelio and Mr. Victor Gotbaum, Executive Director of District Council #37 of the American Federation of State, County and Municipal Employees will again serve as Co-Chairmen of the Municipal Campaign.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2427,
          "min": -1.6694
        },
        "category": {
          "n_tokens": 1,
