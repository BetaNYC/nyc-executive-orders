    {
      "bbox": [
        133,
        1317,
        2112,
        1489
      ],
      "category": "Text",
      "text": "Once each year Municipal employees, like all people who work in New York City have the opportunity to help supporting the 425 voluntary hospital, health and welfare agencies of the United Fund of Greater New York.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.304,
          "min": -1.6079
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 42,
          "mean": -0.0215,
          "min": -0.6452
        }
      },
      "ink": {
        "ink_px": 12940,
        "area_px": 315725,
        "density": 0.04099,
        "chars": 213,
        "chars_per_1k_ink": 16.46
      }
    },
    {
      "bbox": [
        127,
        1546,
        2247,
        1757
      ],
      "category": "Text",
      "text": "These agencies are dealing with critical problems in the lives of all of our people, drug addiction, cancer, heart disease, adoption, day care, blind, hospitals and many many others. They serve over 4,000,000 of our fellow New Yorkers each year at a total operating cost of over one billion dollars.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2906,
          "min": -1.4076
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 68,
          "mean": -0.0013,
          "min": -0.019
        }
      },
      "ink": {
        "ink_px": 17315,
        "area_px": 395115,
        "density": 0.04382,
        "chars": 299,
        "chars_per_1k_ink": 17.27
      }
    },
    {
      "bbox": [
        127,
        1778,
        2167,
        1969
      ],
      "category": "Text",
      "text": "In recognition of the vital role of the Fund in New York City, we have adopted a year-round voluntary payroll giving plan, so that city employees by a modest gift each payday can contribute their \"fair share\" to benefit the entire city.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2597,
          "min": -1.4784
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 49,
          "mean": -0.0069,
          "min": -0.2938
        }
      },
      "ink": {
        "ink_px": 13179,
