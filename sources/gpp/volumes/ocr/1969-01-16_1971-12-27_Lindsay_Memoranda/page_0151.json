        "density": 0.037,
        "chars": 236,
        "chars_per_1k_ink": 17.91
      }
    },
    {
      "bbox": [
        123,
        2007,
        2182,
        2123
      ],
      "category": "Text",
      "text": "Comptroller Beame fully supports this effort and is creating the necessary procedures for smooth and efficient operation of this contribution program.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2867,
          "min": -1.6858
        },
