    {
      "bbox": [
        365,
        1387,
        1969,
        1564
      ],
      "category": "Text",
      "text": "For several years the Boy Scouts of America has operated a Special Interest Exploring program for boys of high school age, particularly the sixteen to eighteen-year olds.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2205,
          "min": -1.2922
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 31,
