    {
      "bbox": [
        250,
        1216,
        1859,
        1310
      ],
      "category": "Text",
      "text": "RE: DESIGN AND CONSTRUCTION OF MASS TRANSPORTATION PROJECTS FOR NEW SUBWAY ROUTES",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2435,
