    {
      "bbox": [
        261,
        2038,
        2041,
        2326
      ],
      "category": "Text",
      "text": "In many inquiries conducted by the agency it will be necessary to question an employee concerning the performance of his official duties. The following advice as to his constitutional rights (which contains a warning as to the consequences of his refusal to answer a proper question) must be timely given. The proper form of advice is as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2864,
          "min": -1.7161
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 63,
          "mean": -0.0056,
          "min": -0.3485
        }
      },
      "ink": {
        "ink_px": 4763,
        "area_px": 508959,
        "density": 0.00936,
        "chars": 346,
        "chars_per_1k_ink": 72.64
      }
    },
    {
      "bbox": [
        567,
        2357,
        1863,
        2697
      ],
      "category": "Text",
      "text": "> \"I wish to advise you that you have all the rights and privileges guaranteed by the laws of the State of New York and the Constitutions of this State and of the United States, including the right not to be compelled to incriminate yourself. You have a right to have an attorney present if you wish.\"",
