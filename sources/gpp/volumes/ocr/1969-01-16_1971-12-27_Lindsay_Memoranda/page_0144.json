    },
    {
      "bbox": [
        357,
        1415,
        2010,
        1744
      ],
      "category": "Text",
      "text": "The base period on which retirement benefits are calculated was shortened for most City employees, effective July 1, 1968, from five years to one year, thus creating the possibility that a substantial amount of extra compensation creditable for retirement purposes in the year preceding retirement could distort the suppositions on the basis of which the City accrues its pension reserves.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2759,
