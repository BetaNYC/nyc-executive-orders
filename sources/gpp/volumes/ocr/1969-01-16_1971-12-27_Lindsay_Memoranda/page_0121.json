        "chars": 137,
        "chars_per_1k_ink": 4419.35
      }
    },
    {
      "bbox": [
        374,
        1617,
        1970,
        1763
      ],
      "category": "Text",
      "text": "The Citizens Union originally raised this question in a letter to the Mayor, which he transmitted to the Board.",
