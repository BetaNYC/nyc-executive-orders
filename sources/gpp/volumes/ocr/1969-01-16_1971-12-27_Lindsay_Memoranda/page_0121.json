        1802,
        1066,
        1851
      ],
      "category": "Text",
      "text": "The Citizens Union wrote:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2129,
          "min": -1.6953
        },
        "category": {
