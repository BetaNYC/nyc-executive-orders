        1345
      ],
      "category": "Text",
      "text": "RE: Applications for Federal Grants--Circular A-95 Procedures",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2051,
          "min": -1.4304
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 13,
          "mean": -0.0082,
