    },
    {
      "bbox": [
        304,
        1675,
        1805,
        1946
      ],
      "category": "Text",
      "text": "The success of such program requires effective coordination of such activities and services. Accordingly, I hereby designate the Department of Commerce and Industry in the Economic Development Administration to serve as the coordinating agency for \"Operation Main Street\".",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2161,
