    {
      "bbox": [
        273,
        1161,
        1767,
        1385
      ],
      "category": "Text",
      "text": "As the legislative session comes nearer to adjournment, a greater number of bills are being passed and sent to the Governor for executive action. Many of these bills affect the City and they are referred to appropriate City agencies for analysis and recommendation by my Legislative Representative in Albany.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2665,
          "min": -1.378
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 54,
          "mean": -0.0006,
          "min": -0.0248
        }
      },
      "ink": {
        "ink_px": 24257,
        "area_px": 334208,
        "density": 0.07258,
        "chars": 308,
        "chars_per_1k_ink": 12.7
      }
    },
    {
      "bbox": [
        273,
        1412,
        1859,
        1722
      ],
      "category": "Text",
      "text": "Bills which go to the Governor while the Legislature is still in session are \"10 day bills\". This means that the Governor has only 10 days in which to act on such bills. It is essential, therefore, that City agencies submit their reports on such bills within 48 hours after receipt of notice that a particular bill is before the Governor so that I may have the benefit of your advice in making my recommendations to the Governor.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2165,
          "min": -1.4407
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 91,
          "mean": -0.0007,
          "min": -0.0381
        }
      },
      "ink": {
        "ink_px": 34841,
        "area_px": 491040,
        "density": 0.07095,
        "chars": 429,
        "chars_per_1k_ink": 12.31
      }
    },
    {
      "bbox": [
        273,
        1757,
        1820,
        1895
      ],
      "category": "Text",
      "text": "Reports on bills before the Governor are to be submitted in accordance with my Memorandum to you dated January 11, 1954, in relation to reports on pending State legislation.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1965,
          "min": -1.2962
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 39,
          "mean": -0.0,
          "min": -0.0004
        }
      },
      "ink": {
        "ink_px": 13426,
        "area_px": 214755,
        "density": 0.06252,
        "chars": 173,
        "chars_per_1k_ink": 12.89
      }
    },
    {
      "bbox": [
        273,
        1929,
        1863,
        2110
      ],
      "category": "Text",
      "text": "Delay in replying to requests for reports on bills before the Governor for executive action may be detrimental to the City's interests. Accordingly, I anticipate and shall appreciate your prompt cooperation in reporting on bills before the Governor.",
