    {
      "bbox": [
        89,
        1295,
        1816,
        1423
      ],
      "category": "Text",
      "text": "Efficient operation of our City service requires a constructive approach in personnel administration, both in the central personnel agency and in the individual departments.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3201,
          "min": -1.4677
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 27,
          "mean": -0.003,
          "min": -0.0735
        }
      },
      "ink": {
        "ink_px": 10679,
