    {
      "bbox": [
        273,
        1388,
        1842,
        1687
      ],
      "category": "Text",
      "text": "The Department of Health is prepared to provide City employees and their families with the opportunity of being vaccinated against paralytic polio. The City furnishes vaccine free only to those under twenty and to needy adults. Each employee must therefore pay for the cost of the vaccine, which is 80 cents per dose. Two doses will be given this spring, approximately one month apart. The third dose will be given next winter. The administrative costs will be borne by the City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2727,
          "min": -1.4787
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 95,
          "mean": -0.0036,
          "min": -0.134
        }
      },
      "ink": {
        "ink_px": 44699,
        "area_px": 466966,
        "density": 0.09572,
        "chars": 479,
        "chars_per_1k_ink": 10.72
      }
    },
    {
      "bbox": [
        271,
        1725,
        1857,
        1940
      ],
      "category": "Text",
      "text": "The injections will be given in the basement of City Hall. In order to plan effectively, it will be necessary to know approximately how many of your employees and members of their families want the vaccinations. It will also be necessary for you to designate a person with whom detailed arrangements can be made concerning schedules, method of payment, etc.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2442,
          "min": -1.4245
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 66,
          "mean": -0.0002,
          "min": -0.009
        }
      },
      "ink": {
        "ink_px": 33914,
        "area_px": 340560,
        "density": 0.09958,
        "chars": 357,
        "chars_per_1k_ink": 10.53
      }
    },
    {
      "bbox": [
        267,
        1976,
        1814,
        2152
      ],
      "category": "Text",
      "text": "Dr. Leona Baumgartner, Commissioner of Health, 125 Worth Street, New York City, will appreciate hearing from you as soon as feasible. If City Hall is not easily accessible to your employees group, the Health Department will try to work out other suitable arrangements.",
