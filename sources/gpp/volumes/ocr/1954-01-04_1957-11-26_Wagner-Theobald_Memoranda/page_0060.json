        "density": 0.14268,
        "chars": 193,
        "chars_per_1k_ink": 6.78
      }
    },
    {
      "bbox": [
        171,
        1613,
        1747,
        1782
      ],
      "category": "Text",
      "text": "Since the City has allocated a record amount of $105 million for school construction purposes, there is a dire need that all agencies and interested parties in such agencies give top priority to the duties of this program.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2426,
          "min": -1.4134
        },
        "category": {
          "n_tokens": 1,
