          "min": -0.0011
        }
      },
      "ink": {
        "ink_px": 30013,
        "area_px": 253838,
        "density": 0.11824,
        "chars": 222,
        "chars_per_1k_ink": 7.4
      }
    },
    {
      "bbox": [
        171,
        1824,
        1688,
        1953
      ],
      "category": "Text",
      "text": "An additional feature of this comprehensive program is the allocation in a fiscal year of $20 odd million for the modernization and repair of school buildings.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.201,
          "min": -1.3338
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 30,
          "mean": -0.0003,
          "min": -0.0073
        }
      },
      "ink": {
        "ink_px": 21416,
        "area_px": 186147,
        "density": 0.11505,
        "chars": 159,
        "chars_per_1k_ink": 7.42
      }
    },
    {
      "bbox": [
        166,
        1994,
        1771,
        2297
      ],
      "category": "Text",
      "text": "In order to effectuate the aims and objectives of this vast school construction program, the agencies are instructed to give very careful consideration to planning and personnel in attaining this common objective. The closest cooperation and coordination in the relationships between the various agencies and the departments is essential to the execution of this order. I expect the fullest cooperation of all agencies and heads concerned with the school construction program.",
