          "min": -0.0342
        }
      },
      "ink": {
        "ink_px": 27203,
        "area_px": 384120,
        "density": 0.07082,
        "chars": 362,
        "chars_per_1k_ink": 13.31
      }
    },
    {
      "bbox": [
        246,
        2472,
        1685,
        2651
      ],
      "category": "Text",
      "text": "The Bureau of the Budget has initiated a procedure cover-\ning reporting on performance standards and workload data which is\nessential for budgetary controls and evaluation. This procedure is\noutlined in Executive Order No. 30.",
