    {
      "bbox": [
        271,
        1363,
        1656,
        1453
      ],
      "category": "Text",
      "text": "Several department heads have asked me to clarify agency\nresponsibility with respect to departmental reporting.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2641,
          "min": -1.4354
        },
        "category": {
