        "ink_px": 42920,
        "area_px": 626416,
        "density": 0.06852,
        "chars": 609,
        "chars_per_1k_ink": 14.19
      }
    },
    {
      "bbox": [
        222,
        2047,
        1811,
        2180
      ],
      "category": "Text",
      "text": "Delay in replying to requests for such comments may be detrimental to the City's interests. Accordingly, I expect your prompt cooperation in reporting on all bills before the Governor.",
