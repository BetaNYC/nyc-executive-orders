    },
    {
      "bbox": [
        207,
        1705,
        1797,
        1842
      ],
      "category": "Text",
      "text": "It is my intention that the recommendations contained in that report be strictly adhered to. Therefore, you are hereby directed to take the necessary steps to insure strict compliance with the original directive.",
