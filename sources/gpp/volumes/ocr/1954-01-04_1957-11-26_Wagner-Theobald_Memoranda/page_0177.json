      ],
      "category": "Text",
      "text": "TO: HEADS OF ALL CITY DEPARTMENTS AND AGENCIES\n\nFROM: ROBERT F. WAGNER, MAYOR OF THE CITY OF NEW YORK\n\nSUBJECT: CHECK-OFF OF UNION DUES",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2999,
          "min": -1.4744
        },
        "category": {
          "n_tokens": 1,
