        "ink_px": 33708,
        "area_px": 319196,
        "density": 0.1056,
        "chars": 253,
        "chars_per_1k_ink": 7.51
      }
    },
    {
      "bbox": [
        173,
        2484,
        1935,
        2683
      ],
      "category": "Text",
      "text": "As I have mentioned previously, I am most pleased with the progress we have made thus far, and I again want to express my appreciation to you and your employees for the effort and cooperation given in the development of this program.",
