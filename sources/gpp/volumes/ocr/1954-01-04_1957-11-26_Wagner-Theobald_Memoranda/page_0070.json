        1863,
        1164
      ],
      "category": "Text",
      "text": "SUBJECT: The 1955 Campaign of The Greater New York Fund - (Apr 25-June 29)",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3287,
          "min": -1.7765
        },
        "category": {
          "n_tokens": 1,
