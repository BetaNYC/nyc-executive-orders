    {
      "bbox": [
        262,
        1240,
        1810,
        1635
      ],
      "category": "Text",
      "text": "A number of cases have been called to my attention of City employees who have been handicapped through illness or injury, received rehabilitation training by competent medical agencies, been declared by competent medical authorities to be employable, but who were not reassigned to duty in their respective agencies,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2789,
