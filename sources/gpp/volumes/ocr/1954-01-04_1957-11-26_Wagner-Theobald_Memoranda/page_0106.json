        "chars_per_1k_ink": 12.75
      }
    },
    {
      "bbox": [
        153,
        1938,
        1872,
        2266
      ],
      "category": "Text",
      "text": "I have assured The Greater New York Fund of the full support of the Municipal Government in its campaign among city employees, and I am sure that you will organize a campaign for the Fund among the employees of your department, or if your department has a community chest or welfare fund, you will submit a strong recommendation on behalf of the Fund to the committee responsible for making contributions.",
      "logprob_stats": {
        "bbox": {
