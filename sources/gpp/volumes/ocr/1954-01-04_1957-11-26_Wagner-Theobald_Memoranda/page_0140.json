    {
      "bbox": [
        158,
        1137,
        1919,
        1771
      ],
      "category": "Text",
      "text": "The Joint Legislative Committee on Interstate Cooperation is conducting a survey to determine whether certified mail may be used as an acceptable alternative to registered mail, in cases where the present law requires or authorizes the use of registered mail to give notice. It is the thinking of the Joint Legislative Committee that in many such cases, certified mail, which is cheaper, could be substituted for an acceptable alternative.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2593,
