      ],
      "category": "Text",
      "text": "MEMORANDUM TO: HEADS OF ALL MAYOR'S DEPARTMENTS AND AGENCIES.\nSUBJECT: MONTHLY ADMINISTRATIVE REPORTS",
      "logprob_stats": {
        "bbox": {
