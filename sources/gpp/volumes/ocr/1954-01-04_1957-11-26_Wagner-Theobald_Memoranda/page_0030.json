      },
      "ink": {
        "ink_px": 19898,
        "area_px": 433260,
        "density": 0.04593,
        "chars": 373,
        "chars_per_1k_ink": 18.75
      }
    },
    {
      "bbox": [
        222,
        1927,
        1700,
        2128
      ],
      "category": "Text",
      "text": "Commissioner Henry L. McCarthy of the Department of Welfare has consented to serve as chairman of the drive among city employees, and I know that you will help the Commissioner in every way you can in this most necessary work.",
