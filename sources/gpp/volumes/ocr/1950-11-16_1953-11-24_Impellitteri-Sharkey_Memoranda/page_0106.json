    {
      "bbox": [
        354,
        1366,
        1770,
        1574
      ],
      "category": "Text",
      "text": "As the legislative session comes nearer to adjournment, a great number of bills are being passed and sent to the Governor for executive action. Many of these bills affect the City and they are referred to you for comments by my Legislative Representative in Albany.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2512,
          "min": -1.3445
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 50,
          "mean": -0.0002,
          "min": -0.0025
        }
      },
      "ink": {
        "ink_px": 30922,
        "area_px": 298620,
        "density": 0.10355,
        "chars": 265,
        "chars_per_1k_ink": 8.57
      }
    },
    {
      "bbox": [
        354,
        1609,
        1718,
        1939
      ],
      "category": "Text",
      "text": "Bills which go to the Governor while the Legislature is still in session are \"10 day bills\". This means that the Governor has only 10 days in which to act on such bills. It is essential, therefore, that City agencies submit their reports to Mr. Condello in Albany within 48 hours after receipt of notice that a particular bill is before the Governor. Reports on bills before the Governor are to be submitted in accordance with my Memorandum No. 26, dated November 16, 1952.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2218,
          "min": -1.2231
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 112,
          "mean": -0.0005,
          "min": -0.0407
        }
      },
      "ink": {
        "ink_px": 53120,
        "area_px": 454840,
        "density": 0.11679,
        "chars": 473,
        "chars_per_1k_ink": 8.9
      }
    },
    {
      "bbox": [
        354,
        1974,
        1655,
        2102
      ],
      "category": "Text",
      "text": "Delay in replying to requests for such comments may be detrimental to the City's interests. Accordingly, I expect your prompt cooperation in reporting on bills before the Governor.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.188,
          "min": -1.3753
