    {
      "bbox": [
        325,
        1326,
        1506,
        1572
      ],
      "category": "Text",
      "text": "Correspondence with any official of a State or Federal Government agency, or with any official of a foreign country, must be done through the Mayor's Office. Some Departments have failed to follow this procedure, as directed by a Memorandum of January 7, 1946. Only routine Police matters are excepted.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1947,
          "min": -1.2932
