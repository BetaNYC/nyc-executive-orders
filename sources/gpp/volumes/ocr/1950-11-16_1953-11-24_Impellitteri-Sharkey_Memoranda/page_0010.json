        1400,
        910
      ],
      "category": "Text",
      "text": "To: Heads of all City Departments and Agencies",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2823,
          "min": -1.5018
        },
        "category": {
          "n_tokens": 1,
