        "chars": 46,
        "chars_per_1k_ink": 37.19
      }
    },
    {
      "bbox": [
        255,
        1026,
        1787,
        1478
      ],
      "category": "Text",
      "text": "It has come to my attention that certain City employees who come into daily contact with our citizens, and particularly small businessmen, have been soliciting gratuities on the eves of various holidays throughout the year. I want every Department head to issue instructions to all the employees under their jurisdiction that they are, under no circumstances, to solicit or encourage in any manner or form gratuities or honorariums from our taxpayers. The men and women of our City pay the bills of the municipal administration through their annual contributions to the City's revenues.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2698,
          "min": -1.5957
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 109,
          "mean": -0.0029,
          "min": -0.1864
        }
      },
      "ink": {
        "ink_px": 24523,
        "area_px": 692965,
        "density": 0.03539,
        "chars": 586,
        "chars_per_1k_ink": 23.9
      }
    },
    {
      "bbox": [
        255,
        1514,
        1697,
        1764
      ],
      "category": "Text",
      "text": "I fully realize that those who participate in this practice are few and feel they are not violating any rules or regulations, but merely succumbing to what evidently has been considered a custom. It isn't a pleasant custom, and it doesn't reflect credit on that great body of fine, decent, efficient municipal employees.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.217,
          "min": -1.4164
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 62,
          "mean": -0.0005,
          "min": -0.019
        }
      },
      "ink": {
        "ink_px": 12770,
        "area_px": 359683,
        "density": 0.0355,
        "chars": 320,
        "chars_per_1k_ink": 25.06
      }
    },
    {
      "bbox": [
        255,
        1801,
        1646,
        1926
      ],
      "category": "Text",
      "text": "I further hope that our citizens will cooperate with me in my desire to put a stop to such a petty public annoyance.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2318,
          "min": -1.2881
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 24,
          "mean": -0.0006,
          "min": -0.0078
        }
      },
      "ink": {
        "ink_px": 3690,
        "area_px": 175514,
        "density": 0.02102,
        "chars": 116,
        "chars_per_1k_ink": 31.44
      }
    },
    {
      "bbox": [
        255,
        1963,
        1721,
        2132
      ],
      "category": "Text",
      "text": "I would like to take this opportunity, on the eve of my departure for a brief vacation, to extend my very best wishes for a pleasant Thanksgiving to all our municipal employees, and to the people of the City of New York.",
