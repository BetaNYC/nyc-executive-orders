    },
    {
      "bbox": [
        321,
        2985,
        2035,
        3183
      ],
      "category": "Text",
      "text": "WHEREAS, the creation of the Model Cities Committee complies with the requirements of the Model Cities program for administrative coordination of governmental activities in the Model Cities areas, and",
      "logprob_stats": {
