          "mean": -0.0116,
          "min": -0.635
        }
      },
      "ink": {
        "ink_px": 3616,
        "area_px": 492205,
        "density": 0.00735,
        "chars": 318,
        "chars_per_1k_ink": 87.94
      }
    },
    {
      "bbox": [
        319,
        2756,
        2114,
        2953
      ],
      "category": "Text",
      "text": "WHEREAS, direction and supervision of the municipal participation in the Model Cities program is to be undertaken by the Model Cities Committee, as provided for in the application submitted to the federal government, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2658,
          "min": -1.6382
        },
        "category": {
