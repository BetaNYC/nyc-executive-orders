        "chars": 116,
        "chars_per_1k_ink": 94.16
      }
    },
    {
      "bbox": [
        319,
        2437,
        2031,
        2722
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York by action of the Board of Estimate on April 6, 1967 (Cal. No. 179) authorized the application to the federal government for assistance under the Model Cities program for three areas in the City of New York described as Central Brooklyn, Harlem-East Harlem, and South Bronx-Morrisania, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2744,
          "min": -1.4812
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
