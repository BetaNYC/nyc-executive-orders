        "chars": 372,
        "chars_per_1k_ink": 102.88
      }
    },
    {
      "bbox": [
        321,
        2302,
        2108,
        2400
      ],
      "category": "Text",
      "text": "WHEREAS, widespread and extensive citizen participation is essential to the success of the Model Cities program, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2896,
          "min": -1.5888
        },
        "category": {
