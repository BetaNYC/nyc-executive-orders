      }
    },
    {
      "bbox": [
        325,
        1894,
        1916,
        2255
      ],
      "category": "Text",
      "text": "WHEREAS, an organization as large as our city government should and must develop from within its own ranks this essential group of senior public servants through an effective and comprehensive program to estimate future executive needs, to identify potential and tried executive talent in the city service, and through counseling, training, and work assignment to increase the number of executives available for the leadership that our city needs.",
      "logprob_stats": {
        "bbox": {
