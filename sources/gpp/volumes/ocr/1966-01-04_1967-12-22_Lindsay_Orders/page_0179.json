        264,
        2613,
        2122,
        2769
      ],
      "category": "Text",
      "text": "Section 1. The jurisdiction, administration and operation of the Municipal Archives and Records Center is hereby transferred to the City Register.",
      "logprob_stats": {
        "bbox": {
