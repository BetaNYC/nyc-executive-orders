    {
      "bbox": [
        163,
        1047,
        1857,
        1150
      ],
      "category": "Text",
      "text": "This is to certify that the Trustees of The New York Public Library, at a meeting on June 14, 1967 adopted the following resolution:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3212,
          "min": -1.7055
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.079,
          "min": -0.079
        },
        "text": {
          "n_tokens": 33,
