    {
      "bbox": [
        361,
        2028,
        2080,
        2182
      ],
      "category": "Text",
      "text": "(b) Step 2. - If the grievance is not adjusted, the member may not later than ten days after the completion of Step One, seek the following review:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2602,
          "min": -1.5516
        },
        "category": {
