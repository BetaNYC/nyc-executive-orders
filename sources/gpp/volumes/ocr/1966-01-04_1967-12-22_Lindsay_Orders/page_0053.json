        1101
      ],
      "category": "Text",
      "text": "Continuation of increased-take-home-pay plan\nduring 1966-1967 State fiscal year, for offi-\ncers and employees of the Triborough Bridge\nand Tunnel Authority, The New York Public\nLibrary, The Brooklyn Public Library and The\nQueens Borough Public Library, who are mem-\nbers of the New York State Employees' Retire-\nment System.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3596,
          "min": -1.7674
        },
        "category": {
          "n_tokens": 1,
