        2263,
        1982,
        2471
      ],
      "category": "Text",
      "text": "WHEREAS, the Triborough Bridge and Tunnel Authority and such Libraries, by the resolutions hereto annexed, have elected to continue such increased-take-home-pay plan during the 1966-1967 fiscal year of the State; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2345,
          "min": -1.5285
        },
        "category": {
