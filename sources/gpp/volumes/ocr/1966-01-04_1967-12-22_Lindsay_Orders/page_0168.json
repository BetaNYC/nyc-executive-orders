    {
      "bbox": [
        336,
        1832,
        2043,
        2067
      ],
      "category": "Text",
      "text": "There shall be established in each department or agency a joint labor relations committee, to consist of representatives of the employees in the department or agency and representatives of the commissioner or head of the department or agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
