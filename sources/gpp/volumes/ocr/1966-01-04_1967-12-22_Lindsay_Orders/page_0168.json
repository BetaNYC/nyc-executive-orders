    },
    {
      "bbox": [
        336,
        2104,
        2093,
        2435
      ],
      "category": "Text",
      "text": "The joint labor relations committee shall assist, through regular and periodic conferences and consultations, in formulating policies and suggesting changes which may be necessary in existing policies, concerning the wages, hours and working conditions in the department or agency, as well as in measures to improve the efficiency of the operations of the department or agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2255,
