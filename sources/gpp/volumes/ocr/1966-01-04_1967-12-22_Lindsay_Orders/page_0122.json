    {
      "bbox": [
        491,
        1307,
        852,
        1357
      ],
      "category": "Text",
      "text": "BE IT RESOLVED,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.294,
          "min": -1.4587
        },
        "category": {
