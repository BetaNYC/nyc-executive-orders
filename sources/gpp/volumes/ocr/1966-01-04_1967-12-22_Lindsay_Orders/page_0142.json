    {
      "bbox": [
        0,
        1219,
        2043,
        1535
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the Triborough Bridge and Tunnel Authority, with the approval of the City, has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay-plan applicable to officers and employees of such Authority who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3503,
          "min": -1.7701
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 88,
          "mean": -0.0031,
          "min": -0.1579
        }
      },
      "ink": {
        "ink_px": 22381,
        "area_px": 553956,
        "density": 0.0404,
        "chars": 417,
        "chars_per_1k_ink": 18.63
      }
    },
    {
      "bbox": [
        0,
        1581,
        2001,
        1792
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of such Authority personnel without diminution or loss of pension rights with the result that the take-home-pay of such Authority personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2988,
          "min": -1.7097
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 41,
          "mean": -0.0121,
          "min": -0.3818
        }
      },
      "ink": {
        "ink_px": 11108,
        "area_px": 360400,
        "density": 0.03082,
        "chars": 231,
        "chars_per_1k_ink": 20.8
      }
    },
    {
      "bbox": [
        0,
        1835,
        2006,
        2111
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such an on Authority personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the Authority and the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2685,
          "min": -1.7161
        },
        "category": {
