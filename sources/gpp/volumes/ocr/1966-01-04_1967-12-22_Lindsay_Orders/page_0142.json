    },
    {
      "bbox": [
        0,
        2142,
        1982,
        2422
      ],
      "category": "Text",
      "text": "WHEREAS, the City, at the 1967 Session of the State Legislature, sponsored the enactment of Laws 1967 Ch. 379, which authorizes the Triborough Bridge and Tunnel Authority, with the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1967-1968 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2597,
          "min": -1.6614
        },
        "category": {
