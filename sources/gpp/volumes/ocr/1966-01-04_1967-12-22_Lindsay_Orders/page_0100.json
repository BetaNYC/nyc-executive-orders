        1700,
        1889
      ],
      "category": "Text",
      "text": "b. Actions by City Departments or Agencies based upon interpretations of collective bargaining agreements shall not be taken without prior consultation with The Director of Labor Relations.",
      "logprob_stats": {
        "bbox": {
