    {
      "bbox": [
        424,
        793,
        1667,
        1212
      ],
      "category": "Text",
      "text": "Continuation of increased take-home-pay plan\nduring 1967-1968 State fiscal year, for offi-\ncers and employees of the Triborough Bridge\nand Tunnel Authority, The New York Public\nLibrary, The Brooklyn Public Library and The\nQueens Borough Public Library, who are mem-\nbers of the New York State Employees' Retire-\nment System.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3661,
          "min": -1.68
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0106,
          "min": -0.0106
        },
        "text": {
