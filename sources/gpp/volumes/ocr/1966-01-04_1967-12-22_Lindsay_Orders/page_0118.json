        86,
        2446,
        2048,
        2680
      ],
      "category": "Text",
      "text": "WHEREAS, the Triborough Bridge and Tunnel Authority and such\nlibraries, by the resolutions hereto annexed, have elected to continue\nsuch increased-take-home-pay plan during the 1967-1968 fiscal year of the\nCity; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2548,
          "min": -1.6062
        },
        "category": {
