    },
    {
      "bbox": [
        86,
        1256,
        2030,
        1635
      ],
      "category": "Text",
      "text": "WHEREAS, since 1960, the Triborough Bridge and Tunnel Authority\nand since 1961, the above mentioned libraries, with the approval of the\nCity, have provided, for successive periods of one State fiscal year (ex-\ncept for a shorter period in the 1960-1961 year) pursuant to statutes en-\ntered by the State Legislature, an increased take-home-pay-plan applicable\nto officers and employees of such Authority and Libraries who are members\nof the New York State Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3728,
          "min": -1.9497
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 118,
          "mean": -0.0259,
          "min": -0.6765
        }
      },
      "ink": {
        "ink_px": 21454,
        "area_px": 655500,
        "density": 0.03273,
        "chars": 488,
        "chars_per_1k_ink": 22.75
      }
    },
    {
      "bbox": [
        86,
        1673,
        2062,
        1901
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension con-\nditions of such officers and employees without diminution or loss of\npension rights, with the result that the take-home-pay of such officers\nand employees is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3102,
          "min": -1.7515
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 50,
          "mean": -0.0565,
          "min": -1.3285
        }
      },
      "ink": {
        "ink_px": 7710,
        "area_px": 404110,
        "density": 0.01908,
        "chars": 237,
        "chars_per_1k_ink": 30.74
      }
    },
    {
      "bbox": [
        86,
        1931,
        2070,
        2213
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such\nplan on such personnel, their morale, efficiency and productiveness are\nimproved, with resulting substantial benefits to the functioning of the\nAuthority and such Libraries, and enhancement of the welfare of the people\nof the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.226,
          "min": -1.4264
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 59,
          "mean": -0.0426,
          "min": -1.1935
        }
      },
      "ink": {
        "ink_px": 9416,
        "area_px": 499495,
        "density": 0.01885,
        "chars": 297,
        "chars_per_1k_ink": 31.54
      }
    },
    {
      "bbox": [
        86,
        2238,
        2073,
        2421
      ],
      "category": "Text",
      "text": "WHEREAS, by Laws 1967, Ch. 159, the State Legislature has autho-\nized a continuation of such increased-take-home-pay plan during the 1967-\n1968 fiscal year of the State; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2883,
          "min": -1.7105
        },
        "category": {
          "n_tokens": 1,
