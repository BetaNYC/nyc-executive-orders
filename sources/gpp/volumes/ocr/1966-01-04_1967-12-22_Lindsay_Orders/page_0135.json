        "density": 0.05458,
        "chars": 326,
        "chars_per_1k_ink": 11.51
      }
    },
    {
      "bbox": [
        150,
        2008,
        1960,
        2302
      ],
      "category": "Text",
      "text": "WHEREAS, the City, at the 1967 Session of the State Legislature, sponsored the enactment of Laws 1967, Ch. 379, which authorizes the New York City Board of Education, with the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1967-1968 fiscal year; and",
      "logprob_stats": {
        "bbox": {
