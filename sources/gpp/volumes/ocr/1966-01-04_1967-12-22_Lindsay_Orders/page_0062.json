    },
    {
      "bbox": [
        191,
        1687,
        1917,
        1781
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2426,
          "min": -1.2515
        },
        "category": {
          "n_tokens": 1,
