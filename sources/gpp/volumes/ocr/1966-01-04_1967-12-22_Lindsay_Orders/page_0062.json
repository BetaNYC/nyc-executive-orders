        "density": 0.02976,
        "chars": 164,
        "chars_per_1k_ink": 24.25
      }
    },
    {
      "bbox": [
        186,
        1433,
        1982,
        1652
      ],
      "category": "Text",
      "text": "WHEREAS, pursuant to Laws 1966, Ch. 611, such increased-take-home-pay plan has been continued by Executive Orders Nos. 18 to 24, inclusive, issued June 17, 1966, through the 1966-1967 fiscal year of the City, and it is fair and equitable that such salary adjustment plan be likewise continued through such fiscal year;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1526,
          "min": -1.3134
        },
        "category": {
          "n_tokens": 1,
