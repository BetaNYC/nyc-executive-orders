        "chars": 169,
        "chars_per_1k_ink": 81.06
      }
    },
    {
      "bbox": [
        271,
        2597,
        2030,
        2793
      ],
      "category": "Text",
      "text": "WHEREAS, civil defense, under this reorganization, will continue to be eligible for reimbursement under the federal government's matching funds program, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2645,
