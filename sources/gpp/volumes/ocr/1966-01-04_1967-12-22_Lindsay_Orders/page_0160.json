    {
      "bbox": [
        252,
        1732,
        2165,
        1862
      ],
      "category": "Text",
      "text": "WHEREAS, the Interim Director of the Office of Civil Defense issued on March 18, 1966 a report entitled \"Reorganization of Civil Defense, March, 1966\" and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
