        "density": 0.00584,
        "chars": 116,
        "chars_per_1k_ink": 83.15
      }
    },
    {
      "bbox": [
        267,
        2416,
        2073,
        2607
      ],
      "category": "Text",
      "text": "WHEREAS, the appropriate civil defense agencies of the State and Federal governments have given approval to the administrative plan carrying out this reorganization, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2441,
          "min": -1.6315
        },
        "category": {
          "n_tokens": 1,
