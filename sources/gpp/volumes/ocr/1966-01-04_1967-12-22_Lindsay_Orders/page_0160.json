    {
      "bbox": [
        275,
        2777,
        2147,
        3020
      ],
      "category": "Text",
      "text": "WHEREAS, an Executive Order (No. 29) was issued on or about August 19, 1966 redesignating the office of Civil Defense as the Office of Civil Defense and Disaster Control, and directed the latter to serve as the staff of the Emergency Control Board-Office of Civil Defense, and",
      "logprob_stats": {
