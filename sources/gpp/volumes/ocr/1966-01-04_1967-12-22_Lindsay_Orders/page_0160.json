        "chars": 155,
        "chars_per_1k_ink": 86.59
      }
    },
    {
      "bbox": [
        257,
        1867,
        2150,
        2097
      ],
      "category": "Text",
      "text": "WHEREAS, in New York City alone over fifteen million dollars have been spent on surveying and designating fallout shelters and the Federal Government is prepared to give the City a total of thirty-one million dollars in shelter supplies, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3082,
          "min": -1.5963
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 45,
          "mean": -0.0012,
          "min": -0.0337
        }
      },
      "ink": {
        "ink_px": 2574,
        "area_px": 424580,
        "density": 0.00606,
        "chars": 241,
        "chars_per_1k_ink": 93.63
      }
    },
    {
      "bbox": [
        263,
        2097,
        2016,
        2280
      ],
      "category": "Text",
      "text": "WHEREAS, the Office of Civil Defense has to date failed to provide satisfactory solutions to the problems of shelter management, communications, emergency control, and volunteer enrollment, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2488,
          "min": -1.5907
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 33,
          "mean": -0.0,
          "min": -0.0002
        }
      },
      "ink": {
        "ink_px": 1852,
        "area_px": 315008,
        "density": 0.00588,
        "chars": 193,
        "chars_per_1k_ink": 104.21
      }
    },
    {
      "bbox": [
        267,
        2278,
        2023,
        2416
      ],
      "category": "Text",
      "text": "WHEREAS, substantial economies can be achieved by regrouping the prior functions of the Office of Civil Defense, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2957,
          "min": -1.5483
        },
        "category": {
          "n_tokens": 1,
