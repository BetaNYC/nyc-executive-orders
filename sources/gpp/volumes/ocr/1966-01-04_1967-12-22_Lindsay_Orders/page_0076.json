    {
      "bbox": [
        425,
        1116,
        1625,
        1178
      ],
      "category": "Text",
      "text": "Whereas, It is necessary and desirable to supplement and in certain respects amend Executive Order No. 4 so as to insure such coordination more effectively:",
      "logprob_stats": {
