        2071,
        1154
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the state Legislature at the request of the City, an increased-take-home-pay plan applicable to officers and employees of City agencies who are members of City-supported retirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.4422,
          "min": -2.1136
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 71,
          "mean": -0.0065,
          "min": -0.1473
        }
      },
      "ink": {
        "ink_px": 32920,
        "area_px": 409260,
        "density": 0.08044,
        "chars": 337,
        "chars_per_1k_ink": 10.24
      }
    },
    {
      "bbox": [
        84,
        1191,
        2043,
        1363
      ],
      "category": "Text",
      "text": "WHEREAS, under such plan the City makes possible a decrease in pension contributions of City personnel without diminution or loss of pension rights, with the result that the take-home-pay of City personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2998,
          "min": -1.608
        },
        "category": {
