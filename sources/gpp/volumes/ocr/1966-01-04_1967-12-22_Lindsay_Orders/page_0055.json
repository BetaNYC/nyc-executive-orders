        "chars_per_1k_ink": 10.39
      }
    },
    {
      "bbox": [
        84,
        1409,
        2025,
        1587
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan for City personnel, their morale, efficiency and productiveness are improved, and so forth resulting substantial benefits to the functioning of the City government and the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
