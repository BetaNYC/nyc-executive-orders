        2251,
        1992,
        2470
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Housing Authority, by resolution adopted on June 17, 1967, has elected, subject to the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1967-1968 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2263,
          "min": -1.6469
        },
        "category": {
