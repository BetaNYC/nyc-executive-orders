        "density": 0.09569,
        "chars": 304,
        "chars_per_1k_ink": 7.66
      }
    },
    {
      "bbox": [
        101,
        1977,
        2087,
        2240
      ],
      "category": "Text",
      "text": "WHEREAS, the City, at the 1967 session of the State Legislature, sponsored the enactment of Laws 1967, Ch. 379, which authorizes the New York City Housing Authority, with the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1967-1968 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2648,
          "min": -1.442
        },
        "category": {
          "n_tokens": 1,
