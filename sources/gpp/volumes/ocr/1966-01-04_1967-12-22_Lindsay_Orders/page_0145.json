    {
      "bbox": [
        177,
        950,
        2077,
        1287
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Board of Estimate, on\nJune 21, 1962 (Cal. NO. 525) adopted a salary adjustment plan for the\nCity's 1962-1963 fiscal year, providing certain salary adjustments\nfor specified categories of City employees and other public or quasi-\npublic employees, who could not benefit from the increased-take-home-\npay plan put into effect by the City for members of City-supported\nretirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3024,
          "min": -1.3794
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 108,
          "mean": -0.0116,
          "min": -0.6937
        }
      },
      "ink": {
        "ink_px": 31877,
        "area_px": 597501,
        "density": 0.05335,
        "chars": 416,
        "chars_per_1k_ink": 13.05
      }
    },
    {
      "bbox": [
        187,
        1314,
        2101,
        1472
      ],
      "category": "Text",
      "text": "WHEREAS, such salary adjustment plan has been since\ncontinued by the City for each fiscal year as to which such increased-\ntake-home-pay plan has been continued; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2638,
          "min": -1.505
        },
        "category": {
          "n_tokens": 1,
