          "min": -0.0
        },
        "text": {
          "n_tokens": 35,
          "mean": -0.0003,
          "min": -0.0043
        }
      },
      "ink": {
        "ink_px": 11912,
        "area_px": 285723,
        "density": 0.04169,
        "chars": 165,
        "chars_per_1k_ink": 13.85
      }
    },
    {
      "bbox": [
        187,
        1492,
        2133,
        1753
      ],
      "category": "Text",
      "text": "WHEREAS, pursuant to Laws 1967, Ch. 379, such increased-take-home-pay plan has been continued by Executive Orders Nos. 42 to 47, inclusive, issued June 16, 1967, through the 1967-1968 fiscal year of the City, and it is fair and equitable that such salary adjustment plan be likewise continued through such fiscal year;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2477,
          "min": -1.5283
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
