        "chars": 318,
        "chars_per_1k_ink": 13.18
      }
    },
    {
      "bbox": [
        196,
        1767,
        2032,
        1889
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the\nCity of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2581,
          "min": -1.4745
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 28,
