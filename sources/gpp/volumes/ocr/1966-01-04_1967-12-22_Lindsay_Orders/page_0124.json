    {
      "bbox": [
        195,
        1146,
        1910,
        1567
      ],
      "category": "Text",
      "text": "BE IT ORTED, That pursuant to the provisions of Section 70-a of the Retirement and Social Security Law, as amended by L. 1967, c. 159, the Board of Trustees of the Queens Borough Public Library does hereby elect as a particular voting employer with respect to the New York State Employees' Retirement System to make contributions to the pension accumulation fund pursuant to such Section 70-a, as so amended, for the purpose of providing death benefits and pensions providing for increased take-home pay, on the basis of a reduction, pursuant to such section, of the contributions of each member, by five per centum of his compensation; and be it further",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2864,
          "min": -1.4641
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 140,
          "mean": -0.0559,
          "min": -1.9843
        }
      },
      "ink": {
        "ink_px": 68335,
        "area_px": 677223,
        "density": 0.1009,
        "chars": 654,
        "chars_per_1k_ink": 9.57
      }
    },
    {
      "bbox": [
        200,
        1612,
        1913,
        2031
      ],
      "category": "Text",
      "text": "RESOLVED, That such reductions, pursuant to such Section 70-a, as so amended, in the contributions of members of such Retirement System in the employ of the Queens Borough Public Library, shall be made beginning with the payroll period commencing on April 1, 1967; it being the intent of this resolution that the reductions in the contributions of such members hereby prior to death, pursuant to L. 1967, c 159, shall succeed without interruption, or reductions provided for such members, pursuant to L. 1966, ch. 114, by the resolution of this Board of Trustees approved by Executive Order #20 issued by the Mayor on June 17, 1966.",
