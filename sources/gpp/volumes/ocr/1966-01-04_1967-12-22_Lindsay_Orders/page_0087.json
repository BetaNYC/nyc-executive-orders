    {
      "bbox": [
        562,
        1856,
        2142,
        2286
      ],
      "category": "Text",
      "text": "Section 1. Housing and Development Administration.\nThere is established in the executive office of the Mayor a Housing and Development Administration. The Administration shall be headed by an Administrator who shall be appointed by and serve at the pleasure of the Mayor. The Mayor may appoint three Deputy Administrators as may be necessary for the performance of the duties of the Administration. The agencies specified in Section 3 hereof, subject to the jurisdiction of the Mayor, are directed to make available to the Administrator such assistance as he may request.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2649,
          "min": -1.6992
        },
        "category": {
