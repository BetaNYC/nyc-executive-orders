    },
    {
      "bbox": [
        61,
        1508,
        1859,
        1700
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such a plan of such personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the City government and the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2531,
          "min": -1.2917
