        1929,
        1263
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay plan applicable to City-paid officers and employees who are members of City-Supported retirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3762,
          "min": -2.0776
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 71,
          "mean": -0.0151,
          "min": -0.5637
        }
      },
      "ink": {
        "ink_px": 25076,
        "area_px": 368704,
        "density": 0.06801,
        "chars": 330,
        "chars_per_1k_ink": 13.16
      }
    },
    {
      "bbox": [
        61,
        1296,
        1879,
        1475
      ],
      "category": "Text",
      "text": "WHEREAS, under such plan the City makes possible a decrease in extension contributions of such personnel without diminution or loss of extension rights, with the result that the take-home-pay of such personnel increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2822,
          "min": -1.5524
