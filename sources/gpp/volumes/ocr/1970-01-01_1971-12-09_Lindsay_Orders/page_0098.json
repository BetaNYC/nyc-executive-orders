    {
      "bbox": [
        129,
        529,
        955,
        637
      ],
      "category": "Text",
      "text": "WHEREAS, it has been determined by independent studies that the time required to pay City vendors and contractors is excessive; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2337,
          "min": -1.1176
        },
