      ],
      "category": "List-item",
      "text": "1. Establishment of Agency. There is established in the Health Services Administration \"The Comprehensive Health Planning Agency for The City of New York\" (hereinafter called the \"Agency\"). The Board of Directors of the Agency (hereinafter called the \"Board\") shall consist of not less than 71 nor more than 88 members to be appointed in accordance with section 3 below.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2881,
          "min": -1.3148
        },
