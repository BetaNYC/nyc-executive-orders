          "min": -0.0067
        },
        "text": {
          "n_tokens": 48,
          "mean": -0.0308,
          "min": -0.9439
        }
      },
      "ink": {
        "ink_px": 574,
        "area_px": 120910,
        "density": 0.00475,
        "chars": 222,
        "chars_per_1k_ink": 386.76
      }
    },
    {
      "bbox": [
        162,
        631,
        1291,
        797
      ],
      "category": "List-item",
      "text": "(i) Establish standards and guidelines for consumer, provider and government participation in all types of health planning at both the City-wide and community levels, including periodic review of compliance with such standards by public, voluntary and proprietary health and health-related agencies within the City, and review of existing health planning programs.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2702,
          "min": -1.2661
        },
        "category": {
          "n_tokens": 2,
