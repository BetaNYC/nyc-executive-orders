        "chars_per_1k_ink": 351.71
      }
    },
    {
      "bbox": [
        165,
        497,
        1249,
        608
      ],
      "category": "List-item",
      "text": "2. <u>Purposes</u>. The general purpose of the Agency shall be to engage in comprehensive health planning for The City of New York. Without limiting the generality of the foregoing, the Agency is empowered and directed to:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.278,
          "min": -1.2791
        },
        "category": {
          "n_tokens": 2,
