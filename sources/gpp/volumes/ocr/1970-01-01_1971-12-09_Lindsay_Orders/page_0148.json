    {
      "bbox": [
        122,
        483,
        1294,
        673
      ],
      "category": "Text",
      "text": "The Expense Budget for the 1969-1970 fiscal period was financed\nby estimated state and federal aid totalling $2.6 billion. Delay in\nreceipt of state and federal reimbursement requires major temporary\nborrowing by the Comptroller with the result that the City must bear a\ngreater interest cost to finance current operations. In addition,\nfailure to realize these estimated revenues within the fiscal period\nplaces severe financial strains on the budget.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2573,
          "min": -1.276
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 96,
          "mean": -0.0062,
          "min": -0.3869
        }
      },
      "ink": {
        "ink_px": 24035,
        "area_px": 207999,
        "density": 0.11555,
        "chars": 452,
        "chars_per_1k_ink": 18.81
      }
    },
    {
      "bbox": [
        126,
        697,
        1278,
        964
      ],
      "category": "Text",
      "text": "You are therefore directed to exert all your efforts to obtain\nthese receivables still outstanding for the fiscal period 1969-1970 as\nquickly as possible covering all activities eligible for such aid. To\nprovide better budgetary and fiscal controls in the current and future\nfiscal years, you are to submit monthly to the Director of the Budget a\nstatement on the condition of these receivables, in duplicate. This\nform must be submitted by the 15th day after the end of the month. In\naddition, separate statements on the condition of receivables must be\nfiled in duplicate for expenditures reimbursable from federal or state\nfunds chargeable to authorizations provided for in the Capital Budget.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2502,
          "min": -1.2053
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
