        "chars_per_1k_ink": 32.6
      }
    },
    {
      "bbox": [
        176,
        1244,
        1353,
        1345
      ],
      "category": "Text",
      "text": "WHEREAS, I have determined that it is in the best interests of the City, the Authority and the members, officers and employees of the Authority that such plan shall be so continued;",
      "logprob_stats": {
        "bbox": {
