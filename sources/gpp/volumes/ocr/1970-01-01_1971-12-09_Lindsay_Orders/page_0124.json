    {
      "bbox": [
        161,
        575,
        1369,
        791
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the New York City Housing Authority with the approval of the City, has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased take-home-pay plan applicable to members, officers and employees of the New York City Housing Authority who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2928,
          "min": -1.3153
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0011,
          "min": -0.0011
        },
        "text": {
          "n_tokens": 91,
          "mean": -0.0002,
          "min": -0.0142
        }
      },
      "ink": {
        "ink_px": 9400,
        "area_px": 250918,
        "density": 0.03746,
        "chars": 439,
        "chars_per_1k_ink": 46.7
      }
    },
    {
      "bbox": [
        167,
        801,
        1353,
        931
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of Authority personnel without diminution or loss of pension rights, with the result that the take-home-pay of Authority personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2643,
          "min": -1.3887
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0041,
          "min": -0.1606
        }
      },
      "ink": {
        "ink_px": 4584,
        "area_px": 150781,
        "density": 0.0304,
        "chars": 222,
        "chars_per_1k_ink": 48.43
      }
    },
    {
      "bbox": [
        170,
        939,
        1335,
        1096
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on Authority personnel, their morale, efficiency and productivity are improved, with resulting substantial benefits to the functioning of the Authority and the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2755,
          "min": -1.4129
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 53,
          "mean": -0.0005,
          "min": -0.0114
        }
      },
      "ink": {
        "ink_px": 8258,
        "area_px": 183009,
        "density": 0.04512,
        "chars": 304,
        "chars_per_1k_ink": 36.81
      }
    },
    {
      "bbox": [
        173,
        1105,
        1353,
        1236
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Housing Authority, by resolution adopted on May 27, 1970 has elected, subject to the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1970-1971 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2267,
          "min": -1.2369
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 62,
          "mean": -0.0002,
