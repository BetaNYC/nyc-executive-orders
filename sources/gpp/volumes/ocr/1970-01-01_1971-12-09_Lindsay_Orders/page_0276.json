    },
    {
      "bbox": [
        169,
        842,
        1267,
        947
      ],
      "category": "Text",
      "text": "WHEREAS, the Task Force found that there were overlapping functions, duplication of effort and lack of communication among the various City agencies which license and administer child care programs; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2265,
          "min": -1.0381
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
