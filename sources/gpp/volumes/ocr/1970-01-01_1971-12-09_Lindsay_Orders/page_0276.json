    {
      "bbox": [
        169,
        1078,
        1265,
        1157
      ],
      "category": "Text",
      "text": "WHEREAS, the most appropriate unit of City government to coordinate and administer such programs would be the Human Resources Administration;",
      "logprob_stats": {
        "bbox": {
