        "chars": 203,
        "chars_per_1k_ink": 50750.0
      }
    },
    {
      "bbox": [
        169,
        973,
        1234,
        1054
      ],
      "category": "Text",
      "text": "WHEREAS, the Task Force has recommended that as many as possible of the early childhood programs be absorbed into one City agency; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1941,
          "min": -1.3129
        },
        "category": {
          "n_tokens": 1,
