    {
      "bbox": [
        117,
        657,
        974,
        767
      ],
      "category": "Text",
      "text": "WHEREAS, Chapter 696 of the Laws of 1887 exempted\nhospitals, orphan asylums and other charitable institutions in the\nCity of New York from paying for the use and supply of water, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
