    },
    {
      "bbox": [
        119,
        871,
        1001,
        981
      ],
      "category": "Text",
      "text": "WHEREAS, payments by the United States, the State and City\nof New York have become a significant part of the reimbursements,\nhospitals and similar institutions receive for their services, and",
      "logprob_stats": {
