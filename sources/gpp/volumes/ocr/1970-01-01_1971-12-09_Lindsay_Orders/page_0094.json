    },
    {
      "bbox": [
        119,
        997,
        1049,
        1148
      ],
      "category": "Text",
      "text": "WHEREAS, because of the exemption granted for water\nconsumption, hospitals and similar institutions do not include in the\ncomputation of their daily rate for services rendered, the cost of water\nsupplied by the City of New York, and",
      "logprob_stats": {
