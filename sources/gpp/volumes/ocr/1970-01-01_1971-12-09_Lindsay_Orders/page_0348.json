        "chars": 430,
        "chars_per_1k_ink": 45.42
      }
    },
    {
      "bbox": [
        91,
        1099,
        1346,
        1194
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decreased in the pension contributions of Authority personnel without diminution or loss of pension rights, with the result that the take-home-pay of Authority personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
