        "chars": 121,
        "chars_per_1k_ink": 24200.0
      }
    },
    {
      "bbox": [
        224,
        636,
        1231,
        750
      ],
      "category": "Text",
      "text": "Whereas, it is desirable and necessary that certain preventive measures be adopted, so as to preclude or minimize the impact of an air pollution episode on the health and welfare of the people of The City of New York.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2891,
          "min": -1.3022
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 44,
          "mean": -0.0001,
          "min": -0.0016
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 115460,
        "density": 0.0,
        "chars": 217,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        224,
        771,
        1145,
        834
      ],
      "category": "Text",
      "text": "Now, therefore, by the power vested in me as Mayor of The City of New York, it is hereby ordered as follows;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2477,
          "min": -1.4461
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 26,
          "mean": -0.0102,
          "min": -0.252
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 58752,
        "density": 0.0,
        "chars": 108,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        222,
        851,
        1174,
        1097
      ],
      "category": "Text",
      "text": "Section (1) There is hereby established an Air Pollution Warning System which shall operate in three stages: Alert Stage 1, Alert Stage 2 and Emergency. The criteria for determining the stages shall be those prescribed in the Air Pollution Warning Manual (hereafter \"Manual\") to be issued by the Administrator, Environmental Protection Administration, (hereafter \"the Administrator\") on the effective date of this order and such provisions are hereby incorporated in this executive order.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2786,
          "min": -1.385
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.387,
          "min": -0.387
        },
        "text": {
          "n_tokens": 90,
          "mean": -0.0007,
          "min": -0.0494
        }
      },
      "ink": {
        "ink_px": 7,
        "area_px": 232505,
        "density": 3e-05,
        "chars": 488,
        "chars_per_1k_ink": 69714.29
      }
    },
    {
      "bbox": [
        221,
        1121,
        1170,
        1363
      ],
      "category": "List-item",
      "text": "2. (2) Whenever the Department of Air Resources of the Environmental Protection Administration, (hereafter \"the Department\") by appropriate physical measurement and after consultation with the National Weather Service and the Interstate Sanitation Commission shall determine that the criteria for any of the stages set forth in Section 1 shall have been reached, the Administrator shall so advise the Mayor and the Emergency Control Board.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2793,
          "min": -1.2596
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.2371,
          "min": -0.4741
        },
        "text": {
          "n_tokens": 76,
