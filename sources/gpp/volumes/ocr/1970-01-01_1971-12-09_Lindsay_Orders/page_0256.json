    },
    {
      "bbox": [
        138,
        455,
        1370,
        966
      ],
      "category": "Text",
      "text": "\u00a72. The deposit of any account having a balance in a bank of at least $100,000, or any account in which the balance may reasonably be expected to be that amount shall be a matter for negotiation between the Finance Administration and the bank with respect to the rates to be charged for the services rendered and the compensating balance to be maintained, and the Finance Administration shall have the authority to invest the amount of such account that exceeds the compensating balance. For the purpose of this section, any combination of accounts in one or more banks, used for similar purposes, aggregating $100,000 shall be deemed to be an account of that amount.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3277,
          "min": -1.504
        },
        "category": {
