    {
      "bbox": [
        105,
        931,
        1378,
        1105
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the New York City Housing Authority with the approval of the City, has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased take-home-pay plan applicable to members, officers and employees of the New York City Housing Authority who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3282,
          "min": -1.7429
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0167,
          "min": -0.0167
        },
        "text": {
          "n_tokens": 91,
          "mean": -0.0003,
          "min": -0.0152
        }
      },
      "ink": {
        "ink_px": 3314,
        "area_px": 192270,
        "density": 0.01724,
        "chars": 439,
        "chars_per_1k_ink": 132.47
      }
    },
    {
      "bbox": [
        105,
        1118,
        1343,
        1218
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of Authority personnel without a diminution or loss of pension rights, with the result that the take-home pay of Authority personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2479,
          "min": -1.4611
        },
        "category": {
