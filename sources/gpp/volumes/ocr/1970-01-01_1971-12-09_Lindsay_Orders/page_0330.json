        "density": 0.01433,
        "chars": 223,
        "chars_per_1k_ink": 130.49
      }
    },
    {
      "bbox": [
        113,
        1043,
        1287,
        1163
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such\nplan on such personnel, their morale, efficiency and productiveness are\nimproved, with resulting substantial benefits to the functioning of the\nCity government and the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2212,
          "min": -1.385
        },
        "category": {
