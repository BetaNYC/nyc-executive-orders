        1325,
        887
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has\nprovided, for successive periods of one fiscal year pursuant to statutes\nenacted by the State Legislature at the request of the City, an increased-\ntake-home-pay plan applicable to City-paid officers and employees who are\nmembers of City-supported retirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3244,
          "min": -1.5517
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0046,
          "min": -0.0046
        },
        "text": {
          "n_tokens": 75,
          "mean": -0.006,
          "min": -0.4347
        }
      },
      "ink": {
        "ink_px": 2361,
