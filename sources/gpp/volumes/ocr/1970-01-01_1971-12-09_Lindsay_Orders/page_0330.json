        "density": 0.01485,
        "chars": 331,
        "chars_per_1k_ink": 140.19
      }
    },
    {
      "bbox": [
        113,
        908,
        1291,
        1016
      ],
      "category": "Text",
      "text": "WHEREAS, under such plan the City makes possible a decrease\nin pension contributions of such personnel without diminution or loss of\npension rights, with the result that the take-home-pay of such personnel\nis increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2739,
          "min": -1.6627
        },
        "category": {
