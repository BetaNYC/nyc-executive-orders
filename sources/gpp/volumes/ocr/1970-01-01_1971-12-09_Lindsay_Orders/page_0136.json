    {
      "bbox": [
        302,
        901,
        1206,
        1091
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay plan applicable to City-paid officers and employees who are members of City-supported retirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2737,
          "min": -1.3761
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0012,
          "min": -0.0012
        },
        "text": {
          "n_tokens": 70,
          "mean": -0.0094,
          "min": -0.5231
        }
      },
      "ink": {
        "ink_px": 5271,
        "area_px": 175104,
        "density": 0.0301,
        "chars": 330,
        "chars_per_1k_ink": 62.61
      }
    },
    {
      "bbox": [
        302,
        1119,
        1206,
        1256
      ],
      "category": "Text",
      "text": "WHEREAS, under such plan the City makes possible a decrease in pension contributions of such personnel without diminution or loss of pension rights, with the result that the take-home-pay of such personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.229,
          "min": -1.2495
        },
        "category": {
          "n_tokens": 1,
