    {
      "bbox": [
        156,
        386,
        1618,
        667
      ],
      "category": "Text",
      "text": "The Commissioner of Labor shall decide in each instance which employee grouping or unit, i.e., one or more departments, or any subdivisions or classifications thereof, will assure to employees the fullest freedom in exercising the rights herein granted consistent with the efficient operation of the public service and to designate such grouping or unit as appropriate for the purpose of collective bargaining.",
      "logprob_stats": {
        "bbox": {
