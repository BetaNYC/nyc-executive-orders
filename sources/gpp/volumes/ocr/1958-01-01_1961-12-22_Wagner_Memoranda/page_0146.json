    {
      "bbox": [
        141,
        1574,
        1728,
        1758
      ],
      "category": "Text",
      "text": "The \"10 day\" and \"30 day\" designations indicate the maximum number of days in which the Governor is allowed to take executive action on bills presented to him. Reports on such bills are due in two and ten days, respectively, as directed above.",
      "logprob_stats": {
        "bbox": {
