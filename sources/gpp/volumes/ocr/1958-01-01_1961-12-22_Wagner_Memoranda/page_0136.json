    },
    {
      "bbox": [
        261,
        2184,
        1533,
        2312
      ],
      "category": "Text",
      "text": "Eight copies of each proposed bill, together with eight copies of the supporting memorandum, are to be submitted to Bernard J. Ruggieri, Assistant to the Mayor, as soon as possible.",
