    },
    {
      "bbox": [
        122,
        1196,
        1613,
        1517
      ],
      "category": "Text",
      "text": "The machinery for obtaining such certificate and the circumstances governing its issuance are described and set forth in these rules and regulations, which are hereby promulgated pursuant to the authority vested in the Commissioner of Labor by sections 4 and 6 of said Executive Order. Where applicable and appropriate and when not inconsistent with these rules and regulations and with said Executive Order, the procedures and rules of decision of the State Labor Relations Board will guide the application and administration of these rules and regulations.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2415,
          "min": -1.4929
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 94,
