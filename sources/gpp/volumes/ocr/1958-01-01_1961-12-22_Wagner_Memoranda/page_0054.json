    {
      "bbox": [
        173,
        1165,
        1745,
        1375
      ],
      "category": "Text",
      "text": "The increasing use of radioactive materials for peace-\ntime purposes - medical, industrial and research - has created many\nnew problems of protecting the health and safety of New York City's\nresidents and its workers. These problems are quite apart from\nthe hazards of atomic attack.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2701,
          "min": -1.5689
