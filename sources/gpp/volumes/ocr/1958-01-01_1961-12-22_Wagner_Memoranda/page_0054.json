    },
    {
      "bbox": [
        166,
        1403,
        1735,
        1794
      ],
      "category": "Text",
      "text": "Last April, I announced the creation of a Technical Advisory Committee on Radiation with Dr. John C. Bugher, Director of Medical Education and Public Health of the Rockefeller Foundation, as chairman to advise me and the various city agencies on policies relating to handling and controlling radiation materials within The City of New York. In addition I announced the appointment of a Radiation Consultant for the City's Health Department to formulate a departmental program of radiation control and to provide advice and assistance to other city agencies concerned with radiation.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2736,
          "min": -1.4281
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
