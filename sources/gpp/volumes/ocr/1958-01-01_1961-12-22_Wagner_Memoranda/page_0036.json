      "category": "Text",
      "text": "TO: HEADS OF ALL CITY DEPARTMENTS AND AGENCIES\nFROM: HON. ROBERT F. WAGNER, MAYOR, CITY OF NEW YORK\nSUBJECT: SENIOR CITIZENS MONTH, MAY, 1958",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 17,
          "mean": -0.445,
          "min": -1.9742
        },
        "category": {
          "n_tokens": 1,
