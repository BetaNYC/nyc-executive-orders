        "chars_per_1k_ink": 115.13
      }
    },
    {
      "bbox": [
        161,
        2624,
        1805,
        2807
      ],
      "category": "Text",
      "text": "8. The Police Commissioner is instructed to make arrangements for the voluntary surrender, or recapture of insignia in the possession of individuals to whom city cars are not assigned, effective July 15, 1959.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
