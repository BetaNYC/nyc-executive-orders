      ],
      "category": "Table",
      "text": "<table><tr><td>MUNICIPAL REFERENCE LIBRARY</td></tr><tr><td>RECEIVED</td></tr><tr><td>JUN 23 1960</td></tr><tr><td>MUNICIPAL BUILDING</td></tr><tr><td>NEW YORK CITY</td></tr></table>",
      "logprob_stats": {
