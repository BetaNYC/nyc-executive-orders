        "density": 0.0123,
        "chars": 174,
        "chars_per_1k_ink": 52.41
      }
    },
    {
      "bbox": [
        240,
        2203,
        1751,
        2407
      ],
      "category": "Text",
      "text": "The Mayor's Information Center will be located at Room 8A, City Hall.\nI have designated Robert A. Low, Assistant to the Mayor, to serve as Director of the Mayor's Information Center and its subsidiary Mobile Unit.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.308,
          "min": -1.5108
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0273,
          "min": -0.576
        }
      },
      "ink": {
        "ink_px": 3017,
        "area_px": 310030,
        "density": 0.00973,
        "chars": 213,
        "chars_per_1k_ink": 70.6
      }
    },
    {
      "bbox": [
        240,
        2436,
        1733,
        2637
      ],
      "category": "Text",
      "text": "The Director will make periodic reports to the Mayor and will provide him with such information as may be necessary to keep him informed of the Center's activities.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1878,
          "min": -1.3534
        },
        "category": {
