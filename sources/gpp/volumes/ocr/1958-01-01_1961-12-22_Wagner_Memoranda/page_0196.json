    },
    {
      "bbox": [
        291,
        1485,
        1581,
        1835
      ],
      "category": "Text",
      "text": "It is difficult for the Post Office to direct the mail properly when a street address is not indicated or the number is omitted. In Queens, especially, there is difficulty when only a county or borough name is used in place of the correct post office name.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
