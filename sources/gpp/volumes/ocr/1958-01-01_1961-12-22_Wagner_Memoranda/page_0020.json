    },
    {
      "bbox": [
        136,
        1797,
        635,
        1832
      ],
      "category": "Section-header",
      "text": "## 2. DECLARATION OF POLICY",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.203,
          "min": -1.4262
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.0,
          "min": -0.0001
