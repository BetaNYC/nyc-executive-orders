    {
      "bbox": [
        136,
        1327,
        1728,
        1757
      ],
      "category": "Text",
      "text": "Inquiry into the mutual needs of the City and its employees and experience developed in the establishment and maintenance of labor relations in the municipal service since issuance on July 21, 1954, of the Interim Order on the Conduct of Relations Between the City of New York and Its Employees, and of the amendment thereto of March 14, 1955, have indicated the necessity for desiring a new program of collective dealing between the City and its employees, Accordingly, this order is hereby issued. It shall, in place and in stead of said Interim Order, constitute the present labor-relations policy and plan for the City of New York and its employees. Said Interim Order, to the extent not incorporated in this order, is hereby revoked and superseded. This order shall be referred to as the \"Executive Order on City Employee Relations\".",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2354,
          "min": -1.4512
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
