    {
      "bbox": [
        205,
        1223,
        1702,
        1278
      ],
      "category": "Text",
      "text": "SUBJECT: Increased Participation in Work Staggering",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2151,
          "min": -1.4717
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 10,
