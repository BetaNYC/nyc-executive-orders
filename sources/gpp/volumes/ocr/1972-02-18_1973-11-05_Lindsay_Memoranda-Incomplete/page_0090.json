    {
      "bbox": [
        141,
        476,
        1802,
        814
      ],
      "category": "Text",
      "text": "4-Students do receive reimbursement for transportation, but this is administered entirely by the H.S.V.P. staff. The volunteer fills a bi-weekly time sheet indicating the periods during which he or she worked. The volunteer's supervisor initial the time sheet, and the volunteer submits it to the H.S.V.P. for payment. He or she receives a check directly from the H.S.V.P. for the amount requested. H.S.V.P. ends for transportation reimbursement come from private grants to the H.S.V.P.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.358,
          "min": -1.9042
        },
        "category": {
          "n_tokens": 1,
