        "chars_per_1k_ink": 94.9
      }
    },
    {
      "bbox": [
        141,
        851,
        1847,
        995
      ],
      "category": "Text",
      "text": "5-Agency supervisors generally deal with groups of students rather than individuals. Volunteers are not assigned to shadow individuals but handle special projects or serve as additional staff members.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2919,
