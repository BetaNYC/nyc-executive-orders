    {
      "bbox": [
        174,
        1222,
        1861,
        1407
      ],
      "category": "Text",
      "text": "The following is a description of the points covered during the conferences held during the 1st week of December to introduce the High School Volunteer Program to the city and cultural agencies of New York.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2999,
          "min": -1.5658
        },
        "category": {
