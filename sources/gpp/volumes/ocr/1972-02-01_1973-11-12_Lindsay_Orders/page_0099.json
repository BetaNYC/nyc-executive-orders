    {
      "bbox": [
        336,
        983,
        1672,
        1100
      ],
      "category": "Text",
      "text": "AMENDING EXECUTIVE ORDER NO. 52 DATED SEPTEMBER 29, 1967\nIN RELATION TO THE CONDUCT OF LABOR RELATIONS BETWEEN THE\nCITY OF NEW YORK AND ITS EMPLOYEES",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.275,
          "min": -1.4819
        },
