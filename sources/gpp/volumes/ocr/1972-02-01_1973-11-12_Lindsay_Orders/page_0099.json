        "density": 0.0173,
        "chars": 162,
        "chars_per_1k_ink": 26.93
      }
    },
    {
      "bbox": [
        126,
        2121,
        1852,
        2257
      ],
      "category": "Text",
      "text": "Whereas, in order to effectuate such changes it is necessary to amend\nExecutive Order No. 52;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2096,
          "min": -1.3181
        },
        "category": {
          "n_tokens": 1,
