    {
      "bbox": [
        172,
        1127,
        1975,
        1354
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-61, the New York City Board of Education, with the approval of the City, has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay-plan applicable to members of the Board of Education Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3056,
          "min": -1.7348
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 76,
          "mean": -0.0009,
          "min": -0.0299
        }
      },
      "ink": {
        "ink_px": 17161,
        "area_px": 384180,
        "density": 0.04467,
        "chars": 354,
        "chars_per_1k_ink": 20.63
      }
    },
    {
      "bbox": [
        172,
        1400,
        1953,
        1535
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of such members without diminution or loss of pension rights, with the result that the take-home-pay of such members is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2264,
          "min": -1.6344
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0023,
          "min": -0.0861
        }
      },
      "ink": {
        "ink_px": 10973,
        "area_px": 229160,
        "density": 0.04788,
        "chars": 208,
        "chars_per_1k_ink": 18.96
      }
    },
    {
      "bbox": [
        172,
        1581,
        1980,
        1811
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on such members, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the administration of the affairs of the Board of Education and the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2151,
          "min": -1.1765
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 59,
