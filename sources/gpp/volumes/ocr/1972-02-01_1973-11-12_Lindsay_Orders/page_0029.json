    {
      "bbox": [
        172,
        2127,
        1953,
        2318
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Board of Education, by resolution adopted on June 9, 1972 has elected, subject to the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1972-1973 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1896,
          "min": -1.3189
        },
        "category": {
