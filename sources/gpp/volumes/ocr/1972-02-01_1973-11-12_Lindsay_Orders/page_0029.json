        }
      },
      "ink": {
        "ink_px": 16519,
        "area_px": 390920,
        "density": 0.04226,
        "chars": 326,
        "chars_per_1k_ink": 19.73
      }
    },
    {
      "bbox": [
        172,
        1857,
        1953,
        2085
      ],
      "category": "Text",
      "text": "WHEREAS, the City, at the 1972 Session of the State Legislature, sponsored the enactment of Laws of 1972, Ch. 921 which authorizes the New York City Board of Education, with the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1972-1973 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1393,
          "min": -1.2996
        },
        "category": {
