    },
    {
      "bbox": [
        0,
        1008,
        1857,
        1323
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-61, the New York City Housing Authority with the approval of the City, has provided, for success-ive periods of one fiscal year pursuant to statutes enacted by the state Legislature at the request of the City, an increased take-home-pay plan applicable to members, officers and employees of the New York City Housing Authority who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3232,
          "min": -1.7088
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0042,
          "min": -0.0042
        },
        "text": {
          "n_tokens": 91,
          "mean": -0.0161,
          "min": -0.6334
        }
      },
      "ink": {
        "ink_px": 16341,
        "area_px": 500228,
        "density": 0.03267,
        "chars": 438,
        "chars_per_1k_ink": 26.8
      }
    },
    {
      "bbox": [
        0,
        1368,
        1725,
        1545
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of Authority personnel without a diminution or loss of pension rights, with the result that the take-home pay of Authority personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2654,
          "min": -1.5687
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 41,
          "mean": -0.0004,
          "min": -0.0077
        }
      },
      "ink": {
        "ink_px": 7856,
        "area_px": 258456,
        "density": 0.0304,
        "chars": 224,
        "chars_per_1k_ink": 28.51
      }
    },
    {
      "bbox": [
        0,
        1594,
        1792,
        1821
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on Authority personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the Authority and the City Government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2425,
          "min": -1.5755
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 54,
          "mean": -0.0195,
          "min": -0.6938
        }
      },
      "ink": {
        "ink_px": 7527,
        "area_px": 344586,
        "density": 0.02184,
        "chars": 306,
        "chars_per_1k_ink": 40.65
      }
    },
    {
      "bbox": [
        0,
        1866,
        1747,
        2047
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Housing Authority, by resolution adopted on June 14, 1972 has elected, subject to the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1972-1973 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2294,
          "min": -1.4452
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 62,
