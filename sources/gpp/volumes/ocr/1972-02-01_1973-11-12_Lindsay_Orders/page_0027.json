    },
    {
      "bbox": [
        0,
        2090,
        1730,
        2229
      ],
      "category": "Text",
      "text": "WHEREAS, I have determined that it is in the best interests of the City, the Authority and the members, officers and employees of the Authority that such plan shall be so confined;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2496,
          "min": -1.4366
        },
        "category": {
