        1757,
        1184
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-61, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay plan applicable to City-paid officers and employees who are members of City-supported retirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2914,
          "min": -1.4873
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 68,
          "mean": -0.0042,
          "min": -0.2537
        }
      },
      "ink": {
        "ink_px": 41,
