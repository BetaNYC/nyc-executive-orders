        "chars_per_1k_ink": 8000.0
      }
    },
    {
      "bbox": [
        141,
        1222,
        1763,
        1395
      ],
      "category": "Text",
      "text": "WHEREAS, under such plan the City makes possible a decrease in pension contributions of such personnel without diminution or loss of pension rights, with the result that the take-home-pay of such personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.221,
          "min": -1.3976
        },
        "category": {
