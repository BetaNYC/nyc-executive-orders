    },
    {
      "bbox": [
        141,
        1447,
        1835,
        1627
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on such personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the City government and the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2218,
          "min": -1.5517
        },
