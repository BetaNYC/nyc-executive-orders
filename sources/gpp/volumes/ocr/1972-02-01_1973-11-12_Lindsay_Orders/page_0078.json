        171,
        2122,
        1980,
        2244
      ],
      "category": "Text",
      "text": "§ 2. The New York City Mayor's Office for the Handicapped shall perform the following:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2765,
          "min": -1.5874
        },
        "category": {
