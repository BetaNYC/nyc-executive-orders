    {
      "bbox": [
        133,
        1003,
        1861,
        1245
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased take-home-pay plan applicable to officers and employees of City agencies who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3347,
          "min": -1.7345
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0032,
          "min": -0.0032
        },
        "text": {
          "n_tokens": 74,
          "mean": -0.0025,
          "min": -0.1807
        }
      },
      "ink": {
        "ink_px": 12923,
        "area_px": 388204,
        "density": 0.03329,
        "chars": 350,
        "chars_per_1k_ink": 27.08
      }
    },
    {
      "bbox": [
        133,
        1275,
        1767,
        1447
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of City personnel without diminution or loss of pension rights, with the result that the take-home-pay of City personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2585,
          "min": -1.5024
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0071,
          "min": -0.2816
        }
      },
      "ink": {
        "ink_px": 9188,
        "area_px": 260478,
        "density": 0.03527,
        "chars": 212,
        "chars_per_1k_ink": 23.07
      }
    },
    {
      "bbox": [
        128,
        1501,
        1816,
        1718
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on City personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2989,
          "min": -1.3307
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0017,
          "min": -0.0622
        }
      },
      "ink": {
        "ink_px": 8456,
        "area_px": 337028,
        "density": 0.02509,
        "chars": 283,
        "chars_per_1k_ink": 33.47
      }
    },
    {
      "bbox": [
        124,
        1772,
        1858,
        2132
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Housing Development Corporation, by resolution adopted on June 19, 1972, has elected, subject to the approval of the Mayor, to provide such an increased-take-home-pay plan during the City's 1972-1973 fiscal year for the officers and employees of such Corporation who are members of the New York City Employees' Retirement System, and to confirm the increased-take-home-pay plan provided for such officers and employees during such part of their membership in such Retirement System as falls within the 1971-1972 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2797,
          "min": -1.4909
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 128,
          "mean": -0.0001,
          "min": -0.0022
        }
      },
      "ink": {
