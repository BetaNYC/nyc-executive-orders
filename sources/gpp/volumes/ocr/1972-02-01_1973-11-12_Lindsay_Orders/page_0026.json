    },
    {
      "bbox": [
        116,
        2360,
        1912,
        2537
      ],
      "category": "Text",
      "text": "NOW THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered that the annexed resolution of the New York City Housing Development Corporation, adopted by such Corporation on June 19, 1972 is hereby approved.",
