    {
      "bbox": [
        128,
        1077,
        1857,
        1157
      ],
      "category": "Text",
      "text": "Whereas, the improvement of our urban environment is critically important to the overall welfare of the people of the City;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2741,
          "min": -1.3587
        },
        "category": {
          "n_tokens": 1,
