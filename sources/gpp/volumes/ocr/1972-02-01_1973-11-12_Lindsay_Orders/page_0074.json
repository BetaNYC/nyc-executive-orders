    {
      "bbox": [
        181,
        1476,
        1858,
        1595
      ],
      "category": "Text",
      "text": "WHEREAS, $5,000,000 has been authorized in the City Capital Budget for 1973-74 for a \"Block Security Program\" under the supervision and control of the Police Department; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
