        "chars_per_1k_ink": 365.59
      }
    },
    {
      "bbox": [
        114,
        1453,
        1790,
        1947
      ],
      "category": "List-item",
      "text": "SECTION 1. Employees and officers, other than those covered under the Mayor's Personnel Order No. 76/70 of October 13, 1970 and the Mayor's Personnel Order No. 41/72 of September 5, 1972, with unused creditable vacation and/or compensatory time allowances standing to their credit consistent with existing City-wide rules and/or regulations, whose employment is terminated other than by retirement, subject to the written approval of the agency head, may be paid the monetary value of accumulated and unused vacation time and/or compensatory time allowances standing to their credit for such time as may be due them. The monetary value so paid shall not exceed the salary rate earnable in the year of termination and shall not be creditable for computing a retirement allowance.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
