        "density": 0.01144,
        "chars": 246,
        "chars_per_1k_ink": 46.56
      }
    },
    {
      "bbox": [
        146,
        1492,
        1997,
        1773
      ],
      "category": "Text",
      "text": "WHEREAS, many of the Vietnam era veterans in the City are either unemployed, on public assistance or receiving unemployment compensation, or are without adequate housing, and the incidence of drug addiction or alienation from the civilian community among such veterans has increased: and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2412,
          "min": -1.4651
        },
        "category": {
