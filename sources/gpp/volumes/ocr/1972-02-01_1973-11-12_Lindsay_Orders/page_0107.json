        "chars": 287,
        "chars_per_1k_ink": 53.95
      }
    },
    {
      "bbox": [
        143,
        1812,
        1943,
        2011
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York has an obligation to provide a variety of services in order to reorient discharged servicemen and to help reinvolve them with the civilian community; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2561,
          "min": -1.5517
        },
        "category": {
