    {
      "bbox": [
        146,
        1174,
        1963,
        1455
      ],
      "category": "Text",
      "text": "WHEREAS, The City of New York is deeply concerned with the problems and needs of veterans and especially Vietnam era veterans, including the need for employment, housing, medical care and educational, vocational and drug addiction counseling; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2901,
          "min": -1.6584
        },
        "category": {
