    },
    {
      "bbox": [
        140,
        2049,
        1943,
        2253
      ],
      "category": "Text",
      "text": "WHEREAS, our experience with the New York City Division of Veteran's Affairs has demonstrated that the services now available to the veteran must be broadly expanded in order to meet these current problems and needs;",
      "logprob_stats": {
        "bbox": {
