    },
    {
      "bbox": [
        209,
        1179,
        1753,
        1355
      ],
      "category": "Text",
      "text": "WHEREAS, in order to encourage and facilitate this form of development in the City of New York and particularly in the Borough of Richmond it is necessary to create a special implementation agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3326,
