    {
      "bbox": [
        155,
        1422,
        1807,
        1507
      ],
      "category": "Text",
      "text": "WHEREAS, the delivery of government services to the people of the City of New York is a primary government function;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3103,
          "min": -1.6185
