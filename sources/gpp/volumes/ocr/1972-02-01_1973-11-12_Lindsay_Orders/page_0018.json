        "density": 0.04073,
        "chars": 350,
        "chars_per_1k_ink": 21.0
      }
    },
    {
      "bbox": [
        281,
        1512,
        1763,
        1694
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of City personnel without diminution or loss of pension rights, with the result that the take-home-pay of the City personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2748,
          "min": -1.6391
        },
        "category": {
          "n_tokens": 1,
