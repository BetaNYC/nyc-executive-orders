    {
      "bbox": [
        121,
        823,
        1767,
        1113
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay plan applicable to officers and employees of City agencies who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3485,
          "min": -1.738
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 75,
          "mean": -0.0009,
          "min": -0.0493
        }
      },
      "ink": {
        "ink_px": 43037,
        "area_px": 439410,
        "density": 0.09794,
        "chars": 350,
        "chars_per_1k_ink": 8.13
      }
    },
    {
      "bbox": [
        128,
        1136,
        1776,
        1341
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of City personnel without diminution or loss of pension rights, with the result that the take-home-pay of City personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3042,
          "min": -1.5623
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0064,
          "min": -0.2524
        }
      },
      "ink": {
        "ink_px": 26758,
        "area_px": 312914,
        "density": 0.08551,
        "chars": 212,
        "chars_per_1k_ink": 7.92
      }
    },
    {
      "bbox": [
        131,
        1361,
        1855,
        1618
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on City personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.299,
          "min": -1.5587
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0029,
          "min": -0.1132
        }
      },
      "ink": {
        "ink_px": 36101,
        "area_px": 412542,
        "density": 0.08751,
        "chars": 283,
        "chars_per_1k_ink": 7.84
      }
    },
    {
      "bbox": [
        138,
        1630,
        1819,
        1938
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Off-Track Betting Corporation, by resolution adopted on June 8, 1972, has elected, subject to the approval of the Mayor, to provide such an increased-take-home-pay plan during the City's 1972-1973 fiscal year for the officers and employees of such Corporation who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3111,
          "min": -1.3251
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 86,
          "mean": -0.0001,
          "min": -0.0052
        }
      },
      "ink": {
        "ink_px": 42411,
        "area_px": 481404,
        "density": 0.0881,
        "chars": 357,
        "chars_per_1k_ink": 8.42
      }
    },
    {
      "bbox": [
        140,
        1947,
        1797,
        2125
      ],
      "category": "Text",
      "text": "WHEREAS, I have determined that it is in the best interests of the City, the Corporation and the officers and employees of the Corporation that such plans shall be so effectuated;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2933,
          "min": -1.4832
        },
        "category": {
          "n_tokens": 1,
