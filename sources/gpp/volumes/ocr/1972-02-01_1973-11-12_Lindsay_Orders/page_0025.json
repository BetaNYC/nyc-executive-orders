        "density": 0.02433,
        "chars": 217,
        "chars_per_1k_ink": 29.58
      }
    },
    {
      "bbox": [
        151,
        1940,
        1954,
        2082
      ],
      "category": "Text",
      "text": "WHEREAS, I have determined that it is in the best interests of the City, the Authority and the officers and employees of the Authority that such plan shall be so continued;",
