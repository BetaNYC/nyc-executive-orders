    {
      "bbox": [
        147,
        839,
        1944,
        1157
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-61, the New York City Transit Authority, with the approval of the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay plan applicable to officers and employees of the New York City Transit Authority who are members of the New York City Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.307,
          "min": -1.6176
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 88,
          "mean": -0.003,
          "min": -0.1555
        }
      },
      "ink": {
        "ink_px": 4727,
        "area_px": 536960,
        "density": 0.0088,
        "chars": 428,
        "chars_per_1k_ink": 90.54
      }
    },
    {
      "bbox": [
        147,
        1207,
        1826,
        1387
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of Authority personnel without diminution or loss of pension rights, with the result that the take-home-pay of Authority personnel is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2702,
          "min": -1.441
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0108,
          "min": -0.4297
        }
      },
      "ink": {
        "ink_px": 4827,
        "area_px": 282360,
        "density": 0.0171,
        "chars": 222,
        "chars_per_1k_ink": 45.99
      }
    },
    {
      "bbox": [
        147,
        1437,
        1898,
        1664
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on Authority personnel, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the functioning of the Authority and the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2489,
          "min": -1.3369
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 54,
          "mean": -0.0021,
          "min": -0.0792
        }
      },
      "ink": {
        "ink_px": 9071,
        "area_px": 372096,
        "density": 0.02438,
        "chars": 306,
        "chars_per_1k_ink": 33.73
      }
    },
    {
      "bbox": [
        151,
        1711,
        1870,
        1897
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Transit Authority, by resolution adopted June 19, 1972 has elected subject to the approval of the Mayor, to continue such increased-take-home-pay during the City's 1972-1973 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2891,
          "min": -1.2994
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 59,
          "mean": -0.0002,
          "min": -0.0034
        }
      },
