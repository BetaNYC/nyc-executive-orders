    {
      "bbox": [
        215,
        1290,
        1870,
        1408
      ],
      "category": "Text",
      "text": "WHEREAS, the use of alcoholic beverages by City employees is of immediate concern to the City, as an employer, when it results in a job-related problem; and",
      "logprob_stats": {
