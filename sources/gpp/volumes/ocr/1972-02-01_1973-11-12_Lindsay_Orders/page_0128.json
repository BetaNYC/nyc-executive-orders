      }
    },
    {
      "bbox": [
        94,
        1181,
        1877,
        1309
      ],
      "category": "Text",
      "text": "WHEREAS, many Hispanic defendants and complainants are not sufficiently fluent in English to comprehend fully the processes of arrest, adjudication, incarceration, and post-conviction supervision;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2269,
