      }
    },
    {
      "bbox": [
        94,
        1457,
        1903,
        1615
      ],
      "category": "Text",
      "text": "WHEREAS, the special problems of Hispanic persons who become involved in the criminal justice system cannot be solved without clear identification of specific problem areas and concrete recommendations for reform in each agency of the system;",
      "logprob_stats": {
        "bbox": {
