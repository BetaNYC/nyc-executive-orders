      }
    },
    {
      "bbox": [
        94,
        1340,
        1903,
        1423
      ],
      "category": "Text",
      "text": "WHEREAS, this situation may result in curtailment of the rights of Hispanic New Yorkers and hamper their access to important remedial services;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1994,
