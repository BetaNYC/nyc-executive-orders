      ],
      "category": "Text",
      "text": "**Section 3.** (a) Except as otherwise provided in subdivision (c) of this section 3, the Authority hereby designates for conditional exclusion from the benefits provided by section 2 of this resolution all members of the Housing Police Service.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3319,
