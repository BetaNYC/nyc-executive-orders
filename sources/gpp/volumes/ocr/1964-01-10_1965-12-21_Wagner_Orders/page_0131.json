        "density": 0.03513,
        "chars": 78,
        "chars_per_1k_ink": 13.35
      }
    },
    {
      "bbox": [
        294,
        2534,
        1610,
        2738
      ],
      "category": "Text",
      "text": "A. The inspection activities of the D.W.S.G.&E. relating to citizen complaints of water leaks within buildings shall be transferred to the Department of Buildings.",
      "logprob_stats": {
