    },
    {
      "bbox": [
        294,
        1903,
        1627,
        2337
      ],
      "category": "Text",
      "text": "It has been found that several city agencies have overlapping responsibilities in the housing code enforcement area. These include the Departments of Buildings, Health, Fire, Water Supply, Gas & Electricity and Sanitation. This situation has resulted in duplication of inspections by these agencies and confusion on the part of citizens.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2322,
          "min": -1.3797
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 58,
          "mean": -0.001,
          "min": -0.0524
        }
      },
