        "chars": 337,
        "chars_per_1k_ink": 13.6
      }
    },
    {
      "bbox": [
        294,
        2374,
        1630,
        2497
      ],
      "category": "Text",
      "text": "In order to remedy this situation, I direct that the following steps be taken:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2214,
          "min": -1.5079
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0006,
          "min": -0.0006
        },
        "text": {
          "n_tokens": 16,
          "mean": -0.0002,
          "min": -0.0009
        }
      },
      "ink": {
        "ink_px": 5841,
