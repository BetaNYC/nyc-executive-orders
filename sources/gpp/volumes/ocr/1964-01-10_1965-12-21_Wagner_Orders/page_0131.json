    {
      "bbox": [
        294,
        1668,
        1625,
        1862
      ],
      "category": "Text",
      "text": "The City is currently involved in a massive effort to bring about better housing conditions through more effective housing code enforcement.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.264,
          "min": -1.4972
