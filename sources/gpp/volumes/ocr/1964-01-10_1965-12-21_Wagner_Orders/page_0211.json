      ],
      "category": "Text",
      "text": "A. The Poverty Operations Board created by Executive Order No. 114 is renewed in its existence by this Order, but shall be entitled the Anti-Poverty Operations Board (hereinafter referred to as the Board). Its duties and functions are modified as described herein.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.4398,
          "min": -2.0261
        },
        "category": {
          "n_tokens": 1,
