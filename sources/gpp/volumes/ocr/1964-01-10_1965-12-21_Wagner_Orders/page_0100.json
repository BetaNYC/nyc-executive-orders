    },
    {
      "bbox": [
        231,
        2308,
        1787,
        2536
      ],
      "category": "Text",
      "text": "You are further requested to submit, by September 30, 1964, the name of a qualified responsible person who will coordinate this changeover for your agency, to Mr. Walter J. Detmar, Jr., Director, Bureau of Operating Services, Department of Public Works, Room 1450, Municipal Building, New York, N. Y. 10007.",
