        "chars": 118,
        "chars_per_1k_ink": 218.52
      }
    },
    {
      "bbox": [
        91,
        1083,
        1535,
        1285
      ],
      "category": "Text",
      "text": "In accordance with the explanatory note setting forth these reductions you are required to submit schedules explaining how you expect to realize these reductions.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2711,
          "min": -1.5866
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 25,
          "mean": -0.0019,
          "min": -0.0429
        }
      },
      "ink": {
        "ink_px": 803,
        "area_px": 264014,
        "density": 0.00304,
        "chars": 162,
        "chars_per_1k_ink": 201.74
      }
    },
    {
      "bbox": [
        91,
        1323,
        1493,
        1683
      ],
      "category": "Text",
      "text": "As the new City Charter requires that appropriations be made by program, activity, etc., it was necessary for the sake of expediency, to arbitrarily assign these reductions to programs. You are not bound by these amounts, but may reassign them in whole or in part to other programs, activities, etc., as you see fit.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2489,
          "min": -1.6697
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 67,
          "mean": -0.0042,
          "min": -0.2571
        }
      },
      "ink": {
        "ink_px": 665,
        "area_px": 455400,
        "density": 0.00146,
        "chars": 316,
        "chars_per_1k_ink": 475.19
      }
    },
    {
      "bbox": [
        91,
        1715,
        1509,
        2076
      ],
      "category": "Text",
      "text": "In the message which accompanied my executive budget, I stated that these reductions were to be applied in a manner to insure a minimum of inconvenience to the public. I urge each of you to be mindful of this and effect the required savings in areas that will not adversely affect essential city services.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2431,
          "min": -1.4497
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 57,
          "mean": -0.0042,
          "min": -0.1983
        }
      },
      "ink": {
        "ink_px": 849,
        "area_px": 462441,
        "density": 0.00184,
        "chars": 305,
        "chars_per_1k_ink": 359.25
      }
    },
    {
      "bbox": [
        91,
        2110,
        1430,
        2233
      ],
      "category": "Text",
      "text": "The schedules required are to be submitted to me on or before June 22, 1964.",
