    {
      "bbox": [
        91,
        925,
        1552,
        1058
      ],
      "category": "Text",
      "text": "The Expense Budget for 1964-1965 contains budget reductions, approximately 6%, deducted from the amounts appropriated.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3049,
          "min": -1.6539
        },
        "category": {
