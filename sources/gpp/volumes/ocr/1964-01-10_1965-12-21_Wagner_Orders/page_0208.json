    {
      "bbox": [
        121,
        577,
        1927,
        968
      ],
      "category": "Text",
      "text": "A. The body created by Executive Order No. 11 as the Mayor's Council Against Poverty is hereby disbanded, and a new organization to be entitled the New York City Council Against Poverty (hereinafter referred to as the Council), with new membership, is created in its place, with such duties and functions as are described herein.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3493,
          "min": -1.6665
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0486,
          "min": -0.0486
        },
        "text": {
          "n_tokens": 69,
          "mean": -0.0415,
          "min": -0.8428
        }
      },
      "ink": {
        "ink_px": 0,
