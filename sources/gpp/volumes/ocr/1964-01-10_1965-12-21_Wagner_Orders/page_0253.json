        "density": 0.0,
        "chars": 62,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        1700,
        1771,
        1957
      ],
      "category": "Text",
      "text": "Experience during the two years of operation under Executive Order 34, dated April 15, 1963, indicates a need for modification of the procedures established. Executive Order 34 dated April 15, 1963, and Deputy Mayor Cavanagh's memorandum of December 28, 1964, relating to appeals, are hereby superseded. The following procedures shall govern medical examinations for drivers of City motor vehicles:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2238,
          "min": -1.4257
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 96,
          "mean": -0.0047,
          "min": -0.3892
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 385968,
        "density": 0.0,
        "chars": 398,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        1993,
        1740,
        2167
      ],
      "category": "Text",
      "text": "1. Candidates for the position of Motor Vehicle Operator, and other positions for which a driver's license is required, shall be subject to a medical examination by the Department of Personnel, and prior to appointment, by the appointing agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2157,
          "min": -1.3734
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0052,
          "min": -0.0052
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0002,
          "min": -0.0069
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 256375,
        "density": 0.0,
        "chars": 245,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        2197,
        1722,
        2334
      ],
      "category": "Text",
      "text": "2. Prior to assigning any other employees to driving a City vehicle as an important part of their duties, they shall be subject to a medical examination by the employing agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2318,
          "min": -1.4434
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 34,
          "mean": -0.0001,
          "min": -0.0029
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 199686,
        "density": 0.0,
        "chars": 177,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        2364,
        1727,
        2631
      ],
      "category": "Text",
      "text": "3. Employees in the title of Motor Vehicle Operator, and other employees who drive City vehicles as an important part of their duties, shall be subject to periodic medical re-examination in accordance with standards established by the City Personnel Director. These shall not be more stringent than the then current standards for candidates for the position of Motor Vehicle Operator.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1863,
          "min": -1.2577
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 67,
          "mean": -0.0001,
          "min": -0.0015
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 389136,
        "density": 0.0,
        "chars": 384,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        2654,
        1730,
        2795
      ],
      "category": "Text",
      "text": "4. Motor Vehicle Operators who, after a medical examination, are found medically unfit to drive may appeal such determination to the City Civil Service Commission.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2182,
          "min": -1.5677
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 29,
          "mean": -0.0009,
          "min": -0.0199
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 206610,
        "density": 0.0,
        "chars": 163,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        2821,
        1690,
        2972
      ],
      "category": "Text",
      "text": "5. All Departments and Agencies shall follow the attached procedures for medical examinations and for actions to be taken with regard to employees found medically unfit to drive City motor vehicles.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2286,
          "min": -1.518
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 33,
          "mean": -0.0003,
          "min": -0.006
        }
      },
      "ink": {
        "ink_px": 0,
        "area_px": 215080,
        "density": 0.0,
        "chars": 198,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        215,
        2991,
        1735,
        3277
      ],
      "category": "Text",
      "text": "6. Until further notice, the Department of Hospitals will conduct the medical examinations for any City agency which does not have its own medical staff. Agencies requiring this medical assistance shall apply to the Department of Hospitals. The Department of Hospitals shall establish a procedure and schedule of the examinations which will be adhered to by all concerned.",
      "logprob_stats": {
        "bbox": {
