        1619,
        1527,
        1659
      ],
      "category": "Text",
      "text": "SUBJECT: MEDICAL EXAMINATION OF DRIVERS OF CITY MOTOR VEHICLES",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2033,
          "min": -1.2967
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 17,
          "mean": -0.0003,
          "min": -0.0012
        }
      },
      "ink": {
