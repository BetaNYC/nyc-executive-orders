      ],
      "category": "Text",
      "text": "SUBJECT: PROPERTY ACQUIRED ON ACCOUNT OF NON-PAYMENT OF TAXES AND APPROVED FOR USE FOR PUBLIC PURPOSE. PROCEDURE AND PAYMENT.",
