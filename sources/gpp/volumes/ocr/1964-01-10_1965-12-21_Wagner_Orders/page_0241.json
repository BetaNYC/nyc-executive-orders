        "chars": 28,
        "chars_per_1k_ink": 314.61
      }
    },
    {
      "bbox": [
        387,
        2567,
        1707,
        2826
      ],
      "category": "Text",
      "text": "It is the policy of the City of New York to promote the most effective use of its existing manpower pool to fill positions which require highly developed managerial and administrative abilities. This will be accomplished through the establishment of a Career Executive Roster which shall be consulted prior to making appointments from outside the city service.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2307,
          "min": -1.2451
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 60,
          "mean": -0.0,
          "min": -0.0003
        }
      },
      "ink": {
