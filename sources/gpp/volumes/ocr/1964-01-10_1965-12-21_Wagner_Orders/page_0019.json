    {
      "bbox": [
        76,
        1604,
        1600,
        1811
      ],
      "category": "Text",
      "text": "This year The Greater New York Fund Campaign among city employees will be held from May 1 to June 30. Since the Fund does not solicit gifts from individuals at home or in public places, but only on the job, this is the one opportunity that all employees have to contribute to the 425 voluntary hospitals, health and welfare agencies of the Fund. These agencies perform the vital community role of annually helping nearly 4,000,000 New Yorkers of all faiths and races.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3159,
          "min": -1.3691
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 104,
          "mean": -0.0059,
          "min": -0.5087
        }
      },
      "ink": {
        "ink_px": 10221,
        "area_px": 285039,
        "density": 0.03586,
        "chars": 467,
        "chars_per_1k_ink": 45.69
      }
    },
    {
      "bbox": [
        76,
        1844,
        1616,
        1951
      ],
      "category": "Text",
      "text": "It is the responsibility of the entire community of New York to support the campaign and that is why each city employee is being asked to do his share, like all other people who work in our city.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2247,
          "min": -1.4908
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0237,
          "min": -0.7188
        }
      },
      "ink": {
        "ink_px": 3531,
        "area_px": 150552,
        "density": 0.02345,
        "chars": 195,
        "chars_per_1k_ink": 55.23
      }
    },
    {
      "bbox": [
        76,
        1982,
        1535,
        2057
      ],
      "category": "Text",
      "text": "As my personal representative, I have asked Dr. Theodore H. Lang to assume full responsibility for The Greater New York Fund Campaign among city employees.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2182,
          "min": -1.5116
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 29,
          "mean": -0.0001,
          "min": -0.001
        }
      },
      "ink": {
        "ink_px": 2700,
        "area_px": 98400,
        "density": 0.02744,
        "chars": 155,
        "chars_per_1k_ink": 57.41
      }
    },
    {
      "bbox": [
        76,
        2086,
        1618,
        2196
      ],
      "category": "Text",
      "text": "For a first step, I would like you to appoint an executive in your organization to represent you and to serve as chairman for the drive among your employees. Please forward this name to Dr. Lang at the Department of Personnel by April 10, 1964.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2104,
          "min": -1.3311
        },
        "category": {
          "n_tokens": 1,
