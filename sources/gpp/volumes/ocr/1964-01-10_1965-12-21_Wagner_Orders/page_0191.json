    {
      "bbox": [
        297,
        1065,
        1776,
        1198
      ],
      "category": "Text",
      "text": "This is to certify that the Trustees of The New York Public Library, at a meeting on May. 12, 1965 at which a quorum was present, adopted the following resolution:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2237,
          "min": -1.3348
        },
        "category": {
