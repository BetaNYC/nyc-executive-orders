    },
    {
      "bbox": [
        277,
        1727,
        1415,
        1797
      ],
      "category": "Text",
      "text": "This important program focusing on young people from poor families with poor employment opportunities has as its aims:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2496,
          "min": -1.2877
        },
