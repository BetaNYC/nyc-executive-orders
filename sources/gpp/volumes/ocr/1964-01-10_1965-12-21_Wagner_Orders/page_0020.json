    {
      "bbox": [
        280,
        1522,
        1449,
        1701
      ],
      "category": "Text",
      "text": "One element in our attack upon poverty in this City is the Municipal Cooperative Education and Work Program. We intend to expand this program from the 930 high school students now working for 55 City agencies and attending school on an alternate week basis to 2000 students with every City agency participating.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2427,
          "min": -1.2467
        },
        "category": {
