    {
      "bbox": [
        238,
        654,
        1733,
        959
      ],
      "category": "Text",
      "text": "In connection with our continuing and expanding efforts to up-grade and increase the skills of unemployed and under-utilized people in our city, there are many programs, and we can expect there will be many more, involving job placements in City agencies for the purpose of providing for training, work experience and employment opportunities. It is essential for efficient and effective operations that these programs constitute an integrated and coordinated effort.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2867,
          "min": -1.7245
        },
        "category": {
          "n_tokens": 1,
