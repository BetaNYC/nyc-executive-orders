        1496,
        1442,
        1587
      ],
      "category": "Text",
      "text": "SUBJECT: Continuance of Group Health Insurance Membership of City Employees on Retirement",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2081,
          "min": -1.4798
        },
        "category": {
          "n_tokens": 1,
