    {
      "bbox": [
        424,
        1745,
        1733,
        1987
      ],
      "category": "Text",
      "text": "This year The Greater New York Fund Campaign among city employees will be conducted from May 1 to June 30. Every city employee should be encouraged to contribute to this once-a-year, on the job solicitation which supports the 425 voluntary hospital, health and welfare agencies of the Fund.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2832,
          "min": -1.6776
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 61,
          "mean": -0.0024,
          "min": -0.1429
        }
      },
      "ink": {
        "ink_px": 5427,
        "area_px": 318573,
        "density": 0.01704,
        "chars": 290,
        "chars_per_1k_ink": 53.44
      }
    },
    {
      "bbox": [
        424,
        2024,
        1756,
        2188
      ],
      "category": "Text",
      "text": "No one is asked to contribute to the Fund at any time or place except at work. For this reason, it is important that each person is given an opportunity to support this community-wide effort.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2225,
          "min": -1.4433
        },
        "category": {
