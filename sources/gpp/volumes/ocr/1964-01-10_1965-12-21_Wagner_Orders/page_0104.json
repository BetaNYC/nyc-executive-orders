    },
    {
      "bbox": [
        469,
        2007,
        1563,
        2297
      ],
      "category": "Text",
      "text": "\"This switch was found _ON_ after office was closed. That means electricity was wasted.\n\nPlease turn off all equipment the use of which is not required when office is vacant.\"",
