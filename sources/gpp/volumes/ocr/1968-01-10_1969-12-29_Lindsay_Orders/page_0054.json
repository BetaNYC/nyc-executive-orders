        806,
        1017,
        915
      ],
      "category": "Text",
      "text": "WHEREAS, such local law provides by its terms that it shall\ntake effect on such date as I shall provide by executive order,\nand,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2508,
