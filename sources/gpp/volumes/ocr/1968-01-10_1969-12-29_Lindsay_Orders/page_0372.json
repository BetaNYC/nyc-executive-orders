        "chars": 374,
        "chars_per_1k_ink": 124666.67
      }
    },
    {
      "bbox": [
        140,
        758,
        1156,
        897
      ],
      "category": "Text",
      "text": "WHEREAS, such Act, to carry out such purpose, calls for comprehensive planning of health services, manpower facilities and research at every level of public and private endeavor and provides for federal financial assistance for such purpose, specifically providing for area-wide planning agencies for regions, metropolitan areas, or local areas, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2296,
          "min": -1.2241
        },
        "category": {
