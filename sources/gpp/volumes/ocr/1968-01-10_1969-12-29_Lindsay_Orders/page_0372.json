        "chars_per_1k_ink": 349000.0
      }
    },
    {
      "bbox": [
        142,
        911,
        1221,
        1010
      ],
      "category": "Text",
      "text": "WHEREAS, Congress has declared that attainment of the goals of the Comprehensive Health Planning Act \"depends on an effective partnership, involving close intergovernment collaboration, official and voluntary efforts, and participation of individuals and organization,\" and",
      "logprob_stats": {
