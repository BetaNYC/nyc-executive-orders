        "chars_per_1k_ink": 2914.29
      }
    },
    {
      "bbox": [
        194,
        992,
        1017,
        1037
      ],
      "category": "Text",
      "text": "1. Declaration. A HEALTH EMERGENCY is hereby deemed\nto exist.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2115,
          "min": -1.1266
        },
        "category": {
          "n_tokens": 1,
