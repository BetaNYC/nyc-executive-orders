        "density": 0.00018,
        "chars": 61,
        "chars_per_1k_ink": 8714.29
      }
    },
    {
      "bbox": [
        194,
        1056,
        1053,
        1165
      ],
      "category": "Text",
      "text": "2. Filing and Publication. This Executive Order shall\nbe filed in the office of the City Clerk and published in the City\nRecord forthwith, or if publication in the City Record is not\npossible because of the emergency, in any available newspaper of\ngeneral circulation, if possible.",
      "logprob_stats": {
