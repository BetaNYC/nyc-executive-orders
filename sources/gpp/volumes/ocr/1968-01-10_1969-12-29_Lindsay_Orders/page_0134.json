      ],
      "category": "Text",
      "text": "Continuation of increased take-home-pay plan\nduring 1968-1969 State fiscal year, for offi-\ncers and employees of the Triborough Bridge\nand Tunnel Authority, The New York Public\nLibrary, The Brooklyn Public Library and The\nQueens Borough Public Library, who are mem-\nbers of the New York State Employees' Retire-\nment System.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2796,
          "min": -1.3358
        },
        "category": {
          "n_tokens": 1,
