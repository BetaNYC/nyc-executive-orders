    },
    {
      "bbox": [
        97,
        563,
        936,
        739
      ],
      "category": "Text",
      "text": "WHEREAS, since 1960, the Triborough Bridge and Tunnel Authority and since 1961, the above mentioned libraries, with the approval of the City, have provided, for successive periods of one State fiscal year (except for a shorter period in the 1960-1961 year) pursuant to statutes enacted by the State Legislature, an increased take-home-pay-plan applicable to officers and employees of such Authority and Libraries who are members of the New York State Employees' Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 17,
          "mean": -0.2862,
          "min": -1.2847
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0006,
          "min": -0.0006
        },
        "text": {
          "n_tokens": 107,
          "mean": -0.0004,
          "min": -0.0367
        }
      },
      "ink": {
        "ink_px": 2212,
        "area_px": 140892,
        "density": 0.0157,
        "chars": 484,
        "chars_per_1k_ink": 218.81
      }
    },
    {
      "bbox": [
        101,
        758,
        912,
        845
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the\npension contributions of such officers and employees without\ndiminution or loss of pension rights, with the result that the\ntake-home-pay of such officers and employees is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.241,
          "min": -1.2887
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 50,
          "mean": -0.0057,
          "min": -0.2831
        }
      },
      "ink": {
        "ink_px": 234,
        "area_px": 67936,
        "density": 0.00344,
        "chars": 238,
        "chars_per_1k_ink": 1017.09
      }
    },
    {
      "bbox": [
        104,
        865,
        1052,
        973
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by\nsuch plan on such personnel, their morale, efficiency and productive-\nness are improved, with resulting substantial benefits to the functioning\nof the Authority and such Libraries, and enhancement of the welfare of\nthe people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2026,
          "min": -1.066
        },
        "category": {
          "n_tokens": 1,
