          "min": -0.0952
        }
      },
      "ink": {
        "ink_px": 634,
        "area_px": 98496,
        "density": 0.00644,
        "chars": 299,
        "chars_per_1k_ink": 471.61
      }
    },
    {
      "bbox": [
        106,
        993,
        1000,
        1059
      ],
      "category": "Text",
      "text": "WHEREAS, by Laws 1968, Ch. 232, the State Legislature has\nauthorized a continuation of such increased-take-home-pay plan during\nthe 1968-1969 fiscal year of the State; and",
      "logprob_stats": {
        "bbox": {
