    },
    {
      "bbox": [
        81,
        867,
        1083,
        984
      ],
      "category": "Text",
      "text": "Section 1. An Air Pollution Control Alert-Warning System shall be established. This system shall include four stages known as (1) Forecast, (2) Alert, (3) Warning, (4) Emergency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2628,
          "min": -1.4583
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.127,
          "min": -0.127
        },
        "text": {
