    },
    {
      "bbox": [
        81,
        608,
        1077,
        766
      ],
      "category": "Text",
      "text": "WHEREAS, it is desirable and necessary, that certain preventive and abatement measures be adopted, so as to preclude or minimize the impact of an air pollution episode on the health and welfare of the citizens of the City of New York,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
