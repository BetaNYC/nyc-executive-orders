        "chars_per_1k_ink": 217000.0
      }
    },
    {
      "bbox": [
        112,
        616,
        1062,
        661
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2279,
          "min": -1.2082
        },
        "category": {
          "n_tokens": 1,
