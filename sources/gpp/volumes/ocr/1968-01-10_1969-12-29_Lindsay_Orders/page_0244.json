    },
    {
      "bbox": [
        110,
        528,
        1123,
        597
      ],
      "category": "Text",
      "text": "WHEREAS, it is desirable and necessary that certain preventive measures be adopted, so as to preclude or minimize the impact of an air pollution episode on the health and welfare of the people of the City of New York,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
