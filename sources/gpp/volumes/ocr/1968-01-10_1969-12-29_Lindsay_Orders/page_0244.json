          "min": -0.0885
        }
      },
      "ink": {
        "ink_px": 4,
        "area_px": 145008,
        "density": 3e-05,
        "chars": 486,
        "chars_per_1k_ink": 121500.0
      }
    },
    {
      "bbox": [
        117,
        1048,
        1107,
        1163
      ],
      "category": "Text",
      "text": "§ 3. Upon receipt of notice that meteorological conditions are such that the Forecast stage has been reached, the Mayor may declare the existence of such stage. Upon receipt of notice that conditions are such that any of the other stages have been reached, the Mayor will declare the existence of such other stage.",
      "logprob_stats": {
