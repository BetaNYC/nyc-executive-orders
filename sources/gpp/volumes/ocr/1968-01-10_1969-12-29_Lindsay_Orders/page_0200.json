    {
      "bbox": [
        90,
        151,
        994,
        259
      ],
      "category": "Text",
      "text": "WHEREAS, indirect costs - such as those for the services of the Office of the Comptroller, the Personnel, Purchase, Public Works, and Law Departments - should, in accordance with established management procedures, be accounted for in all computations of cost, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 17,
