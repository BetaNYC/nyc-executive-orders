      "bbox": [
        345,
        547,
        1080,
        784
      ],
      "category": "Text",
      "text": "a. Every City contract, and the bidding documents therefor, unless exempted from the provisions of this Executive Order pursuant to Section 4 hereof, shall contain provisions requiring bidders therefor to submit to the contracting agency, prior to the award of such contract, a program of affirmative action to provide for equal employment opportunity in accordance with the intent and purpose of this Executive Order, in such form and substance as may be required by rule, regulation or order of the City Administrator.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.209,
          "min": -1.0235
