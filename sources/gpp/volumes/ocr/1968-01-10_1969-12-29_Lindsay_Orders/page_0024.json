        "chars_per_1k_ink": 7466.67
      }
    },
    {
      "bbox": [
        187,
        744,
        1113,
        789
      ],
      "category": "Text",
      "text": "WHEREAS, executive authority to be effective must have administrative flexibility to assign managers to specific positions,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1084,
          "min": -1.1016
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 19,
