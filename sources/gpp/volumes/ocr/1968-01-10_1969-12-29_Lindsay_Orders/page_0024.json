    },
    {
      "bbox": [
        187,
        611,
        1087,
        657
      ],
      "category": "Text",
      "text": "WHEREAS, efficient and effective governmental operations require competent managers and adequate executive authority; and",
      "logprob_stats": {
        "bbox": {
