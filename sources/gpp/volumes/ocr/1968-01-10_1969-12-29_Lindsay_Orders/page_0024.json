        }
      },
      "ink": {
        "ink_px": 22,
        "area_px": 42816,
        "density": 0.00051,
        "chars": 121,
        "chars_per_1k_ink": 5500.0
      }
    },
    {
      "bbox": [
        187,
        677,
        1047,
        722
      ],
      "category": "Text",
      "text": "WHEREAS, managerial competence can be assured only if managerial assignments are based on merit and fitness; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1126,
          "min": -0.9645
        },
        "category": {
