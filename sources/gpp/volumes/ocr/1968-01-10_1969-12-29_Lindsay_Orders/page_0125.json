        672
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the City has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased-take-home-pay plan applicable to City-paid officers and employees who are members of City-Supported retirement systems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2536,
          "min": -1.3344
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0013,
          "min": -0.0013
        },
        "text": {
          "n_tokens": 71,
          "mean": -0.0003,
          "min": -0.007
        }
      },
      "ink": {
        "ink_px": 416,
