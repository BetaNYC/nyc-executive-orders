        "chars": 223,
        "chars_per_1k_ink": 1956.14
      }
    },
    {
      "bbox": [
        138,
        824,
        1058,
        938
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan of such personnel, their morale, efficiency and productivity are improved, with resulting substantial benefits to the functioning of the City government and the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2483,
          "min": -1.2019
        },
        "category": {
