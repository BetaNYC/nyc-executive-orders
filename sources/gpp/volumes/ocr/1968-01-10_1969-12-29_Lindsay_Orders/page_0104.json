      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York can utilize the services of the physically handicapped who are not occupationally disabled, as well as the services of the mentally retarded who have been trained to perform specific tasks, and",
      "logprob_stats": {
        "bbox": {
