        "chars": 202,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        143,
        854,
        1127,
        984
      ],
      "category": "Text",
      "text": "Section 1. The Department of Real Estate is charged, until the establishment of the Municipal Services Administration, with the responsibility for the care, maintenance and operation of all the burial grounds which have been under the jurisdiction of the Borough Presidents. The Municipal Services Administration, upon its establishment, shall assume such responsibility.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2051,
          "min": -0.9943
        },
        "category": {
          "n_tokens": 1,
