        "chars": 306,
        "chars_per_1k_ink": 51000.0
      }
    },
    {
      "bbox": [
        140,
        663,
        1118,
        749
      ],
      "category": "Text",
      "text": "WHEREAS, it is essential to implement such authorization and to provide for the assumption of such care, maintenance and operation and for the transfer of the necessary personnel from the offices of the Borough Presidents,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2111,
          "min": -1.086
