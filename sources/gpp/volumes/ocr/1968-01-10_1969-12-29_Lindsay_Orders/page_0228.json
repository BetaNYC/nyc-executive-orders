        "chars": 222,
        "chars_per_1k_ink": 222000.0
      }
    },
    {
      "bbox": [
        141,
        769,
        1117,
        835
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, and in accordance with the authority contained in the aforesaid section of the Administrative Code, I hereby order as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2174,
          "min": -1.1141
        },
        "category": {
