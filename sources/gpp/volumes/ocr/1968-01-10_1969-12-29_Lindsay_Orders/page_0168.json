    {
      "bbox": [
        87,
        374,
        1038,
        530
      ],
      "category": "Text",
      "text": "WHEREAS, since the City fiscal year 1960-1961, the New York City Board of Education, with the approval of the City, has provided, for successive periods of one fiscal year pursuant to statutes enacted by the State Legislature at the request of the City, an increased take-home-pay-plan applicable to members of the Board of Education Retirement System; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.3413,
          "min": -1.8417
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 77,
          "mean": -0.0009,
          "min": -0.0381
        }
      },
      "ink": {
        "ink_px": 2301,
        "area_px": 141884,
        "density": 0.01622,
        "chars": 356,
        "chars_per_1k_ink": 154.72
      }
    },
    {
      "bbox": [
        87,
        542,
        995,
        641
      ],
      "category": "Text",
      "text": "WHEREAS, such plan makes possible a decrease in the pension contributions of such members without diminution or loss of pension rights, with the result that the take-home-pay of such members is increased; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 17,
          "mean": -0.3331,
          "min": -1.8233
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.008,
          "min": -0.3155
        }
      },
      "ink": {
        "ink_px": 957,
        "area_px": 85500,
        "density": 0.01119,
        "chars": 208,
        "chars_per_1k_ink": 217.35
      }
    },
    {
      "bbox": [
        87,
        666,
        1058,
        793
      ],
      "category": "Text",
      "text": "WHEREAS, by reason of the economic benefits conferred by such plan on such members, their morale, efficiency and productiveness are improved, with resulting substantial benefits to the administration of the affairs of the Board of Education and the City government and enhancement of the welfare of the people of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2754,
          "min": -1.6734
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 59,
          "mean": -0.0016,
          "min": -0.032
        }
      },
      "ink": {
        "ink_px": 978,
        "area_px": 118422,
        "density": 0.00826,
        "chars": 326,
        "chars_per_1k_ink": 333.33
      }
    },
    {
      "bbox": [
        87,
        812,
        1080,
        917
      ],
      "category": "Text",
      "text": "WHEREAS, the City, at the 1968 Session of the State Legislature, sponsored the enactment of Laws 1967, Ch. 826, which authorizes the New York City Board of Education, with the approval of the Mayor, to continue such increased take-home-pay plan during the City's 1968-1969 fiscal year.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2528,
          "min": -1.3155
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 80,
          "mean": -0.0004,
          "min": -0.0207
        }
      },
      "ink": {
        "ink_px": 809,
        "area_px": 98333,
        "density": 0.00823,
        "chars": 285,
        "chars_per_1k_ink": 352.29
      }
    },
    {
      "bbox": [
        87,
        932,
        1075,
        1030
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Board of Education, by resolution adopted on June 26, 1968, has elected, subject to the approval of the Mayor, to continue such increased-take-home-pay plan during the City's 1968-1969 fiscal year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2616,
          "min": -1.3368
        },
        "category": {
