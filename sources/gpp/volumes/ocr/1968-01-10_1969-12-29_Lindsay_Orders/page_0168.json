    {
      "bbox": [
        87,
        1054,
        1050,
        1131
      ],
      "category": "Text",
      "text": "WHEREAS, I have determined that it is in the best interests of the City, the Board of Education and the members of the Board of Education Retirement System that such plan shall be so continued;",
      "logprob_stats": {
