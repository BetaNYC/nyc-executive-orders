    {
      "bbox": [
        200,
        292,
        1082,
        381
      ],
      "category": "Text",
      "text": "(a) The Agency shall advise the contractor who is the low bidder on the project to proceed to meet the emergency. This advice must be in written form, and must consist either of a Letter of Intent or formal contract.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
