    {
      "bbox": [
        192,
        633,
        1144,
        770
      ],
      "category": "Text",
      "text": "WHEREAS, the City Council has passed and I, as Mayor, have approved a local law designated as Local Law No. 67 of 1969 which amends the New York City Charter by providing for the consolidation of certain City agencies into a Transportation Administration, and prescribes the functions, powers and duties of such administration, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2742,
          "min": -1.28
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0006,
          "min": -0.0006
        },
        "text": {
          "n_tokens": 70,
          "mean": -0.0019,
          "min": -0.071
        }
      },
      "ink": {
        "ink_px": 0,
