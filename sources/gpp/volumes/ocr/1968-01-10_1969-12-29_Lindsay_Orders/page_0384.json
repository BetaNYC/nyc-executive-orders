        "chars": 127,
        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        193,
        884,
        1154,
        953
      ],
      "category": "Text",
      "text": "WHEREAS, implementation of such local law requires the creation of an organizational structure to fulfill the Transportation Administration's responsibilities, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1952,
          "min": -1.1377
        },
        "category": {
          "n_tokens": 1,
