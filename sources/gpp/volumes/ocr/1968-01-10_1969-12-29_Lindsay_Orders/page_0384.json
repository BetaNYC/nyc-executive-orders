        "chars_per_1k_ink": null
      }
    },
    {
      "bbox": [
        193,
        975,
        1165,
        1067
      ],
      "category": "Text",
      "text": "WHEREAS, the development of programs to improve transportation in the City of New York requires coordination of the operations of other agencies of the City government with the operation of the Transportation Administration, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
