    },
    {
      "bbox": [
        222,
        341,
        913,
        415
      ],
      "category": "Text",
      "text": "The foregoing amendments provide for a continuance of the 5% increased take home pay plan for members of the system who are not in career pension plan positions.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2745,
          "min": -1.6379
        },
