        "chars": 161,
        "chars_per_1k_ink": 61.36
      }
    },
    {
      "bbox": [
        222,
        429,
        945,
        521
      ],
      "category": "Text",
      "text": "For those members in career pension plan positions the rate will be reduced to 4% as specified in the agreement negotiated between the Office of Staff Relations of the Board of Education and Local 37 of AFSCME - AFL - CIO.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2401,
          "min": -1.3653
        },
        "category": {
