        "chars_per_1k_ink": 21166.67
      }
    },
    {
      "bbox": [
        139,
        744,
        1113,
        855
      ],
      "category": "Text",
      "text": "WHEREAS, implementation of such local law and development of programs to enhance the Parks, Recreation and Cultural Affairs of the City of New York requires coordination of the operations of other agencies of the City government with that of the Parks, Recreation and Cultural Affairs Administration, and",
      "logprob_stats": {
        "bbox": {
