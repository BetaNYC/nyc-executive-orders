    {
      "bbox": [
        137,
        549,
        1090,
        667
      ],
      "category": "Text",
      "text": "WHEREAS, the City Council has passed and I, as Mayor, have approved a local law designated as Local Law No. 22 of 1968 which amends the City Charter by providing for the consolidation of certain agencies into a Parks, Recreation and Cultural Affairs Administration and provides the functions, powers and duties of such administration, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2636,
          "min": -1.3382
        },
        "category": {
          "n_tokens": 1,
