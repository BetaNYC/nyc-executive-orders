        1151,
        695
      ],
      "category": "Text",
      "text": "WHEREAS, such salary adjustment plan has been since continued by the City for each fiscal year as to which such increased-take-home-pay plan has been continued; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2209,
          "min": -1.1075
        },
        "category": {
