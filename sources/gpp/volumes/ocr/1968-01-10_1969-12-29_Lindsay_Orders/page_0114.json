        1054,
        638
      ],
      "category": "Text",
      "text": "WHEREAS, such local law provides by its terms that it shall take effect on such date as I shall provide by executive order, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2326,
          "min": -1.0988
        },
