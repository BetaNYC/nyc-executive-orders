    {
      "bbox": [
        174,
        965,
        1540,
        1346
      ],
      "category": "Text",
      "text": "In the very near future, a Data Processing System,\nthe first of its kind, will be installed in the Mayor's Corres-\npondence Division. It will relieve City Hall Staff of much of\nthe routine processing and permit greater concentration on matters\nrequiring special attention. It will also relieve agency staff of\nmuch of the previously required routine processing.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2273,
          "min": -1.3194
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 74,
          "mean": -0.0019,
          "min": -0.1193
        }
      },
      "ink": {
        "ink_px": 3904,
