        "density": 0.00788,
        "chars": 361,
        "chars_per_1k_ink": 92.47
      }
    },
    {
      "bbox": [
        174,
        1377,
        1540,
        1830
      ],
      "category": "Text",
      "text": "By use of the Data Processing System, the Mayor's Cor-\nrespondence Division will be able to acknowledge the receipt of\nand handle all communications with greater speed, accuracy and\ncontrol. Reports and analyses, not presently available, will\nbe by-products of the new machinery. These include action reports\nshowing agency activities, reports indicating action overdue, and\nreports on and analyses of citizens' views on major issues.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2061,
          "min": -1.294
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 86,
          "mean": -0.0004,
          "min": -0.0093
