        "chars": 296,
        "chars_per_1k_ink": 41.49
      }
    },
    {
      "bbox": [
        143,
        1618,
        1507,
        1687
      ],
      "category": "Text",
      "text": "The four million who are helped here in New York City come from every walk of life, and include many people we know.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2159,
          "min": -1.253
        },
        "category": {
          "n_tokens": 1,
