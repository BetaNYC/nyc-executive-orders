    {
      "bbox": [
        238,
        1627,
        1533,
        1903
      ],
      "category": "Text",
      "text": "All officers and employees of the city are hereby directed to refrain from purchasing any property from the city. The purchase of real estate as well as personal property by employees whose salary is payable in whole or in part from the city treasury, is prohibited by Section 1106 of the Charter and any employee or officer who violates this provision of law is subject to fine, suspension or removal from office and may be subject to prosecution for a misdemeanor.",
      "logprob_stats": {
