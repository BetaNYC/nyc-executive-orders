        1316
      ],
      "category": "Text",
      "text": "SUBJECT: THE 1963 GREATER NEW YORK FUND CAMPAIGN (MAY 1 - JUNE 30)",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2231,
          "min": -1.2124
        },
        "category": {
