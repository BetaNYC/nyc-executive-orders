    {
      "bbox": [
        128,
        1591,
        1547,
        1750
      ],
      "category": "Text",
      "text": "The procedure for processing requests for real property\nspace requirements of the various departments and agencies under my\njurisdiction as outlined in Executive Order No. 24 dated November 27,\n1962 is hereby amended to include the following paragraphs:",
      "logprob_stats": {
        "bbox": {
