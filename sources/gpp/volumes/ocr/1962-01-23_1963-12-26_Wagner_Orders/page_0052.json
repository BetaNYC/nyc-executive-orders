        1159,
        1267,
        1232
      ],
      "category": "Text",
      "text": "SUBJECT: RULES GOVERNING CONDUCT OF OFFICERS AND EMPLOYEES DURING INVESTIGATION OF THEIR CONDUCT",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
