        "chars": 96,
        "chars_per_1k_ink": 11.05
      }
    },
    {
      "bbox": [
        119,
        1299,
        1581,
        1447
      ],
      "category": "Text",
      "text": "Occasionally situations develop which require the presence of City officers or employees before City, County, State or Federal investigating officials or bodies. To keep the City administration informed of such matters and to insure proper action in each such case, the following policy is hereby established:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2728,
          "min": -1.3864
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 52,
          "mean": -0.0026,
          "min": -0.127
        }
      },
      "ink": {
        "ink_px": 24917,
        "area_px": 204300,
        "density": 0.12196,
        "chars": 309,
        "chars_per_1k_ink": 12.4
      }
    },
    {
      "bbox": [
        203,
        1473,
        1494,
        1689
      ],
      "category": "List-item",
      "text": "1. Any officer or employee of the City who is under disciplinary proceedings or who is under investigation by a City, County, State or Federal investigating body or official, or who is summoned to testify before such body or official, under penalty of forfeiting the salary and allowance which may be due him, shall not resign from his position without the approval of the head of the agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2531,
          "min": -1.3952
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 76,
          "mean": -0.0011,
          "min": -0.0668
        }
      },
      "ink": {
        "ink_px": 29675,
        "area_px": 276675,
        "density": 0.10726,
        "chars": 392,
        "chars_per_1k_ink": 13.21
      }
    },
    {
      "bbox": [
        203,
        1714,
        1494,
        1860
      ],
      "category": "List-item",
      "text": "2. If notwithstanding the prohibition in paragraph 1, such officer or employee submits a resignation, it shall not be accepted by the agency head without prior consultation with and approval by the Mayor or a person designated by him.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1737,
          "min": -1.2692
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.0,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 44,
          "mean": -0.0002,
          "min": -0.0057
        }
      },
      "ink": {
        "ink_px": 18166,
        "area_px": 187425,
        "density": 0.09692,
        "chars": 234,
        "chars_per_1k_ink": 12.88
      }
    },
    {
      "bbox": [
        203,
        1887,
        1475,
        2103
      ],
      "category": "List-item",
      "text": "3. All officers and employees who are requested to submit to interview by or who are requested or summoned to appear before or to submit documentary evidence to or to furnish oral testimony before a City, County, State or Federal investigating official or body, or who shall perform any of these acts voluntarily, shall notify the head of the agency forthwith, in writing, of the circumstances.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1899,
          "min": -1.3273
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 75,
          "mean": -0.0001,
          "min": -0.0022
        }
      },
      "ink": {
        "ink_px": 28687,
        "area_px": 272552,
        "density": 0.10525,
        "chars": 394,
        "chars_per_1k_ink": 13.73
      }
    },
    {
      "bbox": [
        200,
        2132,
        1443,
        2242
      ],
      "category": "List-item",
      "text": "4. The agency head shall, upon receipt of information covered in paragraph 3, immediately inform the Mayor or the person designated by him, orally and in writing of the matter.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2592,
          "min": -1.445
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 36,
          "mean": -0.0004,
          "min": -0.0076
        }
      },
      "ink": {
        "ink_px": 13729,
        "area_px": 135864,
        "density": 0.10105,
        "chars": 176,
        "chars_per_1k_ink": 12.82
      }
    },
    {
      "bbox": [
        198,
        2271,
        1459,
        2418
      ],
      "category": "List-item",
      "text": "5. The agency head shall incorporate the substance of paragraphs 1 and 3 in the agency's rules and regulations relating to the conduct of its officers and employees and shall bring these rules to the attention of its officers and employees.",
