    {
      "bbox": [
        288,
        1841,
        1552,
        1981
      ],
      "category": "Text",
      "text": "1. A Council on Expanded Employment Opportunity and Training (to be known as the Mayor's Council on Expanded Employment Opportunity and Training) is hereby established in the Office of the Mayor.",
