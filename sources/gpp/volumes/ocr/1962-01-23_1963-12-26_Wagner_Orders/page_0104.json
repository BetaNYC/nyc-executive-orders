    {
      "bbox": [
        121,
        1488,
        1513,
        1767
      ],
      "category": "Text",
      "text": "It is directed that all requests for space required by\ncity departments or agencies to house their functions be made in\nwriting to the Director of the Budget. These requests will con-\ntain a general description of the functions to be housed, the\ntotal personnel involved, and any special equipment or other unique\nrequirements that may be necessary to perform the particular func-\ntion.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2171,
          "min": -1.5282
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 78,
          "mean": -0.0047,
          "min": -0.3142
        }
      },
      "ink": {
        "ink_px": 9198,
        "area_px": 356841,
        "density": 0.02578,
        "chars": 386,
        "chars_per_1k_ink": 41.97
      }
    },
    {
      "bbox": [
        121,
        1798,
        1495,
        2438
      ],
      "category": "Text",
      "text": "The Bureau of the Budget will confirm the need for the\ndepartment or functional housing requested, including the number\nof personnel allocated to the activity. The request and the\nsupporting data will, upon this initial approval, be forwarded to\nthe Department of Real Estate, for processing and determination\nof the actual amount of space required, the approximate rental\ncost of same including the cost of alterations, and whether this\nactivity should be housed in a public or a private building. This\ninformation will be communicated to the Bureau of the Budget for\ncertification that the amount of space is reasonable and the nec-\nessary funds will be made available. Approval of the expenditure\nby the Bureau of the Budget will be authorization for the Depart-\nment of Real Estate to enter into negotiations for the space in a\nprivate building or to allocate the space in a public building.\n(A lease for space in a private building must be approved by the\nBoard of Estimate before it can be consummated.)",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2393,
          "min": -1.5091
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 206,
          "mean": -0.0045,
          "min": -0.3881
