        "ink_px": 5702,
        "area_px": 293501,
        "density": 0.01943,
        "chars": 387,
        "chars_per_1k_ink": 67.87
      }
    },
    {
      "bbox": [
        101,
        2036,
        1566,
        2177
      ],
      "category": "Text",
      "text": "You are to submit, by November 15, 1963, the name of a qualified, responsible person who will coordinate this changeover for your agency, to Walter J. Detmar, Jr., Director of Operating Services, Department of Public Works, Room 1458, Municipal Building, New York, N.Y. 10007.",
