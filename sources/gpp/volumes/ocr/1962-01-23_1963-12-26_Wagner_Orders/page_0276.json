    {
      "bbox": [
        108,
        1096,
        1648,
        1240
      ],
      "category": "Text",
      "text": "Effective July 1, 1963. I am allowing you to exercise the powers of Section 124a of the New York City Charter, without any limitation, except those provided by law, on the expenditure of funds appropriated to your agency.",
