    {
      "bbox": [
        94,
        1644,
        1643,
        1858
      ],
      "category": "Text",
      "text": "The Director of the Budget has been designated custodian of the master budget. Accordingly, for informational purposes, all modifications and changes in units of appropriations shall be transmitted monthly to the Director of the Budget on forms provided by his office. In addition, all appointments, expenditures etc. are to be reported monthly to the Director of the Budget, on the forms supplied by his office.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2668,
          "min": -1.3318
        },
        "category": {
          "n_tokens": 1,
