    {
      "bbox": [
        297,
        1429,
        1544,
        1739
      ],
      "category": "Text",
      "text": "Intensive discussions and consultations have been held with the Federal Housing and Home Finance Agency and the State Division of Housing and Community Renewal concerning the method of allocation of costs for relocating tenants and managing properties in Urban Renewal projects. This matter was also reviewed with the members of the Board of Estimate and the leadership of the City Council on November 4, 1963 at City Hall.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.211,
          "min": -1.4136
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
