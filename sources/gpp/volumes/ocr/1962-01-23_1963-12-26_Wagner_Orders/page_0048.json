    },
    {
      "bbox": [
        225,
        1570,
        1512,
        1776
      ],
      "category": "Text",
      "text": "WHEREAS, there is pending in the City Council a proposed local law providing for the establishment of a city rent and rehabilitation administration which would constitute the city housing rent agency of the City of New York under the provisions of Chapter 21 of the Laws of 1962 and any amendments thereto, and which proposed local law provides for the regulation and control of residential rents and evictions in this City; and",
      "logprob_stats": {
