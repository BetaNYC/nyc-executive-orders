    {
      "bbox": [
        232,
        1206,
        1965,
        1409
      ],
      "category": "Text",
      "text": "The 1967 legislative program for the City is now being formulated for the State Legislature. All department and agency heads have been requested to appoint one person to coordinate this program in each department.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2344,
          "min": -1.5331
        },
        "category": {
          "n_tokens": 1,
