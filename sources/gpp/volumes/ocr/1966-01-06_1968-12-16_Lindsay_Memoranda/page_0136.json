    },
    {
      "bbox": [
        596,
        1580,
        1881,
        1984
      ],
      "category": "Text",
      "text": "If the appointment is to a position with a salary of $13,000 or more a year, certification by the Commissioner of Investigation that the prospective employee has satisfactorily completed the Department of Investigation's personal history questionnaire must be secured prior to submission of any request for a certificate to fill a vacancy pursuant to Executive Order #5 or a request for a budget modification.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2673,
          "min": -1.4821
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 76,
          "mean": -0.0022,
          "min": -0.1622
        }
      },
      "ink": {
        "ink_px": 1061,
