    },
    {
      "bbox": [
        318,
        1693,
        1855,
        1990
      ],
      "category": "Text",
      "text": "As the first step in a large-scale effort to establish an effective working relationship with the Federal government, I have asked Mr. Drabkin to undertake a detailed survey of all Federal aid received by the City. He will be assisted by Mr. Jay Kriegel, Assistant to the Mayor. This survey is a most important project of my administration and I urge you to give it your prompt attention.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2401,
          "min": -1.3534
        },
        "category": {
