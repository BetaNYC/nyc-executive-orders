    {
      "bbox": [
        323,
        1344,
        1818,
        1642
      ],
      "category": "Text",
      "text": "Last week, I officially opened New York City's office in Washington, D. C. It is located at 1730 K Street, N. W., Suite 319, phone 202-223-6694. Mr. Murray Drabkin, who directed our tax reorganization program, will direct the office. The office is available to assist you in your needs in Washington and for your use if you should be in Washington.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.227,
          "min": -1.1986
        },
        "category": {
          "n_tokens": 1,
