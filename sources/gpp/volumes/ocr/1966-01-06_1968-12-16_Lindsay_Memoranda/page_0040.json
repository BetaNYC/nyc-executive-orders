        1197
      ],
      "category": "Text",
      "text": "SUBJECT: MOTION PICTURE AND TELEVISION PRODUCTION INDUSTRIES",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.236,
          "min": -1.517
        },
        "category": {
          "n_tokens": 1,
