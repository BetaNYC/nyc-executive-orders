      ],
      "category": "Text",
      "text": "SUBJECT: DISASTER PREPAREDNESS PROGRAM - NEW YORK UNIVERSITY",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2668,
