    {
      "bbox": [
        297,
        1176,
        1915,
        1431
      ],
      "category": "Text",
      "text": "Any City official who intends to testify before the Congress, to submit a statement, or to take any other official position on a Federal matter of concern to the City is to submit to Mr. Drabkin a copy of his remarks or statement 5 days in advance of transmittal to the Federal government.",
      "logprob_stats": {
