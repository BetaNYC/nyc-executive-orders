    {
      "bbox": [
        277,
        1260,
        1911,
        1444
      ],
      "category": "Text",
      "text": "Your attention is called to the provisions of Section 1105 of the New York City Charter as amended by Local Law No. 51, approved by Mayor Lindsay on December 21, 1966. The significant changes, effective January 20, 1967, are as follows.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.292,
          "min": -1.5814
        },
        "category": {
          "n_tokens": 1,
