        }
      },
      "ink": {
        "ink_px": 28936,
        "area_px": 357469,
        "density": 0.08095,
        "chars": 326,
        "chars_per_1k_ink": 11.27
      }
    },
    {
      "bbox": [
        162,
        2117,
        1887,
        2250
      ],
      "category": "Text",
      "text": "Although every department must submit proposed economies, all department heads are asked to identify those economies which will imperil basic City services.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2602,
          "min": -1.3548
        },
        "category": {
