        1082,
        876
      ],
      "category": "Text",
      "text": "TO: All Department and Agency Heads\n\nRE: Budget Economy Review\n\nDATE: January 19, 1966",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.415,
          "min": -1.7829
        },
        "category": {
          "n_tokens": 1,
