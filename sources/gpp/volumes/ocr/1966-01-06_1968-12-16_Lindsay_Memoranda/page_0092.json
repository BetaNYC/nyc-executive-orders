        "density": 0.06468,
        "chars": 341,
        "chars_per_1k_ink": 10.81
      }
    },
    {
      "bbox": [
        216,
        2073,
        1875,
        2177
      ],
      "category": "Text",
      "text": "You should also know that the Legislature is driving toward adjournment _sine die_ in late March.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2391,
          "min": -1.4903
        },
        "category": {
          "n_tokens": 1,
