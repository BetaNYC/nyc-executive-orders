    {
      "bbox": [
        272,
        1470,
        1800,
        1649
      ],
      "category": "Text",
      "text": "Enclosed you will find a copy of Executive Order No. 25 signed by the Mayor on August 1, 1966, which prescribes the procedure to be followed in the procurement of space for municipal departments and agencies.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1912,
          "min": -0.8598
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 49,
          "mean": -0.0002,
