    },
    {
      "bbox": [
        144,
        2647,
        2475,
        2921
      ],
      "category": "Text",
      "text": "We should not become fundraisers for the main effort conducted in New York State, Inc., 50 Rockefeller Plaza. However, if you are approached by individuals or corporations wishing to contribute, you might inform them that checks can be made payable to the Action group.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2255,
          "min": -1.6313
        },
        "category": {
