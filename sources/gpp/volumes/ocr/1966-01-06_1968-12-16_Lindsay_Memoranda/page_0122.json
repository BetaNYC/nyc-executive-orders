    },
    {
      "bbox": [
        144,
        2380,
        2498,
        2594
      ],
      "category": "Text",
      "text": "It would be helpful if you would actively seek opportunities to address civic, fraternal, and religious groups. Please alert me to any possibilities, so that I can try to send a speaker. If you want to speak but have no forum, let me know.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1945,
          "min": -1.4703
        },
        "category": {
          "n_tokens": 1,
