    {
      "bbox": [
        249,
        1311,
        1945,
        1489
      ],
      "category": "Text",
      "text": "Executive Order Number 21, dated October 8, 1962, requires heads of departments or agencies, considering plans for an official trip, to request \"as far in advance as possible\" permission for these trips.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2826,
