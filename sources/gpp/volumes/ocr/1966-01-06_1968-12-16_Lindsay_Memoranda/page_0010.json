    },
    {
      "bbox": [
        249,
        1529,
        1737,
        1663
      ],
      "category": "Text",
      "text": "Official trips undertaken on City time and/or City expense, are extremely useful when done in the line of professional activity.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.248,
          "min": -1.4616
        },
        "category": {
          "n_tokens": 1,
