        "density": 2e-05,
        "chars": 295,
        "chars_per_1k_ink": 36875.0
      }
    },
    {
      "bbox": [
        238,
        1991,
        1871,
        2174
      ],
      "category": "Text",
      "text": "If the above is not followed, all correspondence will be sent back to the originator for completion. If it is not possible to determine from where the documents originated, they will be held until confirmation is received.",
