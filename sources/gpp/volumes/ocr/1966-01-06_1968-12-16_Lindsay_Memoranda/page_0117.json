        "chars": 88,
        "chars_per_1k_ink": 88000.0
      }
    },
    {
      "bbox": [
        238,
        1687,
        1895,
        1951
      ],
      "category": "List-item",
      "text": "2. When preparing such documents, a white file copy, a yellow file copy and all backup <u>must be attached</u>. This will all be sent to the Mayor's central files and will be used as our permanent records. In addition, all file copies <u>must have</u> the name of the writer clearly in evidence.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2608,
          "min": -1.522
        },
        "category": {
          "n_tokens": 2,
