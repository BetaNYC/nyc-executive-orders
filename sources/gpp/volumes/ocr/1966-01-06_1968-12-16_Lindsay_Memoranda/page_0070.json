    {
      "bbox": [
        297,
        1325,
        1999,
        1494
      ],
      "category": "Text",
      "text": "On August 2, 1966, I appointed a group of 20 outstanding citizens to serve as the Mayor's Amusement-Resort Advisory Committee, functioning under the general direction of Joel J. Tyler, Commissioner of Licenses.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.221,
