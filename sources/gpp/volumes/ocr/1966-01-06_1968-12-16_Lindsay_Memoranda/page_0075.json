        "density": 0.00525,
        "chars": 423,
        "chars_per_1k_ink": 140.62
      }
    },
    {
      "bbox": [
        335,
        1538,
        1836,
        1692
      ],
      "category": "Text",
      "text": "Although this prohibition against acceptance of gifts applies throughout the year, special measures must be taken to prevent violations during the holiday season.",
      "logprob_stats": {
