        "chars": 529,
        "chars_per_1k_ink": 5.87
      }
    },
    {
      "bbox": [
        338,
        1871,
        1956,
        2076
      ],
      "category": "Text",
      "text": "Additionally, the Vehicular Control Board will also review the necessity of filling any motor vehicle operator vacancies that may occur in the reassignment of motor vehicle operators to a centralized pool.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2664,
          "min": -1.4424
