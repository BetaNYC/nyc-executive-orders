    },
    {
      "bbox": [
        284,
        1572,
        1993,
        1715
      ],
      "category": "Text",
      "text": "All recommendations of the conference are to get full and detailed consideration; they are to be implemented to the full extent of available resources; and this follow-up process is to begin now.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2485,
