    {
      "bbox": [
        173,
        1390,
        1907,
        1702
      ],
      "category": "Text",
      "text": "Accordingly, any proposals to be submitted to the Constitutional Convention must be forwarded to Deputy Mayor Robert W. Sweet at City Hall no later than May 24, 1967. These will then be transmitted to the Mayor's Task Force on the Constitutional Convention for evaluation. All proposals should be in form proper for submission and should be accompanied by supporting memoranda. Twenty copies of each should be forwarded.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2172,
          "min": -1.3926
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 83,
          "mean": -0.0002,
          "min": -0.0053
        }
      },
      "ink": {
        "ink_px": 6746,
        "area_px": 509936,
        "density": 0.01323,
        "chars": 420,
        "chars_per_1k_ink": 62.26
      }
    },
    {
      "bbox": [
        173,
        1742,
        1929,
        1970
      ],
      "category": "Text",
      "text": "All reports on propositions referred for comment by the office of the Legislative Representative should be made within five days of the receipt of the printed proposition to that office, 111 Washington Avenue, Albany, New York, with a carbon copy to Deputy Mayor Sweet.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2004,
          "min": -1.1994
