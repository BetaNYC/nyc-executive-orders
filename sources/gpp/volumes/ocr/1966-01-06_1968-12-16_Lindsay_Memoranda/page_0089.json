        "chars": 99,
        "chars_per_1k_ink": 5.92
      }
    },
    {
      "bbox": [
        357,
        1692,
        1599,
        1920
      ],
      "category": "List-item",
      "text": "3. Permit vacancy control by Budget to be changed from a system requiring individual consideration of each filling to one which would permit filling of all lower vacancies within limits negotiated by each agency;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
