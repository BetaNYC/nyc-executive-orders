    {
      "bbox": [
        164,
        1209,
        1765,
        1355
      ],
      "category": "Text",
      "text": "The success of the reorganization of the government demands central control over all appointments at a policy making level, especially during the interim period. This control is necessary to:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.212,
          "min": -1.4183
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 33,
          "mean": -0.0035,
          "min": -0.1157
        }
      },
      "ink": {
        "ink_px": 26556,
