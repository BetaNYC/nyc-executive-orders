          "min": -0.0009
        }
      },
      "ink": {
        "ink_px": 18737,
        "area_px": 161322,
        "density": 0.11615,
        "chars": 113,
        "chars_per_1k_ink": 6.03
      }
    },
    {
      "bbox": [
        357,
        1561,
        1623,
        1658
      ],
      "category": "List-item",
      "text": "2. Prevent the establishment of new positions without corresponding elimination of other positions;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2153,
          "min": -1.4803
        },
