        "density": 0.12273,
        "chars": 191,
        "chars_per_1k_ink": 7.19
      }
    },
    {
      "bbox": [
        357,
        1384,
        1529,
        1521
      ],
      "category": "List-item",
      "text": "1. Allow only essential executive positions to be established during the time the proposals are being considered;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2595,
          "min": -1.4557
        },
        "category": {
