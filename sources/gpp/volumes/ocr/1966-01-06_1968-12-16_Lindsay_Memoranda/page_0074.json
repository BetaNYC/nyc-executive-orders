        "chars_per_1k_ink": 8.47
      }
    },
    {
      "bbox": [
        321,
        1689,
        1964,
        1925
      ],
      "category": "Text",
      "text": "Any worthwhile venture undertaken must be properly managed and successfully concluded. I, therefore, urge that you follow through on this in your department, or agency, if you have not already done so. Call in your United Negro College campaign managers, reimpress them, reinstruct them and remind them to report back.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.275,
          "min": -1.5028
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0009,
          "min": -0.0009
        },
        "text": {
          "n_tokens": 61,
