    },
    {
      "bbox": [
        327,
        1467,
        1873,
        1677
      ],
      "category": "Text",
      "text": "I know that you must share my interest in helping the thirty-three desegregated colleges contributed to by the United Negro College Fund. Hundreds of New York City residents who may otherwise be unable to acquire higher education are doing so in these accredited institutions.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2805,
          "min": -1.67
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 50,
          "mean": -0.0005,
          "min": -0.0115
        }
      },
      "ink": {
        "ink_px": 32571,
