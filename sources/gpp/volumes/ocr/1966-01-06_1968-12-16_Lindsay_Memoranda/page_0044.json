    {
      "bbox": [
        334,
        1302,
        1606,
        1343
      ],
      "category": "Text",
      "text": "RE: THE USE OF CITY CARS AND MOTOR VEHICLE OPERATORS",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2212,
          "min": -1.3892
        },
