    },
    {
      "bbox": [
        197,
        1691,
        2035,
        1942
      ],
      "category": "Text",
      "text": "It is urgent that you mail your opinion and position within two (2) days after you receive the bill and that you address it directly to Paul J. Curran, Legislative Representative, Room 203, 111 Washington Avenue, Albany, N.Y., 12210. Delay in responding could result in the enactment of legislation highly unfavorable to the City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1704,
          "min": -1.3123
        },
        "category": {
