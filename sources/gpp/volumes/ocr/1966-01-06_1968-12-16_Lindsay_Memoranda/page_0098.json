    {
      "bbox": [
        197,
        1440,
        2032,
        1643
      ],
      "category": "Text",
      "text": "In order that the Governor may receive New York City's position during this period, I have instructed my Legislative Representative, Paul J. Curran, to mail you a copy of each bill that might affect your department or agency, stamped \"Bill before the Governor\".",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1965,
          "min": -1.2533
        },
        "category": {
          "n_tokens": 1,
