      ],
      "category": "Text",
      "text": "TO: HEADS OF ALL CITY DEPARTMENTS AND AGENCIES\n\nFROM: MAYOR JOHN V. LINDSAY\n\nSUBJECT: 1966 U. S. SAVINGS BONDS CAMPAIGN",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3575,
          "min": -1.5769
        },
        "category": {
          "n_tokens": 1,
