        "ink_px": 36303,
        "area_px": 460922,
        "density": 0.07876,
        "chars": 421,
        "chars_per_1k_ink": 11.6
      }
    },
    {
      "bbox": [
        190,
        2268,
        1903,
        2409
      ],
      "category": "Text",
      "text": "Vacancies and promotions are here **NOW!** You'll be eligible to qualify for a commission in the Reserve Corps, besides taking advantage of the many educational benefits the Reserve offers to you.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1929,
          "min": -1.126
        },
        "category": {
