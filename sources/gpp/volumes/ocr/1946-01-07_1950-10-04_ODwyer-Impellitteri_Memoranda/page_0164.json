          "min": -0.207
        }
      },
      "ink": {
        "ink_px": 16048,
        "area_px": 227010,
        "density": 0.07069,
        "chars": 196,
        "chars_per_1k_ink": 12.21
      }
    },
    {
      "bbox": [
        186,
        2450,
        1863,
        2644
      ],
      "category": "Text",
      "text": "And, you really get the full benefit of a day's pay. No need to spend fancy prices for your meal on meeting nights. You can eat your meal right here at the Port - excellent food, the cost for a full-course dinner is only 35¢ per person.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.17,
          "min": -1.149
        },
        "category": {
          "n_tokens": 1,
