        "density": 0.03474,
        "chars": 73,
        "chars_per_1k_ink": 18.41
      }
    },
    {
      "bbox": [
        271,
        1157,
        1905,
        1379
      ],
      "category": "Text",
      "text": "There have been a variety of requests from City employee groups for general salary increases based on the rise in the cost of living. Since such general increases can only be granted within the framework of the City's financial ability to pay, it is my desire, at this time, to have such requests handled on an over-all, City-wide basis.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2339,
          "min": -1.4841
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 68,
          "mean": -0.0024,
          "min": -0.1459
        }
      },
      "ink": {
        "ink_px": 15632,
        "area_px": 357642,
        "density": 0.04371,
        "chars": 337,
        "chars_per_1k_ink": 21.56
      }
    },
    {
      "bbox": [
        271,
        1426,
        1885,
        1514
      ],
      "category": "Text",
      "text": "Therefore, in connection with such requests for general salary increases, the following procedure shall be observed:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2085,
          "min": -1.3614
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 19,
          "mean": -0.0003,
          "min": -0.0029
        }
      },
      "ink": {
        "ink_px": 6285,
        "area_px": 140008,
        "density": 0.04489,
        "chars": 116,
        "chars_per_1k_ink": 18.46
      }
    },
    {
      "bbox": [
        271,
        1560,
        1820,
        1648
      ],
      "category": "Text",
      "text": "1. They shall be taken up with the respective Commissioners or Department Heads.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2006,
          "min": -1.0492
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.062,
          "min": -0.062
        },
        "text": {
          "n_tokens": 15,
          "mean": -0.0003,
          "min": -0.0023
        }
      },
      "ink": {
        "ink_px": 4263,
        "area_px": 135814,
        "density": 0.03139,
        "chars": 80,
        "chars_per_1k_ink": 18.77
      }
    },
    {
      "bbox": [
        271,
        1693,
        1865,
        1786
      ],
      "category": "Text",
      "text": "2. The Commissioners or Department Heads shall thereupon examine the requests.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1904,
          "min": -1.363
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 14,
          "mean": -0.0006,
          "min": -0.0032
        }
      },
      "ink": {
        "ink_px": 4385,
        "area_px": 146103,
        "density": 0.03001,
        "chars": 78,
        "chars_per_1k_ink": 17.79
      }
    },
    {
      "bbox": [
        271,
        1828,
        1940,
        2240
      ],
      "category": "Text",
      "text": "3. Thereupon, such requests together with such comments and recommendations as the Commissioner or Department Head may desire to make, shall immediately be referred to the Special Temporary Committee, which I am hereby creating, and which shall consist of Budget Director Thomas Patterson, Commissioner William Reid, and a representative of the Division of Labor Relations of the City. This Committee shall expeditiously make a full report to me which shall indicate whether and what City funds are available to meet such requests and the extent to which such requests may and should be adopted.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.182,
          "min": -1.2392
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 106,
          "mean": -0.0005,
          "min": -0.0431
        }
      },
      "ink": {
        "ink_px": 30032,
        "area_px": 676506,
        "density": 0.04439,
        "chars": 595,
        "chars_per_1k_ink": 19.81
      }
    },
    {
      "bbox": [
        271,
        2276,
        2030,
        2425
      ],
      "category": "Text",
      "text": "This Committee shall confine its deliberations solely to the matter of requests for general salary increases and shall not consider any individual salary adjustments.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1891,
          "min": -1.4598
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 27,
