    {
      "bbox": [
        271,
        1023,
        1685,
        1104
      ],
      "category": "Text",
      "text": "SUBJECT: Requests from City employee groups for general salary increases.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2282,
          "min": -1.264
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 13,
          "mean": -0.0185,
