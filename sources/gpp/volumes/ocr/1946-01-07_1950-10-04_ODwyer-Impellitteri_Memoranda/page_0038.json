        "density": 0.10598,
        "chars": 294,
        "chars_per_1k_ink": 8.13
      }
    },
    {
      "bbox": [
        585,
        1890,
        1823,
        2081
      ],
      "category": "Text",
      "text": "\"........The scope of the drive does not encompass scrap in the homes throughout the nation, but it is intended to strike at the large deposits of scrap which can quickly be placed in the material pipeline.\"",
      "logprob_stats": {
        "bbox": {
