    {
      "bbox": [
        350,
        1221,
        1961,
        1547
      ],
      "category": "Text",
      "text": "The Civilian Production Administration is presently conducting a nation-wide drive to increase the flow of iron and steel scrap to the mills. In connection with its campaign, the CPA has sent a letter to the Governor, from which the following excerpts are quoted:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3201,
          "min": -1.4345
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 49,
          "mean": -0.0053,
          "min": -0.2533
        }
      },
      "ink": {
        "ink_px": 29958,
        "area_px": 525489,
        "density": 0.05701,
        "chars": 263,
        "chars_per_1k_ink": 8.78
      }
    },
    {
      "bbox": [
        580,
        1577,
        1797,
        1856
      ],
      "category": "Text",
      "text": "\"Steel production is absolutely dependent on scrap and the present acute shortage of iron and steel scrap now threatens to reduce materially the output of the steel industry. Unless increased supplies of scrap can be secured promptly, many open-hearth furnaces will shut down for lack of scrap.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2807,
          "min": -1.4117
        },
        "category": {
          "n_tokens": 1,
