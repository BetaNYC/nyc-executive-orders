    },
    {
      "bbox": [
        366,
        2103,
        1921,
        2270
      ],
      "category": "Text",
      "text": "Governor Dewey has requested the cooperation of all municipalities within the State in this national campaign.",
      "logprob_stats": {
        "bbox": {
