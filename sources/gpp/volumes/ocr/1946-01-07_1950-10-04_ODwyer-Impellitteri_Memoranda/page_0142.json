    {
      "bbox": [
        166,
        513,
        1916,
        931
      ],
      "category": "Text",
      "text": "In the event of a sudden disaster or emergency, endangering, or likely to endanger the life or health of a considerable number of people, it is of the utmost importance that the activities of city departments, boards, offices and cooperating agencies be closely coordinated at the scene of the emergency.",
      "logprob_stats": {
