    {
      "bbox": [
        391,
        1244,
        1951,
        2013
      ],
      "category": "Text",
      "text": "Because an ample supply of blood for transfusions and other medical purposes will be an important factor in civilian defense and because we can anticipate a call for blood for the armed services, I have named Dr. Samuel Frant, First Deputy Commissioner of the Department of Health, chairman of a municipal employees committee and instructed him to begin enrolling blood donors immediately among City employees. Dr. Frant will work with the Red Cross Blood Program which will handle the actual collection of blood from donors and process it.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2618,
          "min": -1.5975
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 99,
