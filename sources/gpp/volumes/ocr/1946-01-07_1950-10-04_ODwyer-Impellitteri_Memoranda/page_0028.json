    {
      "bbox": [
        412,
        1289,
        1929,
        1605
      ],
      "category": "Text",
      "text": "On next Wednesday afternoon, June 5th, at 5:00 P.M., at City Hall Plaza, the Joint Committee of Civil Service Employees will join the Citizens' Committee to Save CPA in holding a meeting to urge Congress to retain price and rent controls. I feel that the preservation of price and rent controls is especially necessary for the thousands of Civil Service workers who live on fixed incomes derived from a fixed municipal budget.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3076,
          "min": -1.4671
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 86,
          "mean": -0.0017,
          "min": -0.0824
        }
      },
      "ink": {
        "ink_px": 18947,
        "area_px": 480636,
        "density": 0.03942,
        "chars": 426,
        "chars_per_1k_ink": 22.48
      }
    },
    {
      "bbox": [
        415,
        1646,
        1932,
        2057
      ],
      "category": "Text",
      "text": "I would appreciate your cooperation in making it possible for each and every one of the employees of your Department not then engaged in official duties to be present, allowing them sufficient time to get to the meeting from their place of work. It would be very helpful if you facilitated in every way possible the work of the representatives of the Joint Committee in distributing circulars of the meeting and, in other ways, indicating to the employees of your Department your personal interest in this important problem.",
