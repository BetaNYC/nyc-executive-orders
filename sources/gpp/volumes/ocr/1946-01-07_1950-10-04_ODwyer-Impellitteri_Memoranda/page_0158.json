    {
      "bbox": [
        226,
        1613,
        1929,
        1757
      ],
      "category": "Text",
      "text": "I have directed the Department of Welfare to set up a new foster home program which will supplement the work of the private agencies which are now giving this service.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.223,
