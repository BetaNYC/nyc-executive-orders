    {
      "bbox": [
        270,
        631,
        1790,
        1039
      ],
      "category": "Text",
      "text": "In the cases stated, the employee would be absent on the holidays *not* because the days are Memorial Day or Armistice Day but, in the one case, because the employee is not working for the City when the holidays occur or, in the other case, because the days are Saturdays.",
      "logprob_stats": {
