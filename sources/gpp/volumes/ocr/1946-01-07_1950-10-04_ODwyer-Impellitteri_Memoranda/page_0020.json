    {
      "bbox": [
        358,
        997,
        1990,
        1185
      ],
      "category": "Text",
      "text": "Section B40-4.0 Officers and employees to be residents. - a. Any office or position, compensation for which is payable solely or in part from funds of the city, shall be filled only by a person who is a citizen and bona fide resident and dweller of the city for at least three years.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3704,
          "min": -1.7402
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0263,
          "min": -0.0263
        },
        "text": {
