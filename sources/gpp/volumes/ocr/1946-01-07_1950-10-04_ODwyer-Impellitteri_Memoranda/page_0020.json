        "chars_per_1k_ink": 11.2
      }
    },
    {
      "bbox": [
        364,
        1180,
        1930,
        1410
      ],
      "category": "Text",
      "text": "b. A person who is not a citizen and bona fide resident or dweller of the city for three years, may be appointed to a temporary position for which peculiar or exceptional qualifications of a scientific, professional or technical character are necessary. In such cases, evidence in writing shall be furnished:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
