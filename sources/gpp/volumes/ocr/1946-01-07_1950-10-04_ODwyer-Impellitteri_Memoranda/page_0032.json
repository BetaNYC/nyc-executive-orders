      "bbox": [
        408,
        1210,
        1920,
        1434
      ],
      "category": "Text",
      "text": "FROM: Thomas L. J. Corcoran, Deputy Mayor\n\nTO: Heads of all Mayor's Departments and Agencies\n\nSUBJECT: State legislation for Departments and Agencies",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3181,
          "min": -1.529
        },
        "category": {
          "n_tokens": 1,
