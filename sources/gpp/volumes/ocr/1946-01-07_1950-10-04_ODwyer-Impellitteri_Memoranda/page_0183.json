        "density": 0.0403,
        "chars": 231,
        "chars_per_1k_ink": 10.01
      }
    },
    {
      "bbox": [
        316,
        1816,
        2046,
        2070
      ],
      "category": "Text",
      "text": "Mr. Schriftgiesser's article should serve as an excellent sales manual for all of us who would like to tell the rest of the world exactly why New York is a truly wonderful town to live in, to work in, to visit.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2942,
          "min": -1.5464
        },
        "category": {
