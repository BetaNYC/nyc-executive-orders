    {
      "bbox": [
        312,
        1460,
        2015,
        1794
      ],
      "category": "Text",
      "text": "The article, written by Karl Schriftgiesser, is an outstanding piece of promotional literature for the City of New York. All of us who are proud of our City, particularly those responsible for its operation, should read this story.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.3165,
          "min": -1.6455
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0141,
          "min": -0.6339
        }
      },
      "ink": {
        "ink_px": 23072,
