        "ink_px": 11604,
        "area_px": 329581,
        "density": 0.03521,
        "chars": 219,
        "chars_per_1k_ink": 18.87
      }
    },
    {
      "bbox": [
        284,
        1758,
        1983,
        2001
      ],
      "category": "List-item",
      "text": "WHEREAS it is fitting on this day that the people of the City of New York pause to reflect upon the past five decades of achievements made possible by consolidation and to take inspiration therefrom for even greater progress and expansion in the future,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2659,
          "min": -1.6688
        },
        "category": {
          "n_tokens": 2,
