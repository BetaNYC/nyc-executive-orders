        1293,
        955
      ],
      "category": "Text",
      "text": "Section 1. Office of Director for Homeless and Single Room\nOccupancy Housing Services Established. There is established in\nthe Office of the Mayor the Office for Homeless and Single Room\nOccupancy Services, headed by the Director for Homeless and Single\nRoom Occupancy Housing Services (the \"Director\").",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2383,
          "min": -1.2629
        },
        "category": {
          "n_tokens": 1,
