        "chars": 238,
        "chars_per_1k_ink": 18.53
      }
    },
    {
      "bbox": [
        231,
        1521,
        1395,
        1610
      ],
      "category": "Text",
      "text": "NOW THEREFORE, by the power vested in me as Mayor of the City of New York, it hereby is ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2378,
          "min": -1.3232
        },
        "category": {
          "n_tokens": 1,
