    },
    {
      "bbox": [
        231,
        1641,
        1455,
        1894
      ],
      "category": "Text",
      "text": "Section 1. Establishment of the Task Force. There hereby is established the Mayor's Advisory Task Force on the City University of New York (the \"Task Force\"). The Task Force shall include members appointed by the Mayor, who shall be residents of the City of New York or shall maintain a place of business in the City of New York. The Mayor, at his discretion, may appoint a Chair of the Task Force. Members of the Task Force shall serve without compensation.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2479,
          "min": -1.5886
        },
        "category": {
          "n_tokens": 1,
