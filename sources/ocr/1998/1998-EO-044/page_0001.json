        "density": 0.04587,
        "chars": 97,
        "chars_per_1k_ink": 16.43
      }
    },
    {
      "bbox": [
        243,
        1599,
        1470,
        1783
      ],
      "category": "Text",
      "text": "Section 1. As soon as the transfer of school security and ancillary functions\ncurrently performed by the Division of School Safety of the Board of Education is\neffectuated pursuant to the terms and conditions of the MOU dated September 17, 1998, the\nNYPD shall assume such functions, consistent with such terms and conditions.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2455,
          "min": -1.4402
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.3135,
          "min": -0.3135
        },
        "text": {
