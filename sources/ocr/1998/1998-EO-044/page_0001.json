        "density": 0.07412,
        "chars": 156,
        "chars_per_1k_ink": 17.22
      }
    },
    {
      "bbox": [
        243,
        1477,
        1473,
        1581
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of\nNew York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2557,
          "min": -1.3514
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
