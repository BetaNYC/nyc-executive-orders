          "min": -0.2913
        }
      },
      "ink": {
        "ink_px": 17316,
        "area_px": 225032,
        "density": 0.07695,
        "chars": 326,
        "chars_per_1k_ink": 18.83
      }
    },
    {
      "bbox": [
        245,
        1803,
        1473,
        2072
      ],
      "category": "Text",
      "text": "\u00a7 2. The Commissioner of Citywide Administrative Services and the Police\nCommissioner shall take all steps necessary, consistent with applicable law, to implement\nSection 1 of this Order, including ensuring the transfer, currently scheduled for December\n20, 1998, from the Division of School Safety of necessary employees substantially engaged\nin the performance of school security and ancillary functions of the Division, except as may\nbe otherwise provided in accordance with Section 8 of such MOU.",
