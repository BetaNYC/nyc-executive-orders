    {
      "bbox": [
        241,
        1117,
        1469,
        1340
      ],
      "category": "Text",
      "text": "WHEREAS, the Board of Education and the City of New York have entered\ninto a Memorandum of Understanding (\"MOU\"), dated September 17, 1998, containing the\nterms and conditions of a transfer of school security and ancillary functions currently\nperformed by the Division of School Safety of the Board of Education to the New York\nCity Police Department; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2574,
          "min": -1.2388
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 83,
          "mean": -0.0043,
          "min": -0.3486
        }
      },
      "ink": {
        "ink_px": 22877,
        "area_px": 272952,
        "density": 0.08381,
        "chars": 355,
        "chars_per_1k_ink": 15.52
      }
    },
    {
      "bbox": [
        241,
        1360,
        1467,
        1459
      ],
      "category": "Text",
      "text": "WHEREAS, such MOU has provided for such transfer to take place on\nNovember 1, 1998 or as soon as practicable thereafter, but not later than January 1, 1999;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2624,
          "min": -1.3521
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0007,
          "min": -0.0186
        }
      },
