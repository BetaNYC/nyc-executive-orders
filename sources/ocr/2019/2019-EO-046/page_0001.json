        1482,
        1102
      ],
      "category": "Text",
      "text": "WHEREAS, the Disaster Mitigation Act of 2000, Public Law 106-390 (\"the Act\"), establishes a national disaster hazard mitigation program to reduce the loss of life and property, human suffering, economic disruption, and disaster assistance costs resulting from natural disasters, and to assist state, local, and Indian tribal governments in implementing effective hazard mitigation measures designed to ensure the continuation of critical services and facilities after a natural disaster; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2479,
          "min": -1.2544
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 95,
          "mean": -0.0011,
          "min": -0.0815
        }
      },
      "ink": {
        "ink_px": 50627,
        "area_px": 324360,
        "density": 0.15608,
        "chars": 491,
        "chars_per_1k_ink": 9.7
      }
    },
    {
      "bbox": [
        195,
        1143,
        1490,
        1311
      ],
      "category": "Text",
      "text": "WHEREAS, the Act requires such governments to develop hazard mitigation plans to identify the natural hazards that could impact their jurisdictions, identify actions and activities to mitigate the effects of those hazards, and establish a coordinated process to implement such plans; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2189,
          "min": -1.177
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0,
          "min": -0.0004
        }
      },
      "ink": {
        "ink_px": 30008,
        "area_px": 215040,
        "density": 0.13955,
        "chars": 287,
        "chars_per_1k_ink": 9.56
      }
    },
    {
      "bbox": [
        197,
        1350,
        1458,
        1472
      ],
      "category": "Text",
      "text": "WHEREAS, the Act requires local governments to update such plans every five years and submit such updated plans to the Federal Emergency Management Agency (\"FEMA\") for approval; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2137,
          "min": -1.1891
        },
        "category": {
          "n_tokens": 1,
