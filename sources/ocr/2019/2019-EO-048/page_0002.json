    },
    {
      "bbox": [
        205,
        842,
        1497,
        993
      ],
      "category": "Text",
      "text": "\u00a7 3. Transfer of Employees. (a) All steps necessary, consistent with\napplicable law, to implement this Order, including ensuring the transfer, pursuant to section\n70(2) of the Civil Service Law, of necessary employees substantially engaged in the\nperformance of the functions to be assumed pursuant to this Order.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2481,
          "min": -1.3012
        },
        "category": {
          "n_tokens": 1,
