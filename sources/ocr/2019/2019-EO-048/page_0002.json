    {
      "bbox": [
        205,
        593,
        1497,
        783
      ],
      "category": "Text",
      "text": "\u00a7 2. Disposition of Contracts and Agreements. To the extent practicable,\nprior to the date of the transfer of functions, ACS and DOE may make arrangements, with\nthe purpose of ensuring continuity in monitoring, coordinating, and providing support to\nthe EarlyLearn Contracted Services, with respect to appropriate disposition of contracts and\nagreements entered into by ACS for the benefit of the system.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2813,
          "min": -1.3631
        },
        "category": {
