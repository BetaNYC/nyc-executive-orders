    },
    {
      "bbox": [
        180,
        1125,
        1475,
        1235
      ],
      "category": "Text",
      "text": "WHEREAS, the City is committed to providing a coordinated program to\ncombat substance abuse and other mental, emotional and social problems of its employees\nin a humane and constructive manner; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2174,
          "min": -1.2605
        },
        "category": {
          "n_tokens": 1,
