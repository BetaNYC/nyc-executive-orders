        "chars": 197,
        "chars_per_1k_ink": 10.36
      }
    },
    {
      "bbox": [
        180,
        1280,
        1473,
        1356
      ],
      "category": "Text",
      "text": "WHEREAS, experience indicates that Employee Assistance Programs (EAPs) constitute an effective means for ameliorating such problems; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2205,
          "min": -1.2286
        },
        "category": {
          "n_tokens": 1,
