      }
    },
    {
      "bbox": [
        180,
        1399,
        1473,
        1552
      ],
      "category": "Text",
      "text": "WHEREAS, the City recognizes that EAPs represent an investment in the\nimproved productivity of its workforce, and therefore encourages its employees to utilize\nEAP services when they experience problems related to substance abuse or other mental,\nemotional or social problems;",
      "logprob_stats": {
