    {
      "bbox": [
        180,
        971,
        1477,
        1083
      ],
      "category": "Text",
      "text": "WHEREAS, it has long been recognized that substance abuse and other\nmental, emotional and social problems have a serious impact on the health, welfare and\nsocial life of the individual, the individual's family, co-workers and the community; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2485,
          "min": -1.2474
        },
        "category": {
