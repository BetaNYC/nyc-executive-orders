    {
      "bbox": [
        179,
        987,
        1485,
        1063
      ],
      "category": "Text",
      "text": "WHEREAS, fair housing and fair lending is essential to the City's growth and\nprosperity; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2572,
          "min": -1.3306
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 23,
          "mean": -0.0064,
