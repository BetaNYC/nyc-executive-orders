        "chars_per_1k_ink": 10.41
      }
    },
    {
      "bbox": [
        184,
        1720,
        1489,
        1792
      ],
      "category": "Text",
      "text": "NOW THEREFORE, by the power vested in me as Mayor of the City of New\nYork it is hereby ordered:",
