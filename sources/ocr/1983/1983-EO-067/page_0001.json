          "min": -0.633
        }
      },
      "ink": {
        "ink_px": 25745,
        "area_px": 185955,
        "density": 0.13845,
        "chars": 268,
        "chars_per_1k_ink": 10.41
      }
    },
    {
      "bbox": [
        285,
        1317,
        1423,
        1413
      ],
      "category": "Text",
      "text": "Section 3. Annual Report. The Office shall report\nannually to the Mayor on its activities and shall prepare\nsuch other reports as the Mayor shall request.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.245,
          "min": -1.4776
        },
