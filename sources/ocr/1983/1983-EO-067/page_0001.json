      "bbox": [
        282,
        861,
        1338,
        923
      ],
      "category": "Text",
      "text": "By the power vested in me as Mayor of the City of\nNew York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2719,
          "min": -1.3054
        },
