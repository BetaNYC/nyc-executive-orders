    {
      "bbox": [
        282,
        960,
        1419,
        1083
      ],
      "category": "Text",
      "text": "Section 1. Office Established. The New York City\nEnergy Office (the \"Office\") is hereby established in the\nOffice of the Mayor. The Office shall be headed by a\nDirector.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2288,
          "min": -1.1322
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.1798,
          "min": -0.1798
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0188,
          "min": -0.631
        }
      },
      "ink": {
        "ink_px": 15869,
        "area_px": 140616,
        "density": 0.11285,
        "chars": 169,
        "chars_per_1k_ink": 10.65
      }
    },
    {
      "bbox": [
        282,
        1122,
        1440,
        1281
      ],
      "category": "Text",
      "text": "Section 2. Responsibilities. The Office shall, as\npart of its duties, exercise all of the functions, powers\nand duties of the Public Utility Service established by\nLocal Law No. 78 of 1982 in accordance with the provisions\nof Article 14-A of the General Municipal Law.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2391,
          "min": -1.3491
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 66,
