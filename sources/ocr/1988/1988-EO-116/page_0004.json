    {
      "bbox": [
        341,
        967,
        1537,
        1201
      ],
      "category": "Text",
      "text": "Local Law No. 60, which transferred responsibility for employee occupational safety and health programs from the Department of Personnel to the Mayor's Office of Operations, was enacted in August 1987. I have now amended Executive Order No. 30, which outlines agency responsibilities in this area, to place responsibility of the Citywide Occupational Safety and Health Committee with the Office of Operations.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2698,
          "min": -1.3368
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 79,
          "mean": -0.0036,
          "min": -0.2815
        }
      },
      "ink": {
        "ink_px": 40878,
