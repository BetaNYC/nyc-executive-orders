          "min": -0.0
        },
        "text": {
          "n_tokens": 57,
          "mean": -0.0001,
          "min": -0.0034
        }
      },
      "ink": {
        "ink_px": 43899,
        "area_px": 221088,
        "density": 0.19856,
        "chars": 320,
        "chars_per_1k_ink": 7.29
      }
    },
    {
      "bbox": [
        223,
        1656,
        1515,
        1925
      ],
      "category": "Text",
      "text": "WHEREAS, the Board of Education is authorized by Section 526 of the City Charter to investigate any subject of which it has cognizance or over which it has legal control, and is required by Education Law §2554 subd. 15a to promote the best interests of the schools; and whereas an investigation into and report on corruption in the school system, and the effect of such conduct on educational programs, will promote the best interests of the students and the school district;",
      "logprob_stats": {
        "bbox": {
