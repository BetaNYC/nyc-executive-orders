        "chars_per_1k_ink": 14.11
      }
    },
    {
      "bbox": [
        173,
        982,
        1489,
        1097
      ],
      "category": "Text",
      "text": "WHEREAS, the Department of Correction's (DOC's) staffing shortages are affecting health operations, including the availability of escorts to bring patients to the clinic and of DOC personnel to staff the clinics; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1464,
          "min": -1.07
        },
        "category": {
