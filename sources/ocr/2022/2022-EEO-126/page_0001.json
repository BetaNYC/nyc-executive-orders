        184,
        1552,
        1491,
        1626
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 2 of Emergency Executive Order No. 122, dated June 20, 2022, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1925,
          "min": -1.2908
        },
        "category": {
