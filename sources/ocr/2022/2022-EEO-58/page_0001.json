        1513,
        907
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the remnants of Hurricane Ida, first declared in Emergency Executive Order No. 230, issued on September 1, 2021, and last extended by Emergency Executive Order No. 48, issued on February 28, 2022, remains in effect;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2206,
          "min": -1.224
        },
        "category": {
