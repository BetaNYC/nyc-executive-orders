        "chars_per_1k_ink": 13.84
      }
    },
    {
      "bbox": [
        193,
        1295,
        1437,
        1372
      ],
      "category": "Text",
      "text": "Section 1. I hereby direct that section 1 of Emergency Executive Order No. 56, dated March 14, 2022, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.171,
          "min": -1.2222
        },
        "category": {
          "n_tokens": 1,
