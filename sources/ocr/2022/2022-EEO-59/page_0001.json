          "min": -0.6333
        }
      },
      "ink": {
        "ink_px": 13760,
        "area_px": 141636,
        "density": 0.09715,
        "chars": 182,
        "chars_per_1k_ink": 13.23
      }
    },
    {
      "bbox": [
        193,
        753,
        1500,
        905
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the City of New York first declared in Emergency Executive Order No. 98, issued on March 12, 2020, and extended most recently by Emergency Executive Order No. 46, issued on February 28, 2022, remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2281,
          "min": -1.2588
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 81,
          "mean": -0.0035,
          "min": -0.2812
        }
      },
      "ink": {
        "ink_px": 21395,
        "area_px": 197217,
        "density": 0.10848,
        "chars": 295,
        "chars_per_1k_ink": 13.79
      }
    },
    {
      "bbox": [
        193,
        947,
        1500,
        1061
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because of the propensity of the virus to spread person-to-person, and also because the actions taken to prevent such spread have led to property loss and damage; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1837,
          "min": -1.1224
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 39,
          "mean": -0.0138,
          "min": -0.5264
        }
      },
      "ink": {
        "ink_px": 13963,
        "area_px": 148235,
        "density": 0.0942,
        "chars": 195,
        "chars_per_1k_ink": 13.97
      }
    },
    {
      "bbox": [
        193,
        1101,
        1493,
        1257
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, pursuant to the powers vested in me by the laws of the State of\nNew York and the City of New York, including but not limited to the New York Executive Law,\nthe New York City Charter and the Administrative Code of the City of New York, and the\ncommon law authority to protect the public in the event of an emergency:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1798,
          "min": -1.2554
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
