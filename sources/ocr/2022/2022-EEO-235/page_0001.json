          "min": -0.0
        },
        "text": {
          "n_tokens": 34,
          "mean": -0.0,
          "min": -0.0002
        }
      },
      "ink": {
        "ink_px": 11728,
        "area_px": 105944,
        "density": 0.1107,
        "chars": 144,
        "chars_per_1k_ink": 12.28
      }
    },
    {
      "bbox": [
        200,
        951,
        1511,
        1074
      ],
      "category": "Text",
      "text": "WHEREAS, the City and all of its agencies are prepared to continue to respond to monkeypox and are committed to protecting the health and well-being of all New Yorkers, which is imperiled by the person-to-person spread of monkeypox; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1923,
          "min": -1.2048
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0006,
          "min": -0.0264
        }
      },
      "ink": {
        "ink_px": 17736,
        "area_px": 160208,
        "density": 0.11071,
        "chars": 236,
        "chars_per_1k_ink": 13.31
      }
    },
    {
      "bbox": [
        200,
        1118,
        1511,
        1199
      ],
      "category": "Text",
      "text": "WHEREAS, additional reasons for requiring the measures continued in this Order are set forth in Emergency Executive Order No. 158, dated August 1, 2022; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1583,
          "min": -1.1801
        },
        "category": {
          "n_tokens": 1,
