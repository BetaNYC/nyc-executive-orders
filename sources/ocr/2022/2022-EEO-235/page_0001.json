          "min": -0.0001
        },
        "text": {
          "n_tokens": 44,
          "mean": -0.0026,
          "min": -0.1129
        }
      },
      "ink": {
        "ink_px": 16809,
        "area_px": 156332,
        "density": 0.10752,
        "chars": 226,
        "chars_per_1k_ink": 13.45
      }
    },
    {
      "bbox": [
        200,
        825,
        1511,
        906
      ],
      "category": "Text",
      "text": "WHEREAS, on July 23, 2022, the World Health Organization declared the monkeypox outbreak a Public Health Emergency of International Concern; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2377,
          "min": -1.4514
        },
        "category": {
          "n_tokens": 1,
