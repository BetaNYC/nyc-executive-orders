    },
    {
      "bbox": [
        200,
        1243,
        1511,
        1364
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency relating to monkeypox, declared in Emergency Executive Order No. 158, dated August 1, 2022, and last extended by Emergency Executive Order No. 218, dated September 27, 2022, remains in effect;",
      "logprob_stats": {
        "bbox": {
