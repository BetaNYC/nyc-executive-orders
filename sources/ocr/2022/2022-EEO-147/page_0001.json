        "chars_per_1k_ink": 12.87
      }
    },
    {
      "bbox": [
        190,
        830,
        1499,
        980
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the\nCity of New York first declared in Emergency Executive Order No. 98, dated March 12, 2020,\nand extended most recently by Emergency Executive Order No. 127, dated June 25, 2022, remains\nin effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2362,
          "min": -1.0299
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 83,
          "mean": -0.0063,
          "min": -0.5236
        }
      },
      "ink": {
        "ink_px": 22209,
