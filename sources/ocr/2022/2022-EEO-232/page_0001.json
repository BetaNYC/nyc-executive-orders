    },
    {
      "bbox": [
        192,
        664,
        1502,
        777
      ],
      "category": "Text",
      "text": "WHEREAS, the COVID-19 pandemic has severely impacted New York City and its\neconomy, and is addressed effectively only by joint action of the City, State, and Federal\ngovernments; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2782,
          "min": -1.3916
        },
        "category": {
          "n_tokens": 1,
