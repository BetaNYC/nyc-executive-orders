        "density": 0.09341,
        "chars": 132,
        "chars_per_1k_ink": 14.4
      }
    },
    {
      "bbox": [
        192,
        1474,
        1502,
        1705
      ],
      "category": "Text",
      "text": "§ 2. I hereby direct the Fire and Police Departments, the Department of Buildings, the\nSheriff, and other agencies as needed, to enforce the directives set forth in this Order in accordance\nwith their lawful authorities, including Administrative Code sections 15-227(a), 28-105.10.1, and\n28-201.1, and section 107.6 of the Fire Code. Violations of the directives set forth in this Order\nmay be issued as if they were violations under Health Code sections 3.07 and 3.11, and enforced\nby the Department of Health and Mental Hygiene or any other agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1487,
          "min": -1.1415
        },
        "category": {
