        "density": 0.09394,
        "chars": 182,
        "chars_per_1k_ink": 13.28
      }
    },
    {
      "bbox": [
        192,
        818,
        1502,
        969
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the\nCity of New York first declared in Emergency Executive Order No. 98, dated March 12, 2020,\nand extended most recently by Emergency Executive Order No. 210, dated September 22, 2022,\nremains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2216,
          "min": -1.111
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 84,
          "mean": -0.0057,
          "min": -0.4746
        }
      },
      "ink": {
        "ink_px": 21881,
        "area_px": 194941,
        "density": 0.11224,
        "chars": 289,
        "chars_per_1k_ink": 13.21
      }
    },
    {
      "bbox": [
        192,
        1011,
        1502,
        1126
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because of the propensity of the virus to spread person-to-person, and also because the actions taken to prevent such spread have led to property loss and damage;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1775,
          "min": -1.0947
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 38,
          "mean": -0.0059,
          "min": -0.1627
        }
      },
      "ink": {
        "ink_px": 13901,
        "area_px": 148465,
        "density": 0.09363,
        "chars": 191,
        "chars_per_1k_ink": 13.74
      }
    },
    {
      "bbox": [
        192,
        1166,
        1502,
        1319
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, pursuant to the powers vested in me by the laws of the State of New\nYork and the City of New York, including but not limited to the New York Executive Law, the\nNew York City Charter and the Administrative Code of the City of New York, and the common\nlaw authority to protect the public in the event of an emergency:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1852,
          "min": -1.188
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
