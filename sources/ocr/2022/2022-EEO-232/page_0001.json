    },
    {
      "bbox": [
        192,
        1359,
        1502,
        1434
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 1 of Emergency Executive Order No. 226, dated\nOctober 7, 2022, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1652,
          "min": -1.1395
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 43,
          "mean": -0.01,
          "min": -0.4291
        }
      },
      "ink": {
        "ink_px": 9165,
