        "chars_per_1k_ink": 12.48
      }
    },
    {
      "bbox": [
        193,
        1217,
        1503,
        1372
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, pursuant to the powers vested in me by the laws of the State of New\nYork and the City of New York, including but not limited to the New York Executive Law, the\nNew York City Charter and the Administrative Code of the City of New York, and the common\nlaw authority to protect the public in the event of an emergency:",
      "logprob_stats": {
