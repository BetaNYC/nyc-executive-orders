    },
    {
      "bbox": [
        193,
        869,
        1503,
        1020
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the\nCity of New York first declared in Emergency Executive Order No. 98, issued on March 12, 2020,\nand extended most recently by Emergency Executive Order No. 127, issued on June 25, 2022,\nremains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2199,
          "min": -0.9281
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
