    },
    {
      "bbox": [
        192,
        833,
        1502,
        982
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the City of New York first declared in Emergency Executive Order No. 98, issued on March 12, 2020, and extended most recently by Emergency Executive Order No. 127, issued on June 25, 2022, remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2434,
          "min": -1.2228
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
