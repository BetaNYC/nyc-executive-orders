    {
      "bbox": [
        131,
        675,
        1561,
        753
      ],
      "category": "Text",
      "text": "WHEREAS, the COVID-19 pandemic has severely impacted New York City and its economy, and is addressed effectively only by joint action of the City, State, and Federal governments; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2878,
          "min": -1.3665
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 38,
          "mean": -0.0113,
          "min": -0.4289
        }
      },
      "ink": {
        "ink_px": 13104,
