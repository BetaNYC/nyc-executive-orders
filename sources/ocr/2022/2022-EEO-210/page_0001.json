        "density": 0.08611,
        "chars": 129,
        "chars_per_1k_ink": 15.06
      }
    },
    {
      "bbox": [
        129,
        1486,
        1561,
        1716
      ],
      "category": "Text",
      "text": "§ 3. I hereby direct the Fire and Police Departments, the Department of Buildings, the Sheriff, and other agencies as needed, to enforce the directives set forth in this Order in accordance with their lawful authorities, including Administrative Code sections 15-227(a), 28-105.10.1, and 28-201.1, and section 107.6 of the Fire Code. Violations of the directives set forth in this Order may be issued as if they were violations under Health Code sections 3.07 and 3.11, and enforced by the Department of Health and Mental Hygiene or any other agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2106,
          "min": -1.1527
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 143,
          "mean": -0.0,
          "min": -0.0005
