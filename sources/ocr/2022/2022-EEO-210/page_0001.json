        "density": 0.13003,
        "chars": 182,
        "chars_per_1k_ink": 13.89
      }
    },
    {
      "bbox": [
        131,
        791,
        1564,
        907
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the City of New York first declared in Emergency Executive Order No. 98, dated March 12, 2020, and extended most recently by Emergency Executive Order No. 180, dated August 24, 2022, remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2667,
          "min": -1.3952
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 80,
          "mean": -0.0006,
          "min": -0.043
        }
      },
      "ink": {
        "ink_px": 20614,
        "area_px": 151164,
        "density": 0.13637,
        "chars": 286,
        "chars_per_1k_ink": 13.87
      }
    },
    {
      "bbox": [
        131,
        946,
        1561,
        1024
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because of the propensity of the virus to spread person-to-person, and also because the actions taken to prevent such spread have led to property loss and damage;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2183,
          "min": -1.2515
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 38,
          "mean": -0.0004,
          "min": -0.0103
        }
      },
      "ink": {
        "ink_px": 13592,
        "area_px": 102068,
        "density": 0.13317,
        "chars": 191,
        "chars_per_1k_ink": 14.05
      }
    },
    {
      "bbox": [
        129,
        1062,
        1561,
        1216
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, pursuant to the powers vested in me by the laws of the State of New York and the City of New York, including but not limited to the New York Executive Law, the New York City Charter and the Administrative Code of the City of New York, and the common law authority to protect the public in the event of an emergency:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2221,
          "min": -1.2058
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 71,
          "mean": -0.0,
          "min": -0.0004
        }
      },
      "ink": {
        "ink_px": 22656,
        "area_px": 198968,
        "density": 0.11387,
        "chars": 331,
        "chars_per_1k_ink": 14.61
      }
    },
    {
      "bbox": [
        131,
        1255,
        1558,
        1333
      ],
      "category": "Text",
      "text": "Section 1. I hereby direct that the State of Emergency declared in Emergency Executive Order No. 98, dated March 12, 2020, and extended by subsequent orders, is extended for thirty (30) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2183,
          "min": -1.188
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0021,
          "min": -0.1013
        }
      },
      "ink": {
        "ink_px": 13382,
        "area_px": 100776,
        "density": 0.13279,
        "chars": 191,
        "chars_per_1k_ink": 14.27
      }
    },
    {
      "bbox": [
        131,
        1371,
        1558,
        1447
      ],
      "category": "Text",
      "text": "§ 2. I hereby order that section 1 of Emergency Executive Order No. 205, dated September 17, 2022, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2013,
          "min": -1.196
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
