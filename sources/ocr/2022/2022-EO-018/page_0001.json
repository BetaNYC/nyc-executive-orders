    {
      "bbox": [
        187,
        783,
        1490,
        976
      ],
      "category": "Text",
      "text": "WHEREAS, the City has five pension systems that offer defined benefit retirement plans to nearly 350,000 City employees and 320,000 retirees or their beneficiaries: the New York City Employees' Retirement System, the Police Pension Fund, the Fire Pension Fund, the Teachers' Retirement System, and the Board of Education Retirement System (collectively, \"the Systems\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2739,
          "min": -1.3018
        },
        "category": {
