    },
    {
      "bbox": [
        187,
        1015,
        1352,
        1093
      ],
      "category": "Text",
      "text": "WHEREAS, the Comptroller, through the Bureau of Asset Management, is the investment advisor to, and custodian of, the five System funds; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2111,
