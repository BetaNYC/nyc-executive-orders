        1131,
        1455,
        1244
      ],
      "category": "Text",
      "text": "WHEREAS, the City offers a defined contribution plan to its employees, known as the Deferred Compensation Plan (the \"Plan\"), which is administered by the Office of Labor Relations; and",
      "logprob_stats": {
        "bbox": {
