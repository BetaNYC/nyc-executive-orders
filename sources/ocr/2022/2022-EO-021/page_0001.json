      "bbox": [
        189,
        751,
        1565,
        868
      ],
      "category": "Text",
      "text": "WHEREAS, New York City is an international center of media and entertainment, and the continued health and development of all forms of media and entertainment are vital to the economic success and cultural identity of New York City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2716,
          "min": -1.4047
        },
        "category": {
          "n_tokens": 1,
