    },
    {
      "bbox": [
        186,
        1496,
        1500,
        1613
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency existing within DOC facilities, first declared in Emergency Executive Order No. 241, dated September 15, 2021, and extended most recently by Emergency Executive Order No. 181, dated August 24, 2022, remains in effect;",
      "logprob_stats": {
        "bbox": {
