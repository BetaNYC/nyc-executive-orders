    },
    {
      "bbox": [
        142,
        855,
        1551,
        966
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the remnants of Hurricane Ida, first declared in Emergency Executive Order No. 230, issued on September 1, 2021, and last extended by Emergency Executive Order No. 105, issued on May 26, 2022, remains in effect;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2506,
          "min": -1.3614
        },
        "category": {
