    {
      "bbox": [
        142,
        1124,
        1551,
        1198
      ],
      "category": "Text",
      "text": "Section 1. I hereby direct that the State of Emergency declared in Emergency Executive Order No. 230, dated September 1, 2021, and extended by subsequent orders, is extended for thirty (30) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.215,
          "min": -1.2562
        },
        "category": {
