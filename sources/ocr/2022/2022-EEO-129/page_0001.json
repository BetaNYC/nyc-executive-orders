    },
    {
      "bbox": [
        142,
        1009,
        1551,
        1082
      ],
      "category": "Text",
      "text": "NOW THEREFORE, by the power vested in me as Mayor of the City of New York pursuant to law, including Executive Law § 24:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1966,
          "min": -1.2907
        },
        "category": {
