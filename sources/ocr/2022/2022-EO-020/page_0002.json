        1561,
        928
      ],
      "category": "Text",
      "text": "\u00a7 2. Transfer of Categories of Adjudications Related to Impartial Hearings under the Education Law and Rehabilitation Act of 1973, as amended.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.229,
