        "density": 0.14453,
        "chars": 343,
        "chars_per_1k_ink": 12.08
      }
    },
    {
      "bbox": [
        133,
        1008,
        1561,
        1126
      ],
      "category": "Text",
      "text": "WHEREAS, the prior consolidation and transfer of administrative tribunals into OATH has allowed the City of New York to continue in the impartial administration of justice and the conduct of independent, professional, efficient, and technologically advanced adjudicatory hearings; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2345,
          "min": -1.365
        },
        "category": {
