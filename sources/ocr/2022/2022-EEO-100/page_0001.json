    },
    {
      "bbox": [
        189,
        796,
        1492,
        947
      ],
      "category": "Text",
      "text": "WHEREAS, excessive staff absenteeism among correction officers and supervising officers has contributed to a rise in unrest and disorder, and creates a serious risk to the necessary maintenance and delivery of sanitary conditions; access to basic services including showers, meals, visitation, religious services, commissary, and recreation; and prompt processing at intake; and",
      "logprob_stats": {
        "bbox": {
