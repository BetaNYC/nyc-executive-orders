        }
      },
      "ink": {
        "ink_px": 9622,
        "area_px": 96900,
        "density": 0.0993,
        "chars": 144,
        "chars_per_1k_ink": 14.97
      }
    },
    {
      "bbox": [
        115,
        1217,
        1589,
        1332
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency existing within DOC facilities, first declared in Emergency Executive Order No. 241, issued on September 15, 2021, and extended most recently by Emergency Executive Order No. 84, issued on April 28, 2022, remains in effect;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1355,
          "min": -1.1529
        },
        "category": {
