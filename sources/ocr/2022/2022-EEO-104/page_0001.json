    {
      "bbox": [
        115,
        638,
        1589,
        715
      ],
      "category": "Text",
      "text": "WHEREAS, on September 2, 2021, the federal monitor in the *Nunez* use-of-force class action stated steps must be taken immediately to address the conditions in the New York City jails; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2752,
          "min": -1.3152
        },
        "category": {
          "n_tokens": 1,
