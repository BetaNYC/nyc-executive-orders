          "min": -0.0
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0064,
          "min": -0.2258
        }
      },
      "ink": {
        "ink_px": 13007,
        "area_px": 100776,
        "density": 0.12907,
        "chars": 188,
        "chars_per_1k_ink": 14.45
      }
    },
    {
      "bbox": [
        115,
        753,
        1589,
        908
      ],
      "category": "Text",
      "text": "WHEREAS, excessive staff absenteeism among correction officers and supervising officers has contributed to a rise in unrest and disorder, and creates a serious risk to the necessary maintenance and delivery of sanitary conditions; access to basic services including showers, meals, visitation, religious services, commissary, and recreation; and prompt processing at intake; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2192,
          "min": -1.2434
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 68,
          "mean": -0.0006,
          "min": -0.0381
        }
      },
      "ink": {
        "ink_px": 25153,
        "area_px": 201552,
        "density": 0.1248,
        "chars": 378,
        "chars_per_1k_ink": 15.03
      }
    },
    {
      "bbox": [
        115,
        947,
        1589,
        1060
      ],
      "category": "Text",
      "text": "WHEREAS, the Department of Correction's (DOC's) staffing shortages are affecting health operations, including the availability of escorts to bring patients to the clinic and of DOC personnel to staff the clinics; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1763,
          "min": -1.0487
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0002,
          "min": -0.0067
        }
      },
      "ink": {
        "ink_px": 14273,
        "area_px": 147288,
        "density": 0.09691,
        "chars": 216,
        "chars_per_1k_ink": 15.13
      }
    },
    {
      "bbox": [
        115,
        1101,
        1589,
        1176
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given to address the effects of excessive staff absenteeism and in order to address the conditions at DOC facilities; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1618,
          "min": -1.0781
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
