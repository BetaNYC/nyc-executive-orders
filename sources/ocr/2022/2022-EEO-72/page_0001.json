    {
      "bbox": [
        188,
        1256,
        1497,
        1369
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency existing within DOC facilities, first declared in Emergency Executive Order No. 241, issued on September 15, 2021, and extended most recently by Emergency Executive Order No. 66, issued on March 29, 2022, remains in effect;",
