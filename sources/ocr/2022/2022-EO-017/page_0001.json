    {
      "bbox": [
        179,
        790,
        1482,
        982
      ],
      "category": "Text",
      "text": "WHEREAS, the City has five pension systems that offer defined benefit retirement plans to nearly 350,000 City employees and 320,000 retirees or their beneficiaries: the New York City Employees' Retirement System (\"NYCERS\"), the Police Pension Fund (\"PPF\"), the Fire Pension Fund (\"Fire\"), the Teachers' Retirement System (\"TRS\") and the Board of Education Retirement System (\"BERS\") (collectively, \"the Systems\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2656,
          "min": -1.2644
        },
        "category": {
          "n_tokens": 1,
