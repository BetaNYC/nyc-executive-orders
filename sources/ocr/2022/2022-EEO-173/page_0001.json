    },
    {
      "bbox": [
        190,
        1065,
        1502,
        1147
      ],
      "category": "Text",
      "text": "WHEREAS, additional reasons for requiring the measures continued in this Order are set forth in Emergency Executive Order No. 158, dated August 1, 2022; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1835,
          "min": -1.0529
        },
        "category": {
