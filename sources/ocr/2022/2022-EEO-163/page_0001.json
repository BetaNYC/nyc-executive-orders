    },
    {
      "bbox": [
        195,
        1191,
        1509,
        1272
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency relating to monkeypox, declared in Emergency Executive Order No. 158, dated August 1, 2022, remains in effect;",
      "logprob_stats": {
