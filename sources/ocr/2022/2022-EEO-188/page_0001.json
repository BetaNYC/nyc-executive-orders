        },
        "text": {
          "n_tokens": 34,
          "mean": -0.0,
          "min": -0.0002
        }
      },
      "ink": {
        "ink_px": 8406,
        "area_px": 107153,
        "density": 0.07845,
        "chars": 144,
        "chars_per_1k_ink": 17.13
      }
    },
    {
      "bbox": [
        198,
        866,
        1508,
        988
      ],
      "category": "Text",
      "text": "WHEREAS, the City and all of its agencies are prepared to continue to respond to monkeypox and are committed to protecting the health and well-being of all New Yorkers, which is imperiled by the person-to-person spread of monkeypox; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.187,
          "min": -1.0788
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 51,
