        }
      },
      "ink": {
        "ink_px": 12590,
        "area_px": 158793,
        "density": 0.07929,
        "chars": 236,
        "chars_per_1k_ink": 18.75
      }
    },
    {
      "bbox": [
        198,
        1031,
        1508,
        1112
      ],
      "category": "Text",
      "text": "WHEREAS, additional reasons for requiring the measures continued in this Order are set forth in Emergency Executive Order No. 158, dated August 1, 2022; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1788,
          "min": -0.9715
        },
        "category": {
