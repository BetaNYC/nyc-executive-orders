        190,
        1527,
        1446,
        1605
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 1 of Emergency Executive Order No. 236, dated October 17, 2022, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1906,
          "min": -1.185
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 43,
          "mean": -0.0001,
          "min": -0.0053
        }
      },
      "ink": {
        "ink_px": 8099,
