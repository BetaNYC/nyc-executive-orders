    {
      "bbox": [
        320,
        916,
        1537,
        1081
      ],
      "category": "Text",
      "text": "Section 1. Office Established. The Office of\nRail Freight Development (the \"Office\") is hereby established\nin the Office of the Mayor. The Office shall be headed by a\nDirector who shall report to the Deputy Mayor for Economic\nPolicy and Development.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2326,
          "min": -1.2412
        },
        "category": {
          "n_tokens": 1,
