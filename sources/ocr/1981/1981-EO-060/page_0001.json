    },
    {
      "bbox": [
        621,
        1613,
        1539,
        1709
      ],
      "category": "List-item",
      "text": "(i) to rehabilitate obsolete, abandoned\nor deteriorated terminals, yard facilities,\ntracks and related equipment;",
      "logprob_stats": {
        "bbox": {
