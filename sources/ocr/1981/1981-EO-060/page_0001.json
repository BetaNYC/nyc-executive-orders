    },
    {
      "bbox": [
        627,
        1184,
        1434,
        1215
      ],
      "category": "Section-header",
      "text": "(a) <u>Policy Development and Coordination.</u>",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2471,
          "min": -1.3978
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.2285,
          "min": -0.4569
        },
        "text": {
          "n_tokens": 14,
          "mean": -0.0251,
          "min": -0.2861
        }
      },
      "ink": {
        "ink_px": 4659,
