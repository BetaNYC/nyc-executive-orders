    },
    {
      "bbox": [
        619,
        1745,
        1481,
        1841
      ],
      "category": "List-item",
      "text": "(ii) to remove clearance restrictions\nwhich block access to the City by rail\nfreight rolling stock;",
      "logprob_stats": {
        "bbox": {
