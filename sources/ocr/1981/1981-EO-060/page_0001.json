        "chars": 47,
        "chars_per_1k_ink": 10.09
      }
    },
    {
      "bbox": [
        520,
        1218,
        1597,
        1413
      ],
      "category": "Text",
      "text": "The Office shall have overall responsibility\nfor the development and coordination of rail freight\npolicy for the City of New York. Agencies engaged in\nactivities affecting rail freight transportation\nshall consult with the Office for the purpose of im-\nproving rail freight service within the City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2193,
          "min": -1.1533
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0007,
          "min": -0.0007
        },
        "text": {
          "n_tokens": 55,
          "mean": -0.0026,
          "min": -0.1133
        }
      },
      "ink": {
        "ink_px": 32450,
        "area_px": 209430,
        "density": 0.15494,
        "chars": 298,
        "chars_per_1k_ink": 9.18
      }
    },
    {
      "bbox": [
        520,
        1447,
        1517,
        1577
      ],
      "category": "Text",
      "text": "(b) <u>Capital Improvement.</u> After consultation\nwith the Department of Transportation, the Office\nshall develop a capital improvement program for\nthe following purposes:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2124,
          "min": -1.2002
        },
        "category": {
