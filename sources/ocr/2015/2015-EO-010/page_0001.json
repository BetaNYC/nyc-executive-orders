    },
    {
      "bbox": [
        192,
        1195,
        1441,
        1403
      ],
      "category": "Text",
      "text": "WHEREAS, it is further the policy of the City of New York generally to promote the economic, social and physical well-being of women, and to develop and support policies that promote opportunities for women in all areas, including, but not limited to, employment, housing, child care, education and health; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2218,
          "min": -1.1619
        },
        "category": {
          "n_tokens": 1,
