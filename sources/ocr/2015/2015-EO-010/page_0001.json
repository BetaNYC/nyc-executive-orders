    },
    {
      "bbox": [
        192,
        993,
        1499,
        1142
      ],
      "category": "Text",
      "text": "WHEREAS, it is further the policy of the City of New York that women be assured of the benefits of equal opportunity and the full utilization of their talents, no matter their race, ethnicity, class or sexual orientation; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2347,
