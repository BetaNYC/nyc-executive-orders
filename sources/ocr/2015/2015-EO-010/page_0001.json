      "bbox": [
        192,
        791,
        1497,
        936
      ],
      "category": "Text",
      "text": "WHEREAS, it is the policy of the City of New York to ensure that the women of the City live with dignity and equity, and be free from violence and discrimination based upon gender; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2657,
          "min": -1.2606
        },
