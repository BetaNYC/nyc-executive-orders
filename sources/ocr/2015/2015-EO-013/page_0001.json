    {
      "bbox": [
        195,
        753,
        1453,
        877
      ],
      "category": "Text",
      "text": "WHEREAS, it is the policy of the City of New York to promote economic growth in a manner that ensures that city residents and businesses from all communities and backgrounds can participate in and contribute to the economy of the city.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2401,
          "min": -1.17
        },
        "category": {
          "n_tokens": 1,
