        1465,
        1497,
        1543
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York benefits from input from, outreach to and cooperation with M/WBE firms and advocates in order to ensure greater participation by all in City work.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1896,
          "min": -1.0731
        },
