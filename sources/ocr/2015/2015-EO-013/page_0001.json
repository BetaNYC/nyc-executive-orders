        "chars": 235,
        "chars_per_1k_ink": 9.27
      }
    },
    {
      "bbox": [
        196,
        930,
        1453,
        1010
      ],
      "category": "Text",
      "text": "WHEREAS, Minority and Women-owned Business Enterprises (\"M/WBEs\") are amongst the fastest growing small businesses that create jobs and invest in local communities.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2235,
          "min": -1.1574
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 32,
          "mean": -0.0218,
          "min": -0.6333
        }
      },
      "ink": {
        "ink_px": 19332,
        "area_px": 100683,
        "density": 0.19201,
        "chars": 164,
        "chars_per_1k_ink": 8.48
      }
    },
    {
      "bbox": [
        196,
        1064,
        1494,
        1189
      ],
      "category": "Text",
      "text": "WHEREAS, notwithstanding that M/WBEs are strong drivers of economic growth, they have not historically been awarded contracts at a level commensurate with their representation in the marketplace.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1947,
          "min": -1.1498
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 36,
          "mean": -0.0,
          "min": -0.0007
        }
      },
      "ink": {
        "ink_px": 22029,
        "area_px": 160500,
        "density": 0.13725,
        "chars": 195,
        "chars_per_1k_ink": 8.85
      }
    },
    {
      "bbox": [
        198,
        1242,
        1494,
        1409
      ],
      "category": "Text",
      "text": "WHEREAS, to advance the City's policy of inclusivity and in recognition of the fact that M/WBE firms remain persistently underrepresented among City contractors, the City of New York has made a commitment to awarding more than $16 billion in awards to M/WBE over the next ten years.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1904,
          "min": -1.0344
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 62,
