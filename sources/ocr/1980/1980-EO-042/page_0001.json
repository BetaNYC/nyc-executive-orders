    {
      "bbox": [
        332,
        766,
        1276,
        964
      ],
      "category": "Text",
      "text": "\"Section 1. Subject to the approval of the Mayor and under the Mayor and under the direction of the Office of the Mayor, guidelines setting forth standards and procedures for a City Equal Employment Opportunity Program shall be prepared by the Department of Personnel, the City Commission on Human Rights and the Law Department, in consultation with the Mayor's Office for the Handicapped and the Department for the Aging. The Program guidelines shall comply with applicable federal, state and local laws regulations and guidelines relating to discrimination in employment.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2446,
          "min": -1.4181
