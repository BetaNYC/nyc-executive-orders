        "chars": 110,
        "chars_per_1k_ink": 20.12
      }
    },
    {
      "bbox": [
        365,
        763,
        1337,
        809
      ],
      "category": "Text",
      "text": "Whereas, I find that these circumstances constitute an imminent peril to the public health and safety requiring the adoption of special rules and regulations as emergency measures;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1999,
          "min": -0.8531
        },
        "category": {
