        721
      ],
      "category": "Text",
      "text": "Whereas, All subway and bus services provided by the Metropolitan Transit Authority have ceased operations; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2504,
          "min": -1.2035
        },
        "category": {
          "n_tokens": 1,
