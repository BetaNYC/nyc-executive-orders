        "chars_per_1k_ink": 18.84
      }
    },
    {
      "bbox": [
        365,
        719,
        1337,
        763
      ],
      "category": "Text",
      "text": "Whereas, It is necessary to insure the orderly transportation of people and goods in The City of New York; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2182,
          "min": -1.2674
        },
        "category": {
