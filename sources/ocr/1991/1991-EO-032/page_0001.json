    },
    {
      "bbox": [
        224,
        1449,
        1528,
        1605
      ],
      "category": "Text",
      "text": "WHEREAS, a program to select, train and assist such individuals would provide them with the knowledge and resources necessary to enable them to assist in preventing and resolving conflicts in their communities and to establish harmony, goodwill, understanding and respect among diverse groups within their communities and in the City as a whole;",
      "logprob_stats": {
