    {
      "bbox": [
        179,
        852,
        1494,
        1027
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York serves over 600,000 kindergarten through eighth grade students through the public school system, yet fewer than 165,000 of New York City students in kindergarten through eighth grade currently have the ability to enroll in free after-school programming provided by the Department of Youth and Community Development; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2301,
          "min": -1.2399
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 72,
          "mean": -0.0005,
          "min": -0.0337
        }
      },
      "ink": {
        "ink_px": 27749,
        "area_px": 224700,
        "density": 0.12349,
        "chars": 349,
        "chars_per_1k_ink": 12.58
      }
    },
    {
      "bbox": [
        179,
        1075,
        1494,
        1203
      ],
      "category": "Text",
      "text": "WHEREAS, after-school programs have demonstrated benefits for youth participants, including increases in school engagement, social emotional development, and positive relationships with peers and adults; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1704,
          "min": -1.2035
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 32,
          "mean": -0.0004,
          "min": -0.011
        }
      },
      "ink": {
        "ink_px": 16274,
        "area_px": 164352,
        "density": 0.09902,
        "chars": 207,
        "chars_per_1k_ink": 12.72
      }
    },
    {
      "bbox": [
        179,
        1253,
        1494,
        1339
      ],
      "category": "Text",
      "text": "WHEREAS, after-school programs also support working families and local communities by creating safe spaces for young people to convene during out-of-school hours; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1519,
          "min": -1.0646
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
