        "chars_per_1k_ink": 12.42
      }
    },
    {
      "bbox": [
        179,
        1522,
        1494,
        1696
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York has committed $331 million to provide seats for 20,000 more students in kindergarten through fifth grade to participate in after-school programs and to stabilize and strengthen the current after-school system through increased payment rates to providers of after-school programming; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1031,
          "min": -0.9402
        },
        "category": {
