      }
    },
    {
      "bbox": [
        179,
        1745,
        1494,
        1873
      ],
      "category": "Text",
      "text": "WHEREAS, it is the City's policy goal to expand after-school programming in order for it to become available to all students in kindergarten through fifth grade, which necessitates a long-term strategic plan; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.0928,
          "min": -0.9998
        },
        "category": {
