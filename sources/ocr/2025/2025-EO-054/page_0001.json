          "mean": -0.0016,
          "min": -0.0486
        }
      },
      "ink": {
        "ink_px": 12996,
        "area_px": 110424,
        "density": 0.11769,
        "chars": 166,
        "chars_per_1k_ink": 12.77
      }
    },
    {
      "bbox": [
        179,
        1387,
        1494,
        1472
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York has made a commitment to creating opportunities for young people to thrive and for working families to access affordable childcare; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1207,
          "min": -1.0349
        },
        "category": {
          "n_tokens": 1,
