    },
    {
      "bbox": [
        187,
        1195,
        1497,
        1273
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1755,
          "min": -1.3203
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 25,
          "mean": -0.0004,
          "min": -0.0098
        }
      },
      "ink": {
        "ink_px": 6544,
