        118,
        1627,
        1587,
        1701
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 1 of Emergency Executive Order No. 812, dated June 2, 2025, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2023,
          "min": -1.2746
        },
        "category": {
