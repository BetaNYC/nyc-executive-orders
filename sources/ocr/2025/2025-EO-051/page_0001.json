        "text": {
          "n_tokens": 56,
          "mean": -0.0,
          "min": -0.001
        }
      },
      "ink": {
        "ink_px": 24505,
        "area_px": 143849,
        "density": 0.17035,
        "chars": 246,
        "chars_per_1k_ink": 10.04
      }
    },
    {
      "bbox": [
        217,
        1055,
        1493,
        1162
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Police Department reports that anti-Jewish crimes accounted for 54% of all hate crimes reported in the City of New York in calendar year 2024; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2154,
          "min": -1.286
        },
        "category": {
          "n_tokens": 1,
