    {
      "bbox": [
        219,
        785,
        1499,
        860
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York is home to the largest Jewish community outside of Israel, whose members are integral to the social and economic vitality of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.265,
