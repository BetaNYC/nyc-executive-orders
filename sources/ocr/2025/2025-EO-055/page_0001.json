    {
      "bbox": [
        183,
        1052,
        1492,
        1215
      ],
      "category": "Text",
      "text": "WHEREAS, this Administration seeks innovative and effective ways to improve government operations and services, build productive public/private partnerships, and leverage educational institutions to ensure that all of the City's residents have the opportunity to access, secure, and thrive in family-sustaining careers; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2066,
          "min": -1.2665
        },
        "category": {
