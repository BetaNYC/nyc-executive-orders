    },
    {
      "bbox": [
        181,
        1260,
        1490,
        1388
      ],
      "category": "Text",
      "text": "WHEREAS, the City must develop a more coordinated approach with the private sector to develop our workforce and better match talent to promising career opportunities that benefit residents, employers, and the local economy while promoting equity and shared prosperity; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2269,
