        "density": 0.11558,
        "chars": 158,
        "chars_per_1k_ink": 13.56
      }
    },
    {
      "bbox": [
        116,
        1127,
        1596,
        1240
      ],
      "category": "Text",
      "text": "WHEREAS, heavy rain and flash flooding risks damage to residential and commercial buildings and public infrastructure throughout the City, which could create unsafe conditions and further imperil public safety; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1822,
