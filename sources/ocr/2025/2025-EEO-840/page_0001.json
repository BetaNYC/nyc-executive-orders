    {
      "bbox": [
        116,
        756,
        1596,
        873
      ],
      "category": "Text",
      "text": "WHEREAS, the public safety is imperiled by flash flooding and heavy rain, occurring on Thursday, July 31, 2025 and continuing into Friday, August 1, that is anticipated to flood roads, disrupt mass transit, restrict the operation of emergency vehicles, and impede the delivery of goods and services; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2823,
          "min": -1.3987
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 68,
