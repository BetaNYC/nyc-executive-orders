        "chars_per_1k_ink": 13.11
      }
    },
    {
      "bbox": [
        116,
        1016,
        1596,
        1093
      ],
      "category": "Text",
      "text": "WHEREAS, City Agencies have been preparing for extreme storms and flash flooding and are taking all necessary measures to protect the City and the public; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.203,
          "min": -1.2931
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
