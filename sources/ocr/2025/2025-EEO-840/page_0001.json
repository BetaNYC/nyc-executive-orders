        "chars": 303,
        "chars_per_1k_ink": 14.33
      }
    },
    {
      "bbox": [
        116,
        906,
        1596,
        982
      ],
      "category": "Text",
      "text": "WHEREAS, the National Weather Service has issued a Flood Watch for New York City and contiguous counties through Friday morning, August 1;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2696,
          "min": -1.3343
        },
        "category": {
          "n_tokens": 1,
