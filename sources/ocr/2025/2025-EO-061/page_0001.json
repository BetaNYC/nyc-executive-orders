      }
    },
    {
      "bbox": [
        226,
        979,
        1506,
        1052
      ],
      "category": "Text",
      "text": "WHEREAS, the City has a significant interest in keeping public spaces safe and free of congestion;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.224,
          "min": -1.1572
        },
        "category": {
