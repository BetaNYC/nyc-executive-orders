    },
    {
      "bbox": [
        224,
        1250,
        1502,
        1363
      ],
      "category": "Text",
      "text": "WHEREAS, at times, houses of worship are targets of protests and other actions that can disrupt congregants' ability to freely exercise their chosen religion and threaten the public safety of worshipers and surrounding neighbors; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
