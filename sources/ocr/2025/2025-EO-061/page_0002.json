    },
    {
      "bbox": [
        220,
        452,
        1497,
        602
      ],
      "category": "Text",
      "text": "WHEREAS, houses of worship are sometimes sites of protest, at times leading to worshipers and other community members who avail themselves of services and fellowship offered by houses of worship feeling threatened when exercising their own Constitutional rights of freedom of speech, assembly, and religion; and",
      "logprob_stats": {
        "bbox": {
