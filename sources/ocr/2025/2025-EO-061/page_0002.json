        "chars": 415,
        "chars_per_1k_ink": 10.25
      }
    },
    {
      "bbox": [
        304,
        1146,
        1449,
        1218
      ],
      "category": "List-item",
      "text": "a. Consideration of federal, state, and local laws regulating protests at houses of worship, reproductive health facilities, private residences and other sites; and",
      "logprob_stats": {
