        "chars_per_1k_ink": 9.96
      }
    },
    {
      "bbox": [
        219,
        800,
        1470,
        871
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2173,
          "min": -1.0208
        },
        "category": {
          "n_tokens": 1,
