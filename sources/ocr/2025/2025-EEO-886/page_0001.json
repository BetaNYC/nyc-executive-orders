        "chars_per_1k_ink": 12.2
      }
    },
    {
      "bbox": [
        172,
        1832,
        1517,
        1906
      ],
      "category": "Text",
      "text": "Section 1. I hereby direct that the State of Emergency declared in Emergency Executive Order No. 224, dated October 7, 2022, and extended by subsequent orders, is extended for thirty (30) days.",
