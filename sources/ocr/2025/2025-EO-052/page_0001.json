    {
      "bbox": [
        232,
        1685,
        1465,
        1755
      ],
      "category": "Text",
      "text": "WHEREAS, the IHRA has published 11 contemporary examples of antisemitism to illustrate instances of antisemitism that may be encountered in daily life; and",
      "logprob_stats": {
