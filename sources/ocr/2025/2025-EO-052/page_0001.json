        }
      },
      "ink": {
        "ink_px": 37631,
        "area_px": 224770,
        "density": 0.16742,
        "chars": 388,
        "chars_per_1k_ink": 10.31
      }
    },
    {
      "bbox": [
        232,
        1128,
        1469,
        1237
      ],
      "category": "Text",
      "text": "WHEREAS, on May 26, 2016, the 31 member states of the International Holocaust Remembrance Alliance (\"IHRA\"), of which the United States is a member, adopted a non-legally binding \"working definition\" of antisemitism; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2217,
          "min": -1.1469
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 59,
          "mean": -0.0094,
          "min": -0.4742
        }
      },
      "ink": {
        "ink_px": 21418,
        "area_px": 135630,
        "density": 0.15791,
        "chars": 220,
        "chars_per_1k_ink": 10.27
      }
    },
    {
      "bbox": [
        232,
        1277,
        1471,
        1421
      ],
      "category": "Text",
      "text": "WHEREAS, the IHRA definition reads, \"Antisemitism is a certain perception of Jews, which may be expressed as hatred toward Jews. Rhetorical and physical manifestations of antisemitism are directed toward Jewish or non-Jewish individuals and/or their property, toward Jewish community institutions and religious facilities;\" and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2013,
          "min": -1.1175
        },
        "category": {
          "n_tokens": 1,
