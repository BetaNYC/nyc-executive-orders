    {
      "bbox": [
        232,
        757,
        1471,
        865
      ],
      "category": "Text",
      "text": "WHEREAS, Executive Order No. 51, signed on May 13, 2025, created the Mayor's Office to Combat Antisemitism to identify and develop efforts to eliminate antisemitism and anti-Jewish hate crime; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2652,
