        "chars": 359,
        "chars_per_1k_ink": 11.18
      }
    },
    {
      "bbox": [
        236,
        695,
        1474,
        802
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York recognizes that a definition of antisemitism may be useful for identifying antisemitic behavior and rhetoric, and serve as a foundation to raise awareness and to effectively combat antisemitism;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2566,
          "min": -1.2928
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 44,
          "mean": -0.0061,
          "min": -0.2262
        }
      },
      "ink": {
        "ink_px": 19915,
