        "density": 0.15083,
        "chars": 224,
        "chars_per_1k_ink": 11.25
      }
    },
    {
      "bbox": [
        236,
        844,
        1447,
        914
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2387,
          "min": -1.2307
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0019,
          "min": -0.0019
        },
        "text": {
          "n_tokens": 25,
          "mean": -0.0064,
          "min": -0.1604
        }
      },
      "ink": {
        "ink_px": 8995,
        "area_px": 85697,
        "density": 0.10496,
        "chars": 97,
        "chars_per_1k_ink": 10.78
      }
    },
    {
      "bbox": [
        236,
        955,
        1424,
        1062
      ],
      "category": "Text",
      "text": "Section 1. The City of New York recognizes, and City agencies shall consider as appropriate, the IHRA Working Definition of Antisemitism, as adopted on May 26, 2016, as well as the 11 contemporary examples.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2376,
          "min": -1.3284
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0111,
          "min": -0.0111
        },
        "text": {
          "n_tokens": 54,
          "mean": -0.0002,
          "min": -0.0029
        }
      },
      "ink": {
        "ink_px": 18233,
        "area_px": 127872,
        "density": 0.14259,
        "chars": 206,
        "chars_per_1k_ink": 11.3
      }
    },
    {
      "bbox": [
        221,
        1103,
        1424,
        1207
      ],
      "category": "Text",
      "text": "\u00a7 2. City agencies are encouraged to use these materials as appropriate to facilitate constructive discourse, further understanding, and enable a more thoughtful response to harmful antisemitic behavior.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2156,
          "min": -1.2106
        },
        "category": {
          "n_tokens": 1,
