    {
      "bbox": [
        238,
        508,
        1476,
        654
      ],
      "category": "Text",
      "text": "WHEREAS, on June 12, 2022, Governor Kathy Hochul, as Governor of the State of New York, proclaimed the IHRA \"working definition\" of antisemitism \"a vital resource in the struggle against antisemitism,\" that \"will facilitate constructive discourse, further understanding, and enable a more thoughtful response to this harmful behavior that impacts us all;\" and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.274,
          "min": -1.3918
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 80,
          "mean": -0.0002,
