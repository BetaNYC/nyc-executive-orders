    },
    {
      "bbox": [
        185,
        1443,
        1494,
        1520
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 1 of Emergency Executive Order No. 371, dated March 31, 2023, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1056,
          "min": -0.9157
        },
        "category": {
          "n_tokens": 1,
