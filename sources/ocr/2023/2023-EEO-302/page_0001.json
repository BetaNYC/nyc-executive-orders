          "min": -0.0557
        }
      },
      "ink": {
        "ink_px": 12317,
        "area_px": 104166,
        "density": 0.11824,
        "chars": 161,
        "chars_per_1k_ink": 13.07
      }
    },
    {
      "bbox": [
        182,
        1093,
        1497,
        1256
      ],
      "category": "Text",
      "text": "**WHEREAS**, the state of emergency based on the arrival of thousands of individuals and families seeking asylum, first declared in Emergency Executive Order No. 224, dated October 7, 2022, and extended most recently by Emergency Executive Order No. 278, dated December 6, 2022, remains in effect;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2128,
          "min": -1.3544
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
