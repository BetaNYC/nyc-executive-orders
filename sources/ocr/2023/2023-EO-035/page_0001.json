    {
      "bbox": [
        187,
        798,
        1499,
        875
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York continues to be committed to ensuring that all required prevailing and living wages are paid on all public works projects and service contracts; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.255,
          "min": -1.1999
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
