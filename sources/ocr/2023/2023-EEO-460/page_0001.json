        1497,
        977
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the remnants of Hurricane Ida, first declared in Emergency Executive Order No. 230, dated September 1, 2021, and last extended by Emergency Executive Order No. 436, dated June 19, 2023, remains in effect;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2002,
          "min": -1.1087
        },
        "category": {
          "n_tokens": 1,
