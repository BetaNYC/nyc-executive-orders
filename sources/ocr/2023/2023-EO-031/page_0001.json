    {
      "bbox": [
        201,
        782,
        1488,
        943
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Public Housing Preservation Trust Act, signed into law by Governor Kathy Hochul on June 16, 2022, as Chapter 225 of the Laws of 2022 (the \"Act\"), established the New York City Public Housing Preservation Trust (the \"Public Housing Preservation Trust\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2852,
          "min": -1.3825
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 73,
          "mean": -0.005,
          "min": -0.3134
        }
      },
      "ink": {
        "ink_px": 21047,
        "area_px": 205758,
        "density": 0.10229,
        "chars": 283,
        "chars_per_1k_ink": 13.45
      }
    },
    {
      "bbox": [
        201,
        972,
        1459,
        1050
      ],
      "category": "Text",
      "text": "WHEREAS, Chapter 225 provides that the Public Housing Preservation Trust shall be governed by a Board of Trustees (the \"Board\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2195,
          "min": -1.1342
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 30,
          "mean": -0.0007,
          "min": -0.014
        }
      },
      "ink": {
        "ink_px": 10248,
        "area_px": 98671,
        "density": 0.10386,
        "chars": 132,
        "chars_per_1k_ink": 12.88
      }
    },
    {
      "bbox": [
        201,
        1078,
        1488,
        1199
      ],
      "category": "Text",
      "text": "WHEREAS, the Act states that the Board shall include \"the deputy mayor for housing and economic development of the city of New York, or another deputy mayor designated by the mayor if there is no deputy mayor with that designation\"; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2067,
          "min": -1.0616
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0001,
          "min": -0.0019
        }
      },
      "ink": {
        "ink_px": 17786,
        "area_px": 154638,
        "density": 0.11502,
        "chars": 236,
        "chars_per_1k_ink": 13.27
      }
    },
    {
      "bbox": [
        201,
        1225,
        1491,
        1344
      ],
      "category": "Text",
      "text": "WHEREAS, the Chief Housing Officer of the City of New York performs the duties and has the powers and responsibilities commensurate to a Deputy Mayor in certain areas of public policy, including housing;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.224,
          "min": -1.1862
        },
        "category": {
          "n_tokens": 1,
