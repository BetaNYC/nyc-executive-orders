    {
      "bbox": [
        175,
        388,
        1486,
        622
      ],
      "category": "Text",
      "text": "**Covered Employee.** The term \"covered employee\" means a person (i) employed by a contractor or subcontractor holding a contract; (ii) whose salary is paid in whole or in part from funds provided under a City contract; and (iii) who performs any part of the work under the contract within the City of New York. However, a person whose work under the contract does not include physical interaction with City employees or members of the public shall not be deemed to be a covered employee.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2553,
          "min": -1.5408
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 102,
          "mean": -0.002,
          "min": -0.1606
        }
      },
      "ink": {
