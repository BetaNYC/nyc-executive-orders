        "chars_per_1k_ink": 14.72
      }
    },
    {
      "bbox": [
        175,
        659,
        1483,
        734
      ],
      "category": "Text",
      "text": "§ 3. Requirement. All City agencies must take all necessary actions to ensure that their contractors:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1858,
          "min": -1.2658
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0019,
          "min": -0.0019
        },
        "text": {
          "n_tokens": 20,
          "mean": -0.0063,
          "min": -0.0757
        }
      },
      "ink": {
        "ink_px": 6477,
        "area_px": 94425,
        "density": 0.06859,
        "chars": 101,
        "chars_per_1k_ink": 15.59
      }
    },
    {
      "bbox": [
        175,
        775,
        1486,
        933
      ],
      "category": "Text",
      "text": "a. Require all covered employees to wear a face covering that covers the employee's mouth and nose during days 6 to 10 after infection with COVID-19 upon returning to a work site where the employee can be expected to physically interact with City employees or members of the public in the course of performing work under the contract.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2053,
          "min": -1.3727
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0059,
          "min": -0.0059
        },
        "text": {
          "n_tokens": 67,
          "mean": -0.0001,
          "min": -0.0028
        }
      },
      "ink": {
        "ink_px": 23469,
        "area_px": 198922,
        "density": 0.11798,
        "chars": 334,
        "chars_per_1k_ink": 14.23
      }
    },
    {
      "bbox": [
        175,
        969,
        1486,
        1087
      ],
      "category": "Text",
      "text": "b. Authorize covered employees to remove their face covering in the workplace (indoors or outdoors) when they are not required by subdivision (a) of this section to wear the face covering.",
