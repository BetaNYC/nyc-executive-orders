        },
        "text": {
          "n_tokens": 52,
          "mean": -0.0,
          "min": -0.0015
        }
      },
      "ink": {
        "ink_px": 13942,
        "area_px": 145092,
        "density": 0.09609,
        "chars": 176,
        "chars_per_1k_ink": 12.62
      }
    },
    {
      "bbox": [
        182,
        1067,
        1494,
        1259
      ],
      "category": "Text",
      "text": "WHEREAS, the City has ended public health-related measures that had been ordered to address the COVID-19 emergency, including the requirement for prospective City employees to be vaccinated against COVID-19, which was rescinded by Executive Order No. 25, dated February 6, 2023; and the \"Key to NYC\" program, which was ended in accordance with Emergency Executive Order No. 50, dated March 4, 2022; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.204,
          "min": -1.2199
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 100,
          "mean": -0.0016,
          "min": -0.143
        }
      },
      "ink": {
        "ink_px": 31352,
        "area_px": 246528,
        "density": 0.12717,
        "chars": 402,
        "chars_per_1k_ink": 12.82
      }
    },
    {
      "bbox": [
        182,
        1299,
        1494,
        1415
      ],
      "category": "Text",
      "text": "WHEREAS, although the City, state, and federal governments have rescinded various public health-related measures responding to COVID-19, the City has yet to fully recover from the effects of the COVID-19 pandemic; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1999,
          "min": -1.1721
        },
        "category": {
