    {
      "bbox": [
        182,
        1569,
        1494,
        1649
      ],
      "category": "Text",
      "text": "WHEREAS, the City's office occupancy rate is approximately 48% of the pre-pandemic rate, and the City's subway ridership is at 70% of pre-pandemic levels; and",
      "logprob_stats": {
