        "density": 0.12115,
        "chars": 317,
        "chars_per_1k_ink": 13.23
      }
    },
    {
      "bbox": [
        182,
        912,
        1494,
        1025
      ],
      "category": "Text",
      "text": "WHEREAS, the federal COVID-19 public health emergency declaration ended on May 11, 2023, and the New York state disaster emergency for COVID-19 ended on September 12, 2022; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2297,
          "min": -1.2875
        },
        "category": {
          "n_tokens": 1,
