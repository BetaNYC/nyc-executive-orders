    },
    {
      "bbox": [
        182,
        1453,
        1494,
        1535
      ],
      "category": "Text",
      "text": "WHEREAS, as of June 2023, the City's unemployment rate is 5.4%, higher than the national rate of 3.7%, and higher than City's unemployment rate of 4.3% in February 2020; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.18,
          "min": -1.1563
