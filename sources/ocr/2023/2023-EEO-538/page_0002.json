    {
      "bbox": [
        203,
        871,
        1501,
        944
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 1 of Emergency Executive Order No. 536, dated December 26, 2023, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2164,
