        }
      },
      "ink": {
        "ink_px": 20375,
        "area_px": 149524,
        "density": 0.13627,
        "chars": 226,
        "chars_per_1k_ink": 11.09
      }
    },
    {
      "bbox": [
        188,
        1682,
        1500,
        1796
      ],
      "category": "Text",
      "text": "**WHEREAS**, dozens of charter buses arrive in the City each week, and such charter buses often arrive at night or over the weekend when the City's asylum-seeker operations have the least staff available to receive new arrivals;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2225,
          "min": -1.2903
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 45,
          "mean": -0.0002,
          "min": -0.0027
        }
      },
      "ink": {
        "ink_px": 20211,
        "area_px": 148235,
        "density": 0.13634,
