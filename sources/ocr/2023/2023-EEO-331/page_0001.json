        "density": 0.16708,
        "chars": 470,
        "chars_per_1k_ink": 9.87
      }
    },
    {
      "bbox": [
        179,
        1623,
        1485,
        1744
      ],
      "category": "Text",
      "text": "WHEREAS, certain employees were dismissed from their positions effective February 11,\n2022 for failing to provide proof of vaccination against COVID-19, and now may be eligible to\napply for reinstatement pursuant to PRR Rule 6.2.6, but would need adequate time to do so;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2406,
          "min": -1.3866
        },
        "category": {
          "n_tokens": 1,
