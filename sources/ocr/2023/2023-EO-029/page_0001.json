    {
      "bbox": [
        164,
        834,
        1497,
        1144
      ],
      "category": "Text",
      "text": "Section 1. There shall be six Deputy Mayors. One shall be designated the First Deputy Mayor, one shall be designated the Deputy Mayor for Operations, one shall be designated the Deputy Mayor for Economic and Workforce Development, one shall be designated the Deputy Mayor for Health and Human Services, one shall be designated the Deputy Mayor for Strategic Initiatives, and one shall be designated the Deputy Mayor for Public Safety. There shall also be a Chief Housing Officer, a Chief Technology Officer, a Chief Efficiency Officer, a Chief of Staff, a Chief Advisor, a Chief Counsel to the Mayor and City Hall, a Director of Intergovernmental and External Affairs, a Director of Communications, and a Press Secretary.",
      "logprob_stats": {
