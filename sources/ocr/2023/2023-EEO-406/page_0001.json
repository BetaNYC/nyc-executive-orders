        1504,
        1486,
        1579
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that sections 1 and 2 of Emergency Executive Order No. 402, dated May 10, 2023, are extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2275,
          "min": -1.2929
        },
        "category": {
