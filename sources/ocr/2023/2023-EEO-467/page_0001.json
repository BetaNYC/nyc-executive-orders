        1192,
        1601,
        1265
      ],
      "category": "Text",
      "text": "WHEREAS, additional reasons for requiring the measures continued in this Order are set forth in Emergency Executive Order No. 459, dated July 19, 2023;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.0678,
          "min": -0.8063
        },
        "category": {
