        "chars": 217,
        "chars_per_1k_ink": 27.66
      }
    },
    {
      "bbox": [
        91,
        768,
        1601,
        841
      ],
      "category": "Text",
      "text": "WHEREAS, as of June 2023, the City's unemployment rate is 5.4%, higher than the national rate of 3.7%, and higher than City's unemployment rate of 4.3% in February 2020; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.1616,
          "min": -0.9619
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 56,
          "mean": -0.0001,
          "min": -0.0032
        }
      },
      "ink": {
        "ink_px": 5978,
        "area_px": 95608,
        "density": 0.06253,
        "chars": 173,
        "chars_per_1k_ink": 28.94
      }
    },
    {
      "bbox": [
        91,
        874,
        1601,
        947
      ],
      "category": "Text",
      "text": "WHEREAS, the City's office occupancy rate is approximately 48% of the pre-pandemic rate, and the City's subway ridership is at 70% of pre-pandemic levels; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.1284,
          "min": -1.0435
        },
        "category": {
          "n_tokens": 1,
