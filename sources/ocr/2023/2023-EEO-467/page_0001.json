          "min": -0.0
        },
        "text": {
          "n_tokens": 44,
          "mean": -0.0,
          "min": -0.0002
        }
      },
      "ink": {
        "ink_px": 5474,
        "area_px": 94316,
        "density": 0.05804,
        "chars": 158,
        "chars_per_1k_ink": 28.86
      }
    },
    {
      "bbox": [
        91,
        980,
        1601,
        1053
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because certain emergency measures continue to be necessary for the City's recovery from the economic, housing, transportation, and other effects of the COVID-19 pandemic; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.0789,
          "min": -0.6578
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0003,
          "min": -0.0125
        }
      },
