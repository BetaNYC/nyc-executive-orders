        "chars_per_1k_ink": 10.03
      }
    },
    {
      "bbox": [
        143,
        927,
        1447,
        1001
      ],
      "category": "Text",
      "text": "WHEREAS, Section 20-d of the City Charter was added by Local Law No. 178 of 2017 to create the Office of Nightlife (\"ONL\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2394,
          "min": -1.26
        },
        "category": {
          "n_tokens": 1,
