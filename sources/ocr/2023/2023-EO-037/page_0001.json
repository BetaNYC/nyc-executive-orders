    {
      "bbox": [
        149,
        1444,
        1456,
        1553
      ],
      "category": "Text",
      "text": "Section 1. Continuation of the Office of Nightlife. ONL is hereby continued and re-established within SBS. The Director of ONL shall be appointed by the Mayor and shall report to the Commissioner of Small Business Services.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2163,
          "min": -1.1423
        },
        "category": {
          "n_tokens": 1,
