    {
      "bbox": [
        143,
        777,
        1449,
        891
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York is interested in promoting the local economy and fostering programs and initiatives that support a thriving small business community in all sectors, including the City's nightlife industry; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2554,
