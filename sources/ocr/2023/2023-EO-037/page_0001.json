        "density": 0.14104,
        "chars": 127,
        "chars_per_1k_ink": 9.71
      }
    },
    {
      "bbox": [
        145,
        1038,
        1447,
        1111
      ],
      "category": "Text",
      "text": "WHEREAS, Executive Order No. 37 of 2018 established ONL within the Mayor's Office of Media and Entertainment (\"MOME\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2068,
          "min": -1.2088
        },
        "category": {
          "n_tokens": 1,
