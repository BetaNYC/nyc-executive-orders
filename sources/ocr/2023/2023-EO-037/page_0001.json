        "density": 0.15366,
        "chars": 122,
        "chars_per_1k_ink": 8.79
      }
    },
    {
      "bbox": [
        246,
        1150,
        1343,
        1183
      ],
      "category": "Text",
      "text": "WHEREAS, Executive Order No. 21 of 2022 continued ONL within MOME; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2221,
          "min": -1.3225
