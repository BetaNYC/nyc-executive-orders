    },
    {
      "bbox": [
        147,
        1222,
        1450,
        1296
      ],
      "category": "Text",
      "text": "WHEREAS, Section 20-d of the City Charter has been amended by local law to permit ONL to be established within the New York City Department of Small Business Services (\"SBS\");",
      "logprob_stats": {
        "bbox": {
