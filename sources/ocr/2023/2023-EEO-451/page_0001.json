          "min": -0.0
        },
        "text": {
          "n_tokens": 56,
          "mean": -0.0001,
          "min": -0.0041
        }
      },
      "ink": {
        "ink_px": 13193,
        "area_px": 104328,
        "density": 0.12646,
        "chars": 173,
        "chars_per_1k_ink": 13.11
      }
    },
    {
      "bbox": [
        183,
        997,
        1499,
        1077
      ],
      "category": "Text",
      "text": "WHEREAS, the City's office occupancy rate is approximately 48% of the pre-pandemic rate, and the City's subway ridership is at 70% of pre-pandemic levels; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1844,
          "min": -1.1852
        },
        "category": {
