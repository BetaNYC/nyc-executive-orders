    },
    {
      "bbox": [
        196,
        870,
        1505,
        987
      ],
      "category": "Text",
      "text": "WHEREAS, studies by the National Bureau of Economic Research and other institutions suggest that the economic and health effects of COVID-19 have had a persistent disproportionately negative impact on M/WBEs; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1525,
          "min": -0.9425
