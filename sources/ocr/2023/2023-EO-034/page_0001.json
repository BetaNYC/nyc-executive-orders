    {
      "bbox": [
        196,
        716,
        1505,
        833
      ],
      "category": "Text",
      "text": "WHEREAS, there is increasing national awareness that minority and women owned business enterprises (\u201cM/WBEs\u201d) continue to be underrepresented in the successful business community; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
