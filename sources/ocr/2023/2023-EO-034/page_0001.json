        }
      },
      "ink": {
        "ink_px": 6896,
        "area_px": 102068,
        "density": 0.06756,
        "chars": 141,
        "chars_per_1k_ink": 20.45
      }
    },
    {
      "bbox": [
        196,
        1140,
        1505,
        1219
      ],
      "category": "Text",
      "text": "WHEREAS Executive Order No. 26, dated February 16, 2023, created, and empowered the position of citywide Chief Business Diversity Officer (\u201cCBDO\u201d); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.0903,
