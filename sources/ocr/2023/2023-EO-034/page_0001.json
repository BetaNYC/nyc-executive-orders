        "chars": 212,
        "chars_per_1k_ink": 20.68
      }
    },
    {
      "bbox": [
        196,
        1024,
        1505,
        1103
      ],
      "category": "Text",
      "text": "WHEREAS, studies undertaken by the City demonstrate an underutilization of M/WBEs in the market where the City conducts its procurements; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1494,
          "min": -1.0629
        },
        "category": {
          "n_tokens": 1,
