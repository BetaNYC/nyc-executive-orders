    },
    {
      "bbox": [
        201,
        1060,
        1501,
        1250
      ],
      "category": "Text",
      "text": "WHEREAS, the vast majority of street vendors are unlicensed and the extent of unlicensed street vending activity has interfered in certain areas with the legitimate interests of small retail business owners and other citizens of the City; and",
      "logprob_stats": {
        "bbox": {
