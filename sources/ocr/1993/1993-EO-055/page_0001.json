    },
    {
      "bbox": [
        201,
        1290,
        1501,
        1476
      ],
      "category": "Text",
      "text": "WHEREAS, each Deputy Mayor and over twenty City agencies have responsibilities regarding various aspects of the street vending industry, and greater coordination of policy is needed; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1998,
