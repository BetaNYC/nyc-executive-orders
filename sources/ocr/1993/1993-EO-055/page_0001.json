    {
      "bbox": [
        202,
        905,
        1499,
        1018
      ],
      "category": "Text",
      "text": "WHEREAS, street vending is a thriving industry in New York City and provides economic opportunity to a broad spectrum of New Yorkers; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2415,
