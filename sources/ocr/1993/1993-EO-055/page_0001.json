    },
    {
      "bbox": [
        204,
        1521,
        1501,
        1711
      ],
      "category": "Text",
      "text": "WHEREAS, it is the objective of the City to advance an effective and consistent approach to regulation of street vending that will ultimately reduce illegal vending, but will be supportive of an appropriate role for legal vending and vendors in the City's economy;",
      "logprob_stats": {
