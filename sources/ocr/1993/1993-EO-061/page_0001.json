    },
    {
      "bbox": [
        234,
        1640,
        1536,
        1756
      ],
      "category": "Text",
      "text": "WHEREAS, the Harlem Urban Development Corporation (\"HUDC\"), a state chartered economic development corporation, has expressed a strong interest in nominating Harlem for Empowerment Zone status; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1813,
          "min": -1.1174
