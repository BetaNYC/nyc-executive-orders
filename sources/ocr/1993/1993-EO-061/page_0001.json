        1797,
        1538,
        1912
      ],
      "category": "Text",
      "text": "WHEREAS, the Act mandates that the affected community be a full partner in the strategic planning process leading to submission of an application for designation of Empowerment Zone status;",
      "logprob_stats": {
        "bbox": {
