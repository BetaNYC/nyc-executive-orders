    },
    {
      "bbox": [
        247,
        1374,
        1388,
        1474
      ],
      "category": "Text",
      "text": "WHEREAS, the City has incorporated domestic violence prevention into the New York City Police Department's community policing program, thereby expanding the \"Safe Streets, Safe City\" program, into a \"Safe Streets, Safe City, Safe Homes\" program; and",
      "logprob_stats": {
        "bbox": {
