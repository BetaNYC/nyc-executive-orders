    },
    {
      "bbox": [
        247,
        1037,
        1388,
        1103
      ],
      "category": "Text",
      "text": "WHEREAS, domestic violence is a devastating phenomena that respects no boundaries of race, ethnicity, age, gender, sexual orientation, or economic status; and",
      "logprob_stats": {
