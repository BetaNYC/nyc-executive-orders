        }
      },
      "ink": {
        "ink_px": 15594,
        "area_px": 94896,
        "density": 0.16433,
        "chars": 158,
        "chars_per_1k_ink": 10.13
      }
    },
    {
      "bbox": [
        241,
        1103,
        1547,
        1176
      ],
      "category": "Text",
      "text": "WHEREAS, the policies and programs of this Administration have been dedicated to assisting children and families in need; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2238,
          "min": -1.1706
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 22,
          "mean": -0.0025,
          "min": -0.0536
        }
      },
      "ink": {
        "ink_px": 13537,
        "area_px": 97310,
        "density": 0.13911,
        "chars": 125,
        "chars_per_1k_ink": 9.23
      }
    },
    {
      "bbox": [
        241,
        1217,
        1547,
        1328
      ],
      "category": "Text",
      "text": "WHEREAS, during the past four years the City has more than doubled the number of emergency shelter beds for victims of domestic violence and their children, and has for the first time ever designed non-residential services for this population; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2,
          "min": -0.9753
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 46,
          "mean": -0.0,
          "min": -0.0003
        }
      },
      "ink": {
        "ink_px": 26008,
        "area_px": 148595,
        "density": 0.17503,
        "chars": 247,
        "chars_per_1k_ink": 9.5
      }
    },
    {
      "bbox": [
        241,
        1371,
        1545,
        1484
      ],
      "category": "Text",
      "text": "WHEREAS, the City has incorporated domestic violence prevention into the New York City Police Department's community policing program, thereby expanding the \"Safe Streets, Safe City\" program, into a \"Safe Streets, Safe Homes\" program; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1967,
          "min": -1.1343
        },
        "category": {
          "n_tokens": 1,
