    {
      "bbox": [
        241,
        875,
        1552,
        947
      ],
      "category": "Text",
      "text": "WHEREAS, it is estimated that domestic violence affects as many as 279, 300 households in New York City every year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2596,
          "min": -1.2258
        },
        "category": {
          "n_tokens": 1,
