    {
      "bbox": [
        225,
        1069,
        1537,
        1295
      ],
      "category": "Text",
      "text": "Section 1. There shall be six Deputy Mayors. One shall be designated the First Deputy Mayor, one shall be designated Deputy Mayor for Finance and Economic Development, one shall be designated Deputy Mayor for Planning and Development, one shall be designated Deputy Mayor for Public and Community Affairs, one shall be designated Deputy Mayor for Public Safety, and one shall be designated Deputy Mayor for Health and Human Services.",
