          "min": -0.0891
        },
        "text": {
          "n_tokens": 50,
          "mean": -0.0006,
          "min": -0.0234
        }
      },
      "ink": {
        "ink_px": 9992,
        "area_px": 48370,
        "density": 0.20657,
        "chars": 258,
        "chars_per_1k_ink": 25.82
