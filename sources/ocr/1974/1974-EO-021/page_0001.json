        "area_px": 275184,
        "density": 0.22645,
        "chars": 1125,
        "chars_per_1k_ink": 18.05
      }
    },
    {
      "bbox": [
        403,
        1668,
        1277,
        1712
      ],
      "category": "Text",
      "text": "\u00a7 5. The Mayor or the Counsel to the Board of Ethics may refer any prospective appointee to the full Board of Ethics for consideration.",
