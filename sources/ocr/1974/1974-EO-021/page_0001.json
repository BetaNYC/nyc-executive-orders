      }
    },
    {
      "bbox": [
        423,
        1271,
        1277,
        1356
      ],
      "category": "List-item",
      "text": "C. For an individual who is appointed to a permanent competitive Civil Service position at a starting salary equal to or greater than the minimum rate of M-1 or E-1 of the Managerial or Executive Pay Plans, as a result of an open competitive examination.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1202,
          "min": -1.0763
        },
        "category": {
          "n_tokens": 2,
