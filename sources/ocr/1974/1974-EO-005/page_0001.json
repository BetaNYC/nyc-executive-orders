    {
      "bbox": [
        591,
        1046,
        1318,
        1115
      ],
      "category": "Text",
      "text": "Whereas, Section 3 of the New York City Charter authorizes the Mayor, as Chief Executive Officer of the City, to create such positions within his Executive Office as he may deem necessary to fulfill his duties, and to delegate specified functions, powers and duties to any member of said Office, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2085,
          "min": -1.1526
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 60,
          "mean": -0.0011,
          "min": -0.058
        }
      },
      "ink": {
        "ink_px": 9857,
        "area_px": 50680,
        "density": 0.19449,
        "chars": 299,
        "chars_per_1k_ink": 30.33
      }
    },
    {
      "bbox": [
        591,
        1115,
        1318,
        1167
      ],
      "category": "Text",
      "text": "Whereas, Section 210 of the Civil Service Law imposes certain functions, powers and duties upon the Chief Executive Officer of the City when it appears that a violation of subdivision 2 of that section may have occurred, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1697,
          "min": -1.016
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 46,
          "mean": -0.0046,
          "min": -0.2072
        }
      },
      "ink": {
        "ink_px": 7339,
        "area_px": 38372,
        "density": 0.19126,
        "chars": 224,
        "chars_per_1k_ink": 30.52
      }
    },
    {
      "bbox": [
        591,
        1167,
        1318,
        1202
      ],
      "category": "Text",
      "text": "Whereas, It is deemed necessary to appoint a Special Assistant to the Mayor to exercise the aforementioned functions, powers and duties, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1721,
          "min": -1.0995
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 26,
