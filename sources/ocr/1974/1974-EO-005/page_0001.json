      "bbox": [
        591,
        1272,
        1318,
        1307
      ],
      "category": "Text",
      "text": "Whereas, It is necessary and desirable to continue in effect the provisions of Executive Order No. 32 of January 21, 1971.",
      "logprob_stats": {
        "bbox": {
