          "min": -0.1812
        }
      },
      "ink": {
        "ink_px": 4776,
        "area_px": 25340,
        "density": 0.18848,
        "chars": 140,
        "chars_per_1k_ink": 29.31
      }
    },
    {
      "bbox": [
        591,
        1202,
        1318,
        1270
      ],
      "category": "Text",
      "text": "Whereas, On January 21, 1971 by Executive Order No. 32 Mayor John V. Lindsay appointed the Personnel Director of The City of New York as Special Assistant to the Mayor to investigate and make determinations pursuant to Section 210 of the Civil Service Law, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1749,
          "min": -1.0187
        },
        "category": {
          "n_tokens": 1,
