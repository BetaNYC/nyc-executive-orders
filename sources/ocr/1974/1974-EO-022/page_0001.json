    },
    {
      "bbox": [
        355,
        763,
        1273,
        807
      ],
      "category": "Text",
      "text": "Whereas, There exists the historical precedent of the Interdepartmental Health Council which was established to coordinate health services and functioned from 1952 to 1967.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2366,
