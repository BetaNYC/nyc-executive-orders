        "ink_px": 9455,
        "area_px": 38425,
        "density": 0.24606,
        "chars": 245,
        "chars_per_1k_ink": 25.91
      }
    },
    {
      "bbox": [
        516,
        1352,
        978,
        1368
      ],
      "category": "Text",
      "text": "§ 8. This Executive Order shall take effect immediately.",
