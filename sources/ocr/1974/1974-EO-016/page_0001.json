        1234,
        486
      ],
      "category": "Text",
      "text": "AMENDMENT OF EXECUTIVE ORDER NO. 28, DATED NOVEMBER 19, 1970",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2178,
