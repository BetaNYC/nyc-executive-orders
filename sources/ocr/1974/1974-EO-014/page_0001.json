          "min": -0.004
        }
      },
      "ink": {
        "ink_px": 12939,
        "area_px": 81696,
        "density": 0.15838,
        "chars": 242,
        "chars_per_1k_ink": 18.7
      }
    },
    {
      "bbox": [
        420,
        1203,
        1301,
        1270
      ],
      "category": "List-item",
      "text": "(b) Equal employment opportunity under this Order shall include but shall not be limited to the following: recruitment, hiring, selection, benefits, promotion, transfer, separation, compensation, and skills training.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1173,
          "min": -0.6886
        },
        "category": {
