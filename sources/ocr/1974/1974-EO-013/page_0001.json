        "density": 0.23819,
        "chars": 84,
        "chars_per_1k_ink": 24.22
      }
    },
    {
      "bbox": [
        451,
        1205,
        1247,
        1337
      ],
      "category": "Text",
      "text": "Section 1. A Manhattan Civic Center Task Force is hereby created consisting of the First Deputy Mayor, the Administrator of the Municipal Service Administration, who shall serve as Chairman, the Chairman of the City Planning Commission, the Administrator of the Parks, Recreation and Cultural Affairs Administration, the Administrator of the Transportation Administration, the Director of the Bureau of the Budget and the Director of the Office of Lower Manhattan Development. The President of the Borough of Manhattan has agreed to serve as a member of this Task Force.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1681,
          "min": -1.0796
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0486,
          "min": -0.0486
        },
        "text": {
          "n_tokens": 99,
          "mean": -0.0001,
          "min": -0.0073
        }
      },
      "ink": {
        "ink_px": 23949,
        "area_px": 105469,
        "density": 0.22707,
        "chars": 570,
        "chars_per_1k_ink": 23.8
      }
    },
    {
      "bbox": [
        454,
        1337,
        1247,
        1373
      ],
      "category": "Text",
      "text": "\u00a7 2. With respect to the Manhattan Civic Center area, it shall be the duty of this Task Force to:",
      "logprob_stats": {
