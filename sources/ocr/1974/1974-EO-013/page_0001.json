          "min": -0.0001
        },
        "text": {
          "n_tokens": 40,
          "mean": -0.0003,
          "min": -0.0055
        }
      },
      "ink": {
        "ink_px": 7532,
        "area_px": 30771,
        "density": 0.24478,
        "chars": 181,
        "chars_per_1k_ink": 24.03
      }
    },
    {
      "bbox": [
        491,
        1186,
        1221,
        1205
      ],
      "category": "Text",
      "text": "Now, therefore, by the power vested in me as Mayor, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1866,
          "min": -1.1257
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0486,
          "min": -0.0486
        },
        "text": {
          "n_tokens": 20,
