    },
    {
      "bbox": [
        290,
        1248,
        1496,
        1395
      ],
      "category": "Text",
      "text": "Section 1. The public is urged to avoid all unnecessary driving and remain off the roads effective Tuesday, March 14, 2017, 12:01 am to midnight and to use public transportation wherever possible. Members of the public who must drive due to an emergency shall use extreme caution.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2551,
          "min": -1.3928
        },
        "category": {
          "n_tokens": 1,
