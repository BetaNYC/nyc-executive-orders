    {
      "bbox": [
        189,
        855,
        1488,
        970
      ],
      "category": "Text",
      "text": "WHEREAS, the public safety is imperiled by a severe snow storm that is expected to interrupt the flow of traffic, restrict the operation of emergency vehicles and impede the delivery of essential goods and services;",
