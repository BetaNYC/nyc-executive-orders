    },
    {
      "bbox": [
        189,
        1104,
        1464,
        1216
      ],
      "category": "Text",
      "text": "NOW THEREFORE, by the power vested in me as Mayor of the City of New York pursuant to law, including Executive Law \u00a7 24, I hereby proclaim a state of local emergency in the City of New York and order:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2515,
          "min": -1.3825
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
