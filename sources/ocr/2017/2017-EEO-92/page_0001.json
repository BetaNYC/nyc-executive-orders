    },
    {
      "bbox": [
        189,
        999,
        1443,
        1080
      ],
      "category": "Text",
      "text": "WHEREAS, it is necessary to restrict the movement of vehicular traffic as provided herein in order to protect life and property and to allow for rapid and effective snow removal;",
