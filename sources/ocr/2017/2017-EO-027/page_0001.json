        "chars_per_1k_ink": 10.54
      }
    },
    {
      "bbox": [
        204,
        1668,
        1472,
        1829
      ],
      "category": "Text",
      "text": "WHEREAS, a centralized, standardized, and transparent framework that organizes and defines the functional elements of all types of Client and Community Services procured by New York City has resulted in CCS Agencies being able to conduct more efficient and effective solicitations for their programs; and",
      "logprob_stats": {
        "bbox": {
