    {
      "bbox": [
        196,
        691,
        1476,
        815
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York provides a wide range of health and human services, as well as social and economic support services (\"Client and Community Services\"), to a diverse client population throughout New York City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2774,
          "min": -1.3571
        },
        "category": {
