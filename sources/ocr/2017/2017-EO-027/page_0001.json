      }
    },
    {
      "bbox": [
        196,
        841,
        1470,
        1114
      ],
      "category": "Text",
      "text": "WHEREAS, among the Agencies providing such Client and Community Services are the Administration for Children's Services, Department for the Aging, Department of Correction, Mayor's Office of Criminal Justice, Department of Health and Mental Hygiene, Department of Probation, Department of Housing Preservation and Development, Department of Small Business Services, Department of Homeless Services, Department of Youth and Community Development, and Department of Social Services, acting through the Human Resources Administration, referred to collectively herein as \"CCS Agencies\"; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2746,
          "min": -1.4077
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 100,
          "mean": -0.0008,
          "min": -0.0623
        }
      },
      "ink": {
        "ink_px": 58411,
