        "density": 0.17043,
        "chars": 586,
        "chars_per_1k_ink": 10.03
      }
    },
    {
      "bbox": [
        199,
        1144,
        1491,
        1267
      ],
      "category": "Text",
      "text": "WHEREAS, in furtherance of their mission to serve New Yorkers, CCS Agencies enter into contracts with not-for-profit organizations and other private entities (\"CCS Providers\") for the provision of Client and Community Services, amounting to several billion dollars each year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2556,
          "min": -1.3763
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 53,
          "mean": -0.0001,
          "min": -0.0009
        }
      },
      "ink": {
        "ink_px": 25930,
        "area_px": 158844,
        "density": 0.16324,
        "chars": 279,
        "chars_per_1k_ink": 10.76
      }
    },
    {
      "bbox": [
        201,
        1294,
        1457,
        1377
      ],
      "category": "Text",
      "text": "WHEREAS, CCS Providers are vital to the well-being of millions of New Yorkers, especially the City's most vulnerable residents; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2463,
          "min": -1.2984
        },
        "category": {
          "n_tokens": 1,
