    {
      "bbox": [
        191,
        569,
        1488,
        884
      ],
      "category": "Text",
      "text": "Section 1. HHS Accelerator was established by Executive Order No. 160, dated April 9, 2012, to facilitate the central management of the procurement process for Client and Community Services and contractual relationships with current and prospective CCS Providers. HHS Accelerator shall be located within the Mayor's Office of Contract Services (\"MOCS\") and shall be headed by the Director of the Mayor's Office of Contract Services (\"Director\"), who shall report to the First Deputy Mayor. Previous actions taken pursuant to Executive Order No. 160, dated April 9, 2012, are hereby ratified and continued, pending further actions taken pursuant to this Order.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3094,
          "min": -1.5925
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 144,
          "mean": -0.0003,
          "min": -0.0266
        }
      },
      "ink": {
        "ink_px": 61134,
        "area_px": 402570,
        "density": 0.15186,
        "chars": 659,
        "chars_per_1k_ink": 10.78
      }
    },
    {
      "bbox": [
        196,
        913,
        1448,
        995
      ],
      "category": "Text",
      "text": "\u00a7 2. The Director shall implement HHS Accelerator through the following powers and duties:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3039,
          "min": -1.549
        },
        "category": {
          "n_tokens": 1,
