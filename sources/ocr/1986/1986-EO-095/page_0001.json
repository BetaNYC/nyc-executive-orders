        "density": 0.15782,
        "chars": 169,
        "chars_per_1k_ink": 9.34
      }
    },
    {
      "bbox": [
        384,
        1517,
        1518,
        1613
      ],
      "category": "Text",
      "text": "Section 4. **Annual Report.** The Office shall report annually to the\nMayor on its activities and shall prepare such other reports as the Mayor\nshall request.",
      "logprob_stats": {
        "bbox": {
