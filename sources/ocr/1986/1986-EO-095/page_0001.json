      "bbox": [
        382,
        862,
        1515,
        924
      ],
      "category": "Text",
      "text": "By the power vested in me as Mayor of the City of New York, it is\nhereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2509,
          "min": -1.2739
        },
        "category": {
