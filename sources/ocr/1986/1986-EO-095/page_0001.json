        "chars": 81,
        "chars_per_1k_ink": 11.16
      }
    },
    {
      "bbox": [
        382,
        960,
        1563,
        1153
      ],
      "category": "Text",
      "text": "Section 1: **Office Established.** The New York City Energy and Telecommunications Office (the \"Office\") is hereby established in the Office of the Mayor. The Office shall be headed by a Director, who shall also serve as the Director of the New York City Public Utility Service (\"NYCPUS\"). The Director shall report to the Deputy Mayor for Finance and Economic Development.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.226,
          "min": -1.2169
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0067,
          "min": -0.0067
        },
        "text": {
          "n_tokens": 78,
          "mean": -0.006,
          "min": -0.395
        }
      },
      "ink": {
        "ink_px": 39543,
        "area_px": 229905,
        "density": 0.172,
        "chars": 373,
        "chars_per_1k_ink": 9.43
      }
    },
    {
      "bbox": [
        382,
        1189,
        1559,
        1348
      ],
      "category": "Text",
      "text": "Section 2. **Responsibilities.** The Office shall (a) have overall\nresponsibility for the development and coordination of energy policy and\ntelecommunications policy for the City, and (b) exercise all of the functions,\npowers and duties of the public utility service established by Chapter 73 of\nthe New York City Administrative Code.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2081,
          "min": -0.9156
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 72,
          "mean": -0.0064,
          "min": -0.4291
        }
      },
      "ink": {
        "ink_px": 34873,
        "area_px": 189175,
        "density": 0.18434,
        "chars": 334,
        "chars_per_1k_ink": 9.58
      }
    },
    {
      "bbox": [
        384,
        1384,
        1544,
        1481
      ],
      "category": "Text",
      "text": "Section 3. **Staff and Expenses.** The Office shall have such staff and\nincur such expenses necessary for it to perform its responsibilities and\neffectuate its purposes.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2244,
          "min": -1.3437
        },
        "category": {
          "n_tokens": 1,
