    {
      "bbox": [
        365,
        510,
        1360,
        540
      ],
      "category": "Text",
      "text": "I am today issuing two important executive orders.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2882,
          "min": -1.4851
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0234,
          "min": -0.0234
        },
        "text": {
