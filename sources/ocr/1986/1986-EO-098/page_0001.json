    {
      "bbox": [
        308,
        1011,
        1485,
        1103
      ],
      "category": "Text",
      "text": "Section 1. **Advisory Board Established.** There is hereby created an\nAdvisory Board for the Office of Chief Medical Examiner of the City of New\nYork.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2246,
