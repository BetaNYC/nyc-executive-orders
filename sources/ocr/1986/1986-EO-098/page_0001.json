      }
    },
    {
      "bbox": [
        308,
        1142,
        1505,
        1492
      ],
      "category": "Text",
      "text": "Section 2. **Purpose.** The purpose of the Board is to provide advice, consultation and recommendations to the Chief Medical Examiner and to the Mayor concerning the general policies and operations of the Office of Chief Medical Examiner of the City of New York. To enable the Board to properly perform its advisory functions, there should be full and open communications between the Board and the Chief Medical Examiner. This Order provides some general guidelines on communication and information to help achieve that goal. The Board's functions are advisory and are not intended to substitute for or assume the powers and duties under law of the Chief Medical Examiner, particularly in regard to his obligation to arrive independently at judgments of the cause of death in individual cases.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2201,
          "min": -1.3479
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 140,
          "mean": -0.0013,
