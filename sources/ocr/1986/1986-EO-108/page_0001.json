        "density": 0.1612,
        "chars": 332,
        "chars_per_1k_ink": 16.78
      }
    },
    {
      "bbox": [
        312,
        1133,
        861,
        1202
      ],
      "category": "List-item",
      "text": "(ii) an emergency contract or other exempt contract except as the Bureau may direct by regulation; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2186,
          "min": -1.1376
        },
        "category": {
