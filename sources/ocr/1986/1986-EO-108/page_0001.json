    {
      "bbox": [
        309,
        714,
        902,
        876
      ],
      "category": "Text",
      "text": "\"Submission Requirements. No contracting agency shall enter into a contract with any contractor unless such contractor's employment report is first submitted to the Bureau for its review. Unless otherwise required by law, an employment report shall not be required for the following:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.2472,
          "min": -1.0753
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0061,
          "min": -0.0061
        },
        "text": {
          "n_tokens": 48,
          "mean": -0.0048,
          "min": -0.1639
        }
      },
      "ink": {
        "ink_px": 18180,
        "area_px": 96714,
        "density": 0.18798,
        "chars": 283,
        "chars_per_1k_ink": 15.57
      }
    },
    {
      "bbox": [
        310,
        902,
        902,
        1108
      ],
      "category": "List-item",
      "text": "(i) a construction contract in the amount of less than $1 million; a construction subcontract in the amount of less than $750,000; or a supply and service contract in the amount of $50,000 or less or of more than $50,000 in which the contractor employs fewer than 50 employees at the facility or facilities involved in the contract;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2304,
          "min": -0.9909
        },
        "category": {
          "n_tokens": 2,
