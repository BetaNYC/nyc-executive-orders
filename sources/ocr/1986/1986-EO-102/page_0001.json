    {
      "bbox": [
        404,
        601,
        1282,
        649
      ],
      "category": "Text",
      "text": "Section 2. **Responsibilities of the Auditor General.** The Auditor General shall:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2811,
          "min": -1.5901
        },
        "category": {
          "n_tokens": 1,
