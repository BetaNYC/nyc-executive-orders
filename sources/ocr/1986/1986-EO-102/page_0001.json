    {
      "bbox": [
        402,
        443,
        1314,
        572
      ],
      "category": "Text",
      "text": "Section 1. **Office Established.** The Office of the Auditor General (the \"Office\") is hereby established in the Office of the Mayor. The Office shall be headed by the Auditor General, who shall be appointed by, report to and serve at the pleasure of the Mayor.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2292,
          "min": -1.2637
        },
        "category": {
          "n_tokens": 1,
