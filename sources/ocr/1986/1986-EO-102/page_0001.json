          "min": -0.1836
        },
        "text": {
          "n_tokens": 18,
          "mean": -0.0177,
          "min": -0.3142
        }
      },
      "ink": {
        "ink_px": 7242,
        "area_px": 42826,
        "density": 0.1691,
        "chars": 82,
        "chars_per_1k_ink": 11.32
      }
    },
    {
      "bbox": [
        406,
        679,
        1303,
        758
      ],
      "category": "List-item",
      "text": "(a) Establish a uniform policy, including procedures and guidelines, for the conduct of internal audits in all Mayoral agencies;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2376,
          "min": -1.2339
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.002,
          "min": -0.0041
        },
        "text": {
          "n_tokens": 25,
          "mean": -0.0005,
          "min": -0.006
        }
      },
      "ink": {
        "ink_px": 9852,
        "area_px": 71440,
        "density": 0.13791,
        "chars": 128,
        "chars_per_1k_ink": 12.99
      }
    },
    {
      "bbox": [
        409,
        785,
        1242,
        862
      ],
      "category": "List-item",
      "text": "(b) Coordinate and supervise the conduct of such internal audits to insure that major functions of each agency are audited regularly;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.247,
          "min": -1.2912
        },
        "category": {
