      "bbox": [
        410,
        888,
        1303,
        962
      ],
      "category": "List-item",
      "text": "(c) Oversee the recruitment, training and assignment of an adequate number of qualified auditors and staff to conduct such internal audits;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2357,
