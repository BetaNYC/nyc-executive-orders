    {
      "bbox": [
        376,
        687,
        1352,
        801
      ],
      "category": "List-item",
      "text": "\u00a7 2. Members. (a) The Council shall be composed of five members appointed by the Mayor. The health services administrator shall be a member and shall serve as chairman of the Council. Two members shall be health care professionals with substantial experience in emergency care; and two members shall be representatives of the general public and shall not be providers of health care.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2417,
          "min": -1.2458
