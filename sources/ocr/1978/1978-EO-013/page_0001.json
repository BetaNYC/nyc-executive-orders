        "chars": 91,
        "chars_per_1k_ink": 13.63
      }
    },
    {
      "bbox": [
        455,
        747,
        1434,
        833
      ],
      "category": "Text",
      "text": "Section 1. There is hereby continued in the Office of the Mayor the Council on the Environment of New York City (hereinafter called the Council). The Council shall promote environmental concern among New Yorkers and develop solutions to the environmental problems of the City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2363,
          "min": -1.2247
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0263,
          "min": -0.0263
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0034,
          "min": -0.1199
        }
      },
      "ink": {
        "ink_px": 15150,
        "area_px": 84912,
        "density": 0.17842,
        "chars": 276,
        "chars_per_1k_ink": 18.22
      }
    },
    {
      "bbox": [
        455,
        832,
        1434,
        940
      ],
      "category": "Text",
      "text": "§ 2. The Council shall be composed of not less than 15 or more than 35 members. Members shall be appointed by the Mayor for a term of two years. A vacancy occurring other than by expiration of a term shall be filled by the Mayor for the remainder of the term. Members of the Council serving presently shall continue to serve until the expiration of their respective terms.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2144,
          "min": -1.2109
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.2524,
          "min": -0.2524
        },
        "text": {
          "n_tokens": 79,
          "mean": -0.0007,
          "min": -0.0321
        }
      },
      "ink": {
        "ink_px": 18687,
        "area_px": 106384,
        "density": 0.17566,
        "chars": 372,
        "chars_per_1k_ink": 19.91
      }
    },
    {
      "bbox": [
        455,
        940,
        1434,
        1030
      ],
      "category": "Text",
      "text": "§ 3. The membership of the Council shall include representatives of agencies concerned with protecting the environment. At least three-quarters of the members shall be individuals who do not, at the time of their appointment, hold public office or employment. The members of the Council shall serve without compensation.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1983,
          "min": -1.2136
        },
        "category": {
          "n_tokens": 1,
