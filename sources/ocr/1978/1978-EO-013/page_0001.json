    {
      "bbox": [
        455,
        703,
        1431,
        748
      ],
      "category": "Text",
      "text": "BY VIRTUE OF THE POWER VESTED IN ME AS MAYOR OF THE CITY OF NEW YORK, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2649,
          "min": -1.3105
        },
        "category": {
