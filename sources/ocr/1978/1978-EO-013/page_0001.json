        "chars": 320,
        "chars_per_1k_ink": 19.2
      }
    },
    {
      "bbox": [
        457,
        1029,
        1434,
        1073
      ],
      "category": "Text",
      "text": "§ 4. The Chairman of the Council shall be designated by the Mayor from among members of the Council and shall be a resident of the City of New York.",
      "logprob_stats": {
