    {
      "bbox": [
        425,
        1186,
        1387,
        1230
      ],
      "category": "Text",
      "text": "Section 1. All Executive Orders in effect on December 31, 1977, are hereby continued, except to the extent set forth in Section 9 of Executive Order No. 2 issued concurrently herewith.",
