        409,
        727,
        850,
        752
      ],
      "category": "Section-header",
      "text": "\u00a7 3. Responsibilities of Inspectors General.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 18,
          "mean": -0.281,
          "min": -1.1817
        },
