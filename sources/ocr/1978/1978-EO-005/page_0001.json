    {
      "bbox": [
        425,
        887,
        1394,
        928
      ],
      "category": "Text",
      "text": "By the power vested in me as Mayor of The City of New York, it is hereby ordered as\nfollows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2467,
          "min": -1.2333
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.001,
          "min": -0.001
        },
        "text": {
          "n_tokens": 24,
          "mean": -0.0221,
          "min": -0.5239
        }
      },
      "ink": {
        "ink_px": 5180,
