        "density": 0.12689,
        "chars": 92,
        "chars_per_1k_ink": 17.76
      }
    },
    {
      "bbox": [
        425,
        930,
        1394,
        1039
      ],
      "category": "Text",
      "text": "Section 1. A South Bronx Coordinating Council is hereby created, to be headed by the Mayor. The Council shall consist of the Mayor, the Deputy Mayor for Economic Development, the Deputy Mayor for Management, the Chairman of the City Planning Commission, the Commissioner of the Department of Housing Preservation and Development, the Director of Management and Budget and the Corporation Counsel.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1871,
          "min": -0.885
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0891,
          "min": -0.0891
        },
        "text": {
          "n_tokens": 73,
          "mean": -0.0014,
          "min": -0.0894
        }
      },
      "ink": {
        "ink_px": 24162,
        "area_px": 106920,
        "density": 0.22598,
        "chars": 396,
        "chars_per_1k_ink": 16.39
      }
    },
    {
      "bbox": [
        425,
        1039,
        1394,
        1082
      ],
      "category": "Text",
      "text": "\u00a7 2. The Mayor's Coordinator for South Bronx Redevelopment shall serve as Executive Director of the Council.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1794,
          "min": -1.2002
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.1129,
          "min": -0.1129
        },
        "text": {
          "n_tokens": 22,
          "mean": -0.0028,
          "min": -0.0337
        }
      },
      "ink": {
        "ink_px": 6321,
        "area_px": 42768,
        "density": 0.1478,
        "chars": 108,
        "chars_per_1k_ink": 17.09
      }
    },
    {
      "bbox": [
        425,
        1082,
        1392,
        1127
      ],
      "category": "Text",
      "text": "\u00a7 3. The Council shall coordinate planning, development and related efforts in the South Bronx for the City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1839,
          "min": -1.1473
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 22,
          "mean": -0.0003,
          "min": -0.0045
        }
      },
      "ink": {
        "ink_px": 6224,
        "area_px": 44620,
        "density": 0.13949,
        "chars": 108,
        "chars_per_1k_ink": 17.35
      }
    },
    {
      "bbox": [
        423,
        1127,
        1392,
        1282
      ],
      "category": "Text",
      "text": "\u00a7 4. All appropriate City agencies, including without limitation the Department of Employment, the Department of Buildings, the Human Resources Administration, the Department of Transportation, the Department of Parks and Recreation, the Department of Health, the Department of Environmental Protection and the Department of General Services, are directed to assign senior personnel to assist the Council in its efforts, to attend meetings requested by the Council and to work with the Council members to carry out the national, State and City policy objectives and operations in the South Bronx.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1734,
          "min": -1.2023
        },
        "category": {
