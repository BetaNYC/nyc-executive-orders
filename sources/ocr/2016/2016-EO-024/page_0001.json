          "min": -0.252
        }
      },
      "ink": {
        "ink_px": 24071,
        "area_px": 161590,
        "density": 0.14896,
        "chars": 239,
        "chars_per_1k_ink": 9.93
      }
    },
    {
      "bbox": [
        189,
        847,
        1490,
        1016
      ],
      "category": "Text",
      "text": "WHEREAS, although Minority and Women-owned Business Enterprises (\"M/WBEs\") are strong drivers of economic growth, creating jobs and investing in local communities, they have not historically been awarded contracts at a level commensurate with their representation in the marketplace; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2866,
          "min": -1.4554
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 53,
          "mean": -0.0052,
          "min": -0.2532
        }
      },
      "ink": {
        "ink_px": 29741,
        "area_px": 216320,
        "density": 0.13749,
        "chars": 287,
        "chars_per_1k_ink": 9.65
      }
    },
    {
      "bbox": [
        189,
        1052,
        1450,
        1141
      ],
      "category": "Text",
      "text": "WHEREAS, the City has an interest in addressing income inequality and ensuring that City procurement reflects the diversity of the business owners of New York City;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2385,
          "min": -1.5328
        },
        "category": {
          "n_tokens": 1,
