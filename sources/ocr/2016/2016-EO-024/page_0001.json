    {
      "bbox": [
        187,
        1287,
        1488,
        1456
      ],
      "category": "Text",
      "text": "Section 1. Establishment of the Mayor's Office of Minority and Women-owned Business Enterprises. There is hereby established, under the direction of the Office of the Mayor, an Office of Minority and Women-owned Business Enterprises (hereinafter the \"Office\"). The Mayor shall appoint a head of the Office.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
