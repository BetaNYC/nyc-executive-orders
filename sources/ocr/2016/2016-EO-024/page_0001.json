    {
      "bbox": [
        190,
        686,
        1453,
        816
      ],
      "category": "Text",
      "text": "WHEREAS, it is the policy of the City of New York to promote economic growth in a manner that ensures that City residents and businesses from all communities and backgrounds can participate in and contribute to the economy of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3118,
          "min": -1.5235
        },
        "category": {
          "n_tokens": 1,
