        "chars": 164,
        "chars_per_1k_ink": 9.81
      }
    },
    {
      "bbox": [
        189,
        1171,
        1488,
        1250
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2471,
          "min": -1.238
        },
        "category": {
          "n_tokens": 1,
