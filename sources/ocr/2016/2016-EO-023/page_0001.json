        "chars": 159,
        "chars_per_1k_ink": 11.3
      }
    },
    {
      "bbox": [
        192,
        1759,
        1500,
        1850
      ],
      "category": "Text",
      "text": "WHEREAS, picking up such contributions on behalf of the Covered Employees will not impose any cost on the City;",
