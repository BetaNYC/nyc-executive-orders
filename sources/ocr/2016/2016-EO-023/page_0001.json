      "bbox": [
        189,
        1007,
        1500,
        1273
      ],
      "category": "Text",
      "text": "WHEREAS, uniformed employees of the New York City Fire Department who are subject to Article 14 of the Retirement and Social Security Law, as amended by Chapter 298 of the Laws of 2016 (\"the Law\"), contribute a percentage of their salary (\"Contributions\") to the New York City Fire Department Pension Fund towards the cost of the retirement benefits provided for such employees (\"Covered Employees\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2259,
          "min": -1.2155
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 91,
          "mean": -0.0004,
          "min": -0.0188
        }
      },
      "ink": {
        "ink_px": 35724,
        "area_px": 342874,
        "density": 0.10419,
        "chars": 404,
        "chars_per_1k_ink": 11.31
      }
    },
    {
      "bbox": [
        190,
        1296,
        1498,
        1621
      ],
      "category": "Text",
      "text": "WHEREAS, pursuant to section 414(h) of the Internal Revenue Code, employee contributions to a public employer pension plan may be picked up on a pre-tax basis by the public employer and excluded from an employee's federal gross income if the employer specifies that the contributions, although designated as employee contributions to the plan, are being paid by the employer in lieu of contributions by the employee, and the employee cannot choose to receive the amounts directly instead of having them paid by the employer; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2338,
          "min": -1.1509
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 99,
          "mean": -0.0001,
          "min": -0.0047
        }
      },
      "ink": {
        "ink_px": 46871,
        "area_px": 418275,
        "density": 0.11206,
        "chars": 528,
        "chars_per_1k_ink": 11.26
      }
    },
    {
      "bbox": [
        190,
        1643,
        1498,
        1736
      ],
      "category": "Text",
      "text": "WHEREAS, the Internal Revenue Service requires that the City take formal action evidencing an intent to establish an employer pick-up under section 414(h); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2133,
          "min": -1.2348
        },
        "category": {
