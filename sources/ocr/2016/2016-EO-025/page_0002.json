        "density": 0.08841,
        "chars": 179,
        "chars_per_1k_ink": 11.2
      }
    },
    {
      "bbox": [
        189,
        717,
        1492,
        921
      ],
      "category": "Text",
      "text": "WHEREAS, the Unions and the City of New York agree that the Additional Member\nContributions required of the Covered Employees as part of the benefit enhancements provided\nby the Elections should be picked up by the City for purposes of federal income tax treatment\nunder section 414(h) of the Internal Revenue Code; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1776,
          "min": -1.0903
