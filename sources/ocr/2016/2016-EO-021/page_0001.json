        "chars_per_1k_ink": 8.91
      }
    },
    {
      "bbox": [
        175,
        974,
        1503,
        1240
      ],
      "category": "Text",
      "text": "WHEREAS, disparities in pay for comparable work performed by members of different\ngenders or racial groups persist throughout our country, and may be inadvertently replicated by\npremature inquiries into pay history or by reliance upon on pay history in the calculation of wage\nor salary offers to applicants for employment;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2123,
          "min": -1.07
        },
        "category": {
          "n_tokens": 1,
