    {
      "bbox": [
        175,
        819,
        1501,
        932
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York is committed to the promotion of pay equity in its\nemployment practices; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.235,
          "min": -1.1578
        },
        "category": {
