          "min": -0.0001
        },
        "text": {
          "n_tokens": 45,
          "mean": -0.001,
          "min": -0.043
        }
      },
      "ink": {
        "ink_px": 21957,
        "area_px": 160125,
        "density": 0.13712,
        "chars": 245,
        "chars_per_1k_ink": 11.16
      }
    },
    {
      "bbox": [
        183,
        1144,
        1495,
        1268
      ],
      "category": "Text",
      "text": "WHEREAS, OATH has the capacity and ability to adjudicate a wide variety of administrative matters, including matters currently adjudicated by the administrative tribunal of the Department of Consumer Affairs (\"DCA\");",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2171,
          "min": -1.2232
        },
        "category": {
          "n_tokens": 1,
