    {
      "bbox": [
        183,
        1421,
        1491,
        1499
      ],
      "category": "Text",
      "text": "Section 1. Transfer of Categories of Adjudications within the Jurisdiction of the Administrative Tribunal at the Department of Consumer Affairs.",
