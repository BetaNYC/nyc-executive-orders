        "chars_per_1k_ink": 10.81
      }
    },
    {
      "bbox": [
        183,
        1305,
        1491,
        1383
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by virtue of the power vested in me as Mayor of the City of New York, it is hereby ordered:",
