    {
      "bbox": [
        240,
        1101,
        1449,
        1172
      ],
      "category": "Text",
      "text": "Section 1. Executive Order No. 96, dated November 20, 2006, is hereby amended by adding a new section 2-a, to read as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.166,
          "min": -0.9357
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 41,
          "mean": -0.0002,
          "min": -0.0077
        }
      },
      "ink": {
