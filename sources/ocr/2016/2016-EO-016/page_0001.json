    {
      "bbox": [
        181,
        1165,
        1455,
        1353
      ],
      "category": "Text",
      "text": "WHEREAS, it is necessary that transgender and gender non-conforming people be able to access single-sex facilities consistent with their gender identity and gender expression as a matter of safety and public health;",
      "logprob_stats": {
