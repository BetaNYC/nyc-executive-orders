        1414,
        799
      ],
      "category": "Text",
      "text": "WHEREAS, it is the responsibility of the City of New York to protect constituents' wellbeing and to promote the mental health of residents of all backgrounds in communities throughout the five boroughs; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2591,
