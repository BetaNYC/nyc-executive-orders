    },
    {
      "bbox": [
        246,
        920,
        1474,
        1084
      ],
      "category": "Text",
      "text": "Section 1. Continuation of Human Resources Administration. There is\ncontinued in the Executive Office of the Mayor a Human Resources\nAdministration (\"Administration\") with the responsibility to establish, coordinate\nand implement city policies with regard to the social service, human resources\nand community development programs currently supervised by the Administration.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.234,
          "min": -1.3063
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0486,
          "min": -0.0486
        },
        "text": {
          "n_tokens": 63,
          "mean": -0.0081,
          "min": -0.4335
        }
      },
      "ink": {
        "ink_px": 37118,
        "area_px": 202620,
        "density": 0.18319,
        "chars": 373,
        "chars_per_1k_ink": 10.05
      }
    },
    {
      "bbox": [
        246,
        1120,
        1474,
        1216
      ],
      "category": "Text",
      "text": "Section 2. Administrator. The Administration shall be under the direction\nof the Human Resources Administrator, who shall be appointed by the Mayor\nand shall serve at his pleasure.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.201,
          "min": -1.0972
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 35,
          "mean": -0.0054,
          "min": -0.1802
        }
      },
      "ink": {
        "ink_px": 16861,
        "area_px": 117888,
        "density": 0.14303,
        "chars": 180,
        "chars_per_1k_ink": 10.68
      }
    },
    {
      "bbox": [
        248,
        1251,
        1445,
        1442
      ],
      "category": "Text",
      "text": "Section 3. Deputy Administrators. The Administrator may appoint six\ndeputy administrators, one of whom shall be a first deputy administrator, and\nmay delegate to such deputies such duties and responsibilities as he deems\nappropriate. The Administrator shall be authorized to employ staff and retain\nfacilities, services, supplies and equipment necessary or required for the\noperation of the Administration as provided by law.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2229,
