    {
      "bbox": [
        246,
        821,
        1371,
        884
      ],
      "category": "Text",
      "text": "By the power vested in me as Mayor of the City of New York it is\nhereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2568,
          "min": -1.3413
        },
