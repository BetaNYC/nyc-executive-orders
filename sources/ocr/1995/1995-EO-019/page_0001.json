        1279,
        1507,
        1429
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Transit Authority and the City of New York desire by this merger to improve the quality, performance and coordination of policing provided to the transit system;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
