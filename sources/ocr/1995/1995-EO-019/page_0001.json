      }
    },
    {
      "bbox": [
        189,
        1624,
        1510,
        1736
      ],
      "category": "Text",
      "text": "WHEREAS, such MOU will provide for such merger to take place by March 30, 1995, or as soon as possible thereafter;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2491,
