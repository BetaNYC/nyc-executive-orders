      "bbox": [
        186,
        1430,
        1510,
        1617
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Transit Authority and the City of New York intend to enter into a Memorandum of Understanding (MOU) containing the terms and conditions of a merger of the New York City Transit Authority Police Department and the New York City Police Department; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.261,
          "min": -1.3851
        },
        "category": {
          "n_tokens": 1,
