          "min": -0.0006
        }
      },
      "ink": {
        "ink_px": 17541,
        "area_px": 169488,
        "density": 0.10349,
        "chars": 200,
        "chars_per_1k_ink": 11.4
      }
    },
    {
      "bbox": [
        177,
        1387,
        1491,
        1452
      ],
      "category": "Text",
      "text": "WHEREAS, in recent years graffiti \"tags\" have become a means of communication for drug dealers and gangs; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2401,
          "min": -1.2723
        },
        "category": {
