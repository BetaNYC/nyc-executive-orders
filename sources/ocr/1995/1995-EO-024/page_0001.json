    {
      "bbox": [
        181,
        994,
        1495,
        1097
      ],
      "category": "Text",
      "text": "WHEREAS, graffiti has an adverse effect on the quality of life in various communities in the City of New York, creating an impression of disorder and chaos; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2798,
          "min": -1.5309
        },
        "category": {
          "n_tokens": 1,
