        "density": 0.09943,
        "chars": 94,
        "chars_per_1k_ink": 11.16
      }
    },
    {
      "bbox": [
        179,
        1224,
        1495,
        1356
      ],
      "category": "Text",
      "text": "WHEREAS, the damage caused by graffiti-related vandalism depreciates the value of the property it defaces and costs the City and property owners millions of dollars in clean-up expenses each year; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2317,
          "min": -1.2696
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
