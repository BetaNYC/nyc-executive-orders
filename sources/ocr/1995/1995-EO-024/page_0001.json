        "density": 0.11354,
        "chars": 109,
        "chars_per_1k_ink": 11.36
      }
    },
    {
      "bbox": [
        177,
        1485,
        1491,
        1587
      ],
      "category": "Text",
      "text": "WHEREAS, the City therefore has a substantial interest in the removal of existing graffiti and the prevention of future graffiti; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2051,
          "min": -1.299
        },
        "category": {
          "n_tokens": 1,
