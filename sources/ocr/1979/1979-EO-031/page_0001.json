          "min": -0.4905
        }
      },
      "ink": {
        "ink_px": 7079,
        "area_px": 45872,
        "density": 0.15432,
        "chars": 116,
        "chars_per_1k_ink": 16.39
      }
    },
    {
      "bbox": [
        419,
        826,
        1344,
        915
      ],
      "category": "List-item",
      "text": "(a) CETA Workforce. \"CETA Workforce\" means any persons employed in positions which are supported in whole or in part by funds provided by the United States Department of Labor under CETA Titles II-D or VI, excluding positions concerned with administration of the CETA Program.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1935,
          "min": -1.0577
        },
        "category": {
          "n_tokens": 2,
