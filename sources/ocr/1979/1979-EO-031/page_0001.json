    {
      "bbox": [
        375,
        780,
        1344,
        826
      ],
      "category": "Text",
      "text": "Section 1. Definitions. Whenever used in this Executive Order the following terms shall have the following meanings:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1971,
          "min": -1.1045
        },
