        "density": 0.20026,
        "chars": 276,
        "chars_per_1k_ink": 16.43
      }
    },
    {
      "bbox": [
        419,
        915,
        1344,
        980
      ],
      "category": "List-item",
      "text": "(b) Contract. The term \"contract\" shall mean any written agreement or instrument whereby the City, or any agency thereof, is committed to expend or does expend its funds in return for work, labor, or services.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
