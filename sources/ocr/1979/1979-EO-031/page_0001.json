        "chars_per_1k_ink": 17.1
      }
    },
    {
      "bbox": [
        375,
        669,
        1344,
        737
      ],
      "category": "Text",
      "text": "Whereas, It is necessary and desirable for the City to implement these transition efforts in a manner consistent with federal requirements and its commitment to the City's public service employment workforce.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2169,
          "min": -1.128
        },
        "category": {
          "n_tokens": 1,
