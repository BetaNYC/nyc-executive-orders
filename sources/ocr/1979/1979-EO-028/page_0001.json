    {
      "bbox": [
        335,
        940,
        1300,
        986
      ],
      "category": "Text",
      "text": "Section 1. Council Established. The Productivity Council (hereinafter called the Council) is hereby established.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2181,
          "min": -1.1198
        },
        "category": {
