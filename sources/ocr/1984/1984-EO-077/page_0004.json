        230,
        781,
        1419,
        843
      ],
      "category": "Text",
      "text": "WHEREAS, the Commissioner of Finance performs functions related\nto payroll administration, and;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2616,
          "min": -1.1897
        },
