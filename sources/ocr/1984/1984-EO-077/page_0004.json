        "chars": 205,
        "chars_per_1k_ink": 10.8
      }
    },
    {
      "bbox": [
        230,
        1175,
        1434,
        1334
      ],
      "category": "Text",
      "text": "IT IS HEREBY AGREED that the Mayor shall implement this\nAgreement by issuing an Executive Order establishing the Office of Payroll\nAdministration, and that such Order, a copy of which is attached to this\nagreement, shall set forth the functions, organization and other matter related\nto the establishment of such Office, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2108,
          "min": -1.1971
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0009,
          "min": -0.0009
        },
        "text": {
          "n_tokens": 68,
          "mean": -0.0001,
