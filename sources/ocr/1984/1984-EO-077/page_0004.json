        }
      },
      "ink": {
        "ink_px": 25486,
        "area_px": 145024,
        "density": 0.17574,
        "chars": 250,
        "chars_per_1k_ink": 9.81
      }
    },
    {
      "bbox": [
        230,
        1043,
        1436,
        1139
      ],
      "category": "Text",
      "text": "WHEREAS, this goal can best be met by establishing a single entity\nto administer the various functions related to payroll administration, some of\nwhich are currently performed by the Department of Finance,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2189,
          "min": -1.2143
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0003,
          "min": -0.0003
        },
        "text": {
          "n_tokens": 39,
          "mean": -0.0096,
          "min": -0.3578
        }
      },
      "ink": {
        "ink_px": 18984,
