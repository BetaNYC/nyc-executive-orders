      }
    },
    {
      "bbox": [
        230,
        880,
        1365,
        1007
      ],
      "category": "Text",
      "text": "WHEREAS, a computerized payroll management system has been\ndesigned to ensure prompt and accurate payments of wages or salaries to\nemployees and to provide City agencies with improved and modernized\nmanagement and accounting payroll information, and;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2282,
          "min": -1.202
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
