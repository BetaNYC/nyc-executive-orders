      "category": "Text",
      "text": "TO: HEADS OF ALL CITY DEPARTMENTS AND AGENCIES\n\nFROM: ROBERT F. WAGNER, MAYOR\n\nSUBJECT: TRANSFER OF TRAFFIC AND CONSTRUCTION COORDINATION",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2654,
          "min": -1.3333
        },
