          "min": -0.0022
        },
        "text": {
          "n_tokens": 25,
          "mean": -0.002,
          "min": -0.049
        }
      },
      "ink": {
        "ink_px": 12119,
        "area_px": 68736,
        "density": 0.17631,
        "chars": 97,
        "chars_per_1k_ink": 8.0
      }
    },
    {
      "bbox": [
        346,
        1423,
        1476,
        1716
      ],
      "category": "Text",
      "text": "Section 1. Bereavement Leave Established.\nBereavement leave for all City employees is hereby established in the event of the death of a \"domestic partner\", as defined in Section 2, or the death of a parent or child of such domestic partner, or the death of a relative of such domestic partner residing in the household, and shall be afforded in accordance with existing rules and regulations and the terms of this Executive Order.",
