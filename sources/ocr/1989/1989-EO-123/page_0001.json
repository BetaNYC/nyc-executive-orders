        "density": 0.14668,
        "chars": 181,
        "chars_per_1k_ink": 8.17
      }
    },
    {
      "bbox": [
        346,
        989,
        1372,
        1085
      ],
      "category": "Text",
      "text": "WHEREAS, many of these living arrangements involve long-term committed relationships between unmarried persons; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2247,
          "min": -1.2327
        },
        "category": {
