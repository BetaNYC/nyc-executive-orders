    {
      "bbox": [
        346,
        822,
        1491,
        952
      ],
      "category": "Text",
      "text": "WHEREAS, there have been significant changes in our society resulting in diverse living arrangements among individuals and an expanded concept of what constitutes a family unit; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.242,
          "min": -1.2894
        },
        "category": {
          "n_tokens": 1,
