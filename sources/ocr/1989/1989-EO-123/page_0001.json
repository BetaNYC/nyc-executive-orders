        "chars_per_1k_ink": 8.37
      }
    },
    {
      "bbox": [
        346,
        1322,
        1413,
        1385
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1968,
          "min": -1.1573
        },
        "category": {
          "n_tokens": 1,
