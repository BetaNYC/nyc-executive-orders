    {
      "bbox": [
        103,
        851,
        1438,
        936
      ],
      "category": "Text",
      "text": "WHEREAS, the terrorist attack of September 11, 2001 has had an impact upon the City's economy; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3612,
          "min": -2.0869
        },
        "category": {
          "n_tokens": 1,
