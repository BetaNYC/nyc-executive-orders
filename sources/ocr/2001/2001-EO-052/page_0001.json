          "n_tokens": 28,
          "mean": -0.0232,
          "min": -0.647
        }
      },
      "ink": {
        "ink_px": 9936,
        "area_px": 104380,
        "density": 0.09519,
        "chars": 98,
        "chars_per_1k_ink": 9.86
      }
    },
    {
      "bbox": [
        97,
        960,
        1433,
        1091
      ],
      "category": "Text",
      "text": "WHEREAS, although certain direct costs of such attack will be reimbursed by the federal and State governments, the City must also address the unanticipated expenditures and reduction in City revenues that have resulted from the attack; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3472,
          "min": -1.9218
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 43,
