        "chars": 266,
        "chars_per_1k_ink": 10.92
      }
    },
    {
      "bbox": [
        85,
        1259,
        1421,
        1355
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, by the power vested in me as Mayor of the City of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3265,
          "min": -2.1507
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 27,
