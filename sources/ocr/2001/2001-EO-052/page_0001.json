        }
      },
      "ink": {
        "ink_px": 24138,
        "area_px": 161436,
        "density": 0.14952,
        "chars": 239,
        "chars_per_1k_ink": 9.9
      }
    },
    {
      "bbox": [
        90,
        1110,
        1428,
        1246
      ],
      "category": "Text",
      "text": "WHEREAS, it is the responsibility of the City, and in particular of the Mayor, under State law and the City Charter, to ensure the maintenance of a balanced budget and sound fiscal practices, and to set aside necessary reserves in furtherance of such responsibility;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.3086,
          "min": -1.7667
        },
        "category": {
          "n_tokens": 1,
