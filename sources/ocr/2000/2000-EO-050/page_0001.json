      }
    },
    {
      "bbox": [
        190,
        1102,
        1450,
        1177
      ],
      "category": "Text",
      "text": "WHEREAS, such funds should be distributed to charter schools that can demonstrate effective and appropriate use of such funds; and",
      "logprob_stats": {
        "bbox": {
