        "density": 0.12973,
        "chars": 109,
        "chars_per_1k_ink": 26.66
      }
    },
    {
      "bbox": [
        510,
        865,
        1301,
        904
      ],
      "category": "Text",
      "text": "Whereas, John C. Burton, Deputy Mayor for Finance of The City of New York, is\nfully familiar with the facts necessary to entering such agreements.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1899,
          "min": -1.0461
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 32,
          "mean": -0.0058,
          "min": -0.1625
        }
      },
      "ink": {
        "ink_px": 5180,
