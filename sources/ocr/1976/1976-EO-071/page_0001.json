        "chars": 144,
        "chars_per_1k_ink": 26.18
      }
    },
    {
      "bbox": [
        510,
        823,
        1301,
        862
      ],
      "category": "Text",
      "text": "Whereas, Such agreements are beneficial and necessary to the financial stability of\nThe City of New York; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2157,
          "min": -1.0731
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 22,
