    {
      "bbox": [
        510,
        780,
        1301,
        820
      ],
      "category": "Text",
      "text": "Whereas, The City of New York may from time to time enter into agreement with the Municipal Assistance Corporation for The City of New York; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2537,
          "min": -1.0287
        },
        "category": {
          "n_tokens": 1,
