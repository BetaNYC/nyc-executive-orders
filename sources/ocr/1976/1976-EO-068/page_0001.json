        "ink_px": 9519,
        "area_px": 44016,
        "density": 0.21626,
        "chars": 259,
        "chars_per_1k_ink": 27.21
      }
    },
    {
      "bbox": [
        411,
        673,
        1201,
        729
      ],
      "category": "Text",
      "text": "Whereas, It is desirable to separate the protocol and operating functions, clearly define the responsibilities of each function, improve coordination of the planning and direction of such activities and;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2101,
          "min": -1.2495
        },
        "category": {
          "n_tokens": 1,
