    },
    {
      "bbox": [
        411,
        615,
        1201,
        670
      ],
      "category": "Text",
      "text": "Whereas, There exists a need to provide both a sensitive response to matters of Protocol and to maintain a more efficient, economical and effective operating structure to plan, coordinate and direct official receptions and ceremonies as they are required and;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1723,
          "min": -0.7674
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 45,
          "mean": -0.0014,
