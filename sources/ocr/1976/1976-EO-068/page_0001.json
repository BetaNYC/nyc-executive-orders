    {
      "bbox": [
        411,
        559,
        1201,
        615
      ],
      "category": "Text",
      "text": "Whereas, The Mayor is frequently involved in the greeting of Heads of State, distinguished visitors and other dignitaries who are visitors to the City and in public ceremonies, receptions, celebrations and similar functions held under City auspices and;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.204,
          "min": -1.0242
        },
        "category": {
          "n_tokens": 1,
