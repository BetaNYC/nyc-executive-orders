    {
      "bbox": [
        438,
        243,
        1225,
        291
      ],
      "category": "Text",
      "text": "Whereas, It is the policy of The City of New York to utilize its resources in the most effective and efficient manner in providing its required services; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2536,
