    },
    {
      "bbox": [
        438,
        285,
        1225,
        334
      ],
      "category": "Text",
      "text": "Whereas, Continuing pressures on the City budget require that all avenues of improving the utilization of its resources be examined; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2133,
          "min": -1.231
        },
        "category": {
          "n_tokens": 1,
