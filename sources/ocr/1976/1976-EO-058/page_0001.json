        "density": 0.14007,
        "chars": 106,
        "chars_per_1k_ink": 24.59
      }
    },
    {
      "bbox": [
        465,
        1057,
        1251,
        1096
      ],
      "category": "Text",
      "text": "Whereas, A City-wide effort is required to assure consistency in rules, regulations and contracts and compliance with federal, state and local laws; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1752,
          "min": -1.0789
        },
        "category": {
