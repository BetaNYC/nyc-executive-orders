      }
    },
    {
      "bbox": [
        465,
        1096,
        1251,
        1173
      ],
      "category": "Text",
      "text": "Whereas, The New York State Industrial Commissioner has been directed by the Legislature to determine the types of coverages and the specific occupational safety and health requirements needed for public employees and to develop and recommend a specific plan; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
