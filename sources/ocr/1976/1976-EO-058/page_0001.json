        "chars_per_1k_ink": 24.95
      }
    },
    {
      "bbox": [
        465,
        1019,
        1251,
        1057
      ],
      "category": "Text",
      "text": "Whereas, Federal legislation involves the City in various occupational safety and health requirements; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1793,
          "min": -1.1063
        },
        "category": {
