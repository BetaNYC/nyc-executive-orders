      }
    },
    {
      "bbox": [
        465,
        1173,
        1251,
        1212
      ],
      "category": "Text",
      "text": "Whereas, A central management team is necessary to efficiently and adequately work with the State Department of Labor.",
      "logprob_stats": {
        "bbox": {
