    {
      "bbox": [
        504,
        1361,
        1251,
        1437
      ],
      "category": "List-item",
      "text": "(a) to act as the City's liaison with the State Department of Labor in safety and health matters, with particular reference to chapter seven hundred fifty-six of the laws of nineteen hundred seventy-five or any subsequent bills or laws on the subject of public employee occupational safety and health;",
      "logprob_stats": {
