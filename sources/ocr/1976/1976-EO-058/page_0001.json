    {
      "bbox": [
        465,
        961,
        1251,
        1019
      ],
      "category": "Text",
      "text": "Whereas, The City of New York, as an employer, is concerned with providing a safe and healthful working environment for its employees and with preventing personal injuries to its employees; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
