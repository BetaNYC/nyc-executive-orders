        1194,
        689
      ],
      "category": "Section-header",
      "text": "ESTABLISHMENT OF A DEPARTMENT OF PARKS AND\nRECREATION CONCESSIONS' REVIEW COMMITTEE",
      "logprob_stats": {
        "bbox": {
