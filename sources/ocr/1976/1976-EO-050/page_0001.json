        "density": 0.11979,
        "chars": 97,
        "chars_per_1k_ink": 26.52
      }
    },
    {
      "bbox": [
        551,
        635,
        1297,
        709
      ],
      "category": "Text",
      "text": "Section 1. The support staff of the New York City Youth Board shall herein-after be referred to as the New York City Youth Bureau and all references to the Youth Board staff contained in Executive Order No. 36, dated August 28, 1975, are hereby deleted and replaced by the term \"Youth Bureau\".",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2267,
          "min": -1.0968
        },
        "category": {
          "n_tokens": 1,
