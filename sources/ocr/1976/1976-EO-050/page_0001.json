        "ink_px": 5422,
        "area_px": 29754,
        "density": 0.18223,
        "chars": 132,
        "chars_per_1k_ink": 24.35
      }
    },
    {
      "bbox": [
        522,
        571,
        1305,
        609
      ],
      "category": "Text",
      "text": "Now, therefore, by the power vested in me as Mayor of The City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2168,
          "min": -1.1128
        },
        "category": {
