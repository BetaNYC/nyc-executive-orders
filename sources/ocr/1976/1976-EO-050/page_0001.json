        "chars_per_1k_ink": 27.39
      }
    },
    {
      "bbox": [
        551,
        713,
        1295,
        748
      ],
      "category": "Text",
      "text": "\u00a7 2. Section 6 of the Executive Order No. 36 dated August 28, 1975, is hereby amended to read as follows:",
      "logprob_stats": {
