    {
      "bbox": [
        539,
        332,
        1090,
        352
      ],
      "category": "Text",
      "text": "CONTROL OF OVERTIME AND PART-TIME HOURS",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1934,
          "min": -0.7977
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.6706,
          "min": -0.6706
        },
        "text": {
          "n_tokens": 11,
