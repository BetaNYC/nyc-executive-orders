        "chars_per_1k_ink": 25.53
      }
    },
    {
      "bbox": [
        432,
        1377,
        1215,
        1434
      ],
      "category": "Text",
      "text": "§ 7. Each agency shall maintain its records regarding overtime and part-time hours and compensation in good order and shall be subject to periodic audits by the Office of Management and Budget.",
