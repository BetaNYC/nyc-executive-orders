    {
      "bbox": [
        509,
        629,
        1299,
        686
      ],
      "category": "Text",
      "text": "Now, therefore, pursuant to the powers vested in me as Mayor of the City of New York by the City Charter and the Local Finance Law, and in the exercise of the powers of the Finance Board of the City, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
