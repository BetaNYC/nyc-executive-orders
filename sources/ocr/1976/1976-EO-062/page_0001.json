    {
      "bbox": [
        509,
        686,
        1303,
        722
      ],
      "category": "Text",
      "text": "Section 1. Section three of Executive Order No. 55, dated March 29, 1976, is hereby amended as of March 29, 1976, to read as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2273,
          "min": -1.3842
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0222,
          "min": -0.0222
        },
        "text": {
