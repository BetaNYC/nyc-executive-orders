    },
    {
      "bbox": [
        456,
        906,
        1207,
        1072
      ],
      "category": "List-item",
      "text": "a. Issue to each agency a Quarterly Allocation and Personnel Ceiling Statement for such quarter. Each such statement shall set forth for such quarter (i) an allocation for expenditures, by expenditure category; (ii) a personnel ceiling, by personnel category; and (iii) such related material as the Director of Management and Budget shall deem prudent to include. Amendments during the quarter to any Quarterly Allocation and Personnel Ceiling Statement may be issued by the Director of Management and Budget. As used herein, \"quarter\" shall mean the three-month period beginning on July 1, 1976, October 1, 1976, January 1, 1977 or April 1, 1977.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2717,
          "min": -1.7594
        },
        "category": {
          "n_tokens": 2,
