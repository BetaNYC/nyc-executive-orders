      "bbox": [
        421,
        866,
        1207,
        922
      ],
      "category": "Text",
      "text": "Prior to the beginning of each quarter, or as otherwise required, the Director of the Office of Management and Budget (sometimes hereinafter \"OMB\") shall:",
      "logprob_stats": {
