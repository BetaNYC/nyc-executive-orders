          "min": -0.0003
        },
        "text": {
          "n_tokens": 37,
          "mean": -0.017,
          "min": -0.3041
        }
      },
      "ink": {
        "ink_px": 8482,
        "area_px": 41764,
        "density": 0.20309,
        "chars": 169,
        "chars_per_1k_ink": 19.92
      }
    },
    {
      "bbox": [
        421,
        935,
        1203,
        1030
      ],
      "category": "Text",
      "text": "Whereas, The Terms and Conditions of the Budget provide that the Mayor may establish for any agency a quarterly allotment plan which may set forth for the quarter of the fiscal year during which it is to remain in effect (1) rates of expenditure for personal services; (2) ceilings on the total number of personnel; and (3) the total amount of funds to be spent by the agency during such quarter; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1636,
          "min": -0.9382
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 84,
          "mean": -0.0001,
          "min": -0.0032
        }
      },
      "ink": {
        "ink_px": 17642,
        "area_px": 75648,
        "density": 0.23321,
        "chars": 400,
        "chars_per_1k_ink": 22.67
      }
    },
    {
      "bbox": [
        421,
        1031,
        1203,
        1086
      ],
      "category": "Text",
      "text": "Whereas, The Mayor has determined that the establishment of quarterly allocations and personnel ceilings for each agency is necessary in order to ensure compliance with the Financial Plan and the Budget.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1537,
          "min": -1.0196
        },
        "category": {
