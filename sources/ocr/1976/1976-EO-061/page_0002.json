      "ink": {
        "ink_px": 12951,
        "area_px": 59100,
        "density": 0.21914,
        "chars": 271,
        "chars_per_1k_ink": 20.93
      }
    },
    {
      "bbox": [
        421,
        880,
        1203,
        932
      ],
      "category": "Text",
      "text": "Whereas, The New York City Charter empowers and charges the Mayor with the responsibility of administering the Expense Budget for the Fiscal Year 1977 (the \"Budget\") and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1981,
          "min": -1.0818
        },
        "category": {
          "n_tokens": 1,
