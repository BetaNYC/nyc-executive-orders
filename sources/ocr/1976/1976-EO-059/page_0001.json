    {
      "bbox": [
        445,
        299,
        1232,
        356
      ],
      "category": "Text",
      "text": "Whereas, New York City expenditures for Medical Assistance under the Medicaid program now total more than $1.9 billion annually, and the total level of expenditures has increased rapidly since the program was established; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2396,
          "min": -1.2588
        },
        "category": {
          "n_tokens": 1,
