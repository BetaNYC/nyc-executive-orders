          "min": -0.0264
        }
      },
      "ink": {
        "ink_px": 9285,
        "area_px": 45936,
        "density": 0.20213,
        "chars": 225,
        "chars_per_1k_ink": 24.23
      }
    },
    {
      "bbox": [
        445,
        355,
        1235,
        394
      ],
      "category": "Text",
      "text": "Whereas, It is necessary to reduce the City's expenditures for Medical Assistance substantially in order to comply with the New York City Financial Plan; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2752,
          "min": -1.8189
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 29,
          "mean": -0.0076,
          "min": -0.1886
        }
      },
      "ink": {
        "ink_px": 6335,
        "area_px": 31800,
        "density": 0.19921,
        "chars": 157,
        "chars_per_1k_ink": 24.78
      }
    },
    {
      "bbox": [
        445,
        393,
        1232,
        503
      ],
      "category": "Text",
      "text": "Whereas, To reduce expenditures while continuing effective service to the needy requires coordination of the efforts of the Human Resources Administration, the Department of Social Services, the Department of Health, the Department of Mental Health and Mental Retardation Services, the Office of Management and Budget and the Office of the Comptroller, as well as extensive cooperation between City, State and Federal Governments; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2014,
          "min": -1.1112
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 76,
          "mean": -0.0003,
          "min": -0.0157
        }
      },
      "ink": {
        "ink_px": 18216,
        "area_px": 87912,
        "density": 0.20721,
        "chars": 434,
        "chars_per_1k_ink": 23.83
      }
    },
    {
      "bbox": [
        445,
        505,
        1232,
        562
      ],
      "category": "Text",
      "text": "Whereas, It is necessary to modernize and consolidate the City's administration of the Medicaid program to provide appropriate services consistent with control of expenditures, and to respond to changing managerial and legal requirements; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1834,
          "min": -1.0629
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
