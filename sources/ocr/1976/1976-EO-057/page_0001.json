    {
      "bbox": [
        487,
        674,
        1272,
        729
      ],
      "category": "Text",
      "text": "Section 1. Sections 3 and 5 of Executive Order No. 62, dated February 5, 1968, as amended by Executive Order No. 56, dated February 1, 1972, are hereby amended to read as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1943,
          "min": -1.0067
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.101,
          "min": -0.101
        },
        "text": {
          "n_tokens": 60,
          "mean": -0.0001,
          "min": -0.0009
        }
      },
      "ink": {
        "ink_px": 7545,
        "area_px": 44072,
        "density": 0.1712,
        "chars": 179,
        "chars_per_1k_ink": 23.72
      }
    },
    {
      "bbox": [
        525,
        735,
        1272,
        828
      ],
      "category": "Text",
      "text": "\"§ 3. *Composition.* The Urban Design Council shall consist of not less than ten nor more than twenty individuals. They shall be appointed by the Mayor, with due consideration for their understanding of the problems of urban design and their capacity for giving clear, effective advice. They shall serve at the pleasure of the Mayor and without compensation.\"",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1934,
          "min": -1.0633
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.2015,
          "min": -0.2015
        },
        "text": {
          "n_tokens": 68,
          "mean": -0.0096,
          "min": -0.2422
        }
      },
      "ink": {
        "ink_px": 15245,
        "area_px": 70406,
        "density": 0.21653,
        "chars": 359,
        "chars_per_1k_ink": 23.55
      }
    },
    {
      "bbox": [
        525,
        832,
        1272,
        908
      ],
      "category": "Text",
      "text": "§ 5. *Procedure.* All actions of the Urban Design Council shall be by a majority of those present, with a quorum of six required. In other respects, the Council shall establish its own rules of procedure, provided it shall meet at least once a month, considering July and August a single month.\"",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1689,
          "min": -0.8905
        },
        "category": {
