    {
      "bbox": [
        540,
        278,
        1325,
        328
      ],
      "category": "Text",
      "text": "Whereas, John E. Zuccotti, First Deputy Mayor, is fully familiar with the facts necessary to enter into such agreements.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2352,
