    },
    {
      "bbox": [
        541,
        314,
        1326,
        365
      ],
      "category": "Text",
      "text": "Now, therefore, by virtue of the power vested in me as Mayor and pursuant to Section three of the City Charter, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2384,
          "min": -1.2676
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
