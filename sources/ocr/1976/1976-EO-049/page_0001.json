    {
      "bbox": [
        580,
        352,
        1331,
        512
      ],
      "category": "List-item",
      "text": "Section 1. John E. Zuccotti, First Deputy Mayor, is hereby delegated the authority to act for, on behalf of and at the direction of the Mayor in the exercise of all functions, powers and duties which the Mayor may have pursuant to Article 10 of the Public Authorities Law, as amended (the \"Act\"), including, but not limited to, full power to execute for, on behalf of and at the direction of the Mayor any agreement between the City and the Municipal Assistance Corporation for The City of New York pursuant to Section 3038 of the Act, any certificate pursuant to Section 3037 of the Act and any other document in connection with the Act.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.233,
          "min": -1.2542
        },
        "category": {
          "n_tokens": 2,
          "mean": -0.1261,
          "min": -0.2522
        },
        "text": {
          "n_tokens": 143,
          "mean": -0.0003,
          "min": -0.0343
