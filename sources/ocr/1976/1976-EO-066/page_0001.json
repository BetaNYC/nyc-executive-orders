    },
    {
      "bbox": [
        396,
        1159,
        1186,
        1236
      ],
      "category": "Text",
      "text": "\u00a7 8. Under the authority granted by the Emergency Financial Control Board regarding \"covered organizations\", all non-mayoral governmental agencies will implement comparable cost reductions and are to participate in any plans, procedures, priorities and policies developed as a result of this Executive Order.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1414,
          "min": -0.8617
        },
        "category": {
          "n_tokens": 1,
