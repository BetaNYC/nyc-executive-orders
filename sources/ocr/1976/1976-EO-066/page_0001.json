      },
      "ink": {
        "ink_px": 12042,
        "area_px": 46433,
        "density": 0.25934,
        "chars": 241,
        "chars_per_1k_ink": 20.01
      }
    },
    {
      "bbox": [
        396,
        1099,
        1186,
        1157
      ],
      "category": "Text",
      "text": "\u00a7 7 The Office of Management and Budget and the Municipal Services Administrator shall each render periodic reports to the Mayor indicating the policies, implementation, effectiveness and savings achieved as a result of this program.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1888,
          "min": -1.0643
        },
        "category": {
          "n_tokens": 1,
