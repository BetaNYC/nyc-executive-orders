    {
      "bbox": [
        154,
        875,
        1485,
        1050
      ],
      "category": "Text",
      "text": "WHEREAS, it is essential to the City of New York that excellent relations be maintained between the personnel of the United Nations and the various foreign consulates and the people of the City of New York; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2959,
          "min": -1.484
        },
