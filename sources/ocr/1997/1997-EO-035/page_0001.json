        "chars_per_1k_ink": 17.05
      }
    },
    {
      "bbox": [
        160,
        1028,
        1489,
        1203
      ],
      "category": "Text",
      "text": "WHEREAS, in furtherance of this objective the City provides to the personnel of the United Nations and the Consular Corps information about City services, as well as other forms of guidance, assistance and referrals;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2495,
