        1452,
        1500,
        1587
      ],
      "category": "List-item",
      "text": "Section 1. There is hereby established in the Office of the Mayor a Commission for the United Nations, the Consular Corps and Protocol.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2545,
