        "density": 0.05559,
        "chars": 216,
        "chars_per_1k_ink": 17.36
      }
    },
    {
      "bbox": [
        165,
        1182,
        1493,
        1357
      ],
      "category": "Text",
      "text": "WHEREAS, there exists a need to provide a sensitive response to matters of protocol and to maintain an economical and effective operating structure to plan, coordinate and direct official receptions and ceremonies;",
      "logprob_stats": {
        "bbox": {
