    },
    {
      "bbox": [
        296,
        1071,
        1463,
        1495
      ],
      "category": "Text",
      "text": "Section 1. Pursuant to subdivision f of section 8 of the New York City Charter, the Deputy Mayor for Public Safety is delegated all powers and duties of the Mayor respecting the consideration by the Board of Estimate of the renewal of the cable franchises held by Manhattan Cable Television and Paragon Communications and any other actions that may be required to be taken by the Mayor relating thereto.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2094,
          "min": -1.1464
        },
        "category": {
