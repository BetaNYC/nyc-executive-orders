        "chars": 115,
        "chars_per_1k_ink": 9.66
      }
    },
    {
      "bbox": [
        300,
        1086,
        1459,
        1216
      ],
      "category": "Text",
      "text": "WHEREAS, in order to better recognize the rights and meet\nthe needs of people with disabilities, it is necessary to provide for\ngreater cooperation, communication and coordination of functions and\nservices on a City-wide basis;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2313,
          "min": -1.2347
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 45,
          "mean": -0.0021,
          "min": -0.0345
        }
      },
      "ink": {
        "ink_px": 23680,
        "area_px": 153516,
        "density": 0.15425,
        "chars": 227,
        "chars_per_1k_ink": 9.59
      }
    },
    {
      "bbox": [
        300,
        1251,
        1461,
        1313
      ],
      "category": "Text",
      "text": "NOW THEREFORE, by the power vested in me as the Mayor\nof the City of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2267,
          "min": -1.2865
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0008,
          "min": -0.0008
        },
        "text": {
          "n_tokens": 28,
          "mean": -0.0001,
          "min": -0.0014
        }
      },
      "ink": {
        "ink_px": 11839,
        "area_px": 73395,
        "density": 0.16131,
        "chars": 111,
        "chars_per_1k_ink": 9.38
      }
    },
    {
      "bbox": [
        302,
        1348,
        1463,
        1543
      ],
      "category": "Text",
      "text": "Section 1. Office for People With Disabilities. The New York City Mayor's Office for the Handicapped is hereby renamed the Mayor's Office for People With Disabilities. The Office shall report to and be directly accountable to the First Deputy Mayor. The Office shall be headed by a Director who shall be appointed by and serve at the pleasure of the Mayor.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.226,
          "min": -1.253
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0161,
          "min": -0.0161
        },
        "text": {
          "n_tokens": 71,
          "mean": -0.0069,
          "min": -0.2522
        }
      },
      "ink": {
        "ink_px": 42339,
        "area_px": 229505,
        "density": 0.18448,
        "chars": 356,
        "chars_per_1k_ink": 8.41
      }
    },
    {
      "bbox": [
        304,
        1577,
        1463,
        1640
      ],
      "category": "Text",
      "text": "Section 2. Scope of Duties and Authority of Director. The\nDirector of the Mayor's Office for People With Disabilities shall:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2324,
          "min": -1.4159
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 27,
          "mean": -0.0165,
          "min": -0.4315
        }
      },
      "ink": {
        "ink_px": 15979,
        "area_px": 74432,
        "density": 0.21468,
        "chars": 124,
        "chars_per_1k_ink": 7.76
      }
    },
    {
      "bbox": [
        304,
        1675,
        1465,
        1802
      ],
      "category": "List-item",
      "text": "a. Acting in conjunction with other City agencies, be\nresponsible for developing, coordinating and formulating City policies\nrelating to all people with disabilities, and for overseeing the\nimplementation of such policies.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2093,
          "min": -1.2099
        },
        "category": {
          "n_tokens": 2,
