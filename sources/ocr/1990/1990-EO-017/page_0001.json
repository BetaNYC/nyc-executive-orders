    {
      "bbox": [
        300,
        985,
        1457,
        1048
      ],
      "category": "Text",
      "text": "WHEREAS, the rights and needs of people with disabilities\nare matters of vital concern to the City of New York; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2571,
          "min": -1.2394
        },
        "category": {
