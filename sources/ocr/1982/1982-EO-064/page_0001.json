    },
    {
      "bbox": [
        283,
        1579,
        1501,
        1809
      ],
      "category": "Text",
      "text": "Section 3. Award Recipient. The recipient of this Award will be an artist, architect, civic activist, corporation, neighborhood group, or other organization or individual whose actions have had a substantial impact on the visual landscape of New York City. It is intended that the Award be given in recognition of a continuous effort on the part of the recipient to achieve this end.",
      "logprob_stats": {
