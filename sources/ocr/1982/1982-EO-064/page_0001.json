    {
      "bbox": [
        280,
        926,
        1477,
        1120
      ],
      "category": "Text",
      "text": "Section 1. Award Established. The Doris C. Freedman Award (the \"Award\") is hereby established. This Award shall be presented annually to an individual or organization selected by the Mayor in recognition for \"a contribution to the people of the City of New York that greatly enriches the public environment.\"",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2497,
          "min": -1.3417
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.062,
          "min": -0.062
        },
        "text": {
          "n_tokens": 62,
          "mean": -0.01,
          "min": -0.4661
        }
      },
      "ink": {
        "ink_px": 27776,
        "area_px": 233415,
        "density": 0.119,
        "chars": 308,
        "chars_per_1k_ink": 11.09
      }
    },
    {
      "bbox": [
        280,
        1158,
        1458,
        1380
      ],
      "category": "Text",
      "text": "Section 2. Purpose. This Award is dedicated to the memory of Doris C. Freedman who labored tirelessly to enliven and humanize the cultural environment of our city. Doris C. Freedman, the first New York City Director of Cultural Affairs, President of City Walls, The Municipal Art Society and The Public Art Fund, was active in numerous community and educational institutions.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2255,
          "min": -1.0897
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0005,
          "min": -0.0005
        },
        "text": {
          "n_tokens": 79,
          "mean": -0.0026,
          "min": -0.1129
        }
      },
      "ink": {
        "ink_px": 32622,
        "area_px": 262694,
        "density": 0.12418,
        "chars": 375,
        "chars_per_1k_ink": 11.5
      }
    },
    {
      "bbox": [
        283,
        1414,
        1484,
        1543
      ],
      "category": "Text",
      "text": "The purpose of the Award is to recognize outstanding efforts to improve the public environment and encourage greater interest and appreciation for works of art displayed in public places.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2397,
          "min": -1.3976
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
