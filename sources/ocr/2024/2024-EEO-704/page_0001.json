        1482,
        1493,
        1558
      ],
      "category": "Text",
      "text": "Section 1. I hereby order that section 1 of Emergency Executive Order No. 701, dated November 29, 2024, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.213,
          "min": -1.1501
        },
        "category": {
