        1562,
        1562,
        1635
      ],
      "category": "Text",
      "text": "\u00a7 2. I hereby order that section 1 of Emergency Executive Order No. 677, dated October 20, 2024, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2109,
          "min": -1.3534
        },
        "category": {
          "n_tokens": 1,
