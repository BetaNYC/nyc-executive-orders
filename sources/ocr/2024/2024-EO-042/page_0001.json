          "min": -0.0233
        }
      },
      "ink": {
        "ink_px": 17256,
        "area_px": 142158,
        "density": 0.12139,
        "chars": 217,
        "chars_per_1k_ink": 12.58
      }
    },
    {
      "bbox": [
        185,
        1104,
        1492,
        1217
      ],
      "category": "Text",
      "text": "WHEREAS, Chapter 669 of the Laws of 2023 added a new Chapter 79 to the New York City Charter providing for the Mayor to establish an Office of Community Hiring and Workforce Development; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2129,
          "min": -1.2323
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 47,
          "mean": -0.0001,
          "min": -0.0044
        }
      },
      "ink": {
        "ink_px": 15698,
        "area_px": 144866,
        "density": 0.10836,
        "chars": 190,
        "chars_per_1k_ink": 12.1
      }
    },
    {
      "bbox": [
        185,
        1258,
        1483,
        1450
      ],
      "category": "Text",
      "text": "WHEREAS, the Office of Community Hiring and Workforce Development is authorized to develop and coordinate the implementation of a community hiring program in which the City uses the economic power of City procurements and other transactions to require that contractors and subcontractors make best efforts to employ low-income individuals and individuals from economically disadvantaged regions; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2098,
          "min": -1.2759
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 63,
          "mean": -0.0001,
          "min": -0.0032
        }
      },
      "ink": {
        "ink_px": 33324,
        "area_px": 244416,
        "density": 0.13634,
        "chars": 399,
        "chars_per_1k_ink": 11.97
      }
    },
    {
      "bbox": [
        185,
        1491,
        1486,
        1642
      ],
      "category": "Text",
      "text": "WHEREAS, Executive Order 22 of 2022 empowered the Office of Talent and Workforce Development (\"NYC Talent\") to lead a coordinated approach to City's talent and workforce development system to achieve the Citywide talent development objectives, promote equity and create a more inclusive economy; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2068,
          "min": -1.2157
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
