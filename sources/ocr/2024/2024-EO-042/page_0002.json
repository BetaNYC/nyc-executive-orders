          "min": -0.202
        }
      },
      "ink": {
        "ink_px": 17783,
        "area_px": 143248,
        "density": 0.12414,
        "chars": 226,
        "chars_per_1k_ink": 12.71
      }
    },
    {
      "bbox": [
        191,
        793,
        1464,
        905
      ],
      "category": "Text",
      "text": "\u00a7 4. OCH shall serve as the central point for coordinating the Citywide community hiring efforts and perform other functions as deemed necessary by the Director of OCH for the development and implementation of community hiring initiatives.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.244,
          "min": -1.3053
        },
        "category": {
