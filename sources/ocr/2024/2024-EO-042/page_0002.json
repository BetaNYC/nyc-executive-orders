      "category": "Text",
      "text": "Section 1. The Office of Community Hiring and Workforce Development (the \"Office of Community Hiring\" or \"OCH\") shall be located within the Department of Small Business Services (\"DSBS\"). OCH shall perform the functions delineated in section 3502 of the Charter.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3307,
          "min": -1.5032
        },
        "category": {
          "n_tokens": 1,
