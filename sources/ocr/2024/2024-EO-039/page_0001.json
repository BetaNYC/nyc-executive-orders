    },
    {
      "bbox": [
        177,
        1390,
        1491,
        1473
      ],
      "category": "Text",
      "text": "WHEREAS, the City depends on the regular and extensive use of contracted fleet and trucking assets inside the City of New York; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.0666,
          "min": -0.6618
        },
