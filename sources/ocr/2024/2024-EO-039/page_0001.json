        "chars_per_1k_ink": 13.32
      }
    },
    {
      "bbox": [
        177,
        1068,
        1491,
        1151
      ],
      "category": "Text",
      "text": "WHEREAS, a safe systems approach combining training, technology, and improved vehicle design is proven to reduce crashes; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1129,
          "min": -0.9667
        },
        "category": {
