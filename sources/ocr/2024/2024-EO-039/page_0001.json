      }
    },
    {
      "bbox": [
        177,
        952,
        1491,
        1035
      ],
      "category": "Text",
      "text": "WHEREAS, significant safety upgrades to City-owned vehicles and vehicles of city contractors are critical to achieving long-term safety improvements; and",
      "logprob_stats": {
