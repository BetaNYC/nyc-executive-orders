    },
    {
      "bbox": [
        177,
        835,
        1463,
        917
      ],
      "category": "Text",
      "text": "WHEREAS, trucks are involved in 12% of fatalities to pedestrians and 30% of fatalities to bicyclists in NYC; and",
      "logprob_stats": {
