    {
      "bbox": [
        179,
        446,
        1478,
        572
      ],
      "category": "Text",
      "text": "**Chief Fleet Officer:** The DCAS official appointed by the Commissioner, in accordance with Executive Order 161 of 2012, who is responsible for implementing policies and procedures to ensure safe, reliable, and proper use of City vehicles, or their duly authorized designee.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2849,
          "min": -1.4037
        },
        "category": {
          "n_tokens": 1,
