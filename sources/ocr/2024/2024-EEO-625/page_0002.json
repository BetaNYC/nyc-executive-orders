      "bbox": [
        216,
        566,
        1511,
        639
      ],
      "category": "Text",
      "text": "WHEREAS, despite DOC's good faith engagement with the City Council, on January 30, 2024, the City Council voted to override the Mayor's veto of Local Law 42; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2503,
          "min": -1.2723
        },
