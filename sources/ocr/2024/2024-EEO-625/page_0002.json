          "min": -0.0087
        }
      },
      "ink": {
        "ink_px": 44335,
        "area_px": 240640,
        "density": 0.18424,
        "chars": 471,
        "chars_per_1k_ink": 10.62
      }
    },
    {
      "bbox": [
        218,
        1430,
        1511,
        1540
      ],
      "category": "Text",
      "text": "WHEREAS, despite these efforts, and despite the existence of the Nunez Court Orders, on July 15, 2024, the City Council informed DOC that it would not agree to any stay of the effective date of Local Law 42; and",
