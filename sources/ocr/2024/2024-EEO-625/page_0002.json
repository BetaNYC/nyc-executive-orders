    },
    {
      "bbox": [
        218,
        1095,
        1480,
        1168
      ],
      "category": "Text",
      "text": "WHEREAS, on June 25, 2024, pursuant to Local Law 42, the New York City Board of Correction (\"BOC\") adopted rules relating to the implementation of the law; and",
      "logprob_stats": {
        "bbox": {
