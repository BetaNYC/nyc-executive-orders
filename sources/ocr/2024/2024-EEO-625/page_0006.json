    {
      "bbox": [
        218,
        572,
        1511,
        722
      ],
      "category": "Text",
      "text": "WHEREAS, on July 23, 2024, DOC again reached out to the City Council to ask that the City Council stay the effective date of Local Law 42 until these serious issues could be resolved, but in response to an inquiry from legal counsel to DOC, the City Council again informed DOC that it would not agree to any stay of the effective date of Local Law 42; and",
      "logprob_stats": {
        "bbox": {
