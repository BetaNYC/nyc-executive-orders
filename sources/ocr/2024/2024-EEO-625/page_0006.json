    },
    {
      "bbox": [
        218,
        908,
        1511,
        1021
      ],
      "category": "Text",
      "text": "WHEREAS, certain sections of Title 40 of the Rules of the City of New York have already been suspended by Emergency Executive Order No. 279, dated November 1, 2021, and remain suspended pursuant to subsequent renewals of such Emergency Executive Order; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2267,
          "min": -1.0655
        },
        "category": {
