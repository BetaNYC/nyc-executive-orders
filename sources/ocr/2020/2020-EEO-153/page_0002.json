    {
      "bbox": [
        308,
        435,
        1495,
        589
      ],
      "category": "Text",
      "text": "1. For the purposes of the Open Restaurants program, temporary outdoor heaters fueled by piped natural gas shall be deemed to be \"limited plumbing alterations, category 2\", as defined in section 28-101.5 of the Administrative Code, and applications for such work may be filed with the Department of Buildings (\"DOB\") by licensed master plumbers.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2926,
          "min": -1.4112
        },
        "category": {
          "n_tokens": 1,
