        "chars": 238,
        "chars_per_1k_ink": 9.16
      }
    },
    {
      "bbox": [
        308,
        782,
        1491,
        935
      ],
      "category": "Text",
      "text": "3. Propane containers may not be stored on sidewalks, roadways, or indoors. They may only be stored in facilities approved by the Fire Department (\"FDNY\"), except that one-pound containers of propane may be stored in accordance with the guidance issued by FDNY pursuant to subdivision c of this section.",
      "logprob_stats": {
        "bbox": {
