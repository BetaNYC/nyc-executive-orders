    },
    {
      "bbox": [
        199,
        1249,
        1501,
        1400
      ],
      "category": "Text",
      "text": "WHEREAS, Emergency Executive Order No. 126, issued June 18, 2020, established the Open Restaurants program, allowing restaurants, bars and other establishments to use outdoor space on sidewalks and the roadway to set up additional dining space, successfully supporting small businesses and allowing New Yorkers to safely enjoy dining out during the pandemic;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2201,
          "min": -1.0689
        },
