    },
    {
      "bbox": [
        195,
        902,
        1498,
        1051
      ],
      "category": "Text",
      "text": "WHEREAS, Emergency Executive Order No. 98, issued March 12, 2020 and extended most recently by Emergency Executive Order No. 151, issued October 5, 2020, contains a declaration of a state of emergency in the City of New York due to the threat posed by COVID-19 to the health and welfare of City residents, and such declaration remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2297,
          "min": -1.1557
        },
        "category": {
