    },
    {
      "bbox": [
        206,
        937,
        1508,
        1087
      ],
      "category": "Text",
      "text": "WHEREAS, Emergency Executive Order No. 98, issued March 12, 2020 and extended most recently by Emergency Executive Order No. 151, issued October 5, 2020, contains a declaration of a state of emergency in the City of New York due to the threat posed by COVID-19 to the health and welfare of City residents, and such declaration remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2035,
          "min": -1.0967
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 90,
          "mean": -0.0002,
          "min": -0.0161
        }
      },
      "ink": {
        "ink_px": 36223,
        "area_px": 194941,
        "density": 0.18582,
        "chars": 349,
        "chars_per_1k_ink": 9.63
      }
    },
    {
      "bbox": [
        206,
        1129,
        1508,
        1242
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because of the propensity of the virus to spread person-to-person and also because the actions taken to prevent such spread have led to property loss and damage; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1914,
          "min": -1.1728
        },
        "category": {
          "n_tokens": 1,
