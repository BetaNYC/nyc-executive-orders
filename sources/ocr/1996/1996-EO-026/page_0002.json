    {
      "bbox": [
        175,
        375,
        1505,
        570
      ],
      "category": "Text",
      "text": "WHEREAS, the Mayor has directed the Inter-Agency Group to immediately implement its recommendations, and further has directed CWA to engage in an in-depth management review of its functions and operations;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2897,
          "min": -1.4064
        },
        "category": {
          "n_tokens": 1,
