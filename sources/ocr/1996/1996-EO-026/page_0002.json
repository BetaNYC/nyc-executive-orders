        "chars_per_1k_ink": 15.93
      }
    },
    {
      "bbox": [
        167,
        906,
        1500,
        1181
      ],
      "category": "Text",
      "text": "WHEREAS, the Mayor further believes that the mission of CWA will be enhanced if the City's Office of Child Support Enforcement (\"OCSE\") and the City's Head Start program are supervised and coordinated by the CWA Commissioner, and that these programs will benefit from direct supervision by the CWA Commissioner;",
      "logprob_stats": {
        "bbox": {
