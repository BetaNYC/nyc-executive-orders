        }
      },
      "ink": {
        "ink_px": 17418,
        "area_px": 336951,
        "density": 0.05169,
        "chars": 293,
        "chars_per_1k_ink": 16.82
      }
    },
    {
      "bbox": [
        185,
        1405,
        1498,
        1592
      ],
      "category": "Text",
      "text": "WHEREAS, providing access to private, public and not-for-profit sector jobs will give young people an understanding of the job market so that they may make informed choices regarding their futures; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2275,
          "min": -1.293
        },
        "category": {
          "n_tokens": 1,
