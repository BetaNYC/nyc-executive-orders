    },
    {
      "bbox": [
        182,
        1640,
        1498,
        1828
      ],
      "category": "Text",
      "text": "WHEREAS, a focused and sustained coordination of public and private resources to identify available jobs will ensure the widest possible choice of employment experience for the City's youth;",
      "logprob_stats": {
        "bbox": {
