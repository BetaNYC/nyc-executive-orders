    },
    {
      "bbox": [
        188,
        1097,
        1502,
        1359
      ],
      "category": "Text",
      "text": "WHEREAS, identifying opportunities for quality work experience for young people in the City is an effective method of developing their job-related skills and directing their energies in ways that will inure to the benefit of the City and the City's business and not-for-profit communities; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2306,
          "min": -1.2266
        },
        "category": {
