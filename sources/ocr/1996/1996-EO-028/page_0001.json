    {
      "bbox": [
        191,
        868,
        1508,
        1051
      ],
      "category": "Text",
      "text": "WHEREAS, the talent and vitality of the youth of the City are among the City's most valuable resources, and government funding for work experience programs for young people has been significantly diminished; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2521,
