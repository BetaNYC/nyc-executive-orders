        "chars_per_1k_ink": 11.24
      }
    },
    {
      "bbox": [
        194,
        978,
        1501,
        1132
      ],
      "category": "Text",
      "text": "WHEREAS, Emergency Executive Order No. 98, issued March 12, 2020 and extended most recently by Emergency Executive Order No. 192, issued April 2, 2021, contains a declaration of a state of emergency in the City of New York due to the threat posed by COVID-19 to the health and welfare of City residents, and such declaration remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2276,
          "min": -1.3167
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 90,
          "mean": -0.0001,
          "min": -0.0086
        }
      },
      "ink": {
        "ink_px": 30778,
        "area_px": 198660,
        "density": 0.15493,
        "chars": 347,
        "chars_per_1k_ink": 11.27
      }
    },
    {
      "bbox": [
        192,
        1172,
        1501,
        1283
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because of the propensity of the virus to spread person-to-person and also because the actions taken to prevent such spread have led to property loss and damage; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2353,
          "min": -1.3384
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 38,
          "mean": -0.0002,
          "min": -0.0042
        }
      },
      "ink": {
        "ink_px": 17169,
        "area_px": 144480,
        "density": 0.11883,
        "chars": 194,
        "chars_per_1k_ink": 11.3
      }
    },
    {
      "bbox": [
        192,
        1325,
        1503,
        1442
      ],
      "category": "Text",
      "text": "WHEREAS, measures taken to combat the spread of COVID-19 may prevent individuals, businesses and other entities from meeting legally imposed deadlines for the filing of certain documents or for the completion of other required actions; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2191,
          "min": -1.2879
        },
        "category": {
