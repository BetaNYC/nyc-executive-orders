    {
      "bbox": [
        190,
        837,
        1492,
        911
      ],
      "category": "Text",
      "text": "WHEREAS, over 1.6 million New Yorkers experience mental illness every year, with too many of them not having access to mental healthcare when they want or need it; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.261,
          "min": -1.1966
        },
        "category": {
          "n_tokens": 1,
