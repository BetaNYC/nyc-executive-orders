          "min": -0.2255
        }
      },
      "ink": {
        "ink_px": 18247,
        "area_px": 91732,
        "density": 0.19892,
        "chars": 162,
        "chars_per_1k_ink": 8.88
      }
    },
    {
      "bbox": [
        190,
        1068,
        1488,
        1141
      ],
      "category": "Text",
      "text": "WHEREAS, New York City aims to address long-standing inequities in mental health, in the face of decades of federal and state disinvestment and deinstitutionalization; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2033,
          "min": -1.0206
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 36,
          "mean": -0.0002,
          "min": -0.0028
        }
      },
      "ink": {
        "ink_px": 18527,
        "area_px": 93294,
        "density": 0.19859,
        "chars": 171,
        "chars_per_1k_ink": 9.23
      }
    },
    {
      "bbox": [
        190,
        1185,
        1494,
        1259
      ],
      "category": "Text",
      "text": "WHEREAS New York City residents are experiencing profound mental health challenges and trauma during the COVID-19 pandemic, likely to persist for years; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1903,
          "min": -1.1205
        },
        "category": {
          "n_tokens": 1,
