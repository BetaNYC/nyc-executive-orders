        "chars": 167,
        "chars_per_1k_ink": 9.54
      }
    },
    {
      "bbox": [
        190,
        953,
        1417,
        1028
      ],
      "category": "Text",
      "text": "WHEREAS, communities of color and low-income neighborhoods experience more mental health needs and lower rates of connection to community-based, ongoing care; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2126,
          "min": -1.1559
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 28,
