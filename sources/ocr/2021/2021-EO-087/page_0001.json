    },
    {
      "bbox": [
        182,
        1103,
        1491,
        1177
      ],
      "category": "Text",
      "text": "WHEREAS, Hurricane Ida struck the City on September 1, 2021, causing significant property damage and greater loss of life than Hurricane Sandy; and",
      "logprob_stats": {
