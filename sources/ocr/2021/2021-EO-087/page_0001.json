    },
    {
      "bbox": [
        182,
        987,
        1489,
        1061
      ],
      "category": "Text",
      "text": "WHEREAS, HRO has accumulated significant experience and operational expertise in addressing short- and long-term housing-related disaster recovery solutions; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2297,
          "min": -1.2374
        },
        "category": {
