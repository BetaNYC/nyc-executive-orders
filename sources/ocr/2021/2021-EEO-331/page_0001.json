    },
    {
      "bbox": [
        186,
        824,
        1493,
        936
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the\nCity of New York first declared in Emergency Executive Order No. 98, and extended most recently\nby Emergency Executive Order No. 323, remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2384,
          "min": -1.3093
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 58,
