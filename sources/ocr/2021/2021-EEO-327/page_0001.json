        "chars": 331,
        "chars_per_1k_ink": 9.57
      }
    },
    {
      "bbox": [
        201,
        1283,
        1504,
        1358
      ],
      "category": "Text",
      "text": "Section 1. I hereby direct that section 2 of Emergency Executive Order No. 323, dated December 23, 2021, is extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1665,
          "min": -1.1558
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 43,
          "mean": -0.0101,
          "min": -0.4304
        }
      },
      "ink": {
        "ink_px": 13420,
        "area_px": 96900,
        "density": 0.13849,
        "chars": 135,
        "chars_per_1k_ink": 10.06
      }
    },
    {
      "bbox": [
        201,
        1399,
        1504,
        1631
      ],
      "category": "Text",
      "text": "\u00a7 2. I hereby direct the Fire and Police Departments, the Department of Buildings, the\nSheriff, and other agencies as needed, to enforce the directives set forth in this Order in accordance\nwith their lawful authorities, including Administrative Code sections 15-227(a), 28-105.10.1, and\n28-201.1, and section 107.6 of the Fire Code. Violations of the directives set forth in this Order\nmay be issued as if they were violations under the Health Code sections 3.07 and 3.11, and\nenforced by the Department of Health and Mental Hygiene or any other agency.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1445,
          "min": -0.958
        },
        "category": {
