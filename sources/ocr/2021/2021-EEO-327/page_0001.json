          "min": -0.6334
        }
      },
      "ink": {
        "ink_px": 19714,
        "area_px": 144704,
        "density": 0.13624,
        "chars": 182,
        "chars_per_1k_ink": 9.23
      }
    },
    {
      "bbox": [
        201,
        781,
        1504,
        894
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency to address the threat and impacts of COVID-19 in the\nCity of New York first declared in Emergency Executive Order No. 98, and extended most recently\nby Emergency Executive Order No. 323, remains in effect; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2196,
          "min": -1.1369
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 58,
          "mean": -0.01,
          "min": -0.5768
        }
      },
      "ink": {
        "ink_px": 26068,
        "area_px": 147288,
        "density": 0.17699,
        "chars": 241,
        "chars_per_1k_ink": 9.25
      }
    },
    {
      "bbox": [
        201,
        936,
        1504,
        1048
      ],
      "category": "Text",
      "text": "WHEREAS, this Order is given because of the propensity of the virus to spread person-to-\nperson, and also because the actions taken to prevent such spread have led to property loss and\ndamage;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.1894,
          "min": -1.0675
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 42,
          "mean": -0.0154,
          "min": -0.635
        }
      },
      "ink": {
        "ink_px": 19806,
        "area_px": 145996,
        "density": 0.13566,
        "chars": 192,
        "chars_per_1k_ink": 9.69
      }
    },
    {
      "bbox": [
        201,
        1090,
        1504,
        1243
      ],
      "category": "Text",
      "text": "NOW, THEREFORE, pursuant to the powers vested in me by the laws of the State of New\nYork and the City of New York, including but not limited to the New York Executive Law, the\nNew York City Charter and the Administrative Code of the City of New York, and the common\nlaw authority to protect the public in the event of an emergency:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1694,
          "min": -1.1446
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 74,
          "mean": -0.0003,
          "min": -0.0088
        }
      },
      "ink": {
        "ink_px": 34579,
