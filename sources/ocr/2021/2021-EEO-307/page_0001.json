        1049,
        1603,
        1161
      ],
      "category": "Text",
      "text": "Section 1. I hereby direct that the State of Emergency declared in Emergency Executive Order No. 230, dated September 1, 2021, and last extended by Emergency Executive Order No. 282, is extended for thirty (30) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1748,
          "min": -1.0258
        },
        "category": {
