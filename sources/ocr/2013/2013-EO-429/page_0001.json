    {
      "bbox": [
        197,
        1437,
        1517,
        1589
      ],
      "category": "Text",
      "text": "WHEREAS, NYSDEC has issued to DEP fourteen (14) State Pollutant Discharge Elimination System (SPDES) permits authorizing discharges from the City's fourteen municipal wastewater treatment plants and from combined and separate sewers in the drainage basins of each of those wastewater treatment plants;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2155,
          "min": -1.2375
        },
        "category": {
