    },
    {
      "bbox": [
        199,
        1249,
        1515,
        1400
      ],
      "category": "Text",
      "text": "WHEREAS, the New York State Department of Environmental Conservation (NYSDEC), pursuant to authority delegated by the United States Environmental Protection Agency, regulates discharges of pollutants to surface waters, including discharges from the City's combined sewer system and from the City's MS4;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2386,
          "min": -1.0983
        },
        "category": {
          "n_tokens": 1,
