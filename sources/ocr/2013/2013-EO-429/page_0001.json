        "density": 0.1527,
        "chars": 151,
        "chars_per_1k_ink": 10.2
      }
    },
    {
      "bbox": [
        201,
        1100,
        1517,
        1213
      ],
      "category": "Text",
      "text": "WHEREAS, the Department of Environmental Protection (DEP) operates and maintains both the combined sewer system and the majority of the Municipal Separate Storm Sewer System (MS4);",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.213,
          "min": -1.2268
        },
        "category": {
          "n_tokens": 1,
