        "chars_per_1k_ink": 9.89
      }
    },
    {
      "bbox": [
        195,
        1625,
        1512,
        1854
      ],
      "category": "Text",
      "text": "WHEREAS, the City, acting by and through DEP, is currently negotiating a new SPDES permit for the City's MS4 with NYSDEC that will supersede the provisions of the fourteen wastewater treatment plant SPDES permits addressing discharges from the City's MS4, and will include requirements for stormwater controls to reduce pollution from the City's MS4, including \"good housekeeping\" provisions requiring the City to minimize exposure of stormwater to potential sources of contamination from municipal operations; and",
      "logprob_stats": {
