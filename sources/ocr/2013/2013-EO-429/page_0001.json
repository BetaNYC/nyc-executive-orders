    {
      "bbox": [
        201,
        803,
        1519,
        954
      ],
      "category": "Text",
      "text": "WHEREAS, every year, approximately 45 inches of rain fall in New York City, generating an average of 165 billion gallons of stormwater, and approximately half of that rainfall makes its way into the City's combined sewer system, with much of the balance flowing directly into surrounding waterways through the City's separate storm sewers;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2723,
          "min": -1.249
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 70,
