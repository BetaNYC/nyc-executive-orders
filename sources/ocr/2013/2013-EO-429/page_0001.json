          "min": -0.089
        }
      },
      "ink": {
        "ink_px": 31997,
        "area_px": 195092,
        "density": 0.16401,
        "chars": 339,
        "chars_per_1k_ink": 10.59
      }
    },
    {
      "bbox": [
        201,
        990,
        1517,
        1064
      ],
      "category": "Text",
      "text": "WHEREAS, a number of New York City agencies plan, fund, and implement measures to control stormwater runoff to prevent pollution of surface waters, and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2303,
          "min": -1.1903
        },
        "category": {
