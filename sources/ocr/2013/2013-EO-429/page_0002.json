    {
      "bbox": [
        201,
        464,
        1524,
        846
      ],
      "category": "Text",
      "text": "Section 1. Delegation. The Commissioner of the Department of Environmental Protection is hereby directed to act on behalf of the City, and to coordinate the efforts of City agencies, with respect to all matters relating to the City's Stormwater SPDES Permit Requirements, in connection with the National Pollutant Discharge Elimination System (NPDES) program, administered by NYSDEC through the SPDES program, and may enter into agreements with NYSDEC or any other State or federal agency on behalf of the City with respect to such matters. For purposes of this Order, the term \"the City's Stormwater SPDES Permit Requirements\" includes the stormwater provisions of the fourteen (14) wastewater treatment plant SPDES permits including, but not limited to, Combined Sewer Overflow Best Management Practices, as well as the provisions of the MS4 SPDES permit.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2805,
          "min": -1.3394
        },
        "category": {
