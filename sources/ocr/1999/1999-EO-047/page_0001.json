          "mean": -0.0001,
          "min": -0.0009
        }
      },
      "ink": {
        "ink_px": 6319,
        "area_px": 169719,
        "density": 0.03723,
        "chars": 198,
        "chars_per_1k_ink": 31.33
      }
    },
    {
      "bbox": [
        268,
        1670,
        1493,
        1850
      ],
      "category": "Text",
      "text": "Whereas, Executive Law \u00a724 authorizes the Mayor to promulgate local emergency orders upon a finding that the public safety is imperiled by the event of a public emergency or in the event of reasonable apprehension of immediate danger thereof, to protect life and property and to bring an emergency situation under control;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2159,
          "min": -1.1521
        },
        "category": {
          "n_tokens": 1,
