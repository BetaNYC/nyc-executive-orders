        "chars_per_1k_ink": 19.59
      }
    },
    {
      "bbox": [
        454,
        1652,
        1379,
        1762
      ],
      "category": "Text",
      "text": "\u00a7 9. The Comptroller of The City of New York, the Director of Management and Budget, the City Personnel Director and all other officers or agencies of the City having any jurisdiction over the matters provided in this Order are hereby requested, pursuant to the powers vested in them to take the steps necessary to effectuate the provisions of this Order.",
      "logprob_stats": {
