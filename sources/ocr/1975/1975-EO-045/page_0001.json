    {
      "bbox": [
        390,
        355,
        1309,
        399
      ],
      "category": "Text",
      "text": "Section 1. The budget appropriations of all departments and agencies shall be ad-\nministered during the fiscal year 1975-1976 under the terms of this Executive Order.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1764,
          "min": -0.8434
