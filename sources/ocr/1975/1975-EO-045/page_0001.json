    },
    {
      "bbox": [
        390,
        311,
        1309,
        355
      ],
      "category": "Text",
      "text": "Now, therefore, in order to carry out and provide for an effective administration of\nthe 1975-1976 Expense Budget, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2206,
          "min": -1.0311
        },
