    {
      "bbox": [
        389,
        223,
        1309,
        311
      ],
      "category": "Text",
      "text": "Whereas, Certain itemized information and supporting schedules of appropriations, as last modified as of February 14, 1975, were contained in the Mayor's 1975-1976 Budget Message, in accordance with Section 117(b) 2 of the New York City Charter, and it is necessary to provide for certain actions taken subsequent to February 14, 1975.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1929,
