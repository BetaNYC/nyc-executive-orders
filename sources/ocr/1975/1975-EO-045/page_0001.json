    {
      "bbox": [
        390,
        399,
        1309,
        487
      ],
      "category": "Text",
      "text": "\u00a7 2. The term \"Agency\" as used in this Executive Order means any office,\nadministration, department, division, board, bureau, commission, corporation, institution or\nother unit of government, the expenses of which are paid in whole or in part from the City\nTreasury.",
      "logprob_stats": {
