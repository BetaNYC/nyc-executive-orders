    },
    {
      "bbox": [
        382,
        463,
        1307,
        508
      ],
      "category": "Text",
      "text": "Whereas, The Public Service Commission has recently authorized a further increase in the charges allowable for telephone service; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1953,
          "min": -1.0657
        },
        "category": {
