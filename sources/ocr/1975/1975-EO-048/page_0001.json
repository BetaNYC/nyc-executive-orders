        "chars_per_1k_ink": 19.37
      }
    },
    {
      "bbox": [
        408,
        1234,
        1284,
        1299
      ],
      "category": "List-item",
      "text": "\u00a7 5. All non-mayoral governmental agencies are urged to implement comparable cost reductions and are invited to participate in any plans, procedures, priorities and policies developed as a result of this Executive Order.",
      "logprob_stats": {
