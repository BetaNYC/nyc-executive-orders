      "bbox": [
        408,
        1166,
        1284,
        1234
      ],
      "category": "List-item",
      "text": "\u00a7 4. The Municipal Services Administrator shall render periodic reports to the Mayor indicating the policies, implementation, effectiveness and savings achieved as a result of this program.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1901,
