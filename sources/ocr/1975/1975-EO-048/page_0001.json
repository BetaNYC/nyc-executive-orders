      }
    },
    {
      "bbox": [
        382,
        414,
        1307,
        457
      ],
      "category": "Text",
      "text": "Whereas, The total annual telephone expenditure made by The City of New York is deemed an area in which considerable economies can be realized; and",
      "logprob_stats": {
