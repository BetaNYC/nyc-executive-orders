    },
    {
      "bbox": [
        406,
        690,
        1208,
        713
      ],
      "category": "Text",
      "text": "Whereas, There exists a need to realize telephone savings in all City agencies.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2444,
          "min": -1.2452
