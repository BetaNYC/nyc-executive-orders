        "density": 0.17983,
        "chars": 383,
        "chars_per_1k_ink": 20.31
      }
    },
    {
      "bbox": [
        355,
        1401,
        1277,
        1447
      ],
      "category": "List-item",
      "text": "\u00a7 7. The Comptroller of The City of New York is hereby requested to make such payments to the affected employees.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1621,
