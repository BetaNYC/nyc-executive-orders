          "min": -0.0053
        }
      },
      "ink": {
        "ink_px": 7088,
        "area_px": 42780,
        "density": 0.16568,
        "chars": 149,
        "chars_per_1k_ink": 21.02
      }
    },
    {
      "bbox": [
        355,
        1291,
        1277,
        1403
      ],
      "category": "List-item",
      "text": "\u00a7 6. The Director of Management and Budget of The City of New York is hereby designated and empowered to transfer such necessary funds that may be required in accordance with Section 124-a and/or b of the City Charter for the payment to such retired employees of the monetary value of accumulated and unused annual leave or compensatory time standing to the credit of such employees.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1917,
          "min": -1.1489
        },
        "category": {
          "n_tokens": 2,
