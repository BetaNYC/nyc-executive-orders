    {
      "bbox": [
        415,
        861,
        1299,
        950
      ],
      "category": "Text",
      "text": "Section 1. There is hereby established under the direction of the Office of the Mayor a Commission on the Status of Women, the members of which shall be appointed by and serve at the pleasure of the Mayor. The Mayor shall designate a Chairperson and Vice-Chairperson from the members of the Commission so appointed.",
      "logprob_stats": {
        "bbox": {
