    },
    {
      "bbox": [
        370,
        774,
        1299,
        817
      ],
      "category": "Text",
      "text": "Whereas, It is necessary and desirable that The City of New York provide a program for the enactment and implementation of said policy;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.207,
          "min": -1.0982
