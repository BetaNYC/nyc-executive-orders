          "min": -0.1647
        }
      },
      "ink": {
        "ink_px": 6093,
        "area_px": 40656,
        "density": 0.14987,
        "chars": 113,
        "chars_per_1k_ink": 18.55
      }
    },
    {
      "bbox": [
        428,
        940,
        1344,
        986
      ],
      "category": "Text",
      "text": "Now, therefore, pursuant to the authority vested in me as Mayor of The City of New\nYork, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1989,
          "min": -1.1086
        },
        "category": {
          "n_tokens": 1,
