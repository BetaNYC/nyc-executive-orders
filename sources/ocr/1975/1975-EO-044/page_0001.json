        "density": 0.12468,
        "chars": 110,
        "chars_per_1k_ink": 19.89
      }
    },
    {
      "bbox": [
        428,
        989,
        1346,
        1035
      ],
      "category": "Text",
      "text": "Section 1. There is hereby created a Municipal News and Information Bureau in the\nOffice of the Mayor.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2268,
          "min": -1.2345
        },
        "category": {
          "n_tokens": 1,
