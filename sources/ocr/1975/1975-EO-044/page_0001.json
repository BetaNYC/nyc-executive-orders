    },
    {
      "bbox": [
        473,
        1056,
        1346,
        1120
      ],
      "category": "List-item",
      "text": "(a) to act as public information representative for Mayoral agencies not staffed\nwith public affairs or public information personnel and to provide all duties normally\nassociated with that function.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1631,
          "min": -0.9165
        },
        "category": {
