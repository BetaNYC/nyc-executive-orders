    {
      "bbox": [
        426,
        851,
        1344,
        897
      ],
      "category": "Text",
      "text": "Whereas, It is necessary for the City to provide fast and accurate information on the\nfunctions of its various agencies to the media and the public; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2471,
          "min": -1.2941
        },
        "category": {
