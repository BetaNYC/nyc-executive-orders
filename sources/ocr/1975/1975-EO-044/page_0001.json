        "chars_per_1k_ink": 20.02
      }
    },
    {
      "bbox": [
        428,
        897,
        1344,
        940
      ],
      "category": "Text",
      "text": "Whereas, The fiscal constraints of the City demand that these services be performed\nefficiently and economically;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2176,
          "min": -1.1813
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 23,
