    {
      "bbox": [
        355,
        1286,
        1224,
        1353
      ],
      "category": "List-item",
      "text": "\u00a7 5. With respect to electrical energy programs for savings, this Order augments Executive Order No. 29, dated April 16, 1975, and grants specific powers, duties and responsibilities to the Municipal Service Administrator.",
      "logprob_stats": {
