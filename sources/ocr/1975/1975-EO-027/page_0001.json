          "min": -0.0487
        }
      },
      "ink": {
        "ink_px": 13289,
        "area_px": 67817,
        "density": 0.19595,
        "chars": 248,
        "chars_per_1k_ink": 18.66
      }
    },
    {
      "bbox": [
        355,
        434,
        1277,
        480
      ],
      "category": "Text",
      "text": "Whereas, The arts have for countless years flourished and brought fame and excitement to our City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2601,
          "min": -1.295
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 21,
          "mean": -0.0035,
          "min": -0.0445
        }
      },
      "ink": {
        "ink_px": 5971,
        "area_px": 43522,
        "density": 0.13719,
        "chars": 102,
        "chars_per_1k_ink": 17.08
      }
    },
    {
      "bbox": [
        355,
        478,
        1277,
        525
      ],
      "category": "Text",
      "text": "Whereas, All the people of this City bask in the beauty and glory of our vast cultural capacity; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.192,
          "min": -1.2253
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 22,
          "mean": -0.0005,
          "min": -0.0053
        }
      },
      "ink": {
        "ink_px": 5471,
        "area_px": 44448,
        "density": 0.12309,
        "chars": 100,
        "chars_per_1k_ink": 18.28
      }
    },
    {
      "bbox": [
        355,
        525,
        1277,
        596
      ],
      "category": "Text",
      "text": "Whereas, The continuous maintenance and growth of the arts is a continuing concern, so that the blessings and benefits of these cultural resources may be made available to enhance and enrich the lives of all of the people of this City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1816,
          "min": -1.2626
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 46,
          "mean": -0.0001,
          "min": -0.0012
        }
      },
      "ink": {
        "ink_px": 12667,
        "area_px": 66672,
        "density": 0.18999,
        "chars": 239,
        "chars_per_1k_ink": 18.87
      }
    },
    {
      "bbox": [
        355,
        594,
        1277,
        684
      ],
      "category": "Text",
      "text": "Whereas, The general welfare of the people of New York City will be promoted and enriched by the continued recognition of the notable contributions of the arts and the further study of means and programs to expand our cultural activities and maintain our heritage in these areas.",
      "logprob_stats": {
