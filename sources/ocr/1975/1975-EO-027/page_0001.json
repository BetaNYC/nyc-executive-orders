    {
      "bbox": [
        352,
        367,
        1277,
        439
      ],
      "category": "Text",
      "text": "Whereas, The City of New York has been long renowned as an international center of cultural resources and facilities for the enjoyment and education of all of its citizens and the countless visitors who, each year, share these rich experiences; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2527,
          "min": -1.1216
        },
        "category": {
          "n_tokens": 1,
