    },
    {
      "bbox": [
        372,
        723,
        1292,
        770
      ],
      "category": "Text",
      "text": "Whereas, Such reductions are through restrictions in new hiring, termination of pro-\nvisional employees and layoffs of permanently appointed employees; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1956,
          "min": -1.1571
        },
        "category": {
