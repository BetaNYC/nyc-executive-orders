    },
    {
      "bbox": [
        370,
        653,
        1292,
        721
      ],
      "category": "Text",
      "text": "Whereas, Reductions are being effected in part through overall review of personnel resources and employment requirements of agencies in light of the needs of the public service; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1908,
          "min": -0.961
        },
        "category": {
