    },
    {
      "bbox": [
        370,
        603,
        1292,
        649
      ],
      "category": "Text",
      "text": "Whereas, In furtherance of this objective, agencies have been required to review ex-\npenditures and effect necessary reductions; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2269,
          "min": -1.2568
        },
        "category": {
