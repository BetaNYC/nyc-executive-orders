    },
    {
      "bbox": [
        340,
        812,
        1271,
        857
      ],
      "category": "Text",
      "text": "Whereas, Arrangements can be made for the functions of the Office of Staten Island\nDevelopment to be absorbed by other City agencies.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2009,
