    {
      "bbox": [
        387,
        269,
        1307,
        359
      ],
      "category": "Text",
      "text": "Whereas, New York City Local Law No. 43 for the year 1975 grants the Mayor the power to direct by Executive Order the suspension of all or part of certain increases in salary or wages of public employees and all or part of certain increases in other payments to public employees.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2401,
          "min": -1.22
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 61,
          "mean": -0.0044,
          "min": -0.2548
        }
      },
