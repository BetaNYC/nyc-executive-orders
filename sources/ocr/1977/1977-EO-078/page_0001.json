    {
      "bbox": [
        433,
        695,
        1351,
        740
      ],
      "category": "Text",
      "text": "Whereas, The City of New York, especially in a time of fiscal austerity, must make every effort to improve the quality and delivery of human services; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2449,
          "min": -1.1904
        },
        "category": {
          "n_tokens": 1,
