          "min": -0.4328
        }
      },
      "ink": {
        "ink_px": 8619,
        "area_px": 42504,
        "density": 0.20278,
        "chars": 155,
        "chars_per_1k_ink": 17.98
      }
    },
    {
      "bbox": [
        477,
        740,
        1351,
        762
      ],
      "category": "Text",
      "text": "Whereas, The City recognizes the need to maximize the use of existing resources; and,",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2316,
          "min": -1.3707
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0004,
          "min": -0.0004
        },
        "text": {
          "n_tokens": 18,
          "mean": -0.0006,
          "min": -0.0058
        }
      },
      "ink": {
        "ink_px": 5042,
        "area_px": 20240,
        "density": 0.24911,
        "chars": 85,
        "chars_per_1k_ink": 16.86
      }
    },
    {
      "bbox": [
        433,
        762,
        1351,
        848
      ],
      "category": "Text",
      "text": "Whereas, The City views as necessary and desirable the presence of a mechanism to formulate long range plans and the need to provide an instrument for receiving recommendations from the people of New York in our effort to establish priorities in human services;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2119,
          "min": -1.302
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 46,
          "mean": -0.004,
          "min": -0.1133
        }
      },
      "ink": {
        "ink_px": 15344,
        "area_px": 80388,
        "density": 0.19087,
        "chars": 261,
        "chars_per_1k_ink": 17.01
      }
    },
    {
      "bbox": [
        433,
        849,
        1351,
        894
      ],
      "category": "Text",
      "text": "Now, therefore, by the power vested in me as Mayor of The City of New York, it is hereby ordered:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1991,
          "min": -1.1162
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 24,
          "mean": -0.001,
          "min": -0.0206
        }
      },
      "ink": {
        "ink_px": 5457,
        "area_px": 42504,
        "density": 0.12839,
        "chars": 97,
        "chars_per_1k_ink": 17.78
      }
    },
    {
      "bbox": [
        433,
        894,
        1351,
        960
      ],
      "category": "Text",
      "text": "Section 1. There shall be established an Office of Human Services Planning (OHSP) in the Office of the Mayor which shall seek to minimize the impact on human services of budget cuts necessitated by the fiscal crisis.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1848,
          "min": -1.2717
        },
        "category": {
          "n_tokens": 1,
