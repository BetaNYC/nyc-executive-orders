    {
      "bbox": [
        429,
        692,
        1344,
        735
      ],
      "category": "Text",
      "text": "Section 1. Sections 1, 2 and 3 of Executive Order No. 76, dated February 10, 1977, are hereby amended to read as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1732,
          "min": -1.0486
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0444,
          "min": -0.0444
        },
        "text": {
          "n_tokens": 42,
          "mean": -0.0001,
          "min": -0.0026
        }
      },
      "ink": {
