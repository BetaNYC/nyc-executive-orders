    },
    {
      "bbox": [
        474,
        741,
        1346,
        829
      ],
      "category": "Text",
      "text": "\"Section 1. A Westway Expediting Council is hereby created, consisting of the First Deputy Mayor, who shall be Chairman, the Transportation Administrator, the Director of Construction, the Chairman of the City Planning Commission, the Corporation Counsel and the Director of the Office of Management and Budget.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2117,
          "min": -1.2042
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0032,
          "min": -0.0032
        },
        "text": {
          "n_tokens": 58,
          "mean": -0.0042,
          "min": -0.1675
        }
      },
      "ink": {
        "ink_px": 13269,
        "area_px": 78053,
        "density": 0.17,
        "chars": 311,
        "chars_per_1k_ink": 23.44
      }
    },
    {
      "bbox": [
        474,
        829,
        1346,
        894
      ],
      "category": "Text",
      "text": "§ 2. The Transportation Administrator will coordinate all technical activities relating to the expeditious preparation of the official roadway map and the Planning Commission Chairman will coordinate land use and planning activities.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1783,
          "min": -1.168
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0163,
          "min": -0.0163
