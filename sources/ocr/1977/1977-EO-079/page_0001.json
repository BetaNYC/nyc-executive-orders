          "min": -0.0626
        }
      },
      "ink": {
        "ink_px": 9533,
        "area_px": 57882,
        "density": 0.1647,
        "chars": 233,
        "chars_per_1k_ink": 24.44
      }
    },
    {
      "bbox": [
        474,
        894,
        1346,
        960
      ],
      "category": "Text",
      "text": "The Director of Construction will be responsible for coordinating the expeditious relocation and development of public facilities and continue as liaison to the construction industry.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1485,
          "min": -0.7669
        },
