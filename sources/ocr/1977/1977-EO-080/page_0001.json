      "bbox": [
        407,
        969,
        1283,
        1014
      ],
      "category": "List-item",
      "text": "(b) to collect, investigate, compile and publish statistical information relating to the conditions of labor and matters affecting private employment within the City;",
      "logprob_stats": {
