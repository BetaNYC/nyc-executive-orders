        364,
        702,
        1283,
        767
      ],
      "category": "Text",
      "text": "Whereas, The Mayor's Management Advisory Board has recommended the appoint-\nment of an executive manager with responsibility for promoting good labor-management\nrelations.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1708,
