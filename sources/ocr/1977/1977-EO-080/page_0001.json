      "bbox": [
        364,
        656,
        1283,
        702
      ],
      "category": "Text",
      "text": "Whereas, Labor-management harmony is a very important ingredient in the economic\nwell-being of the City; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2073,
          "min": -1.1411
        },
        "category": {
