        "chars": 104,
        "chars_per_1k_ink": 18.19
      }
    },
    {
      "bbox": [
        407,
        902,
        1283,
        970
      ],
      "category": "List-item",
      "text": "(a) to maintain relationships with labor and management in the private sector and coordinate and implement the programs designed to maximize stable labor relations in the private sector;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1803,
          "min": -1.131
        },
