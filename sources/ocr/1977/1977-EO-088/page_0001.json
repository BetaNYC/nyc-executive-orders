        1174,
        618
      ],
      "category": "Title",
      "text": "ESTABLISHMENT OF A SPECIAL COMMISSION OF INQUIRY\nINTO ENERGY FAILURES",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2372,
          "min": -1.2843
        },
        "category": {
