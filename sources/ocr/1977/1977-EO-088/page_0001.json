        "density": 0.18197,
        "chars": 327,
        "chars_per_1k_ink": 20.4
      }
    },
    {
      "bbox": [
        310,
        1411,
        1282,
        1480
      ],
      "category": "List-item",
      "text": "Section 4. The commission may appoint such employees, experts, and consultants as it deems proper within the appropriation provided therefore, and shall make reports to the Mayor at such times as the Mayor shall direct.",
      "logprob_stats": {
