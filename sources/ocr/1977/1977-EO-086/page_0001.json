    {
      "bbox": [
        300,
        769,
        1219,
        812
      ],
      "category": "Text",
      "text": "Section 1. Section 1 of the Executive Order No. 28 dated March 31, 1975, is hereby amended to read as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.183,
          "min": -1.0729
