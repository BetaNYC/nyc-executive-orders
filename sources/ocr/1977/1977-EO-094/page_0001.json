    },
    {
      "bbox": [
        353,
        608,
        1186,
        647
      ],
      "category": "Text",
      "text": "Whereas, HUD intends to fund a demonstration project of sweat equity homesteading based upon certain terms and conditions; and",
      "logprob_stats": {
        "bbox": {
