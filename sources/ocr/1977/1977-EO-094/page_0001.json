    },
    {
      "bbox": [
        353,
        533,
        1186,
        608
      ],
      "category": "Text",
      "text": "Whereas, A proposal has been submitted to the United States Department of Housing and Urban Development (\"HUD\") for a demonstration project of sweat equity homesteading in multiple dwellings located in part of the Morrisania area of The Bronx, (\"the Neighborhood\"); and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2192,
          "min": -1.2085
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 55,
