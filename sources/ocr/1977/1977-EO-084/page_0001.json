    {
      "bbox": [
        325,
        916,
        1252,
        1006
      ],
      "category": "Text",
      "text": "Section 1. Subsection (e) of Section 1 of Executive Order No. 2 (2d) dated January 21, 1970, and amended by Executive Order No. 59 dated May 24, 1972, is hereby amended by amending subsection (e) of section 1 thereof, such subsection having been added by Executive Order No. 73 of January 15, 1973, to read as follows:",
      "logprob_stats": {
