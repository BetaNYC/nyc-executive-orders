        "chars_per_1k_ink": 17.12
      }
    },
    {
      "bbox": [
        325,
        867,
        1252,
        912
      ],
      "category": "Text",
      "text": "Now, therefore, by the power vested in me as the Mayor of The City of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1793,
          "min": -1.0595
        },
        "category": {
          "n_tokens": 1,
