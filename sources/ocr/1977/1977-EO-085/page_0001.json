    {
      "bbox": [
        411,
        1078,
        1336,
        1185
      ],
      "category": "Text",
      "text": "§ 2. Each agency will reduce copier costs (i.e.—rentals and supplies) by no less than 20 per cent of the base period, Fiscal Year 1976, either in or by the end of Fiscal Year 1978. Costs referred to are those paid out of tax levy funds only. Each agency head shall formulate a plan to meet this mandate and shall submit such plan to the Office of Management and Budget for approval no later than July 22, 1977.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2016,
          "min": -1.1188
