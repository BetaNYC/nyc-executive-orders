    {
      "bbox": [
        409,
        702,
        1334,
        748
      ],
      "category": "Text",
      "text": "Whereas, It is the policy of The City of New York to utilize its resources in the most\neffective and efficient manner in providing its required municipal services; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2335,
          "min": -1.241
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
