        "density": 0.14547,
        "chars": 114,
        "chars_per_1k_ink": 17.65
      }
    },
    {
      "bbox": [
        409,
        837,
        1334,
        881
      ],
      "category": "Text",
      "text": "Now, therefore, by the power vested in me as Mayor of The City of New York, it is\nhereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1766,
          "min": -0.9154
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0025,
          "min": -0.0025
        },
        "text": {
          "n_tokens": 28,
          "mean": -0.0006,
          "min": -0.0137
        }
      },
