        "density": 0.19425,
        "chars": 167,
        "chars_per_1k_ink": 19.78
      }
    },
    {
      "bbox": [
        409,
        748,
        1334,
        791
      ],
      "category": "Text",
      "text": "Whereas, Continuing pressures on the City budget require that all avenues of improving\nthe utilization of its resources be examined; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1888,
          "min": -0.9853
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 25,
          "mean": -0.0041,
          "min": -0.0639
        }
      },
      "ink": {
        "ink_px": 7221,
        "area_px": 40700,
        "density": 0.17742,
        "chars": 136,
        "chars_per_1k_ink": 18.83
      }
    },
    {
      "bbox": [
        409,
        792,
        1334,
        839
      ],
      "category": "Text",
      "text": "Whereas, Cost savings and increased efficiency can be realized through improving utilization of copying equipment.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2117,
          "min": -1.0228
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 18,
