    {
      "bbox": [
        309,
        328,
        1238,
        396
      ],
      "category": "Text",
      "text": "Whereas, It is essential to the economic well-being of the City to promote and encourage the utilization by the business community of the \"One-Stop-Business-Service\" in the Office of Economic Development; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2515,
          "min": -1.2222
        },
        "category": {
          "n_tokens": 1,
