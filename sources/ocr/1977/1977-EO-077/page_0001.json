        "chars_per_1k_ink": 17.21
      }
    },
    {
      "bbox": [
        309,
        702,
        1236,
        832
      ],
      "category": "Text",
      "text": "§ 2. To insure cooperation for the One-Stop-Business-Service with City agencies, the head of each department shall designate a high-ranking representative with authority to implement the objectives of this Executive Order and who shall serve as the business service liaison with the One-Stop-Business-Service. Such designations must be filed in my office and the Office of the Deputy Mayor for Economic Development within one week of the date of this Order.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.165,
          "min": -1.0419
        },
        "category": {
          "n_tokens": 1,
