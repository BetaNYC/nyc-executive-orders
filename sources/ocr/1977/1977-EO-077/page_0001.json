        "chars_per_1k_ink": 17.94
      }
    },
    {
      "bbox": [
        309,
        396,
        1236,
        439
      ],
      "category": "Text",
      "text": "Whereas, This vital service assists such businessess in their dealings with City agencies; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2135,
          "min": -1.2508
        },
        "category": {
          "n_tokens": 1,
