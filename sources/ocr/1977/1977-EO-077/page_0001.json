    },
    {
      "bbox": [
        309,
        485,
        1236,
        573
      ],
      "category": "Text",
      "text": "Whereas, in order to promote and advance commercial and industrial prosperity in the City and to eliminate delays, burdens and other procedures that are having an adverse effect on business, it is essential that the One-Stop-Business-Service receive the highest degree of cooperation from all City agencies.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1925,
          "min": -1.0901
        },
        "category": {
          "n_tokens": 1,
