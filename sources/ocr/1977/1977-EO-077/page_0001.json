        "chars": 109,
        "chars_per_1k_ink": 17.8
      }
    },
    {
      "bbox": [
        309,
        616,
        1236,
        702
      ],
      "category": "Text",
      "text": "Section 1. The One-Stop-Business-Service of the New York City Office of Economic Development shall function as coordinator for The City of New York on behalf of the business community to expedite assistance to individual firms in eliminating impediments, restrictions and delays which cause economic loss.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1767,
          "min": -0.9837
        },
        "category": {
          "n_tokens": 1,
