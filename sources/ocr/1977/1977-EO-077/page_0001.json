          "min": -0.0022
        }
      },
      "ink": {
        "ink_px": 17688,
        "area_px": 82236,
        "density": 0.21509,
        "chars": 307,
        "chars_per_1k_ink": 17.36
      }
    },
    {
      "bbox": [
        311,
        573,
        1236,
        616
      ],
      "category": "Text",
      "text": "Now, therefore, by the powers vested in me as Mayor of The City of New York, it is hereby ordered as follows:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1835,
          "min": -1.1179
        },
        "category": {
