        "area_px": 40656,
        "density": 0.12475,
        "chars": 94,
        "chars_per_1k_ink": 18.53
      }
    },
    {
      "bbox": [
        311,
        440,
        1236,
        485
      ],
      "category": "Text",
      "text": "Whereas, The enhancement and protection of the economic life of the City requires the full cooperation of all City agencies having dealings with the business community; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2117,
          "min": -1.1069
        },
        "category": {
          "n_tokens": 1,
