        "density": 0.17484,
        "chars": 210,
        "chars_per_1k_ink": 18.44
      }
    },
    {
      "bbox": [
        306,
        1035,
        1271,
        1078
      ],
      "category": "Text",
      "text": "Whereas, The maintenance of a coordinated, high quality emergency medical services system is essential to the preservation of the life and health of the residents of New York City.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1638,
          "min": -0.9626
        },
        "category": {
          "n_tokens": 1,
