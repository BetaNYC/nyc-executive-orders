    {
      "bbox": [
        312,
        776,
        1279,
        822
      ],
      "category": "Text",
      "text": "Whereas, The Emergency Medical Service of the New York City Health and Hospitals Corporation was established to provide pre-hospital emergency services; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2588,
          "min": -1.3265
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 27,
          "mean": -0.0077,
          "min": -0.2038
        }
      },
      "ink": {
        "ink_px": 7870,
        "area_px": 45778,
        "density": 0.17192,
        "chars": 156,
        "chars_per_1k_ink": 19.82
      }
    },
    {
      "bbox": [
        312,
        822,
        1279,
        909
      ],
      "category": "Text",
      "text": "Whereas, The Emergency Medical Service is the primary provider of pre-hospital emergency medical care in New York City, and is charged with providing safe, expeditious transportation to the medical facility best equipped to render appropriate care, without regard to any patient's ability to pay; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.21,
          "min": -0.8894
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 56,
          "mean": -0.0088,
          "min": -0.4831
        }
      },
      "ink": {
        "ink_px": 15824,
        "area_px": 86686,
        "density": 0.18254,
        "chars": 300,
        "chars_per_1k_ink": 18.96
      }
    },
    {
      "bbox": [
        306,
        925,
        1271,
        970
      ],
      "category": "Text",
      "text": "Whereas, The Emergency Medical Service maintains a central Medical Emergency Communications and Control Center for the purposes of dispatching ambulances; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2284,
          "min": -1.2413
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 27,
          "mean": -0.0002,
          "min": -0.0016
        }
      },
      "ink": {
        "ink_px": 9503,
        "area_px": 44712,
        "density": 0.21254,
        "chars": 158,
        "chars_per_1k_ink": 16.63
      }
    },
    {
      "bbox": [
        306,
        969,
        1271,
        1035
      ],
      "category": "Text",
      "text": "Whereas, The New York City Health and Hospitals Corporation has received funds from the United States Department of Health, Education and Welfare to establish a coordinated emergency medical service system; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2096,
          "min": -1.168
        },
        "category": {
          "n_tokens": 1,
