        "chars": 546,
        "chars_per_1k_ink": 18.01
      }
    },
    {
      "bbox": [
        374,
        961,
        1347,
        1051
      ],
      "category": "Text",
      "text": "Whereas, It is necessary and desirable to transfer all functions, powers and duties of the Council Against Poverty to the Administrator of the Human Resources Administration in order to provide for direct administration of the City of New York's community action program for an interim period;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2237,
          "min": -1.1918
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 51,
          "mean": -0.0051,
