        }
      },
      "ink": {
        "ink_px": 25608,
        "area_px": 112585,
        "density": 0.22745,
        "chars": 429,
        "chars_per_1k_ink": 16.75
      }
    },
    {
      "bbox": [
        377,
        1266,
        1355,
        1404
      ],
      "category": "Text",
      "text": "Section 3. Except to the extent that they may be inconsistent with this order, all determinations, authorizations, regulations, writing, certificates, orders, directives, agreements, and other actions made, issued or entered into with request to any function, power or duty affected by this order and not revoked, superseded or otherwise made inapplicable before the effective date of this order shall continue in full force and effect until amended, modified or terminated or suspended by the Interim Administrator.",
      "logprob_stats": {
        "bbox": {
