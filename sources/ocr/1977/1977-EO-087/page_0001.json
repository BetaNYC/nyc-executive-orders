        "chars": 293,
        "chars_per_1k_ink": 18.54
      }
    },
    {
      "bbox": [
        374,
        1047,
        1347,
        1161
      ],
      "category": "Text",
      "text": "Section 1. The Administrator, Human Resources Administration of The City of New York, is hereby appointed interim administrator (\"Interim Administrator\") for the community action program of The City of New York (\"Community Action Program\"), to serve in such capacity until such time as a new administering board for the Community Action Program is constituted (the \"Interim Period\").",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2171,
          "min": -1.3366
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.5761,
          "min": -0.5761
        },
        "text": {
          "n_tokens": 74,
          "mean": -0.0005,
          "min": -0.0237
        }
      },
      "ink": {
        "ink_px": 21594,
        "area_px": 112355,
        "density": 0.19219,
        "chars": 383,
        "chars_per_1k_ink": 17.74
      }
    },
    {
      "bbox": [
        377,
        1158,
        1352,
        1271
      ],
      "category": "Text",
      "text": "Section 2. All of the functions, powers and duties of the New York City Council Against Poverty created by Executive Order No. 28 of August 15, 1966, as amended by Executive Order No. 84 of July 1, 1968, such Executive Order No. 84 having been amended by Executive Order No. 34 of August 26, 1975 and Executive Order No. 67 of August 16, 1976, are hereby transferred to and vested in such Administrator during the interim period.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2371,
          "min": -1.2845
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
