    {
      "bbox": [
        373,
        809,
        1347,
        960
      ],
      "category": "Text",
      "text": "Whereas, The Community Services Administration has withdrawn its recognition and approval of the Council Against Poverty as the administering board of the community action program in The City of New York and requested that The City of New York, as grantee, directly administer The City of New York's community action program on an interim basis until a new administering board is constituted and until the boards of directors of community corporations are reconstituted in compliance with requirements of the Community Services Administraton; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2396,
          "min": -1.2073
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 94,
          "mean": -0.0072,
          "min": -0.5903
        }
      },
      "ink": {
        "ink_px": 30312,
        "area_px": 149634,
