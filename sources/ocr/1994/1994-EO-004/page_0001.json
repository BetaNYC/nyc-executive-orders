          "min": -0.5264
        }
      },
      "ink": {
        "ink_px": 53056,
        "area_px": 409978,
        "density": 0.12941,
        "chars": 821,
        "chars_per_1k_ink": 15.47
      }
    },
    {
      "bbox": [
        290,
        1356,
        1436,
        1642
      ],
      "category": "List-item",
      "text": "(b) Members shall be appointed (and reappointed) for two year periods in the discretion of the Mayor, except that the term of the initial nine members appointed hereunder shall expire on December 31, 1995. Any member whose term has expired may continue to serve at the pleasure of the Mayor until such time as the member is reappointed or a successor is appointed. The Mayor shall designate the Committee Chair. Adjunct members shall function under section four as voting members until the appointments or reappointments for which they have been designated become final, and such adjunct members may be redesignated at the discretion of the Committee Chair.",
