    {
      "bbox": [
        292,
        550,
        1440,
        944
      ],
      "category": "Text",
      "text": "Section 1. Committee Established. The Mayor's Advisory Committee on appointments (hereinafter called the \"Committee\") hereby is established to assist the Mayor in the recruitment and evaluation of highly qualified candidates of superior ability for appointment, and to evaluate incumbent members for reappointment, to the following commissions and boards: Art Commission, Board of Health (other than the chair), Board of Standards and Appeals, City Planning Commission (other than the chair), Conflicts of Interest Board, Hardship Appeals Panel, Landmarks Preservation Commission, Tax Commission, Taxi and Limousine Commission, the public members of the Environmental Control Board, and the Campaign Finance Board (other than the chair), and any other commission, board or public body as shall be determined by the Mayor, from time to time in his discretion.",
      "logprob_stats": {
        "bbox": {
