    {
      "bbox": [
        172,
        345,
        1320,
        415
      ],
      "category": "Text",
      "text": "(c) Refer to the Department of Investigation for screening all persons the Committee proposes to nominate for appointment;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.245,
          "min": -1.2911
        },
