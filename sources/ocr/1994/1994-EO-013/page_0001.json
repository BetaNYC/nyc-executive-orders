    },
    {
      "bbox": [
        180,
        1276,
        1498,
        1491
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Housing Authority (NYCHA) and the City of New York recognize that a merger of the New York City Housing Authority Police Department (HAPD) and the New York City Police Department (NYPD), subject to appropriate terms and conditions, would serve the best interests of the residents of public housing and the City of New York;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2472,
          "min": -1.4047
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 73,
          "mean": -0.0003,
          "min": -0.0098
        }
      },
      "ink": {
        "ink_px": 23555,
        "area_px": 275418,
        "density": 0.08552,
        "chars": 350,
        "chars_per_1k_ink": 14.86
      }
    },
    {
      "bbox": [
        182,
        1504,
        1500,
        1644
      ],
      "category": "Text",
      "text": "WHEREAS, the New York City Housing Authority and the City of New York intend to enter into a Memorandum of Understanding (MOU) containing the terms and conditions of a merger of the HAPD and the NYPD; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2673,
          "min": -1.5001
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 46,
          "mean": -0.0003,
          "min": -0.0113
        }
      },
      "ink": {
