      ],
      "category": "Text",
      "text": "WHEREAS, merger of the three separate police forces within the City of New York would result in more effective delivery of police services to all the citizens of the City of New York, and in particular to residents of public housing;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.265,
          "min": -1.4221
        },
        "category": {
