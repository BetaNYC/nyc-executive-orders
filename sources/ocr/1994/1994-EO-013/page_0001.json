        "density": 0.07969,
        "chars": 204,
        "chars_per_1k_ink": 14.09
      }
    },
    {
      "bbox": [
        186,
        1658,
        1500,
        1760
      ],
      "category": "Text",
      "text": "WHEREAS, such MOU will provide for such merger to take place by October 1, 1994, or as soon as possible thereafter;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2606,
