        "density": 0.11067,
        "chars": 256,
        "chars_per_1k_ink": 13.71
      }
    },
    {
      "bbox": [
        250,
        1679,
        1556,
        1968
      ],
      "category": "Text",
      "text": "WHEREAS, I have determined that it is in the best interest of the City to exercise its right under Paragraph Eleventh of the Agreement to give notice, and to use the ninety day period to negotiate with the Legal Aid Society, with the purpose of reaching agreement upon modifications to the Agreement that will ensure the continuous provision of constitutionally mandated services to indigent criminal defendants, and will contain important fiscal, programmatic and professional responsibility protections for the City that are lacking in the current Agreement; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2398,
          "min": -1.1678
        },
        "category": {
