    {
      "bbox": [
        248,
        1525,
        1554,
        1660
      ],
      "category": "Text",
      "text": "WHEREAS, Paragraph Eleventh of the Agreement provides that the Agreement \"may be terminated by the City, acting by executive order of the Mayor, ... by service by certified mail of a notice of termination effective ninety (90) days after such service;\" and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2503,
          "min": -1.4183
        },
        "category": {
          "n_tokens": 1,
