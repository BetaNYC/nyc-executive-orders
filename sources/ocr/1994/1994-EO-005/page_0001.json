        "area_px": 170839,
        "density": 0.10128,
        "chars": 210,
        "chars_per_1k_ink": 12.14
      }
    },
    {
      "bbox": [
        253,
        1425,
        1576,
        1564
      ],
      "category": "Text",
      "text": "WHEREAS, the Omnibus Budget Reconciliation Act mandates that the designated community must be a full partner in the strategic planning process leading to submission of an application for designation of Empowerment Zone status; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2532,
