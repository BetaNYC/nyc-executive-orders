    {
      "bbox": [
        245,
        658,
        1566,
        869
      ],
      "category": "Text",
      "text": "WHEREAS, Subchapter C of Title XIII of the Omnibus Budget Reconciliation Act of 1993, Public Law 103-66 (the \"Act\"), authorizes the establishment of an Empowerment Zone Program under which communities of not more than 200,000 people may be designated to receive special investment and training credits and special funding for social services to enhance the economic self-sufficiency of residents of the zone; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.3063,
          "min": -1.4954
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 97,
          "mean": -0.0002,
          "min": -0.0206
        }
      },
      "ink": {
        "ink_px": 31649,
        "area_px": 264383,
        "density": 0.11971,
        "chars": 412,
        "chars_per_1k_ink": 13.02
      }
    },
    {
      "bbox": [
        248,
        886,
        1568,
        1026
      ],
      "category": "Text",
      "text": "WHEREAS, the Act authorizes local and state governments, or economic development corporations chartered by the states, to nominate areas for designation as Empowerment Zones; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2698,
          "min": -1.4192
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0002,
          "min": -0.0002
        },
        "text": {
          "n_tokens": 34,
          "mean": -0.0005,
          "min": -0.0167
        }
      },
      "ink": {
        "ink_px": 13910,
        "area_px": 175000,
        "density": 0.07949,
        "chars": 178,
        "chars_per_1k_ink": 12.8
      }
    },
    {
      "bbox": [
        248,
        1041,
        1570,
        1255
      ],
      "category": "Text",
      "text": "WHEREAS, the communities of Harlem and the South Bronx, comprising the areas to be specified further in the application for Empowerment Zone designation, contain numerous residents in need of special investment and training credits and special funding for social services to enhance their economic self-sufficiency, and otherwise meet the eligibility criteria for designation as an Empowerment Zone under the Act; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2613,
          "min": -1.3324
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 74,
          "mean": -0.0,
          "min": -0.0002
        }
      },
      "ink": {
        "ink_px": 31218,
        "area_px": 267500,
        "density": 0.1167,
        "chars": 417,
        "chars_per_1k_ink": 13.36
      }
    },
    {
      "bbox": [
        251,
        1270,
        1572,
        1407
      ],
      "category": "Text",
      "text": "WHEREAS, the City of New York and the State of New York have determined to nominate the Harlem and South Bronx communities for designation as an Empowerment Zone under the Omnibus Budget Reconciliation Act; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2583,
          "min": -1.3627
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
