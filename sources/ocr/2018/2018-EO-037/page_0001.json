        "chars": 139,
        "chars_per_1k_ink": 10.93
      }
    },
    {
      "bbox": [
        187,
        853,
        1484,
        965
      ],
      "category": "Text",
      "text": "WHEREAS, New York City's real property tax system is governed by provisions of the state constitution, other state law and local law, and has been administered in its current form for nearly four decades; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2312,
