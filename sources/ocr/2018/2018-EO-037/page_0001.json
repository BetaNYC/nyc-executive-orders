        "chars_per_1k_ink": 10.97
      }
    },
    {
      "bbox": [
        187,
        1009,
        1455,
        1082
      ],
      "category": "Text",
      "text": "WHEREAS, the real property tax system should be reviewed to determine whether any reform of such system is advisable;",
      "logprob_stats": {
        "bbox": {
