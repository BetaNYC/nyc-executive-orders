        940,
        1436,
        1090
      ],
      "category": "Text",
      "text": "WHEREAS, there is a need for uniform operation of the City's diverse media functions,\nincluding operation of the City's media assets, encouragement of local economic activity by the\nfilm, broadcasting, cable, theatre and digital industries and encouragement and development of\nnew media technologies;",
      "logprob_stats": {
        "bbox": {
