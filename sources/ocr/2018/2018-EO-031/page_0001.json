    },
    {
      "bbox": [
        157,
        1133,
        1484,
        1245
      ],
      "category": "Text",
      "text": "WHEREAS, the Mayor's Office of Media and Entertainment was established to ensure that\nthe City's media services are well-coordinated to maximize opportunities in the most efficient and\ncost effective manner, by bringing a range of media-related responsibilities under one office; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1961,
          "min": -1.1235
        },
        "category": {
