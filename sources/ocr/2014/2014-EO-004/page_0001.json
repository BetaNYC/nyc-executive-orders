    },
    {
      "bbox": [
        195,
        1382,
        1512,
        1536
      ],
      "category": "List-item",
      "text": "(b) Evaluate and conduct all necessary inquiry to determine those persons whose character ability, training, experience, temperament and commitment to equal justice under law fully qualify them for judicial office;",
      "logprob_stats": {
        "bbox": {
