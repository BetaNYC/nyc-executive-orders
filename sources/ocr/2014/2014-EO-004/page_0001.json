    },
    {
      "bbox": [
        199,
        1151,
        855,
        1188
      ],
      "category": "Section-header",
      "text": "Section 2. **Functions.** The Committee shall:",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 20,
          "mean": -0.2607,
          "min": -1.3579
        },
        "category": {
