    {
      "bbox": [
        199,
        717,
        1489,
        981
      ],
      "category": "Text",
      "text": "WHEREAS, The City of New York (the \"City\") is committed to a program of economic development that preserves the diversity that is fundamental to the City's prosperity and that prioritizes the creation of jobs that pay no less than a Living Wage and serve as gateways to the middle class;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2575,
          "min": -1.1572
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0001,
          "min": -0.0001
        },
        "text": {
          "n_tokens": 59,
          "mean": -0.0013,
          "min": -0.0583
        }
      },
      "ink": {
        "ink_px": 15969,
        "area_px": 336377,
        "density": 0.04747,
        "chars": 287,
        "chars_per_1k_ink": 17.97
      }
    },
    {
      "bbox": [
        199,
        1026,
        1425,
        1140
      ],
      "category": "Text",
      "text": "WHEREAS, the City, as a promoter of economic development, commits significant resources to development projects that provide substantial benefits to the public;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2127,
          "min": -1.245
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 27,
          "mean": -0.006,
          "min": -0.1608
        }
      },
      "ink": {
        "ink_px": 9164,
        "area_px": 138510,
        "density": 0.06616,
        "chars": 160,
        "chars_per_1k_ink": 17.46
      }
    },
    {
      "bbox": [
        199,
        1181,
        1482,
        1372
      ],
      "category": "Text",
      "text": "WHEREAS, City funds used in furtherance of economic development projects that receive Financial Assistance should be used to encourage the creation of Living Wage jobs that provide economic opportunity and serve as models to employers across the City;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.207,
          "min": -1.1918
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 42,
          "mean": -0.0,
          "min": -0.0003
        }
      },
      "ink": {
        "ink_px": 13983,
        "area_px": 242952,
        "density": 0.05755,
        "chars": 251,
        "chars_per_1k_ink": 17.95
      }
    },
    {
      "bbox": [
        199,
        1413,
        1488,
        1679
      ],
      "category": "Text",
      "text": "WHEREAS, payment of living wages has been demonstrated to yield improvements in employees' productivity and growth in their spending power, thus generating returns to the City and the economy through expansion of the City's tax base, growth in private spending and reduction in demand for City services;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.204,
          "min": -1.1183
        },
        "category": {
          "n_tokens": 1,
          "mean": -0.0,
          "min": -0.0
        },
        "text": {
          "n_tokens": 54,
