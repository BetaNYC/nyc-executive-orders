        "ink_px": 17150,
        "area_px": 338670,
        "density": 0.05064,
        "chars": 303,
        "chars_per_1k_ink": 17.67
      }
    },
    {
      "bbox": [
        199,
        1722,
        1498,
        1986
      ],
      "category": "Text",
      "text": "WHEREAS, the President recently recognized the value of living wages by instituting a requirement that employees of federal contractors receive a wage of at least $10.10 per hour, and major cities have, in recent months, set minimum and living wage rates in excess of that amount to account for economic conditions distinct to urban areas; and",
