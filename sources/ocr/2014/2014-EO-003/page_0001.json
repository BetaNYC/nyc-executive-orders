        "area_px": 182555,
        "density": 0.18055,
        "chars": 328,
        "chars_per_1k_ink": 9.95
      }
    },
    {
      "bbox": [
        191,
        1456,
        1476,
        1562
      ],
      "category": "Text",
      "text": "WHEREAS, a Natural Hazard Mitigation Plan for the City of New York approved by the Federal Emergency Management Agency (\"FEMA\") was adopted pursuant to Executive Order No. 126, dated March 4, 2009; and",
