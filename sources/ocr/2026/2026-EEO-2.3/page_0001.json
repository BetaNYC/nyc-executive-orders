    },
    {
      "bbox": [
        208,
        879,
        1514,
        994
      ],
      "category": "Text",
      "text": "WHEREAS, such orders issued prior to January 5, 2026 did not provide or require a plan for actions that would be taken to eliminate the need for the suspensions and modifications of laws and rules effected by the orders; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1818,
          "min": -1.0198
        },
        "category": {
