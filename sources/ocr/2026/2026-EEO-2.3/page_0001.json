    {
      "bbox": [
        208,
        686,
        1514,
        842
      ],
      "category": "Text",
      "text": "WHEREAS, pursuant to a state of emergency first declared by Emergency Executive Order No. 224, dated October 7, 2022, and subsequent orders extending such state of emergency, the City has operated Humanitarian Emergency Response and Relief Centers to provide temporary housing in response to the substantial increase in arrivals during recent years; and",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.2649,
          "min": -1.4411
        },
        "category": {
