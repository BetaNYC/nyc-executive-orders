        "chars_per_1k_ink": 32.78
      }
    },
    {
      "bbox": [
        208,
        1033,
        1514,
        1111
      ],
      "category": "Text",
      "text": "WHEREAS, such state of emergency continues for the present pending the expedited development and implementation of such plan;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1503,
          "min": -1.0527
        },
        "category": {
