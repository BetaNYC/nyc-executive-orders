    },
    {
      "bbox": [
        347,
        452,
        1503,
        529
      ],
      "category": "List-item",
      "text": "b. Assist City agencies in developing and supporting liaisons to the LGBTQIA+\ncommunity;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.1242,
          "min": -0.7312
        },
