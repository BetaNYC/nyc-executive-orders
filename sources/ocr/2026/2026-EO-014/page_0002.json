        "chars_per_1k_ink": 15.82
      }
    },
    {
      "bbox": [
        347,
        762,
        1503,
        915
      ],
      "category": "List-item",
      "text": "d. Work with the Mayor's Office of Nonprofit Services in outreach to nonprofit\norganizations serving LGBTQIA+ New Yorkers to increase awareness of the City's\ninitiatives and procedures to ensure that nonprofits receive timely dispersal of funds\nfor City contracts;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.0492,
          "min": -0.5639
        },
        "category": {
