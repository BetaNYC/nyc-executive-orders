    },
    {
      "bbox": [
        347,
        569,
        1503,
        723
      ],
      "category": "List-item",
      "text": "c. Coordinate with the New York City Commission on Human Rights, the Commission on Gender Equity, and other City entities as appropriate to advance measures to ensure offices and agencies do not engage in discrimination based on gender, gender identity, or sexual orientation;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 19,
          "mean": -0.0865,
          "min": -0.802
        },
        "category": {
          "n_tokens": 2,
