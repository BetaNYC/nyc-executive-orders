    },
    {
      "bbox": [
        410,
        1786,
        2578,
        1929
      ],
      "category": "Text",
      "text": "WHEREAS, such state of emergency first declared in 2021 continues for the present pending the expedited development and implementation of such plan; and",
      "logprob_stats": {
        "bbox": {
