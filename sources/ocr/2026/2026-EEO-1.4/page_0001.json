    },
    {
      "bbox": [
        352,
        1831,
        2506,
        1977
      ],
      "category": "Text",
      "text": "WHEREAS, such state of emergency first declared in 2021 continues for the present pending the expedited development and implementation of such plan;",
      "logprob_stats": {
        "bbox": {
