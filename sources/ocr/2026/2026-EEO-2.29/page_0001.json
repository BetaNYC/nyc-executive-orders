    {
      "bbox": [
        189,
        1411,
        1538,
        1484
      ],
      "category": "Text",
      "text": "\u00a7 2. Section 1 of Emergency Executive Order No. 2.28, dated May 25, 2026, is hereby extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1544,
          "min": -1.1051
        },
        "category": {
