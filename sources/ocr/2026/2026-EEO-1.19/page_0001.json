        "chars": 250,
        "chars_per_1k_ink": 35.94
      }
    },
    {
      "bbox": [
        216,
        1011,
        1496,
        1090
      ],
      "category": "Text",
      "text": "WHEREAS, the state of emergency first declared in 2021 continues for the present pending the expedited development and implementation of such plan;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1904,
          "min": -1.0468
        },
        "category": {
