        1357,
        1507,
        1434
      ],
      "category": "Text",
      "text": "Section 1. Section 1 of Emergency Executive Order No. 1.18, dated April 5, 2026, is hereby extended for five (5) days.",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.2129,
