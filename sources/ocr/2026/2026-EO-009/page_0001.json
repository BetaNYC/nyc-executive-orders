      }
    },
    {
      "bbox": [
        202,
        1528,
        1513,
        1606
      ],
      "category": "Text",
      "text": "WHEREAS, businesses that engage in junk fee pricing must be held accountable for misleading consumers and causing financial harm to New Yorkers;",
      "logprob_stats": {
        "bbox": {
          "n_tokens": 21,
          "mean": -0.1449,
          "min": -1.0997
        },
        "category": {
